<Project>
  <!-- This project intentionally opts out of the repository-wide warnings and analyzer settings.
       Its default target is set here instead of in HotCodeSpike.csproj, so an explicit
       -p:TargetFramework=net11.0 can select .NET 11 without changing tracked project files. -->
  <PropertyGroup Condition="'$(TargetFramework)' == ''">
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
</Project>
