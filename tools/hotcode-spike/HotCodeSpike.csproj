<Project Sdk="Microsoft.NET.Sdk">

  <!-- Throwaway process used by run-spike.ps1 to prove what "dotnet watch" does to a running
       .NET process. Not part of ArcaneCore.slnx. Directory.Build.props next to this file keeps
       the repo-wide settings off it. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
