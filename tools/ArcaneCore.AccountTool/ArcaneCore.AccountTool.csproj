<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ArcaneCore.AccountTool</RootNamespace>
    <AssemblyName>arcane-account</AssemblyName>
    <!-- The platforms of the self-contained release archives (tools/ops/deploy/publish-binaries.sh). Declared here so a restore records
         every runtime-specific target in packages.lock.json and the script can restore each rid in locked mode. The script selects one with
         -p:ReleaseRid=<rid> rather than -r: a global RuntimeIdentifier would also reach every referenced library, whose lock files carry no
         rid targets (NU1004). A property of this project alone does not. Without ReleaseRid the project builds exactly as before. -->
    <RuntimeIdentifiers>win-x64;linux-x64;win-arm64;linux-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(ReleaseRid)' != ''">$(ReleaseRid)</RuntimeIdentifier>
    <SelfContained Condition="'$(ReleaseRid)' != ''">true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ArcaneCore.Kernel\ArcaneCore.Kernel.csproj" />
    <ProjectReference Include="..\..\src\ArcaneCore.Cryptography\ArcaneCore.Cryptography.csproj" />
    <ProjectReference Include="..\..\src\ArcaneCore.Data\ArcaneCore.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
