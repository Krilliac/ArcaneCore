# Proprietary client data and extractor output (map/vmap/mmap/DBC) and GPL-derived world data are
# local only. RepoHygieneTests (tests/ArcaneCore.Game.Tests/Hygiene) fails if any is committed;
# synthetic tests/**/Baselines/*.sql are the only large .sql files allowed.
/data/
/local-data/
*.dbc
*.mpq
*.map
*.vmtree
*.vmtile
*.vmo
*.mmtile
*.mmap

# Docker VPS state (docs/guide/docker.md): ./env holds the compose bind mounts (client data, logs, imports), backups/ the database dumps
# of tools/ops/deploy/backup-database.sh (accounts and characters). RepoHygieneTests rejects a committed *.sql.gz.
/env/
/backups/
*.sql.gz

# Reference cores are cloned outside the repo (/home/user/refs); never tracked.
refs/

# dotnet test --logger trx output
TestResults/

# Python bytecode from tools/ops scripts run by tests
__pycache__/

timing-logs/
gate-logs/
