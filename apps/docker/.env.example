# Copy to .env next to docker-compose.yml and edit. The three database values are required (compose stops without them);
# replace both passwords with long random strings, for example: openssl rand -base64 24
DOCKER_DB_ROOT_PASSWORD=
DOCKER_DB_USER=arcane
DOCKER_DB_PASSWORD=
# The database, Prometheus and Grafana listen on 127.0.0.1 only. Set 0.0.0.0 to reach one from other hosts, behind a firewall.
#DOCKER_DB_EXTERNAL_BIND=127.0.0.1
#DOCKER_PROMETHEUS_EXTERNAL_BIND=127.0.0.1
#DOCKER_GRAFANA_EXTERNAL_BIND=127.0.0.1
# The world address sent to clients; use the host's LAN or public address for remote players.
ARCANE_REALM_ADDRESS=127.0.0.1:8085
ARCANE_REALM_NAME=ArcaneCore
ARCANE_METRICS_ENABLED=false
DOCKER_VOL_DATA=./env/data
DOCKER_VOL_LOGS=./env/logs
