<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>ArcaneCore.Kernel</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.{Hosting.Abstractions,Logging.Abstractions,Options} are part of Microsoft.NETCore.App in .NET 11 (NU1510). -->
    <!-- Logging provider (Logging/): ILoggingBuilder, ProviderAlias and options binding. Both are already in the daemons'
         graph through Microsoft.Extensions.Hosting; no third-party logging package is used. Aliased so Microsoft.Extensions.Logging 9.0.0
         does not collide (CS0433) with ProviderAliasAttribute in .NET 11's built-in Microsoft.Extensions.Logging.Abstractions. -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.21" Aliases="LoggingPkg" />
    <!-- Binds the Diagnostics section in UseArcaneDiagnostics; already in both daemons' graphs through Microsoft.Extensions.Hosting. -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.21" />
    <!-- The .conf provider (Configuration/Conf): ConfigurationProvider and the file watcher. Both are already in the daemons' graph through Microsoft.Extensions.Hosting. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.21" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.21" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Physical" Version="9.0.21" />
  </ItemGroup>

  <ItemGroup>
    <!-- The configuration catalog the .conf tooling reads at run time (generated by the Docs tests of ArcaneCore.World.Tests, see docs/guide/configuration.md). -->
    <EmbeddedResource Include="Configuration/Conf/conf-catalog.json" LogicalName="ArcaneCore.Kernel.Configuration.Conf.conf-catalog.json" />
  </ItemGroup>

</Project>
