<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ArcaneCore.Kernel</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <!-- Logging provider (Logging/): ILoggingBuilder, ProviderAlias and options binding. Both are already in the daemons'
         graph through Microsoft.Extensions.Hosting; no third-party logging package is used. -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" Aliases="MelRuntime" />
    <!-- Binds the Diagnostics section in UseArcaneDiagnostics; already in both daemons' graphs through Microsoft.Extensions.Hosting. -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.0" />
    <!-- The .conf provider (Configuration/Conf): ConfigurationProvider and the file watcher. Both are already in the daemons' graph through Microsoft.Extensions.Hosting. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Physical" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The configuration catalog the .conf tooling reads at run time (generated by the Docs tests of ArcaneCore.World.Tests, see docs/guide/configuration.md). -->
    <EmbeddedResource Include="Configuration/Conf/conf-catalog.json" LogicalName="ArcaneCore.Kernel.Configuration.Conf.conf-catalog.json" />
  </ItemGroup>

</Project>
