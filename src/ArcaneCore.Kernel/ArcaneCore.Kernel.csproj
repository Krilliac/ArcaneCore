<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ArcaneCore.Kernel</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- .NET 11 embeds several Microsoft.Extensions abstractions in the base shared framework.
         .NET 10 still needs Hosting and Logging abstractions as NuGet references.
         Keep these direct references conditional so the eventual .NET 11 build avoids NU1510. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Condition="'$(TargetFramework)' == 'net10.0'" />
    <!-- .NET 11's built-in ProviderAliasAttribute conflicts with the version in Logging 9.x,
         so retain the existing named assembly alias for .NET 11 only. On .NET 10,
         keep Logging globally visible so ProviderAliasAttribute resolves correctly. -->
    <PackageReference Include="Microsoft.Extensions.Logging" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.Extensions.Logging" Aliases="LoggingPkg" Condition="'$(TargetFramework)' == 'net11.0'" />
    <!-- Binds the Diagnostics section in UseArcaneDiagnostics; already in both daemons' graphs through Microsoft.Extensions.Hosting. -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <!-- The .conf provider (Configuration/Conf): ConfigurationProvider and the file watcher. Both are already in the daemons' graph through Microsoft.Extensions.Hosting. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Physical" />
    <!-- The in-process crash dump (Diagnostics/CrashDumpService): DiagnosticsClient.WriteDump against the process's own endpoint, the mechanism behind .debug dump. -->
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" />
  </ItemGroup>

  <ItemGroup>
    <!-- The pure helpers and struct layout of the crash dialog's TaskDialog (CrashDialogTaskDialog) are internal and unit-tested. -->
    <InternalsVisibleTo Include="ArcaneCore.Kernel.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The configuration catalog the .conf tooling reads at run time (generated by the Docs tests of ArcaneCore.World.Tests, see docs/guide/configuration.md). -->
    <EmbeddedResource Include="Configuration/Conf/conf-catalog.json" LogicalName="ArcaneCore.Kernel.Configuration.Conf.conf-catalog.json" />
  </ItemGroup>

</Project>
