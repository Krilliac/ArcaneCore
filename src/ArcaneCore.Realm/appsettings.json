{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "ArcaneCore": {
      "Console": {
        "Mode": "Color"
      },
      "Format": "Json",
      "File": {
        "Enabled": false,
        "Path": "logs/realm.jsonl",
        "RollSizeMb": 64,
        "RollDaily": true,
        "Retain": 14
      },
      "Timestamps": "Utc",
      "IncludeScopes": true
    }
  },
  "Auth": {
    "BindAddress": "0.0.0.0",
    "Port": 3724,
    "AutocreateAccounts": false,
    "AutoPatch": {
      "Enabled": false,
      "Directory": "patches",
      "FileNamePattern": "{build}{locale}.mpq",
      "Patches": []
    }
  },
  "Realm": {
    "Console": { "Enabled": true }
  },
  "Ops": {
    "Metrics": { "Enabled": false, "Exporter": "Prometheus", "RealmPrometheusPrefix": "http://localhost:9465/metrics/" },
    "Watchdog": {
      "Enabled": true,
      "Memory": { "Action": "None", "ActionHeapBytes": 0 },
      "Heartbeat": { "Mode": "Auto", "FilePath": "" },
      "Counters": { "DumpIntervalSeconds": 300 }
    }
  },
  "Database": {
    "Provider": "MariaDb",
    "ConnectionString": "Server=127.0.0.1;Port=3306;Database=arcanecore_auth;User=arcane;Password=arcane;"
  },
  "Realms": {
    "Seed": [
      {
        "Name": "ArcaneCore",
        "Address": "127.0.0.1:8085",
        "Type": "Normal",
        "Flags": "None",
        "Population": 0.0,
        "Category": 0
      }
    ]
  }
}
