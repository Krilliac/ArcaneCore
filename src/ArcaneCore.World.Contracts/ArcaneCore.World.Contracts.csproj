<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ArcaneCore.World.Contracts</RootNamespace>
  </PropertyGroup>

  <!-- The world's pack contracts (docs/design/hot-reload-tiers.md, section 4.1): the feature lifecycle interfaces and the
       core-owned seams a reloadable pack may use. Loaded in the default context (its name starts with "ArcaneCore.", see
       ModuleLoadContext.SharedPrefixes), so it never unloads; a change here is a restart. Keep it small and bump
       ContractsVersion.Current on every breaking change. -->

  <ItemGroup>
    <ProjectReference Include="..\ArcaneCore.Game\ArcaneCore.Game.csproj" />
  </ItemGroup>

  <!-- The playerbot options (Playerbots/, tier 2b) keep their internal helpers (the reload validators and computed views such as
       PlayerbotChatOptions.EffectiveProviders): made public they would become documented configuration keys. The core reads them for
       .reload config, the pack for its behaviour, the tests for both. Tier 2c revisits this list (hot-reload-tiers.md, 4.6). -->
  <ItemGroup>
    <InternalsVisibleTo Include="ArcaneCore.World" />
    <InternalsVisibleTo Include="ArcaneCore.Playerbots" />
    <InternalsVisibleTo Include="ArcaneCore.World.Tests" />
    <InternalsVisibleTo Include="ArcaneCore.Benchmarks" />
  </ItemGroup>

</Project>
