<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ArcaneCore.World</RootNamespace>
    <AssemblyName>ArcaneCore.World</AssemblyName>
    <!-- Server GC (with DATAS, the .NET 9+ default for it) and background collections: on a live-sized heap the world loop's GC
         pause total fell from 3.2-4.1 s to 0.31-0.38 s per 90 s and ticks over the 50 ms budget from 16-38 to 2, for ~200 MB more
         working set (tests/ArcaneCore.Game.Tests/Ops/GcModeMeasurementTests.cs; docs/integration/perf-limits-20261008.md).
         DOTNET_gcServer=0 in the environment restores the workstation collector without a rebuild. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <!-- Microsoft-owned (nuget.org owner dotnetframework, MIT). .debug dump writes this process's own dump through the runtime's diagnostics IPC (docs/ops/diagnostics.md). net8.0 asset, runs on net11.0. -->
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.750501" />
    <!-- Used by the Playerbots pack (src/ArcaneCore.Playerbots, the in-process chat model). It stays here because the pack loads into the
         default context of this executable, which resolves packages from this project's deps.json (docs/design/hot-reload-tiers.md, 4.6). -->
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArcaneCore.Kernel\ArcaneCore.Kernel.csproj" />
    <ProjectReference Include="..\ArcaneCore.Cryptography\ArcaneCore.Cryptography.csproj" />
    <ProjectReference Include="..\ArcaneCore.Data\ArcaneCore.Data.csproj" />
    <ProjectReference Include="..\ArcaneCore.Protocol\ArcaneCore.Protocol.csproj" />
    <ProjectReference Include="..\ArcaneCore.Game\ArcaneCore.Game.csproj" />
    <ProjectReference Include="..\ArcaneCore.World.Contracts\ArcaneCore.World.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Tier 2b (docs/design/hot-reload-tiers.md, 4.6): the Playerbots pack moved to its own assembly and still uses a short list of
       World internals (the managed-bot session members of WorldSession, a few battleground, boost, teleport and movement helpers).
       That list is pinned by tests/ArcaneCore.World.Tests/Architecture/PlayerbotCoreBoundaryTests (it may only shrink); tier 2c turns
       each entry into a public seam or a contract before the pack loads collectibly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="ArcaneCore.Playerbots" />
  </ItemGroup>

  <ItemGroup>
    <!-- The delivered Warden module for build 5875 (MaNGOS Zero src/game/Warden/WardenModuleWin5875Data.cpp, MD5 79C0768D..., stored as base64 text). -->
    <EmbeddedResource Include="Warden\WardenModuleWin5875.b64" LogicalName="ArcaneCore.World.Warden.WardenModuleWin5875.b64" />
  </ItemGroup>

</Project>
