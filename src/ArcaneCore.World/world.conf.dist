#
Skills.FlushDebounceMs = 5000

#
#    Skills.GainCrafting
#        Description: vmangos SkillGain.Crafting (default 1).
#        Type: uint
#        Default: 1
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#skills
#
Skills.GainCrafting = 1

#
#    Skills.GainDefense
#        Description: vmangos SkillGain.Defense (default 1).
#        Type: uint
#        Default: 1
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#skills
#
Skills.GainDefense = 1

#
#    Skills.GainGathering
#        Description: vmangos SkillGain.Gathering (default 1).
#        Type: uint
#        Default: 1
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#skills
#
Skills.GainGathering = 1

#
#    Skills.GainWeapon
#        Description: vmangos SkillGain.Weapon (default 1).
#        Type: uint
#        Default: 1
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#skills
#
Skills.GainWeapon = 1

#
#    Skills.MaxPrimaryTradeSkill
#        Description: vmangos MaxPrimaryTradeSkill (default 2).
#        Type: int
#        Default: 2
#        Allowed: a whole number, -2147483648 to 2147483647
