#
Locomotion.EnvironmentalDamageMin = 605

#
#    Locomotion.GhostRunSpeedBattleground
#        Description: The same inside a battleground (vmangos Death.Ghost.RunSpeed.BG,
#                     World.cpp:778, default 1).
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#locomotion
#
Locomotion.GhostRunSpeedBattleground = 1

#
#    Locomotion.GhostRunSpeedWorld
#        Description: Speed multiplier of a player whose death state is CORPSE, outside
#                     battlegrounds (vmangos Death.Ghost.RunSpeed.World, World.cpp:777,
#                     setConfigMinMax 0.1 to 10, default 1). Read literally as vmangos does
#                     (Unit.cpp:7044); at 1 it does nothing.
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#locomotion
#
Locomotion.GhostRunSpeedWorld = 1

#
#    Locomotion.MirrorTimerBreathMaxSec
#        Description: Seconds of breath under water, times the water breathing multiplier (vmangos
#                     MirrorTimer.Breath.Max, World.cpp:815, default 60).
#        Type: uint
#        Default: 60
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#locomotion
#
Locomotion.MirrorTimerBreathMaxSec = 60

#
#    Locomotion.MirrorTimerEnvironmentalMaxSec
#        Description: Seconds in lava or slime before the first pulse (vmangos
#                     MirrorTimer.Environmental.Max, World.cpp:816, default 1).
#        Type: uint
#        Default: 1
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#locomotion
#
Locomotion.MirrorTimerEnvironmentalMaxSec = 1

#
#    Locomotion.MirrorTimerFatigueMaxSec
#        Description: Seconds of fatigue in deep water before the first pulse (vmangos
#                     MirrorTimer.Fatigue.Max, World.cpp:814, default 60).
#        Type: uint
#        Default: 60
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#locomotion
#
Locomotion.MirrorTimerFatigueMaxSec = 60

#
#    Locomotion.PendingAckResponseTimeMs
#        Description: How long the client has to acknowledge a server-ordered movement change before
#                     the server enforces it (vmangos Movement.PendingAckResponseTime,
#                     World.cpp:985, default 4000 ms; the wait is multiplied by 5 while the player
#                     is being teleported, Unit.cpp:6633).
#        Type: uint
#        Default: 4000
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#locomotion
#
Locomotion.PendingAckResponseTimeMs = 4000

#
#    Locomotion.PlayerRunBackSpeedRate
#        Description: Non-retail when not 1 (default 1): player run-back speed multiplier (the
#                     fork's Movement.RunSpeedRate on MOVE_RUN_BACK; 0.1 to 10; live).
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#locomotion
#
Locomotion.PlayerRunBackSpeedRate = 1

#
#    Locomotion.PlayerRunSpeedRate
#        Description: Non-retail when not 1 (default 1): player run speed multiplier (the fork's
#                     Movement.RunSpeedRate, which also covers run back; 0.1 to 10; live).
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#locomotion
#
Locomotion.PlayerRunSpeedRate = 1

#
#    Locomotion.PlayerSpeedRate
#        Description: Non-retail when not 1 (default 1, retail): multiplies every movement speed of
#                     every player (run, run back, swim, swim back, walk), on top of the per-type
#                     rates below. Not a vmangos key: the MaNGOS Zero fork's
#                     Movement.PlayerSpeedRate (feature/movement-enhancements, WorldConfig.cpp,
#                     percent 10 to 1000, applied in the player block of Unit::UpdateSpeed,
#                     UnitSpeed.cpp:162-168), here a multiplier clamped to 0.1 to 10. Applied where
#                     a player's speed is set (UnitSpeed.SetRate), so every speed change,
#                     force-speed packet and the server's own movement use the result. Live: .reload
#                     config and .movement set re-send the speeds of every online player.
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#locomotion
#
Locomotion.PlayerSpeedRate = 1

#
#    Locomotion.PlayerSwimBackSpeedRate
#        Description: Non-retail when not 1 (default 1): player swim-back speed multiplier (the
#                     fork's Movement.SwimSpeedRate on MOVE_SWIM_BACK; 0.1 to 10; live).
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#locomotion
#
Locomotion.PlayerSwimBackSpeedRate = 1

#
#    Locomotion.PlayerSwimSpeedRate
#        Description: Non-retail when not 1 (default 1): player swim speed multiplier (the fork's
#                     Movement.SwimSpeedRate, which also covers swim back; 0.1 to 10; live).
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#locomotion
#
Locomotion.PlayerSwimSpeedRate = 1

#
#    Locomotion.PlayerTurnRate
#        Description: Non-retail when not 1 (default 1): player turn rate multiplier (0.1 to 10;
#                     live). Neither vmangos nor the fork has one; the base is vmangos
#                     baseMoveSpeed[MOVE_TURN_RATE] = 3.141594 rad/s (Unit.cpp:67-74).
#                     PlayerSpeedRate does not apply to it. A change reaches the client as
#                     SMSG_FORCE_TURN_RATE_CHANGE.
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#locomotion
#
Locomotion.PlayerTurnRate = 1

#
#    Locomotion.PlayerWalkSpeedRate
#        Description: Non-retail when not 1 (default 1): player walk speed multiplier (the fork's
#                     Movement.WalkSpeedRate; 0.1 to 10; live).
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#locomotion
#
Locomotion.PlayerWalkSpeedRate = 1

#
#    Locomotion.RateDamageFall
#        Description: Fall damage multiplier (vmangos Rate.Damage.Fall, World.cpp:533, default 1;
#                     setConfigPos: a negative value becomes 1).
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#locomotion
#
Locomotion.RateDamageFall = 1

#
#    Locomotion.SlimeDamage
#        Description: Deliberate deviation, off by default: hurt in slime like in lava. vmangos
#                     (Player.cpp:1030-1040) and mangos-classic (Player.cpp:1305-1311, "FIXME ...
#                     Undercity") damage only in magma although both define DAMAGE_SLIME; whether
#                     retail 1.12 hurt in slime cannot be proven from the references. When on, a
#                     slime pulse deals the same 605-610 as lava.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#locomotion
#
Locomotion.SlimeDamage = false

###############################################################################
# LOGGING
###############################################################################

#----------------------------------------------------------------------------
# Logging:ArcaneCore
#----------------------------------------------------------------------------

#
#    Logging.ArcaneCore.Console.Mode
#        Description: Color (default), Plain or Off. Live at reload; colour is still disabled when
#                     stdout is not a terminal or NO_COLOR is set. Values: Color, Plain, Off.
#        Type: ConsoleMode
#        Default: Color
#        Allowed: Color | Plain | Off
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
Logging.ArcaneCore.Console.Mode = Color

#
#    Logging.ArcaneCore.Console.QueueCapacity
#        Description: Lines the console writer thread may hold before new lines are dropped (and the
#                     drop counted and reported). Restart-only.
#        Type: int
#        Default: 4096
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
Logging.ArcaneCore.Console.QueueCapacity = 4096

#
#    Logging.ArcaneCore.File.Enabled
#        Description: true writes the one log file, in the chosen Format, to Path. Default off.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
Logging.ArcaneCore.File.Enabled = false

#
#    Logging.ArcaneCore.File.Path
#        Description: The active log file; relative paths resolve against the working directory.
#                     Rolled segments sit next to it as name-yyyyMMdd-NNN.ext. Not set means
#                     logs/arcanecore.jsonl for a Json file and logs/arcanecore.log for a Text file.
#        Type: string
#        Default: (not set)
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
# Logging.ArcaneCore.File.Path =

#
#    Logging.ArcaneCore.File.QueueCapacity
#        Description: Lines the file writer thread may hold before new lines are dropped (counted
#                     and reported in the file itself). The world thread never waits on the disk.
#        Type: int
#        Default: 8192
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
Logging.ArcaneCore.File.QueueCapacity = 8192

#
#    Logging.ArcaneCore.File.Retain
#        Description: Rolled segments kept next to the active file; the oldest beyond this count are
#                     deleted after each roll. 0 keeps all.
#        Type: int
#        Default: 14
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
Logging.ArcaneCore.File.Retain = 14

#
#    Logging.ArcaneCore.File.RollDaily
#        Description: true rolls at the first line of a new day (in the Timestamps clock).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
Logging.ArcaneCore.File.RollDaily = true

#
#    Logging.ArcaneCore.File.RollSizeMb
#        Description: Roll when the active file would exceed this many MiB; 0 never rolls by size.
#        Type: int
#        Default: 64
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
Logging.ArcaneCore.File.RollSizeMb = 64

#
#    Logging.ArcaneCore.Format
#        Description: The content format of the one log file: Json (one JSON object per line,
#                     structured properties kept) or Text (the plain console line format). Not set
#                     means the legacy File/Json switches decide; with nothing configured the
#                     default is Json: JSON keeps the structured state properties for ingestion, and
#                     the console already gives a text view. The file is configured under File.
#                     Restart-only. Values: Text, Json.
#        Type: LogFileFormat?
#        Default: (not set)
#        Allowed: Text | Json
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
# Logging.ArcaneCore.Format =

#
#    Logging.ArcaneCore.IncludeScopes
#        Description: true appends the active logger scopes to each line (=&gt; scope). Live at
#                     reload.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
Logging.ArcaneCore.IncludeScopes = true

#
#    Logging.ArcaneCore.Json.Enabled
#        Description: Deprecated: use File:Enabled with Format=Json. true writes one JSON object per
#                     log event to Path. Default off.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
Logging.ArcaneCore.Json.Enabled = false

#
#    Logging.ArcaneCore.Json.Path
#        Description: Deprecated: use File:Path. The active JSON-lines file; relative paths resolve
#                     against the working directory. Not set means logs/arcanecore.jsonl.
#        Type: string
#        Default: (not set)
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
# Logging.ArcaneCore.Json.Path =

#
#    Logging.ArcaneCore.Json.QueueCapacity
#        Description: Deprecated: use File:QueueCapacity. Lines the JSON writer thread may hold
#                     before new lines are dropped (counted and reported as a JSON line).
#        Type: int
#        Default: 8192
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
Logging.ArcaneCore.Json.QueueCapacity = 8192

#
#    Logging.ArcaneCore.Json.Retain
#        Description: Deprecated: use File:Retain. Rolled segments kept; the oldest beyond this
#                     count are deleted after each roll. 0 keeps all.
#        Type: int
#        Default: 14
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
Logging.ArcaneCore.Json.Retain = 14

#
#    Logging.ArcaneCore.Json.RollDaily
#        Description: Deprecated: use File:RollDaily. true rolls at the first line of a new day (in
#                     the Timestamps clock).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
Logging.ArcaneCore.Json.RollDaily = true

#
#    Logging.ArcaneCore.Json.RollSizeMb
#        Description: Deprecated: use File:RollSizeMb. Roll when the active file would exceed this
#                     many MiB; 0 never rolls by size.
#        Type: int
#        Default: 64
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
Logging.ArcaneCore.Json.RollSizeMb = 64

#
#    Logging.ArcaneCore.Timestamps
#        Description: The clock timestamps are taken from: Utc (default) or Local. Live at reload.
#                     Values: Utc, Local.
#        Type: TimestampKind
#        Default: Utc
#        Allowed: Utc | Local
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
Logging.ArcaneCore.Timestamps = Utc

###############################################################################
# LOOT
###############################################################################

#----------------------------------------------------------------------------
# Loot
#----------------------------------------------------------------------------

#
#    Loot.BossRewardDistanceBonus
#        Description: Extra yards for a world boss victim (vmangos Object.cpp:1494). 0 restores the
#                     plain limit.
#        Type: float
#        Default: 150
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loot
#
Loot.BossRewardDistanceBonus = 150

#
#    Loot.DropItemArtifactRate
#        Description: vmangos Rate.Drop.Item.Artifact (World.cpp:503, default 1): the same for
#                     artifact quality items.
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loot
#
Loot.DropItemArtifactRate = 1

#
#    Loot.DropItemEpicRate
#        Description: vmangos Rate.Drop.Item.Epic (World.cpp:501, default 1): the same for epic
#                     (purple) items.
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loot
#
Loot.DropItemEpicRate = 1

#
#    Loot.DropItemLegendaryRate
#        Description: vmangos Rate.Drop.Item.Legendary (World.cpp:502, default 1): the same for
#                     legendary (orange) items.
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loot
#
Loot.DropItemLegendaryRate = 1

#
#    Loot.DropItemNormalRate
#        Description: vmangos Rate.Drop.Item.Normal (World.cpp:498, default 1): the same for common
#                     (white) items.
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loot
#
Loot.DropItemNormalRate = 1

#
#    Loot.DropItemPoorRate
#        Description: vmangos Rate.Drop.Item.Poor (World.cpp:497, setConfigPos, default 1):
#                     multiplies the chance of an ungrouped loot row whose item is of poor (grey)
#                     quality (LootMgr.cpp:33-42 qualityToRate, applied in LootStoreItem::Roll,
#                     :256-268: a chance of 100 or more always drops, otherwise roll_chance_f(chance
#                     * rate)). Grouped rows are not scaled (LootGroup::Roll uses the raw chances,
#                     :1056-1086).
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loot
#
Loot.DropItemPoorRate = 1

#
#    Loot.DropItemRareRate
#        Description: vmangos Rate.Drop.Item.Rare (World.cpp:500, default 1): the same for rare
#                     (blue) items.
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loot
#
Loot.DropItemRareRate = 1

#
#    Loot.DropItemReferencedRate
#        Description: vmangos Rate.Drop.Item.Referenced (World.cpp:504, default 1): multiplies the
#                     chance of an ungrouped reference row (a negative mincountOrRef) to be
#                     processed (LootStoreItem::Roll, LootMgr.cpp:261-262).
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loot
#
Loot.DropItemReferencedRate = 1

#
#    Loot.DropItemUncommonRate
#        Description: vmangos Rate.Drop.Item.Uncommon (World.cpp:499, default 1): the same for
#                     uncommon (green) items.
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loot
#
Loot.DropItemUncommonRate = 1

#
#    Loot.GroupLootDistance
#        Description: vmangos CONFIG_FLOAT_GROUP_XP_DISTANCE: group members within it share loot and
#                     money.
#        Type: float
#        Default: 74
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loot
#
Loot.GroupLootDistance = 74

#
#    Loot.LootDistance
#        Description: INTERACTION_DISTANCE: how close a looter must stay to the corpse/chest (plus
#                     both radii).
#        Type: float
#        Default: 5
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loot
#
Loot.LootDistance = 5

#
#    Loot.LootedCorpseDecayRate
#        Description: vmangos CONFIG_FLOAT_RATE_CORPSE_DECAY_LOOTED (Rate.Corpse.Decay.Looted,
#                     mangosd.conf.dist.in:1542; cmangos World.cpp:457 too): a looted-out corpse
#                     stays this share of its decay time. The retail default 0 means a third of the
#                     creature's respawn delay (Creature.cpp:3369-3370).
#        Type: float
#        Default: 0
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loot
#
Loot.LootedCorpseDecayRate = 0

#
#    Loot.MoneyRate
#        Description: vmangos Rate.Drop.Money.
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loot
#
Loot.MoneyRate = 1

#
#    Loot.RaidMapsUnlimitedRewardDistance
#        Description: Raid maps have no reward distance limit (vmangos Object.cpp:1482-1483). False
#                     applies GroupLootDistance there too.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loot
#
Loot.RaidMapsUnlimitedRewardDistance = true

#
#    Loot.RollTimeoutMs
#        Description: How long a need/greed roll waits for votes before the players who did not vote
#                     count as passed, in milliseconds (vmangos Group.cpp:72 LOOT_ROLL_TIMEOUT, 1
#                     minute; the same value goes into SMSG_LOOT_START_ROLL as the countdown).
#        Type: uint
#        Default: 60000
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loot
#
Loot.RollTimeoutMs = 60000

###############################################################################
# MODULES
###############################################################################

#----------------------------------------------------------------------------
# Modules:DuelReset
#----------------------------------------------------------------------------

#
#    Modules.DuelReset.Areas
#        Description: DuelReset.Areas: area ids separated by ';' (default Elwynn Forest, Durotar,
#                     Gates of Ironforge); "" or "0" means none.
#        Type: string
#        Default: "12;14;809"
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#modulesduelreset
#
Modules.DuelReset.Areas = "12;14;809"

#
#    Modules.DuelReset.CooldownAge
#        Description: DuelReset.CooldownAge: seconds a cooldown must have run before the start
#                     resets it.
#        Type: uint
#        Default: 30
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#modulesduelreset
#
Modules.DuelReset.CooldownAge = 30

#
#    Modules.DuelReset.Cooldowns
#        Description: DuelReset.Cooldowns: reset cooldowns when the duel starts and restore them
#                     when it is won.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#modulesduelreset
#
Modules.DuelReset.Cooldowns = true

#
#    Modules.DuelReset.Enabled
#        Description: Load the module at all. Off by default: it changes duels in Elwynn Forest,
#                     Durotar and the Gates of Ironforge.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#modulesduelreset
#
Modules.DuelReset.Enabled = false

#
#    Modules.DuelReset.HealthMana
#        Description: DuelReset.HealthMana: fill health and power when the duel starts and restore
#                     them when it is won.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#modulesduelreset
#
Modules.DuelReset.HealthMana = true

#
#    Modules.DuelReset.Zones
#        Description: DuelReset.Zones: zone ids separated by ';'. "" means any zone (areas then do
#                     not matter); "0" means none.
#        Type: string
#        Default: "0"
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#modulesduelreset
#
Modules.DuelReset.Zones = "0"

