# Modules:DuelReset
#----------------------------------------------------------------------------

#
#    Modules.DuelReset.Areas
#        Description: DuelReset.Areas: area ids separated by ';' (default Elwynn Forest, Durotar,
#                     Gates of Ironforge); "" or "0" means none.
#        Type: string
#        Default: "12;14;809"
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#modulesduelreset
#
Modules.DuelReset.Areas = "12;14;809"

#
#    Modules.DuelReset.CooldownAge
#        Description: DuelReset.CooldownAge: seconds a cooldown must have run before the start
#                     resets it.
#        Type: uint
#        Default: 30
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#modulesduelreset
#
Modules.DuelReset.CooldownAge = 30

#
#    Modules.DuelReset.Cooldowns
#        Description: DuelReset.Cooldowns: reset cooldowns when the duel starts and restore them
#                     when it is won.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#modulesduelreset
#
Modules.DuelReset.Cooldowns = true

#
#    Modules.DuelReset.Enabled
#        Description: Load the module at all. Off by default: it changes duels in Elwynn Forest,
#                     Durotar and the Gates of Ironforge.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#modulesduelreset
#
Modules.DuelReset.Enabled = false

#
#    Modules.DuelReset.HealthMana
#        Description: DuelReset.HealthMana: fill health and power when the duel starts and restore
#                     them when it is won.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#modulesduelreset
#
Modules.DuelReset.HealthMana = true

#
#    Modules.DuelReset.Zones
#        Description: DuelReset.Zones: zone ids separated by ';'. "" means any zone (areas then do
#                     not matter); "0" means none.
#        Type: string
#        Default: "0"
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#modulesduelreset
#
Modules.DuelReset.Zones = "0"

