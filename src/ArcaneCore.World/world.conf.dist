#                     factions: 35 Booty Bay, 392 Ratchet, 976 Gadgetzan, 2255 Everlook, 2361
#                     Nighthaven and 2268 Light's Hope Chapel. Empty keeps only the capitals.
#        Type: string
#        Default: "35,392,976,2255,2361,2268"
#        Allowed: text
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Social.Rivalry.Safeguards.SafeAreas = "35,392,976,2255,2361,2268"

