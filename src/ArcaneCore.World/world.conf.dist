#    World.Playerbots.Groups.Cooperation.AnswerBotCalls
#        Description: Let a bot that hears another bot's LFG or LFM line for a goal it could join
#                     offer itself to that group (on by default).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Groups.Cooperation.AnswerBotCalls = true

#
#    World.Playerbots.Groups.Cooperation.GuildBonus
#        Description: The chance and the preference a guildmate of a group's member gains (0..1).
#        Type: float
#        Default: 0.2
#        Allowed: a number, '.' is the decimal point
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Groups.Cooperation.GuildBonus = 0.2

#
#    World.Playerbots.Groups.Cooperation.GuildCalls
#        Description: Let a guild's bot say "anyone for the dungeon?" in guild chat while a group of
#                     the guild's members is forming for it, and let the guildmates who hear it join
#                     at once (on by default). The line is said only when such a group exists.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Groups.Cooperation.GuildCalls = true

#
#    World.Playerbots.Groups.Cooperation.LfgAnswerBonus
#        Description: The chance a bot that answered another bot's LFG or LFM line gains (0..1).
#        Type: float
#        Default: 0.15
#        Allowed: a number, '.' is the decimal point
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Groups.Cooperation.LfgAnswerBonus = 0.15

#
#    World.Playerbots.Groups.Cooperation.MaxLfgAnswersPerLine
#        Description: The most bots that may answer one LFG or LFM line of another bot (1..64,
#                     default 4): once that many hold a place in the group, the rest of the hearers
#                     of the line are not weighed at all.
#        Type: int
#        Default: 4
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Groups.Cooperation.MaxLfgAnswersPerLine = 4

#
#    World.Playerbots.Groups.Cooperation.MaxRaidSize
#        Description: The most members a raid made from a risk signal recruits (6..40).
#        Type: int
#        Default: 40
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Groups.Cooperation.MaxRaidSize = 40

#
#    World.Playerbots.Groups.Cooperation.MentorAffinity
#        Description: The affinity a mentor needs toward the friend (-100..100).
#        Type: int
#        Default: 30
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Groups.Cooperation.MentorAffinity = 30

#
#    World.Playerbots.Groups.Cooperation.MentorChance
#        Description: The chance, times the mentor's helpfulness trait, that a bot able to mentor
#                     does (0..1).
#        Type: float
#        Default: 0.3
#        Allowed: a number, '.' is the decimal point
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Groups.Cooperation.MentorChance = 0.3

#
#    World.Playerbots.Groups.Cooperation.MentorLevelGap
#        Description: The levels a mentor must stand above the friend (1..60).
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Groups.Cooperation.MentorLevelGap = 10

#
#    World.Playerbots.Groups.Cooperation.MentorMaxMinutes
#        Description: The longest, in minutes, a mentoring group lasts (1..240).
#        Type: int
#        Default: 20
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Groups.Cooperation.MentorMaxMinutes = 20

#
#    World.Playerbots.Groups.Cooperation.Mentoring
#        Description: Let a bot far above a friend or guildmate that struggles with a quest group
#                     with it to clear the quest's objective (on by default).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Groups.Cooperation.Mentoring = true

#
#    World.Playerbots.Groups.Cooperation.RaidEscalation
#        Description: Let a risk-signal group that needs more than five become a raid goal when
#                     enough bots are nearby (on by default).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Groups.Cooperation.RaidEscalation = true

#
#    World.Playerbots.Groups.Cooperation.Recruit
#        Description: Let a waiting group recruit nearby bots that lack its goal (on by default).
#                     Off: only bots that share the goal are grouped.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Groups.Cooperation.Recruit = true

#
#    World.Playerbots.Groups.Cooperation.RecruitBaseChance
#        Description: The base chance that a candidate accepts (0..1). The chance is this plus 0.4
#                     times the candidate's sociability, plus 0.003 per point of its affinity toward
#                     the group's caller, plus 0.2 when the candidate fills a missing tank or
#                     healer, plus GuildBonus for a guildmate and LfgAnswerBonus for one that
#                     answered the call; at most 0.95. A rival and an affinity at or below
#                     RefuseAffinity never accept.
#        Type: float
#        Default: 0.35
#        Allowed: a number, '.' is the decimal point
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Groups.Cooperation.RecruitBaseChance = 0.35

#
#    World.Playerbots.Groups.Cooperation.RecruitRadiusYards
#        Description: The farthest from the waiting bot, in yards, a recruit may stand (10..1500).
#        Type: int
#        Default: 300
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Groups.Cooperation.RecruitRadiusYards = 300

#
#    World.Playerbots.Groups.Cooperation.RecruitWaitSeconds
#        Description: Seconds a group of waiting bots stays short before it recruits (1..3600).
#        Type: int
#        Default: 20
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Groups.Cooperation.RecruitWaitSeconds = 20

#
#    World.Playerbots.Groups.Cooperation.RefusalMemoryMinutes
#        Description: How long a candidate's refusal of a waiting group is remembered, in minutes
#                     (1..1440, default 10). The refusal is stored with its time: the candidate is
#                     not asked again until this long after it, and then rolls afresh (when the
#                     group is still waiting). The roll is made once per window of this length, with
#                     windows shifted by a phase hashed from the (candidate, group) pair, so
#                     different pairs do not all turn over together.
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Groups.Cooperation.RefusalMemoryMinutes = 10

#
#    World.Playerbots.Groups.Cooperation.RefuseAffinity
#        Description: A candidate whose affinity toward the group's caller is at or below this never
#                     joins (-100..0).
#        Type: int
#        Default: -40
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Groups.Cooperation.RefuseAffinity = -40

#
#    World.Playerbots.Groups.Cooperation.SameGoalMeetingRadiusYards
#        Description: How far from a dungeon's entrance (the group's meeting point), in yards, a
#                     player on the same continent still counts as on the dungeon goal of a bot that
#                     waits for a group (10..1500). A player inside the dungeon's instance always
#                     counts. Quest goals are unaffected.
#        Type: int
#        Default: 150
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Groups.Cooperation.SameGoalMeetingRadiusYards = 150

