#
World.Playerbots.Social.Helping.AnswerHelp = true

#
#    World.Playerbots.Social.Helping.BuffCooldownMinutes
#        Description: The least minutes between two buffs a bot gives the same stranger (0..1440).
#        Type: int
#        Default: 30
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Social.Helping.BuffCooldownMinutes = 30

