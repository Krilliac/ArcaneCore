#                     announcement.
#        Type: int
#        Default: 6
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldannounce
#
World.Announce.Faults.RatePerMinute = 6

