#
World.Playerbots.Groups.DungeonRuns.BandAboveBoss = 3

#
#    World.Playerbots.Groups.DungeonRuns.BandBelowBoss
#        Description: Levels below the weakest boss the level band starts (0..20): the band's lower
#                     end is the higher of the entrance level and the weakest boss's level minus
