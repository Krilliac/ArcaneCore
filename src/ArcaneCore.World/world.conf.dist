AuctionHouseBot.ValueLegendary = ""

#
#    AuctionHouseBot.ValueNormal
#        Description: Deprecated override of the quality 1 (common, white) auction_bot_value rows;
#                     see ValuePoor (cMaNGOS AuctionHouseBot.Value.Normal).
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
