#        Type: int
#        Default: 24
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Voice.BotsPerPass = 24

#
#    World.Playerbots.Chat.Voice.Enabled
#        Description: Let bots voice their goals and needs (on by default). Off: no topic is
#                     produced and no LFG or trade whisper is answered here.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Voice.Enabled = true

#
#    World.Playerbots.Chat.Voice.GeneralSharePercent
#        Description: The share of LFG and trade calls said in General instead (LFG outside a
#                     capital, trade outside a capital; 0..100).
#        Type: int
#        Default: 25
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Voice.GeneralSharePercent = 25

#
#    World.Playerbots.Chat.Voice.GroupCalls
#        Description: Party and raid needs (on by default), each once per fight, death or stop:
#                     "oom" (a mana user below 10% in a fight), "need heals" (below 30% with a
#                     healer in the group), "rez pls" (dead, a resurrecting class alive in the
#                     group), "inc &lt;n&gt;" (a bot group's tank pulling more than one),
#                     "&lt;mob&gt; on me" (a creature on a bot that is not the tank), "brb" (the bot
#                     stops to drink, vendor or train), "ty" (after a resurrection or a long buff
#                     from a group member), "ding" (a level up), "gz" (a real player's "ding"), a
#                     quest share request in a bot group, and "first time here" (a zone the bot had
#                     never explored).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Voice.GroupCalls = true

#
#    World.Playerbots.Chat.Voice.LinesPerPass
#        Description: The most lines the voice hands to the chat service in one social pass, every
#                     topic together (1..100).
#        Type: int
#        Default: 4
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Voice.LinesPerPass = 4

#
#    World.Playerbots.Chat.Voice.LookingForGroup
#        Description: LFG and LFM calls (on by default): a bot waiting for partners for a dungeon,
#                     raid or elite quest posts "LFG &lt;dungeon&gt;, &lt;lvl&gt; &lt;class&gt;"
#                     (alone) or "LFM &lt;dungeon&gt; need &lt;role&gt;" (the oldest of several
#                     waiting for the same goal) in LookingForGroup, or now and then in General
