AuctionHouseBot.ValueEpic = ""

#
#    AuctionHouseBot.ValueLegendary
#        Description: Deprecated override of the quality 5 (legendary) auction_bot_value rows; see
#                     ValuePoor (cMaNGOS AuctionHouseBot.Value.Legendary).
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#auctionhousebot
