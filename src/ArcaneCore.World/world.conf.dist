#
#    World.Announce.HotSwap.WorldMessage
#        Description: Send a short system chat line to every online player. Never carries account
#                     names; never carries character names unless AllowNamesInWorldMessage.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldannounce
#
World.Announce.HotSwap.WorldMessage = false

#
#    World.Announce.HotSwap.WorldMessageIncludeReason
#        Description: Put the free-text reason the staff member gave (.reload creature_template
#                     fixed drop rates) into the world message. The reason is shown to players as
#                     typed.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldannounce
#
World.Announce.HotSwap.WorldMessageIncludeReason = true

#
#    World.Announce.HotSwap.WorldMessageOnFailure
#        Description: Also send the world message for a swap that was rejected or failed. Default
#                     false: players only hear about changes that happened.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldannounce
#
World.Announce.HotSwap.WorldMessageOnFailure = false

#
#    World.Announce.Saves.AllowNamesInWorldMessage
#        Description: Let the world message carry character names when the announcing code supplies
#                     a text for it. Off by default.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldannounce
#
World.Announce.Saves.AllowNamesInWorldMessage = false

#
#    World.Announce.Saves.DedupSeconds
#        Description: An announcement identical to one delivered this many seconds ago is
#                     suppressed. 0 disables the window.
#        Type: int
#        Default: 120
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldannounce
#
World.Announce.Saves.DedupSeconds = 120

#
#    World.Announce.Saves.GmNotify
#        Description: Send the announcement to every online account above Player (an on-screen
#                     notification and a chat line). Staff only.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldannounce
#
World.Announce.Saves.GmNotify = true

#
#    World.Announce.Saves.IncludeDetails
#        Description: Add the staff-only detail (who, how long, counts, hashes) to the staff chat
#                     line. Players never see it.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldannounce
#
World.Announce.Saves.IncludeDetails = true

#
#    World.Announce.Saves.MinimumSeverity
#        Description: Announcements below this severity are logged and counted but not delivered.
#                     Values: Info, Warning, Error, Critical.
#        Type: AnnounceSeverity
#        Default: Warning
#        Allowed: Info | Warning | Error | Critical
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldannounce
#
World.Announce.Saves.MinimumSeverity = Warning

#
#    World.Announce.Saves.RateBurst
#        Description: Rate limit: how many announcements of this category may go out back to back
#                     before the limit applies. 0 disables the limit.
#        Type: int
#        Default: 5
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldannounce
#
World.Announce.Saves.RateBurst = 5

#
#    World.Announce.Saves.RatePerMinute
#        Description: Rate limit: announcements of this category refilled per minute once the burst
#                     is used. Suppressed ones are counted and reported on the next delivered
#                     announcement.
#        Type: int
#        Default: 6
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldannounce
#
World.Announce.Saves.RatePerMinute = 6

#
#    World.Announce.Saves.WorldMessage
#        Description: Send a short system chat line to every online player. Never carries account
#                     names; never carries character names unless AllowNamesInWorldMessage.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldannounce
#
World.Announce.Saves.WorldMessage = false

