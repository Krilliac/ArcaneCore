# CREATURES
###############################################################################

#----------------------------------------------------------------------------
# Creatures
#----------------------------------------------------------------------------

#
#    Creatures.AggroRate
#        Description: Rate.Creature.Aggro: multiplies every aggro radius (0 disables aggro on
#                     sight).
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.AggroRate = 1

#
#    Creatures.AggroScanMode
#        Description: How proximity aggro is driven (Creatures:AggroScanMode).
#                     AggroScanMode.Relocation is retail behaviour. Values: Relocation, Poll.
#        Type: AggroScanMode
#        Default: Relocation
#        Allowed: Relocation | Poll
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.AggroScanMode = Relocation

#
#    Creatures.AggroUsesBoundingRadius
#        Description: Development: add both bounding radii to the aggro range and subtract them from
#                     the vertical test. Retail (false) measures the plain distance
#                     (IsWithinDistInMap(..., SizeFactor::None), AI/BasicAI.cpp:61-67).
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.AggroUsesBoundingRadius = false

#
#    Creatures.AiRelocationNotifyDelayMs
#        Description: Visibility.AIRelocationNotifyDelay (ms): vmangos 1000 (World.cpp:829,
#                     mangosd.conf.dist.in:2605).
#        Type: uint
#        Default: 1000
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.AiRelocationNotifyDelayMs = 1000

#
#    Creatures.AssistanceDelayMs
#        Description: CreatureFamilyAssistanceDelay (ms) before those helpers attack.
#        Type: uint
#        Default: 1500
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.AssistanceDelayMs = 1500

#
#    Creatures.AssistanceRadius
#        Description: CreatureFamilyAssistanceRadius (yd): same-faction creatures this close to a
#                     creature entering combat join it.
#        Type: float
#        Default: 10
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.AssistanceRadius = 10

#
#    Creatures.CorpseDecayEliteSeconds
#        Description: Corpse.Decay.ELITE (s): 600.
#        Type: uint
#        Default: 600
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.CorpseDecayEliteSeconds = 600

#
#    Creatures.CorpseDecayNormalSeconds
#        Description: Corpse.Decay.NORMAL (s): vmangos + cmangos-classic 300.
#        Type: uint
#        Default: 300
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.CorpseDecayNormalSeconds = 300

#
#    Creatures.CorpseDecayRareEliteSeconds
#        Description: Corpse.Decay.RAREELITE (s): 1200.
#        Type: uint
#        Default: 1200
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.CorpseDecayRareEliteSeconds = 1200

#
#    Creatures.CorpseDecayRareSeconds
#        Description: Corpse.Decay.RARE (s): 900.
#        Type: uint
#        Default: 900
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.CorpseDecayRareSeconds = 900

#
#    Creatures.CorpseDecayWorldBossSeconds
#        Description: Corpse.Decay.WORLDBOSS (s): 3600.
#        Type: uint
#        Default: 3600
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.CorpseDecayWorldBossSeconds = 3600

#
#    Creatures.CreatureAggroOnCreatures
#        Description: Creatures aggro on other creatures in sight
#                     (Creatures:CreatureAggroOnCreatures): a moving creature notifies the creatures
#                     around it as well as the players (mangos CreatureCreatureRelocationWorker,
#                     WorldHandlers/GridNotifiersImpl.h:67-84), so a hostile mob and a guard, or a
#                     mob and an aggressive pet, acquire each other. Retail is true; false keeps the
#                     player-only notifies of the earlier build (cheaper on maps full of wanderers).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.CreatureAggroOnCreatures = true

#
#    Creatures.CreatureDisplayInfoDbcPath
#        Description: Build-5875 CreatureDisplayInfo.dbc (display scale and model id). Empty = no
#                     display model data: the default geometry.
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.CreatureDisplayInfoDbcPath = ""

#
#    Creatures.CreatureModelDataDbcPath
#        Description: Build-5875 CreatureModelData.dbc (model scale and collision height), required
#                     with CreatureDisplayInfoDbcPath.
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.CreatureModelDataDbcPath = ""

#
#    Creatures.EvadeResetsAuras
#        Description: Whether an evading creature loses its auras (Creatures:EvadeResetsAuras):
#                     everything except a non-permanent positive aura cast by a player; with the
#                     KEEP_POSITIVE_AURAS_ON_EVADE flag only the negative ones
#                     (Creature::RemoveAurasAtReset, Objects/Creature.cpp:3611-3630). Retail is
#                     true. The evade health snap switch is
#                     Creatures:Movement:EvadeRestoresFullHealth.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.EvadeResetsAuras = true

#
#    Creatures.EventAi.DebugOnlyEvents
#        Description: Run rows flagged EFLAG_DEBUG_ONLY (0x80); cmangos only does in a debug build.
#                     Off by default.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.EventAi.DebugOnlyEvents = false

#
#    Creatures.EventAi.ReportUnsupported
#        Description: Report rows with unsupported events, actions or conditions once per creature
#                     entry.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.EventAi.ReportUnsupported = true

#
#    Creatures.EventAi.UpdateIntervalMs
#        Description: How often the timer-driven events are evaluated (cmangos EVENT_UPDATE_TIME).
#                     500 is retail behaviour.
#        Type: uint
#        Default: 500
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.EventAi.UpdateIntervalMs = 500

#
#    Creatures.FactionTemplateDbcPath
#        Description: FactionTemplate.dbc for creature hostility when no catalog is registered
#                     (empty = nobody aggroes on sight).
#        Type: string
#        Default: (not set)
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
# Creatures.FactionTemplateDbcPath =

#
#    Creatures.FleeAssistanceRadius
#        Description: CreatureFamilyFleeAssistanceRadius (yd): how far a fleeing creature looks for
#                     help.
#        Type: float
#        Default: 30
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.FleeAssistanceRadius = 30

#
#    Creatures.FleeDelayMs
#        Description: CreatureFamilyFleeDelay (ms): timed flight when no helper is found.
#        Type: uint
#        Default: 7000
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.FleeDelayMs = 7000

#
#    Creatures.GuardsDefendFriendlies
#        Description: A guard also attacks a creature that is fighting a creature the guard is
#                     friendly to (Creatures:GuardsDefendFriendlies). A player who attacks a unit
#                     the guard is friendly to is always attacked, from up to 30 yd (vmangos
#                     GuardAI::IsAttackingPlayerOrFriendly and MoveInLineOfSight,
#                     AI/GuardAI.cpp:35-77, which look at players only). mangos keeps the general
#                     clause commented out (Object/GuardAI.cpp:74), so for creature attackers the
#                     retail behaviour is UNVERIFIED; on by default because a guard that watches a
#                     civilian being killed is the worse mistake.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.GuardsDefendFriendlies = true

#
#    Creatures.ImplicitEventAi
#        Description: Creatures:ImplicitEventAi (default off, retail): vmangos runs EventAI only for
#                     a template whose AIName is 'EventAI' (AI/CreatureAISelector.cpp:37-100,
#                     AI/EventAI/CreatureEventAI.cpp:51-56), and classic-db z2815 carries that
#                     column (creature_template.AIName, 4,325 templates say 'EventAI'; imported by
#                     CreatureDumpImporter). Switched on, a creature whose template has no AIName
#                     but whose entry (or spawn) has creature_ai_scripts rows also runs EventAI, the
#                     cmangos-classic permit (AI/EventAI/CreatureEventAI.cpp:51-63) for hand-edited
#                     data; an explicit AIName always wins. A deviation from retail.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.ImplicitEventAi = false

#
#    Creatures.LeashCheckIntervalMs
#        Description: How often a creature in combat runs its periodic leash checks, in milliseconds
#                     of world time (vmangos tickTime() % 3000 &lt;= diff,
#                     Objects/Creature.cpp:976). 0 turns the template hard leash off.
#        Type: uint
#        Default: 3000
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.LeashCheckIntervalMs = 3000

#
#    Creatures.LeashExtensionSeconds
#        Description: Whole seconds after the leash extension clock was last set before a victim
#                     outside the threat area leashes the creature (vmangos hard-coded 12,
#                     Objects/Creature.cpp:2813).
#        Type: uint
#        Default: 12
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.LeashExtensionSeconds = 12

#
#    Creatures.MaxCreatureAttackRadius
#        Description: MaxCreaturesAttackRadius (yd): the relocation notify visits objects this far
#                     around the mover times the aggro rate; vmangos 40 (World.cpp:565,
#                     mangosd.conf.dist.in:1528).
#        Type: float
#        Default: 40
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.MaxCreatureAttackRadius = 40

#
#    Creatures.Movement.EvadeRestoresFullHealth
#        Description: Creatures:Movement:EvadeRestoresFullHealth: a creature entering evade mode
#                     gets full health and mana at once. Retail (false): vmangos
#                     CreatureAI::EnterEvadeMode sets neither (AI/CreatureAI.cpp:323-346); health
#                     and mana return through the creature's own regeneration, a third of the
#                     maximum every 5 s (Objects/Creature.cpp:1087-1160).
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.Movement.EvadeRestoresFullHealth = false

#
#    Creatures.Movement.HonorWaypointRunColumn
#        Description: Creatures:Movement:HonorWaypointRunColumn: a waypoint node whose
#                     creature_movement.Run column is set is travelled at run speed. Not retail: the
#                     column exists in neither classic-db nor vmangos (an ArcaneCore addition of the
#                     creature-AI step); vmangos waypoint legs walk unless the creature runs by
#                     default (SetWalk(!UNIT_STATE_RUNNING ...),
#                     Movement/WaypointMovementGenerator.cpp:240).
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.Movement.HonorWaypointRunColumn = false

#
#    Creatures.Movement.MissingWaypointPathFallback
#        Description: Creatures:Movement:MissingWaypointPathFallback: what a creature with waypoint
#                     movement but no path (neither its spawn's creature_movement rows nor its
#                     entry's creature_movement_template path) does. Both references leave it
#                     standing (vmangos WaypointMovementGenerator::LoadPath,
#                     Movement/WaypointMovementGenerator.cpp:47-52, logs and keeps an empty path);
#                     that is MissingWaypointPathFallback.Idle. The default,
#                     MissingWaypointPathFallback.Random, is a deliberate deviation: the creature
#                     wanders within its spawn's wander distance (5 yd when the spawn has none) so a
#                     content gap does not leave a patrol frozen in place. The content audit reports
#                     such spawns once at load either way. Values: Random, Idle.
#        Type: MissingWaypointPathFallback
#        Default: Random
#        Allowed: Random | Idle
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.Movement.MissingWaypointPathFallback = Random

#
#    Creatures.Movement.MonsterMoveOffsetBase
#        Description: Creatures:Movement:MonsterMoveOffsetBase. MonsterMoveOffsetBase.Destination is
#                     retail; the midpoint layout is the pre-fidelity ArcaneCore behaviour, kept
#                     only as a rollback switch. Values: Destination, Midpoint.
#        Type: MonsterMoveOffsetBase
#        Default: Destination
#        Allowed: Destination | Midpoint
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.Movement.MonsterMoveOffsetBase = Destination

#
#    Creatures.Movement.RunDuringWanderChancePercent
#        Description: Creatures:Movement:RunDuringWanderChancePercent: for a creature with the
#                     cmangos RUN_DURING_WANDER flag, the percent of random-movement legs that run
#                     (cmangos MotionGenerators/RandomMovementGenerator.cpp:135-136:
#                     SetWalk(urand(0, 99) &gt;= 15)). vmangos has no such flag (its 0x20 is
#                     NO_MOVEMENT_PAUSE), so the setting only reaches creatures imported in the
#                     cmangos dialect.
#        Type: uint
#        Default: 15
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.Movement.RunDuringWanderChancePercent = 15

#
#    Creatures.MovementEnabled
#        Description: Random and waypoint movement; off leaves every creature idle at its spawn
#                     point.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.MovementEnabled = true

#
#    Creatures.NoMeleeFleeMs
#        Description: How long a NO_MELEE_FLEE creature runs before it evades (cmangos
#                     DoFlee(30000), Unit.cpp:7996).
#        Type: uint
#        Default: 30000
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.NoMeleeFleeMs = 30000

#
#    Creatures.NoMeleeFleeOnAggro
#        Description: Creatures:NoMeleeFleeOnAggro (default false): a creature with the static flag
#                     NO_MELEE_FLEE (0x00100000) that a player or a player's pet engages runs in
#                     panic for NoMeleeFleeMs and then evades (cmangos Unit::SetInCombatWithVictim,
#                     Entities/Unit.cpp:7993-7998, and CreatureAI::TimedFleeingEnded,
#                     AI/BaseAI/CreatureAI.cpp:254-258). vmangos only takes the melee away for the
#                     same bit (CREATURE_STATIC_FLAG_NO_MELEE, whose original comment is "Flee";
#                     AI/CreatureAI.cpp:40), and the default keeps that, since vmangos is the
#                     fidelity reference; critters still run from a hit through CritterAI either
#                     way. Melee is off for the flag either way. classic-db z2815 sets it on 71
#                     templates (deer, sheep, cows, wisps, totems, target dummies).
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.NoMeleeFleeOnAggro = false

