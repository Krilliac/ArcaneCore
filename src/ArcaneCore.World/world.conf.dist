###############################################################################
# OPS
###############################################################################

#----------------------------------------------------------------------------
# Ops:Diagnostics
#----------------------------------------------------------------------------

#
#    Ops.Diagnostics.Dumps.Directory
#        Description: The directory the dump files are written to. Empty (default) means dumps
#                     beside the text log file (Logging:ArcaneCore:File:Path, so logs/dumps by
#                     default). It is created on the first dump.
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opsdiagnostics
#
Ops.Diagnostics.Dumps.Directory = ""

#
#    Ops.Diagnostics.Dumps.Enabled
#        Description: true lets an administrator write a dump of the running world with .debug dump.
#                     Default false, because a dump holds everything in memory: session keys,
#                     password material in flight, character data. Keep the dump directory private
#                     and delete the files when the analysis is done.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opsdiagnostics
#
Ops.Diagnostics.Dumps.Enabled = false

#
#    Ops.Diagnostics.Dumps.MinIntervalSeconds
#        Description: The least seconds between two dumps, so a repeated command cannot suspend the
#                     process again and again or fill the disk. 0 disables the limit. Default 600.
#        Type: int
#        Default: 600
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opsdiagnostics
#
Ops.Diagnostics.Dumps.MinIntervalSeconds = 600

#----------------------------------------------------------------------------
# Ops:Metrics
#----------------------------------------------------------------------------

#
#    Ops.Metrics.Enabled
#        Description: The master switch. false: no listener is attached, so every instrument stays
#                     disabled and costs one branch. Default false (TrinityCore Metric.Enable = 0).
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opsmetrics
#
Ops.Metrics.Enabled = false

#
#    Ops.Metrics.Exporter
#        Description: Where the metrics go. Default Prometheus. Values: Prometheus (scrape
#                     endpoint), Otlp (push to an OpenTelemetry collector), Both. Values:
#                     Prometheus, Otlp, Both.
#        Type: MetricsExporter
#        Default: Prometheus
#        Allowed: Prometheus | Otlp | Both
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opsmetrics
#
Ops.Metrics.Exporter = Prometheus

#
#    Ops.Metrics.MapSampleIntervalSeconds
#        Description: Seconds between per-map samples (players, creatures, objects, update time)
#                     taken on the world thread. 1-3600. Default 10 (TrinityCore
#                     Metric.OverallStatusInterval = 10).
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opsmetrics
#
Ops.Metrics.MapSampleIntervalSeconds = 10

#
#    Ops.Metrics.OtlpEndpoint
#        Description: The OTLP/HTTP metrics endpoint the push exporter posts JSON to. Default
#                     http://localhost:4318/v1/metrics.
#        Type: string
#        Default: "http://localhost:4318/v1/metrics"
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opsmetrics
#
Ops.Metrics.OtlpEndpoint = "http://localhost:4318/v1/metrics"

#
#    Ops.Metrics.OtlpIntervalSeconds
#        Description: Seconds between OTLP pushes. 1-3600. Default 15 (TrinityCore Metric.Interval =
#                     1 pushes every second to InfluxDB; a collector batches, so a longer period
#                     suffices).
#        Type: int
#        Default: 15
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opsmetrics
#
Ops.Metrics.OtlpIntervalSeconds = 15

#
#    Ops.Metrics.PerMapMetrics
#        Description: false: no per-map series, only the world totals (bounds the label cardinality
#                     on a server with many instances). Default true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opsmetrics
#
Ops.Metrics.PerMapMetrics = true

#
#    Ops.Metrics.PrometheusPrefix
#        Description: The World daemon's Prometheus scrape listener prefix (an HttpListener prefix
#                     ending in /). Use http://+:9464/metrics/ to listen on every interface (a
#                     container). The Realm daemon does not read this key: it reads
#                     RealmPrometheusPrefix. Default http://localhost:9464/metrics/.
#        Type: string
#        Default: "http://localhost:9464/metrics/"
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opsmetrics
#
Ops.Metrics.PrometheusPrefix = "http://localhost:9464/metrics/"

#
#    Ops.Metrics.Realm
#        Description: A realm label added to every series (TrinityCore tags its metrics with the
#                     realm name). Empty: no label. Default empty.
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opsmetrics
#
Ops.Metrics.Realm = ""

#
#    Ops.Metrics.RealmPrometheusPrefix
#        Description: The Realm daemon's Prometheus scrape listener prefix, so a Realm and a World
#                     started from one shared appsettings.json do not both bind the same port. It
#                     never falls back to PrometheusPrefix; setting both to the same prefix makes
#                     the second daemon to start log an error and serve no metrics. Default
#                     http://localhost:9465/metrics/.
#        Type: string
#        Default: "http://localhost:9465/metrics/"
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opsmetrics
#
Ops.Metrics.RealmPrometheusPrefix = "http://localhost:9465/metrics/"

#----------------------------------------------------------------------------
# Ops:Observability
#----------------------------------------------------------------------------

#
#    Ops.Observability.ClientRejections.BurstPerSession
#        Description: Lines a session may log in a burst before the refill rate applies. 1-1000.
#                     Default 20.
#        Type: int
#        Default: 20
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opsobservability
#
Ops.Observability.ClientRejections.BurstPerSession = 20

#
#    Ops.Observability.ClientRejections.Enabled
#        Description: false: no refusal is decoded or logged and the send path does no extra work.
#                     Default true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opsobservability
#
Ops.Observability.ClientRejections.Enabled = true

#
#    Ops.Observability.ClientRejections.LogSilentDrops
#        Description: true: handlers that return without answering the client log the reason (at
#                     Debug for a bot, Information for a player). Default true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opsobservability
#
Ops.Observability.ClientRejections.LogSilentDrops = true

#
#    Ops.Observability.ClientRejections.RefillPerMinute
#        Description: Lines a session earns back per minute once its burst is spent; a refusal over
#                     the limit is counted and summarised in the next line that is written. 1-6000.
#                     Default 60.
#        Type: int
#        Default: 60
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opsobservability
#
Ops.Observability.ClientRejections.RefillPerMinute = 60

#
#    Ops.Observability.DuplicatePackets.CaptureStacks
#        Description: true: the warning carries a compact call stack of the second send, and of the
#                     first as well once the opcode has duplicated before in this process. Default
#                     true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opsobservability
#
Ops.Observability.DuplicatePackets.CaptureStacks = true

#
#    Ops.Observability.DuplicatePackets.Enabled
#        Description: false: nothing is hashed and the send path does no extra work. Default true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opsobservability
#
Ops.Observability.DuplicatePackets.Enabled = true

#
#    Ops.Observability.DuplicatePackets.IncludeBots
#        Description: true: playerbot sessions are checked as well. Default false (bots are
#                     excluded).
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opsobservability
#
Ops.Observability.DuplicatePackets.IncludeBots = false

#
#    Ops.Observability.DuplicatePackets.RingSize
#        Description: Recent packets remembered per session; older ones are overwritten. 4-256.
#                     Default 16.
#        Type: int
#        Default: 16
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opsobservability
#
Ops.Observability.DuplicatePackets.RingSize = 16

#
#    Ops.Observability.DuplicatePackets.WarnBurstPerSession
#        Description: Warnings a session may log in a burst. 1-100. Default 3.
#        Type: int
#        Default: 3
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opsobservability
#
Ops.Observability.DuplicatePackets.WarnBurstPerSession = 3

#
#    Ops.Observability.DuplicatePackets.WarnPerMinute
#        Description: Warnings a session earns back per minute after its burst. 1-600. Default 6.
#        Type: int
#        Default: 6
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opsobservability
#
Ops.Observability.DuplicatePackets.WarnPerMinute = 6

#
#    Ops.Observability.DuplicatePackets.WindowMs
#        Description: Two identical packets closer together than this many milliseconds are a
#                     duplicate (a world tick is 50 ms). 1-5000. Default 100.
#        Type: int
#        Default: 100
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opsobservability
#
Ops.Observability.DuplicatePackets.WindowMs = 100

#----------------------------------------------------------------------------
# Ops:Watchdog
#----------------------------------------------------------------------------

#
#    Ops.Watchdog.CheckIntervalMs
#        Description: How often the monitoring thread wakes to run every check (hang detection,
#                     heartbeat, probes). 100-60000. Default 1000.
#        Type: int
#        Default: 1000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.CheckIntervalMs = 1000

#
#    Ops.Watchdog.Counters.ChangedOnly
#        Description: true: counters that have not changed since the last dump are left out of it.
#                     Default false.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.Counters.ChangedOnly = false

#
#    Ops.Watchdog.Counters.DumpIntervalSeconds
#        Description: Seconds between dumps. 0 disables the dump (the registry still counts).
#                     Default 300.
#        Type: int
#        Default: 300
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.Counters.DumpIntervalSeconds = 300

#
#    Ops.Watchdog.Enabled
#        Description: The master switch. false: the monitoring thread is not started, nothing in
#                     this section runs, no heartbeat is sent. Default true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.Enabled = true

#
#    Ops.Watchdog.Heartbeat.FilePath
#        Description: The liveness file for File mode; relative paths are under the content root.
#                     Required in that mode (the daemon refuses to start without it).
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.Heartbeat.FilePath = ""

#
#    Ops.Watchdog.Heartbeat.IntervalSeconds
#        Description: Seconds between beats. 0 = half of systemd's WATCHDOG_USEC when it is set,
#                     otherwise 10. Default 0.
#        Type: int
#        Default: 0
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.Heartbeat.IntervalSeconds = 0

#
#    Ops.Watchdog.Heartbeat.Mode
#        Description: Where the heartbeat goes. Default Auto. Values: Auto, None, Systemd, File,
#                     Stdout.
#        Type: HeartbeatMode
#        Default: Auto
#        Allowed: Auto | None | Systemd | File | Stdout
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.Heartbeat.Mode = Auto

#
#    Ops.Watchdog.Heartbeat.WarnIntervalSeconds
#        Description: Least seconds between two "heartbeat withheld" warnings. Default 30.
#        Type: int
#        Default: 30
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.Heartbeat.WarnIntervalSeconds = 30

#
#    Ops.Watchdog.HostLoad.Enabled
#        Description: false: nothing is sampled and the hang, overrun and slow-map lines carry no
#                     host-load text. Default true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.HostLoad.Enabled = true

#
#    Ops.Watchdog.HostLoad.HistorySeconds
#        Description: How many seconds of samples (one per watchdog check) are kept to difference
#                     against; a slow window longer than this is measured from the oldest sample.
#                     10-3600. Default 120.
#        Type: int
#        Default: 120
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.HostLoad.HistorySeconds = 120

#
#    Ops.Watchdog.Memory.Action
#        Description: What happens when the managed heap reaches ActionHeapBytes. Default None (log
#                     only; Collect pauses the world thread for a blocking compacting gen2
#                     collection, Stop ends the process with exit code 1). Values: None, Log,
#                     Collect, Stop.
#        Type: MemoryPressureAction
#        Default: None
#        Allowed: None | Log | Collect | Stop
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.Memory.Action = None

#
#    Ops.Watchdog.Memory.ActionCooldownSeconds
#        Description: Least seconds between two actions (a Stop fires once). Default 300.
#        Type: int
#        Default: 300
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.Memory.ActionCooldownSeconds = 300

#
#    Ops.Watchdog.Memory.ActionHeapBytes
#        Description: The heap size in bytes at which Action fires. 0 disables the action whatever
#                     Action says. Default 0.
#        Type: long
#        Default: 0
#        Allowed: a whole number, -9223372036854775808 to 9223372036854775807
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.Memory.ActionHeapBytes = 0

#
#    Ops.Watchdog.Memory.Enabled
#        Description: false: no sample is taken and no action can fire. Default true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.Memory.Enabled = true

#
#    Ops.Watchdog.Memory.FullGcNotifications
#        Description: true: register for full-GC approach/completion notifications where the runtime
#                     allows it (concurrent GC refuses; then this logs once and only polling runs).
#                     Default false.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.Memory.FullGcNotifications = false

#
#    Ops.Watchdog.Memory.GrowthLogBytes
#        Description: An Information line when the gen2 or large-object-heap high-water mark grows
#                     by at least this many bytes since the last line. 0 disables growth lines.
#                     Default 16777216 (16 MiB).
#        Type: long
#        Default: 16777216
#        Allowed: a whole number, -9223372036854775808 to 9223372036854775807
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.Memory.GrowthLogBytes = 16777216

#
#    Ops.Watchdog.Memory.SampleIntervalSeconds
#        Description: Seconds between heap samples. 1-3600. Default 10.
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.Memory.SampleIntervalSeconds = 10

#
#    Ops.Watchdog.Memory.WarnHeapBytes
#        Description: A rate-limited warning when the managed heap is at least this many bytes. 0
#                     disables the check. Default 0.
#        Type: long
#        Default: 0
#        Allowed: a whole number, -9223372036854775808 to 9223372036854775807
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.Memory.WarnHeapBytes = 0

#
#    Ops.Watchdog.Memory.WarnIntervalSeconds
#        Description: Least seconds between two memory warnings of the same kind. Default 60.
#        Type: int
#        Default: 60
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.Memory.WarnIntervalSeconds = 60

#
#    Ops.Watchdog.Memory.WarnLoadPercent
#        Description: A rate-limited warning when the runtime's memory load (process and machine)
#                     reaches this percentage of the available memory; the GC's own high-load
#                     threshold is 90. 0 disables the check. Default 85.
#        Type: int
#        Default: 85
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.Memory.WarnLoadPercent = 85

#
#    Ops.Watchdog.ThreadPool.CriticalDelayMs
#        Description: A probe that waits longer than this (milliseconds), or has not run at all for
#                     this long, is a critical line. Default 2000.
#        Type: int
#        Default: 2000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.ThreadPool.CriticalDelayMs = 2000

#
#    Ops.Watchdog.ThreadPool.Enabled
#        Description: false: nothing is queued. Default true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.ThreadPool.Enabled = true

#
#    Ops.Watchdog.ThreadPool.ProbeIntervalSeconds
#        Description: Seconds between probes. 1-3600. Default 5.
#        Type: int
#        Default: 5
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.ThreadPool.ProbeIntervalSeconds = 5

#
#    Ops.Watchdog.ThreadPool.WarnDelayMs
#        Description: A probe that waits longer than this (milliseconds) for a pool thread is a
#                     rate-limited warning with the pool counts. Default 200.
#        Type: int
#        Default: 200
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.ThreadPool.WarnDelayMs = 200

#
#    Ops.Watchdog.ThreadPool.WarnIntervalSeconds
#        Description: Least seconds between two starvation warnings. Default 30.
#        Type: int
#        Default: 30
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.ThreadPool.WarnIntervalSeconds = 30

#
#    Ops.Watchdog.TickMonitor.Action
#        Description: What happens when a tick has run longer than ActionHangMs. Default None (log
#                     only; Stop stops the host with exit code 1; FailFast terminates immediately
#                     with exit code 70 so a supervisor restarts a deadlocked world thread). Values:
#                     None, Log, Stop, FailFast.
#        Type: TickHangAction
#        Default: None
#        Allowed: None | Log | Stop | FailFast
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.TickMonitor.Action = None

#
#    Ops.Watchdog.TickMonitor.ActionHangMs
#        Description: A frame running longer than this triggers Action (when Action is not
#                     TickHangAction.None and the host-load sampler does not blame GC pauses or
#                     machine starvation). 0 disables the action whatever Action says. Default 0.
#        Type: int
#        Default: 0
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.TickMonitor.ActionHangMs = 0

#
#    Ops.Watchdog.TickMonitor.BudgetMs
#        Description: A frame longer than this is an overrun. 0 = twice the configured tick interval
#                     (100 ms at the retail 50 ms tick), tolerating sleep jitter. Default 0.
#        Type: int
#        Default: 0
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.TickMonitor.BudgetMs = 0

#
#    Ops.Watchdog.TickMonitor.Enabled
#        Description: false: no tick is recorded, no overrun or hang is reported and the heartbeat
#                     does not depend on the tick. Default true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.TickMonitor.Enabled = true

#
#    Ops.Watchdog.TickMonitor.GatesHeartbeat
#        Description: true: the heartbeat is withheld while a tick has run longer than HangMs, so a
#                     supervisor watchdog restarts a hung world. Default true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.TickMonitor.GatesHeartbeat = true

#
#    Ops.Watchdog.TickMonitor.HangMs
#        Description: A frame longer than this is a hang: one critical line when it is still running
#                     and one when it completes. 0 disables hang detection. Default 2000.
#        Type: int
#        Default: 2000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.TickMonitor.HangMs = 2000

#
#    Ops.Watchdog.TickMonitor.RingCapacity
#        Description: Ring capacity in ticks (rounded up to a power of two, 16-1048576); the
#                     percentiles are over the last capacity-1 ticks. Default 4096 (3.4 minutes at
#                     50 ms).
#        Type: int
#        Default: 4096
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.TickMonitor.RingCapacity = 4096

#
#    Ops.Watchdog.TickMonitor.SummaryIntervalSeconds
#        Description: Seconds between periodic frame-time summaries (p50/p99/max, overruns) at
#                     Information level. 0 disables the summary. Default 300.
#        Type: int
#        Default: 300
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.TickMonitor.SummaryIntervalSeconds = 300

#
#    Ops.Watchdog.TickMonitor.WarnIntervalSeconds
#        Description: Least seconds between two overrun warnings; overruns in between are counted
#                     and reported with the next warning. Default 30.
#        Type: int
#        Default: 30
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#opswatchdog
#
Ops.Watchdog.TickMonitor.WarnIntervalSeconds = 30

###############################################################################
# PAGETEXT
###############################################################################

#----------------------------------------------------------------------------
# PageText
#----------------------------------------------------------------------------

#
#    PageText.DumpPath
#        Description: A MySQL world dump (vmangos or cmangos classic-db, plain or .gz) holding the
#                     page_text table; only that table is read. Empty: no page text, so every page a
#                     client asks for is answered "Item page missing." (the vmangos answer for an
#                     unknown page). A configured file that cannot be read refuses startup.
#        Type: string
#        Default: (not set)
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#pagetext
#
# PageText.DumpPath =

###############################################################################
# PERFORMANCELOG
###############################################################################

#----------------------------------------------------------------------------
# PerformanceLog
#----------------------------------------------------------------------------

#
#    PerformanceLog.SlowMapUpdate
#        Description: Log one map's update longer than this many ms.
#        Type: int
#        Default: 100
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#performancelog
#
PerformanceLog.SlowMapUpdate = 100

#
#    PerformanceLog.SlowPackets
#        Description: Log one in-world packet handler longer than this many ms.
#        Type: int
#        Default: 20
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#performancelog
#
PerformanceLog.SlowPackets = 20

#
#    PerformanceLog.SlowWorldUpdate
#        Description: Log a world frame (or tick, see SlowWorldUpdateMeasure) longer than this many
#                     ms.
#        Type: int
#        Default: 100
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#performancelog
#
PerformanceLog.SlowWorldUpdate = 100

#
#    PerformanceLog.SlowWorldUpdateMeasure
#        Description: What SlowWorldUpdate is compared with. Defaults to the retail frame interval.
#                     Values: FrameInterval, TickDuration.
#        Type: SlowWorldUpdateMeasure
#        Default: FrameInterval
#        Allowed: FrameInterval | TickDuration
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#performancelog
#
PerformanceLog.SlowWorldUpdateMeasure = FrameInterval

###############################################################################
# PETS
###############################################################################

#----------------------------------------------------------------------------
# Pets
#----------------------------------------------------------------------------

#
#    Pets.CreatureFamilyDbcPath
#        Description: Path of the build-5875 CreatureFamily.dbc. Its petFoodMask column is the pet
#                     diet (Pet::HaveInDiet); unset, Feed Pet accepts any food. Its first skill line
#                     (skillLine[0]) is the family's beast-training line (Pet::CanLearnPetSpell);
#                     with a 15-field SkillLineAbility.dbc (NpcServices:SkillLineAbilityDbcPath) it
#                     turns on training-point costs, the family check and the four-active-spell
#                     limit, unset they are off.
#        Type: string
#        Default: (not set)
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#pets
#
# Pets.CreatureFamilyDbcPath =

#
#    Pets.DefaultLoyalty
#        Description: vmangos CONFIG_UINT32_PET_DEFAULT_LOYALTY (mangosd.conf PetDefaultLoyalty, 1 =
#                     Rebellious … 6 = Best Friend): the loyalty a newly tamed pet is raised to
#                     (Spell::EffectTameCreature, SpellEffects.cpp:3151-3154).
#        Type: byte
#        Default: 1
#        Allowed: a whole number, 0 to 255
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#pets
#
Pets.DefaultLoyalty = 1

#
#    Pets.MaxNpcGuardiansPerEntry
#        Description: vmangos Spell::EffectSummonGuardian: a non-player caster stops summoning an
#                     entry once it already has more than this many guardians of it
#                     (SpellEffects.cpp:2806). Retail 15.
#        Type: int
#        Default: 15
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#pets
#
Pets.MaxNpcGuardiansPerEntry = 15

#
#    Pets.PetLeashDistance
#        Description: vmangos Pet::Update: a pet farther than this from its owner is unsummoned
#                     (IsWithinDistInMap(owner, 120.0f), Pet.cpp:662-690).
#        Type: float
#        Default: 120
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#pets
#
Pets.PetLeashDistance = 120

#----------------------------------------------------------------------------
# Pets:Names
#----------------------------------------------------------------------------

#
#    Pets.Names.MinPetName
#        Description: Shortest pet name accepted (vmangos MinPetName, clamped to 2..12; the longest
#                     is always 12).
#        Type: int
#        Default: 2
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#petsnames
#
Pets.Names.MinPetName = 2

#
#    Pets.Names.RealmZone
#        Description: vmangos RealmZone (RealmZone.h): picks the language type the strict name rules
#                     check; 1 = development.
#        Type: int
#        Default: 1
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#petsnames
#
Pets.Names.RealmZone = 1

#
#    Pets.Names.StrictPetNames
#        Description: vmangos StrictPetNames: the alphabet rule of pet names as a mask (0 = any
#                     letters of the realm's language type).
#        Type: uint
#        Default: 0
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#petsnames
#
Pets.Names.StrictPetNames = 0

###############################################################################
# PROGRESSION
###############################################################################

#----------------------------------------------------------------------------
# Progression
#----------------------------------------------------------------------------

#
#    Progression.GroupXpDistance
#        Description: MaxGroupXPDistance (yards, 3D): group members farther from the victim get no
#                     XP or kill credit.
#        Type: float
#        Default: 74
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#progression
#
Progression.GroupXpDistance = 74

#
#    Progression.LevelStatsPath
#        Description: Optional developer-supplied level stats file (see PlayerLevelStatsTable).
#                     Absent: level-ups change level and XP but no base health, mana or stats.
#        Type: string
#        Default: (not set)
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#progression
#
# Progression.LevelStatsPath =

#
#    Progression.MaxPlayerLevel
#        Description: MaxPlayerLevel: no experience is gained at or above it.
#        Type: uint
#        Default: 60
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#progression
#
Progression.MaxPlayerLevel = 60

#
#    Progression.RateXpKill
#        Description: Rate.XP.Kill.
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#progression
#
Progression.RateXpKill = 1

#
#    Progression.RateXpKillElite
#        Description: Rate.XP.Kill.Elite.
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#progression
#
Progression.RateXpKillElite = 1

#
#    Progression.RateXpPersonalMax
#        Description: vmangos Rate.XP.Personal.Max (World.cpp:511, setConfigMin 0, default 1): the
#                     highest personal XP rate a player below GameMaster may set with .modify xprate
#                     (CharacterCommands.cpp:84-88). A negative value is replaced by 1 when the
#                     command reads it.
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#progression
#
Progression.RateXpPersonalMax = 1

#
#    Progression.RateXpPersonalMin
#        Description: vmangos Rate.XP.Personal.Min (World.cpp:510, setConfigMin 0, default 1): the
#                     lowest personal XP rate .modify xprate accepts (CharacterCommands.cpp:78-82).
#                     A negative value is replaced by 1 when the command reads it.
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#progression
#
Progression.RateXpPersonalMin = 1

###############################################################################
# QUESTS
###############################################################################

#----------------------------------------------------------------------------
# Quests
#----------------------------------------------------------------------------

#
#    Quests.AreaTriggerQuests
#        Description: areatrigger_involvedrelation rows (trigger id → exploration quest).
#                     Exploration/event quests without a relation stay unavailable: nothing else
#                     could complete them.
#        Type: QuestAreaTrigger[]
#        Default: (empty list)
#        Allowed: a list: numbered keys 0, 1, 2, ...; each entry is a group of keys
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#quests
#
# Empty by default. Each entry is a group of keys: Quests.AreaTriggerQuests.0.<Field> = value, Quests.AreaTriggerQuests.1.<Field> = value, ...

#
#    Quests.FactionTemplateDbcPath
#        Description: Optional developer-supplied build-5875 FactionTemplate.dbc; absent means
#                     unknown NPC factions.
#        Type: string
#        Default: (not set)
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#quests
#
# Quests.FactionTemplateDbcPath =

#
#    Quests.HighLevelHideDiff
#        Description: Quests.HighLevelHideDiff (negative = never hide).
#        Type: int
#        Default: 7
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#quests
#
Quests.HighLevelHideDiff = 7

#
#    Quests.IgnoreRaid
#        Description: Quests.IgnoreRaid (vmangos CONFIG_BOOL_QUEST_IGNORE_RAID, default off): every
#                     quest counts as allowed in raid groups (Quest::IsAllowedInRaid); otherwise
#                     raid group members get no kill credit and no quest drops for ordinary quests.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#quests
#
Quests.IgnoreRaid = false

#
#    Quests.LogWithheld
#        Description: Quests:LogWithheld (default true): log at startup how many quests are withheld
#                     and why.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#quests
#
Quests.LogWithheld = true

#
#    Quests.LowLevelHideDiff
#        Description: Quests.LowLevelHideDiff (negative = never grey out).
#        Type: int
#        Default: 4
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#quests
#
Quests.LowLevelHideDiff = 4

#
#    Quests.MaxPlayerLevel
#        Description: MaxPlayerLevel (quest XP turns into money at this level).
#        Type: uint
#        Default: 60
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#quests
#
Quests.MaxPlayerLevel = 60

#
#    Quests.OrdinaryRewardQuestIds
#        Description: Developer-validated ordinary item/money quests. The imported template omits
#                     reputation, mail and script rewards, so a template alone cannot prove that
#                     rewarding it is supported.
#        Type: uint[]
#        Default: (empty list)
#        Allowed: a list: numbered keys 0, 1, 2, ...; each value is a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#quests
#
# Empty by default.
# Quests.OrdinaryRewardQuestIds.0 =

#
#    Quests.RateDropMoney
#        Description: Rate.Drop.Money (quest money rewards).
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#quests
#
Quests.RateDropMoney = 1

#
#    Quests.RateXpQuest
#        Description: Rate.XP.Quest.
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#quests
#
Quests.RateXpQuest = 1

#
#    Quests.RewardMode
#        Description: Quests:RewardMode. QuestRewardMode.AllSupported (default, retail) rewards
#                     every quest whose needs have adapters; QuestRewardMode.AllowlistOnly restores
#                     the earlier opt-in through OrdinaryRewardQuestIds. Values: AllSupported,
#                     AllowlistOnly.
#        Type: QuestRewardMode
#        Default: AllSupported
#        Allowed: AllSupported | AllowlistOnly
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#quests
#
Quests.RewardMode = AllSupported

#
#    Quests.SettlementBudgetSeconds
#        Description: Seconds one reward settlement may take end to end (save, drains, the reward
#                     transaction) before it is abandoned and reconciled from the stored rows.
#                     Operational, not a gameplay rule: 5 is the shipped value. A test that
#                     deliberately holds a settlement open raises it so its observation window is
#                     not a race against this deadline.
#        Type: int
#        Default: 5
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#quests
#
Quests.SettlementBudgetSeconds = 5

#
#    Quests.SharePushRequiresQuest
#        Description: Quests:SharePushRequiresQuest (default false, retail): vmangos
#                     HandlePushQuestToParty (QuestHandler.cpp:403-459) offers any quest id to the
#                     party without checking that the pusher holds it; the receiver's accept does
#                     check (Player::CanShareQuest). Switch on to refuse such pushes up front.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#quests
#
Quests.SharePushRequiresQuest = false

#
#    Quests.XpSource
#        Description: Quests:XpSource. QuestXpSource.Auto (default) uses the RewXP column when the
#                     loaded quests have one (vmangos data) and derives the experience from
#                     RewMoneyMaxLevel otherwise (classic-db data). Values: Auto, RewXpColumn,
#                     Derived.
#        Type: QuestXpSource
#        Default: Auto
#        Allowed: Auto | RewXpColumn | Derived
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#quests
#
Quests.XpSource = Auto

###############################################################################
# RANGED
###############################################################################

#----------------------------------------------------------------------------
# Ranged
#----------------------------------------------------------------------------

#
#    Ranged.Ammo.Mode
#        Description: How ranged ammunition is treated. Retail (default): a ranged attack needs
#                     compatible ammunition (or a thrown weapon) and consumes one per shot. Infinite
#                     is a developer switch: no ammunition is required or consumed. Values: Retail,
#                     Infinite.
#        Type: AmmoMode
#        Default: Retail
#        Allowed: Retail | Infinite
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#ranged
#
Ranged.Ammo.Mode = Retail

#
#    Ranged.Range.Leeway
#        Description: How the spell range leeway of moving casters is treated. Retail (default)
#                     keeps the movement leeway; None is a deviation with only the fixed player
#                     allowance. Values: Retail, None.
#        Type: RangeLeewayMode
#        Default: Retail
#        Allowed: Retail | None
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#ranged
#
Ranged.Range.Leeway = Retail

#
#    Ranged.Traps.Hostility
#        Description: How a trap decides a unit is hostile. Faction (default) is the retail faction
#                     reaction; AttackTarget also accepts neutral creatures (a deviation). Values:
#                     Faction, AttackTarget.
#        Type: TrapHostilityRule
#        Default: Faction
#        Allowed: Faction | AttackTarget
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#ranged
#
Ranged.Traps.Hostility = Faction

#
#    Ranged.Traps.RadiusSource
#        Description: Where a hunter trap takes its trigger radius from. Vmangos (default) is the
#                     retail value as vmangos ships it; Template always uses the template radius (a
#                     deviation). Values: Vmangos, Template.
#        Type: TrapRadiusSource
#        Default: Vmangos
#        Allowed: Vmangos | Template
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#ranged
#
Ranged.Traps.RadiusSource = Vmangos

###############################################################################
# REPUTATION
###############################################################################

#----------------------------------------------------------------------------
# Reputation
#----------------------------------------------------------------------------

#
#    Reputation.CombatReactions
#        Description: Retail (true): combat attackability and creature aggro follow player
#                     reputation (at war, Hated guards, contested guards, forced reactions;
#                     Object.cpp:3608-3816). False keeps the template-only hooks. Needs Faction.dbc
#                     and FactionTemplate.dbc.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#reputation
#
Reputation.CombatReactions = true

#
#    Reputation.FactionDbcPath
#        Description: Optional developer-supplied build-5875 Faction.dbc. Absent means no reputation
#                     factions: SMSG_INITIALIZE_FACTIONS stays empty and nonzero NPC factions keep
#                     failing closed.
#        Type: string
#        Default: (not set)
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#reputation
#
# Reputation.FactionDbcPath =

#
#    Reputation.PeaceForcedUsesEffectiveStanding
#        Description: Retail (false) lets forced peace be lifted by the RELATIVE standing only
#                     (ReputationMgr.cpp:334-336); true compares the effective rank including the
#                     race base. Deliberate deviation, default retail.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#reputation
#
Reputation.PeaceForcedUsesEffectiveStanding = false

#
#    Reputation.RateGain
#        Description: Multiplier on every reputation gain; the vmangos key Rate.Reputation.Gain
#                     (default 1, mangosd.conf.dist.in:2831).
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#reputation
#
Reputation.RateGain = 1

#
#    Reputation.RateLowLevelKill
#        Description: Multiplier on reputation gained from killing low-level creatures; the vmangos
#                     key Rate.Reputation.LowLevel.Kill (default 0.2, mangosd.conf.dist.in:2832).
#        Type: float
#        Default: 0.2
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#reputation
#
Reputation.RateLowLevelKill = 0.2

#
#    Reputation.SendForcedReactions
#        Description: Send SMSG_SET_FORCED_REACTIONS when a forced-reaction aura applies or fades
#                     (default false). The layout is vmangos (u32 faction, u32 rank);
#                     gtker/wow_messages types the faction as a u16, so the width is unconfirmed by
#                     a real client. The forced reaction itself works on the server either way; only
#                     the client display of it needs the packet.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#reputation
#
Reputation.SendForcedReactions = false

#
#    Reputation.SpilloverEnabled
#        Description: Retail (true): reputation_spillover_template applies
#                     (ReputationMgr.cpp:211-243). False switches every spillover off.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#reputation
#
Reputation.SpilloverEnabled = true

###############################################################################
# RESILIENCE
###############################################################################

#----------------------------------------------------------------------------
# Resilience
#----------------------------------------------------------------------------

#
#    Resilience.Database.Bootstrap.BaseDelayMs
#        Description: Wait after the first failed attempt, in milliseconds; it doubles after each
#                     further failure (with full jitter).
#        Type: int
#        Default: 500
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#resilience
#
Resilience.Database.Bootstrap.BaseDelayMs = 500

#
#    Resilience.Database.Bootstrap.MaxAttempts
#        Description: Attempts to reach the database at start, including the first; 1 means no
#                     retry. The last failure exits the process with code 6.
#        Type: int
#        Default: 5
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#resilience
#
Resilience.Database.Bootstrap.MaxAttempts = 5

#
#    Resilience.Database.Bootstrap.MaxDelayMs
#        Description: Cap on the wait between attempts, in milliseconds.
#        Type: int
#        Default: 5000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#resilience
#
Resilience.Database.Bootstrap.MaxDelayMs = 5000

#
#    Resilience.Database.Bootstrap.MaxTotalDurationMs
#        Description: Total time budget for all attempts, in milliseconds; 0 lets the attempts alone
#                     bound it.
#        Type: int
#        Default: 0
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#resilience
#
Resilience.Database.Bootstrap.MaxTotalDurationMs = 0

#
#    Resilience.Database.Breaker.FailureRateThreshold
#        Description: Share of failed calls (0..1) in the sampling window that opens the circuit
#                     once MinimumThroughput calls are in it; 0 disables this trip.
#        Type: double
#        Default: 0.5
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#resilience
#
Resilience.Database.Breaker.FailureRateThreshold = 0.5

#
#    Resilience.Database.Breaker.FailureThreshold
#        Description: Consecutive failed calls that open the circuit; 0 disables this trip (the rate
#                     trip must then be on).
#        Type: int
#        Default: 5
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#resilience
#
Resilience.Database.Breaker.FailureThreshold = 5

#
#    Resilience.Database.Breaker.HalfOpenMaxProbes
#        Description: Probe calls let through at once while half-open; one success closes the
#                     circuit, one failure re-opens it.
#        Type: int
#        Default: 1
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#resilience
#
Resilience.Database.Breaker.HalfOpenMaxProbes = 1

#
#    Resilience.Database.Breaker.MinimumThroughput
#        Description: Calls that must fall in the sampling window before the failure rate is judged.
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#resilience
#
Resilience.Database.Breaker.MinimumThroughput = 10

#
#    Resilience.Database.Breaker.OpenDurationMs
#        Description: How long an open circuit refuses every call before it lets one probe through,
#                     in milliseconds.
#        Type: int
#        Default: 10000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#resilience
#
Resilience.Database.Breaker.OpenDurationMs = 10000

#
#    Resilience.Database.Breaker.SamplingWindowMs
#        Description: Length of the sliding window the failure rate is measured over, in
#                     milliseconds.
#        Type: int
#        Default: 10000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#resilience
#
Resilience.Database.Breaker.SamplingWindowMs = 10000

#
#    Resilience.Database.Bulkhead.MaxConcurrency
#        Description: Guarded calls allowed to run at once per logical database; 0 disables the
#                     bulkhead (no cap).
#        Type: int
#        Default: 0
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#resilience
#
Resilience.Database.Bulkhead.MaxConcurrency = 0

#
#    Resilience.Database.Bulkhead.MaxQueue
#        Description: Calls allowed to wait for a slot when every slot is busy; more are refused at
#                     once.
#        Type: int
#        Default: 64
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#resilience
#
Resilience.Database.Bulkhead.MaxQueue = 64

#
#    Resilience.Database.Enabled
#        Description: false turns the whole database guard off: calls go straight to the store and a
#                     start-up failure is not retried (the pre-resilience behaviour).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#resilience
#
Resilience.Database.Enabled = true

#
#    Resilience.Database.QueryTimeoutMs
#        Description: Longest one guarded database call may take before it is cancelled and counted
#                     as a failure, in milliseconds; 0 disables the timeout.
#        Type: int
#        Default: 5000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#resilience
#
Resilience.Database.QueryTimeoutMs = 5000

###############################################################################
# REST
###############################################################################

#----------------------------------------------------------------------------
# Rest
#----------------------------------------------------------------------------

#
#    Rest.AccrualIntervalSeconds
#        Description: Seconds of resting between two gains of rested experience (the reference adds
#                     the gain once at least 10 seconds have passed since the last one). The pool
#                     grows by the same amount per second whatever the interval; a longer one only
#                     makes the steps larger. Values below 1 count as 1.
#        Type: uint
#        Default: 10
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#rest
#
Rest.AccrualIntervalSeconds = 10

#
#    Rest.RateInGame
#        Description: Rate.Rest.InGame: multiplier of the rested experience gained while resting in
#                     an inn or a capital city. 0 turns the gain off.
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#rest
#
Rest.RateInGame = 1

#
#    Rest.RateOfflineInTavernOrCity
#        Description: Rate.Rest.Offline.InTavernOrCity: multiplier of the rested experience gained
#                     while logged out, when the character logged out resting.
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#rest
#
Rest.RateOfflineInTavernOrCity = 1

#
#    Rest.RateOfflineInWilderness
#        Description: Rate.Rest.Offline.InWilderness: multiplier of the rested experience gained
#                     while logged out, when the character did not log out resting. The gain is a
#                     quarter of the resting one at rate 1 (the reference divides it by four).
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#rest
#
Rest.RateOfflineInWilderness = 1

#
#    Rest.SaveIntervalSeconds
#        Description: Seconds between the writes of the rested state of every online character (the
#                     pool, the time and the resting flag; the time is what offline accrual counts
#                     from after a crash). A logout and a shutdown always write. 0 writes only then,
#                     so after a crash the stored time is that of the last logout and the whole
#                     session counts as offline time.
#        Type: uint
#        Default: 300
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#rest
#
Rest.SaveIntervalSeconds = 300

