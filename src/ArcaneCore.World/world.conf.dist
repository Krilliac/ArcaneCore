#                     AuctionHouseBot.Loot.*): "minTemplates, maxTemplates, minRolls, maxRolls".
#                     Each sell pass draws between min and max loot tables of the source (a negative
#                     min makes an empty draw more likely) and rolls each one minRolls..maxRolls
#                     times; every item that drops is added to the listing pool. "0,0,0,0" turns a
#                     source off. Empty (the default) takes the rows; a value overrides them and
#                     logs a warning at start. The key goes in a later release.
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#auctionhousebot
#
AuctionHouseBot.LootCreatureNormal = ""

