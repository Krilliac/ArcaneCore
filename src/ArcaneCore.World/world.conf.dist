#
World.Playerbots.Chat.Speech.MaxQueuedLines = 512

#
#    World.Playerbots.Chat.Speech.RequireRealListener
#        Description: A line a bot starts on its own (not a reply) is said only where a real
#                     (non-bot) player can hear it: someone in say or yell range, a real member of
#                     the group or guild online, a real member of the world channel, an online
#                     whisper target (on by default).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Speech.RequireRealListener = true

#
#    World.Playerbots.Chat.Speech.TargetGapSeconds
#        Description: The least seconds between two lines from one bot to the same player (whisper,
#                     emote or reply; 0..3600; a high-priority reply is not held).
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Speech.TargetGapSeconds = 10

#
#    World.Playerbots.Chat.Speech.WorldChannels
#        Description: The zone channels bots join through their own CMSG_JOIN_CHANNEL on login and
#                     when they change zone, leaving the old zone's ones (General, Trade,
#                     LocalDefense, LookingForGroup; comma-separated; all by default; None joins
#                     none and leaves the ones joined). Names and rules are the 1.12 client's:
#                     General and LocalDefense in every open-world zone, Trade only in a capital,
#                     LookingForGroup everywhere; none of the zone ones inside an instance or
#                     battleground. Values: None, General, Trade, LocalDefense, LookingForGroup,
#                     All.
#        Type: PlayerbotWorldChannels
#        Default: All
#        Allowed: None | General | Trade | LocalDefense | LookingForGroup | All
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Speech.WorldChannels = All

