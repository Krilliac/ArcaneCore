#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Social.Helping.Enabled = true

#
#    World.Playerbots.Social.Helping.MaxAnswersPerCall
#        Description: The most bots that answer one call for help (1..16, 2 by default): a call is
