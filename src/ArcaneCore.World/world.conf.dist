#    World.Playerbots.Groups.DungeonRuns.BandAboveBoss
#        Description: Levels above the strongest boss the level band ends (0..20).
#        Type: int
#        Default: 3
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
