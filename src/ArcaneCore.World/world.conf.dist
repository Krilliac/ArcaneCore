###############################################################################
# AURAS
###############################################################################

#----------------------------------------------------------------------------
# Auras
#----------------------------------------------------------------------------

#
#    Auras.DamageProcCancelsAura
#        Description: Opt-in deviation: an aura that breaks on damage (AuraInterruptFlags DAMAGE)
#                     and procs on TAKEN_ANY_DAMAGE (Wyvern Sting's sleep) ends when its damage proc
#                     fires, as the spell's tooltip says ("Any damage will cancel the effect").
#                     Default false, the vmangos behaviour: MOD_STUN has no proc handler
#                     (HandleNULLProc, UnitAuraProcHandler.cpp:51) and the proc spends only real
#                     charges (Unit.cpp:4330-4335), so an uncharged aura such as Wyvern Sting keeps
#                     going through the damage.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#auras
#
Auras.DamageProcCancelsAura = false

#
#    Auras.HarmfulAurasExpireOffline
#        Description: Harmful auras keep counting down while their owner is offline (the cmangos
#                     rule this engine used before). Retail (vmangos Player::LoadAura,
#                     Player.cpp:15363-15372) subtracts the offline time only from spells with
#                     SPELL_ATTR_EX4_AURA_EXPIRES_OFFLINE (Deserter), so every other aura resumes
#                     with the time it had at logout. Default false.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#auras
#
Auras.HarmfulAurasExpireOffline = false

#
#    Auras.PeriodicCatchUp
#        Description: Deliver every missed periodic tick in one update (the engine's behaviour
#                     before the periodic timing slice). Retail (vmangos Aura::Update,
#                     SpellAuras.cpp:553-572) delivers at most one tick per update, so a lag spike
#                     drops ticks instead of bursting them. Default false.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#auras
#
Auras.PeriodicCatchUp = false

#
#    Auras.ProcEngineBreaksDamageAuras
#        Description: The damage break skips every aura whose spell has procFlags (vmangos
#                     checkProcFlags, Unit.cpp:735-745, 895-906): such auras end through the proc
#                     engine instead (their charges, the root, pacify-silence and fear break
#                     chances, docs/areas/procs.md). Default true, the vmangos rule, now that the
#                     proc engine exists. False removes procFlags auras on the damage break too (the
#                     engine's behaviour before procs existed). Checked against the build 5875
#                     Spell.dbc: Polymorph, Sap, Gouge, Freezing Trap and druid Prowl carry no
#                     procFlags and break on the interrupt path either way; Wyvern Sting
#                     (TAKEN_ANY_DAMAGE) and the hunter pet's Prowl (melee flags, one charge) are
#                     the damage-cancel auras that do.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#auras
#
Auras.ProcEngineBreaksDamageAuras = true

###############################################################################
# AUTOBROADCAST
###############################################################################

#----------------------------------------------------------------------------
# AutoBroadcast
#----------------------------------------------------------------------------

#
#    AutoBroadcast.Enabled
#        Description: Off by default: ClassicDB has no autobroadcast table, so the messages come
#                     from this section.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#autobroadcast
#
AutoBroadcast.Enabled = false

#
#    AutoBroadcast.IntervalMs
#        Description: vmangos default 1800000 (30 minutes).
#        Type: uint
#        Default: 1800000
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#autobroadcast
#
AutoBroadcast.IntervalMs = 1800000

#
#    AutoBroadcast.Messages
#        Description: The announcements (vmangos autobroadcast.string_id rows;
#                     sql/custom/autobroadcast_example.sql has the classic tips).
#        Type: List<string>
#        Default: (empty list)
#        Allowed: a list: numbered keys 0, 1, 2, ...; each value is text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#autobroadcast
#
# Empty by default.
# AutoBroadcast.Messages.0 =

###############################################################################
# BANS
###############################################################################

#----------------------------------------------------------------------------
# Bans
#----------------------------------------------------------------------------

#
#    Bans.BanListCharacterIncludesHistory
#        Description: .banlist character also lists accounts whose only rows are expired, lifted
#                     (inactive) or unban audit rows. vmangos does (HandleBanListCharacterCommand →
#                     HandleBanListHelper, AccountCommands.cpp:835-853, 886-905: any account_banned
#                     row of the account), while its .banlist account lists only rows with active =
#                     1 (:855-884). The default (false) narrows the character listing to accounts
#                     with a ban in force, the same rule as .banlist account here; true restores
#                     vmangos' broad listing. Bound from Bans:BanListCharacterIncludesHistory.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#bans
#
Bans.BanListCharacterIncludesHistory = false

#
#    Bans.MaxListedEntries
#        Description: The most entries one .baninfo history or .banlist reply prints before it ends
#                     with a "not shown" line. Retail prints everything; a long ban history or a
#                     one-letter prefix against a large realm would otherwise build and send one
#                     unbounded chat reply (and, for .banlist character, one history query per
#                     matching account). For .banlist character the cap also bounds the work:
#                     accounts are checked in batches of 200 (one query each) and the walk stops
#                     once one more than the cap has history. 0 restores retail's unbounded output.
#                     Bound from Bans:MaxListedEntries; default 200 (a deliberate deviation, only
#                     above that many entries).
#        Type: int
#        Default: 200
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#bans
#
Bans.MaxListedEntries = 200

#
#    Bans.ProtectHigherSecurity
#        Description: Refuse .ban account / .ban character against an account whose security level
#                     is equal to or higher than the invoker's (an account banning itself is still
#                     allowed, as in retail). vmangos has NO such guard: a game master there can ban
#                     an administrator. The strict default closes the one path by which a
#                     compromised low staff account locks out the highest account; set false for
#                     exact vmangos parity. Does not apply to .ban ip (no per-address account list
#                     is kept) or to unbans. Bound from Bans:ProtectHigherSecurity; default true (a
#                     deliberate deviation from retail, in the safe direction).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#bans
#
Bans.ProtectHigherSecurity = true

#
#    Bans.RealmId
#        Description: The realm id written to account_banned.realm (vmangos realmID); recorded and
#                     shown by .baninfo, never filtered on, exactly as retail. Bound from
#                     Bans:RealmId; default 1.
#        Type: int
#        Default: 1
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#bans
#
Bans.RealmId = 1

#
#    Bans.RecheckIntervalSeconds
#        Description: How often connected sessions are re-checked against the ban rows, IP bans and
#                     the status column, so a ban written by another process (arcane-account, SQL,
#                     the realm daemon) is enforced. Default 60 seconds, the period of mangosd's own
#                     ban-list reload (World.cpp:697 BanListReloadTimer 60;
#                     mangosd.conf.dist.in:232-234 ships 120). vmangos only reloads its IP cache on
#                     that timer and never kicks for an externally written account row
#                     (AccountMgr.cpp:317-327), so kicking on the re-check is an ArcaneCore
#                     deviation in the safe direction; 0 turns the re-check off for exact retail
#                     behaviour. Each pass is a few indexed queries over the connected account ids.
#                     Bound from Bans:RecheckIntervalSeconds.
#        Type: double
#        Default: 60
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#bans
#
Bans.RecheckIntervalSeconds = 60

#
#    Bans.RejectUnparseableDuration
#        Description: Refuse a .ban whose duration is not a clean 1d2h3m4s string. Retail does not:
#                     any other character, or digits without a unit, make TimeStringToSecs return 0,
#                     which the command treats as a PERMANENT ban (Util.cpp:252-275), so a typo bans
#                     forever. Bound from Bans:RejectUnparseableDuration; default false.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#bans
#
Bans.RejectUnparseableDuration = false

#
#    Bans.RevokeSessionKeyOnBan
#        Description: After a live ban the stored session key is nulled, so a world reconnect with
#                     the old key is refused (it then answers UnknownAccount instead of
#                     AUTH_BANNED). Retail keeps the key and relies on the ban check
#                     (WorldSocket.cpp:287-290, 333-345). Bound from Bans:RevokeSessionKeyOnBan;
#                     default false.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#bans
#
Bans.RevokeSessionKeyOnBan = false

###############################################################################
# BATTLEGROUND
###############################################################################

#----------------------------------------------------------------------------
# Battleground
#----------------------------------------------------------------------------

#
#    Battleground.CastDeserter
#        Description: Cast Deserter on a player who leaves a running or starting match (vmangos
#                     Battleground.CastDeserter, World.cpp:781, mangosd.conf.dist.in:2929, default
#                     on).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#battleground
#
Battleground.CastDeserter = true

#
#    Battleground.GroupQueueLimit
#        Description: Groups larger than this are queued as individuals (vmangos
#                     BattleGround.GroupQueueLimit, default 40).
#        Type: uint
#        Default: 40
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#battleground
#
Battleground.GroupQueueLimit = 40

#
#    Battleground.InvitationType
#        Description: 0 invites from the queue in order, 1 balances the two sides (vmangos
#                     Battleground.InvitationType; World.cpp:787 reads 0 when the key is missing but
#                     the shipped mangosd.conf.dist.in:2932 sets 1, which is the retail behaviour
#                     and the default here).
#        Type: uint
#        Default: 1
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#battleground
#
Battleground.InvitationType = 1

#
#    Battleground.PremadeGroupWaitForMatchMs
#        Description: Wait for a premade-versus-premade match this long before premades fall back to
#                     the normal queue, ms; 0 turns it off (vmangos
#                     BattleGround.PremadeGroupWaitForMatch, default 0).
#        Type: uint
#        Default: 0
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#battleground
#
Battleground.PremadeGroupWaitForMatchMs = 0

#
#    Battleground.PremadeQueueMinGroupSize
#        Description: Smallest group that counts as a premade (vmangos
#                     BattleGround.PremadeQueue.MinGroupSize, default 6).
#        Type: uint
#        Default: 6
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#battleground
#
Battleground.PremadeQueueMinGroupSize = 6

#
#    Battleground.PrematureFinishTimerMs
#        Description: How long a side may stay below the minimum before the match ends in favour of
#                     the other side, in ms; 0 turns it off (vmangos
#                     BattleGround.PrematureFinishTimer, World.cpp:788, default 5 minutes).
#        Type: uint
#        Default: 300000
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#battleground
#
Battleground.PrematureFinishTimerMs = 300000

#
#    Battleground.QueuesCount
#        Description: Queues a player may be in at once; 0 means the patch default, which is 3 from
#                     client patch 1.9 on and so 3 for 1.12.1 (vmangos BattleGround.QueuesCount,
#                     World.cpp:794-803).
#        Type: uint
#        Default: 0
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#battleground
#
Battleground.QueuesCount = 0

#
#    Battleground.TagInBattlegrounds
#        Description: Whether a player inside a battleground may be tagged into a group queue
#                     (vmangos BattleGround.TagInBattleGrounds, default on).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#battleground
#
Battleground.TagInBattlegrounds = true

###############################################################################
# CHARACTERCREATION
###############################################################################

#----------------------------------------------------------------------------
# CharacterCreation
#----------------------------------------------------------------------------

#
#    CharacterCreation.AllowTwoSideAccounts
#        Description: vmangos AllowTwoSide.Accounts (default off): one account may hold both
#                     factions on a PvP realm.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#charactercreation
#
CharacterCreation.AllowTwoSideAccounts = false

#
#    CharacterCreation.CharSectionsDbcPath
#        Description: The build-5875 CharSections.dbc (10 fields), supplied by the developer and
#                     never downloaded. Together with CharacterFacialHairStylesDbcPath it turns on
#                     vmangos Player::ValidateAppearance: a CMSG_CHAR_CREATE whose skin, face, hair
#                     or facial hair the client could not have offered is refused with
#                     CHAR_CREATE_FAILED. Both empty: appearance is not checked. Only one set, or a
#                     configured file that is unreadable or has another layout, refuses startup.
#        Type: string
#        Default: (not set)
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#charactercreation
#
# CharacterCreation.CharSectionsDbcPath =

#
#    CharacterCreation.CharacterFacialHairStylesDbcPath
#        Description: The build-5875 CharacterFacialHairStyles.dbc (9 fields); see
#                     CharSectionsDbcPath.
#        Type: string
#        Default: (not set)
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#charactercreation
#
# CharacterCreation.CharacterFacialHairStylesDbcPath =

#
#    CharacterCreation.CharactersCreatingDisabled
#        Description: vmangos CharactersCreatingDisabled (World.cpp:629): bit 0 stops Alliance, bit
#                     1 stops Horde creations for ordinary players (CharacterHandler.cpp:193-216).
#                     Default 0.
#        Type: uint
#        Default: 0
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#charactercreation
#
CharacterCreation.CharactersCreatingDisabled = 0

#
#    CharacterCreation.GameType
#        Description: vmangos GameType (World.cpp:600): PvP, RP-PvP and FFA realms are "PvP realms"
#                     (World.h:802). Values: Normal, PvP, Normal2, Rp, RpPvP, FfaPvP.
#        Type: RealmGameType
#        Default: Normal
#        Allowed: Normal | PvP | Normal2 | Rp | RpPvP | FfaPvP
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#charactercreation
#
CharacterCreation.GameType = Normal

#
#    CharacterCreation.GmStartLevel
#        Description: vmangos GM.StartLevel (default 1), clamped to StartPlayerLevel..MAX_LEVEL
#                     (100); used for accounts above player security (World.cpp:677,
#                     Player.cpp:16217).
#        Type: int
#        Default: 1
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#charactercreation
#
CharacterCreation.GmStartLevel = 1

#
#    CharacterCreation.MinPlayerName
#        Description: vmangos MinPlayerName (default 2), clamped to 2..12 (World.cpp:621).
#        Type: int
#        Default: 2
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#charactercreation
#
CharacterCreation.MinPlayerName = 2

#
#    CharacterCreation.Mode
#        Description: Retail (default) or Legacy (the old permissive behaviour). Values: Retail,
#                     Legacy.
#        Type: CharacterCreationMode
#        Default: Retail
#        Allowed: Retail | Legacy
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#charactercreation
#
CharacterCreation.Mode = Retail

#
#    CharacterCreation.RealmZone
#        Description: vmangos RealmZone (RealmZone.h:23-61), selects the name alphabet with
#                     StrictPlayerNames bit 2. The vmangos default is 1 (development).
#        Type: int
#        Default: 1
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#charactercreation
#
CharacterCreation.RealmZone = 1

#
#    CharacterCreation.StartActions
#        Description: Give new characters their playercreateinfo_action bar (vmangos
#                     MasterPlayer::Create). False leaves it empty.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#charactercreation
#
CharacterCreation.StartActions = true

#
#    CharacterCreation.StartPlayerLevel
#        Description: vmangos StartPlayerLevel (default 1), clamped to 1..MaxPlayerLevel
#                     (World.cpp:673).
#        Type: int
#        Default: 1
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#charactercreation
#
CharacterCreation.StartPlayerLevel = 1

#
#    CharacterCreation.StartPlayerMoney
#        Description: vmangos StartPlayerMoney in copper (default 0), clamped to 0..MAX_MONEY_AMOUNT
#                     (World.cpp:674).
#        Type: long
#        Default: 0
#        Allowed: a whole number, -9223372036854775808 to 9223372036854775807
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#charactercreation
#
CharacterCreation.StartPlayerMoney = 0

#
#    CharacterCreation.StrictPlayerNames
#        Description: vmangos StrictPlayerNames (0 any one script, bit 1 basic Latin, bit 2 realm
#                     zone script).
#        Type: uint
#        Default: 0
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#charactercreation
#
CharacterCreation.StrictPlayerNames = 0

###############################################################################
# CLIENTDATA
###############################################################################

#----------------------------------------------------------------------------
# ClientData
#----------------------------------------------------------------------------

#
#    ClientData.DbcDirectory
#        Description: A directory holding the client's DBFilesClient *.dbc files (build 5875,
#                     extracted by the developer; none ships with the server). Set, every DBC
#                     consumer whose own path key (for example Combat:ShapeshiftFormDbcPath) is
#                     unset or empty reads the file of that name in this directory (for example
#                     SpellShapeshiftForm.dbc); a key that is set still wins. Each file is checked
#                     at start against the vmangos layout (field count and record size) and logged
#                     on one line: loaded, missing or format mismatch. A missing or mismatched file
#                     is not handed to its consumer, which keeps its built-in table or stays off,
#                     with a warning. Empty (the default): only the per-file keys are read, as
#                     before.
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#clientdata
#
ClientData.DbcDirectory = ""

#
#    ClientData.Strict
#        Description: Make a client data problem fatal: a missing or mismatched DBC under
#                     DbcDirectory, a configured per-file path whose file is missing or has another
#                     layout, or a DbcDirectory that does not exist refuses start-up (exit code 78,
#                     like any configuration error) instead of a warning. Default false.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#clientdata
#
ClientData.Strict = false

###############################################################################
# CLUSTER
###############################################################################

#----------------------------------------------------------------------------
# Cluster:Fencing
#----------------------------------------------------------------------------

#
#    Cluster.Fencing.ClaimWatchIntervalSeconds
#        Description: With fencing disabled, how often the world reads the characters ownership row
#                     to notice that a fenced world has claimed the database, in seconds (1 to 300).
#                     Independent of autosave; an unfenced world can keep writing for up to this
#                     long after a claim.
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#clusterfencing
#
Cluster.Fencing.ClaimWatchIntervalSeconds = 10

#
#    Cluster.Fencing.Enabled
#        Description: Enable durable character ownership fencing at world startup; disabled by
#                     default.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#clusterfencing
#
Cluster.Fencing.Enabled = false

#
#    Cluster.Fencing.OwnerNode
#        Description: The durable owner identity; defaults to the current machine name and must be
#                     stable while the world owns the database.
#        Type: string
#        Default: (not set)
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#clusterfencing
#
# Cluster.Fencing.OwnerNode =

#
#    Cluster.Fencing.TakeoverEpoch
#        Description: The positive ownership epoch to compare and swap during an explicit takeover;
#                     pair with TakeoverIncarnation.
#        Type: long?
#        Default: (not set)
#        Allowed: a whole number, -9223372036854775808 to 9223372036854775807
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#clusterfencing
#
# Cluster.Fencing.TakeoverEpoch =

#
#    Cluster.Fencing.TakeoverIncarnation
#        Description: The non-empty ownership incarnation to compare and swap during an explicit
#                     takeover; pair with TakeoverEpoch.
#        Type: Guid?
#        Default: (not set)
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#clusterfencing
#
# Cluster.Fencing.TakeoverIncarnation =

###############################################################################
# COMBAT
###############################################################################

#----------------------------------------------------------------------------
# Combat
#----------------------------------------------------------------------------

#
#    Combat.CastResetsMeleeSwing
#        Description: A non-triggered cast of a spell whose interrupt flags carry
#                     SPELL_INTERRUPT_FLAG_COMBAT (0x08), without Ex2 0x20000, restarts the
#                     main-hand (and off-hand) swing timer when it is cast (vmangos Spell::cast,
#                     Spell.cpp:3805-3810). Default true, retail; false is a deviation that leaves
#                     the timers alone.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#combat
#
Combat.CastResetsMeleeSwing = true

#
#    Combat.CastingConsumesSwing
#        Description: How a blocked swing is handled while MeleeCastingBlocksSwing applies (ranged
#                     (autorepeat lane)). Default false, retail: Unit::UpdateMeleeAttackingState
#                     returns before it looks at any swing timer while a non-melee spell is cast
#                     (Unit.cpp:415-421; mangos-classic Unit.cpp:650-654 has the same order), so the
#                     swing happens as soon as the cast ends. True is the deviation that predates
#                     this lane: the swing timer is consumed and restarted, the swing is lost, not
#                     delayed.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#combat
#
Combat.CastingConsumesSwing = false

#
#    Combat.MeleeCastingBlocksSwing
#        Description: Whether a unit casting a non-melee spell loses its melee swing (vmangos
#                     Unit::AttackerStateUpdate, Unit.cpp:2240-2241: if (!extra &&
#                     IsNonMeleeSpellCasted(false)) return). Default true, the retail behaviour; the
#                     swing timer still restarts, so the swing is lost, not delayed.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#combat
#
Combat.MeleeCastingBlocksSwing = true

#
#    Combat.RateEnergy
#        Description: vmangos Rate.Energy: multiplies the energy regeneration (Player.cpp:2320).
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#combat
#
Combat.RateEnergy = 1

#
#    Combat.RateHealth
#        Description: vmangos Rate.Health: multiplies spirit health regeneration and the aura-161
#                     flat bonus. Must not be negative.
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#combat
#
Combat.RateHealth = 1

#
#    Combat.RateMana
#        Description: vmangos Rate.Mana: multiplies the mana regeneration (Player.cpp:2291). Must
#                     not be negative.
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#combat
#
Combat.RateMana = 1

#
#    Combat.RateRageIncome
#        Description: vmangos Rate.Rage.Income: multiplies the rage a player gains from damage
#                     (Player.cpp:2264).
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#combat
#
Combat.RateRageIncome = 1

#
#    Combat.RateRageLoss
#        Description: vmangos Rate.Rage.Loss: multiplies the out-of-combat rage decay
#                     (Player.cpp:2313). Must not be negative.
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#combat
#
Combat.RateRageLoss = 1

#
#    Combat.RequireShapeshiftFormDbc
#        Description: Refuse to start without ShapeshiftFormDbcPath instead of falling back to the
#                     built-in build-5875 table (ShapeshiftFormCatalog.Retail). Default false.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#combat
#
Combat.RequireShapeshiftFormDbc = false

#
#    Combat.ShapeshiftFormDbcPath
#        Description: Path of the client's SpellShapeshiftForm.dbc (build 5875). Empty = only the
#                     three warrior stances are known.
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#combat
#
Combat.ShapeshiftFormDbcPath = ""

#
#    Combat.StanceShiftKeepsSelfBuffs
#        Description: Whether switching between warrior stances keeps the stance-bound buffs the
#                     unit cast on itself (Retaliation, Recklessness, Shield Wall). Default false:
#                     vmangos removes them with the old stance (SpellAuras.cpp:5565-5575,
#                     SpellAuraHolder::m_isRemovedOnShapeLost). Patch 1.7.0 is quoted by vmangos as
#                     saying they are no longer cancelled (SpellAuras.cpp:5537-5539), but its code
#                     for that sits in a block excluded from the 1.12.1 build, so the code is
#                     followed.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#combat
#
Combat.StanceShiftKeepsSelfBuffs = false

###############################################################################
# CONDITIONS
