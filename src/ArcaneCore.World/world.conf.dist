#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Speech.EmoteReplies = true

#
#    World.Playerbots.Chat.Speech.EmoteReplyGapSeconds
#        Description: The least seconds between two emote answers from one bot to the same emoter
