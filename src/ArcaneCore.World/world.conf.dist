#
#    Creatures.Respawn.AlternateEntries
#        Description: Creatures:Respawn:AlternateEntries: a spawn with creature_spawn_entry rows
#                     (vmangos id2 ... id5) becomes one of those entries when it loads and again at
#                     every respawn (cmangos Creature::LoadFromDB / ResetEntry; vmangos
#                     Creature.cpp:830-841, :1936-1944). False ignores the rows: a spawn whose id is
#                     0 then never spawns (the earlier behaviour).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.Respawn.AlternateEntries = true

#
#    Creatures.Respawn.DrawDelayAtLoad
#        Description: Creatures:Respawn:DrawDelayAtLoad: a spawn's respawn delay
#                     (urand(spawntimesecsmin, spawntimesecsmax)) is drawn once when the creature
#                     object is created and reused at every death (vmangos Creature::LoadFromDB,
#                     Objects/Creature.cpp:1963; SetDeathState reads m_respawnDelay, :2246). False
#                     draws again at every death (the earlier ArcaneCore behaviour).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.Respawn.DrawDelayAtLoad = true

#
#    Creatures.Respawn.DynamicMinimumSeconds
#        Description: Creatures:Respawn:DynamicMinimumSeconds: TrinityCore
#                     Respawn.DynamicMinimumCreature (default 10 s).
#        Type: uint
#        Default: 10
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.Respawn.DynamicMinimumSeconds = 10

#
#    Creatures.Respawn.DynamicRate
#        Description: Creatures:Respawn:DynamicRate: TrinityCore Respawn.DynamicRateCreature
#                     (Map::ApplyDynamicModeRespawnScaling, Maps/Map.cpp:3312-3354). A dying
#                     open-world spawn's respawn delay is multiplied by DynamicRate / players in its
#                     zone when that is below 1, never under DynamicMinimumSeconds. 0 (the default)
#                     is off, which is retail 1.12.1; TrinityCore's suggested value is 10. Dungeons,
#                     raids, battlegrounds, rares and world bosses are never scaled.
#        Type: float
#        Default: 0
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.Respawn.DynamicRate = 0

#
#    Creatures.Respawn.HonorTemplateCorpseDecay
#        Description: Creatures:Respawn:HonorTemplateCorpseDecay: let a template's CorpseDecay
#                     column override the rank delay. It is a cmangos column; vmangos sets the
#                     corpse delay by rank alone (Creature.cpp:1326-1343), which is retail.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.Respawn.HonorTemplateCorpseDecay = false

#
#    Creatures.Respawn.Linked
#        Description: Creatures:Respawn:Linked: carry the creature_linking aggro, respawn and
#                     despawn events (cmangos CreatureLinkingHolder::ProcessSlave,
#                     Entities/CreatureLinkingMgr.cpp:555-612, and CanSpawn, :699-751): a boss's
#                     trash respawns, despawns or dies with it, and a slave with
#                     FLAG_CANT_SPAWN_IF_BOSS_DEAD / ALIVE waits on its master. Retail; false keeps
#                     only FLAG_FOLLOW and the instance scripts' own handling.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.Respawn.Linked = true

#
#    Creatures.Respawn.Persist
#        Description: Creatures:Respawn:Persist: dead spawns keep their respawn time across restarts
#                     (vmangos creature_respawn, characters database). False keeps the timers in
#                     memory only, as before.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.Respawn.Persist = true

#
#    Creatures.Respawn.SaveImmediately
#        Description: Creatures:Respawn:SaveImmediately: every database spawn saves its respawn time
#                     at death (vmangos SaveRespawnTimeImmediately = 1, mangosd.conf.dist.in:397,
#                     World.cpp:729). False saves a normal creature only when it leaves the map or
#                     at shutdown; a world boss is always saved at death (Creature.cpp:2262-2263).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.Respawn.SaveImmediately = true

#
#    Creatures.RespawnPacifyMs
#        Description: Milliseconds a creature cannot initiate attacks after it respawns (vmangos
#                     Creature::SetTempPacified(5000) on respawn, Objects/Creature.cpp:877-878). 0
#                     disables.
#        Type: uint
#        Default: 5000
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.RespawnPacifyMs = 5000

#
#    Creatures.SendAiReaction
#        Description: Send SMSG_AI_REACTION(hostile) when a creature starts attacking (vmangos
#                     Creature::SendAIReaction from Unit::Attack); the client plays the aggro sound
#                     from it.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.SendAiReaction = true

#
#    Creatures.StealthAlertCooldownMs
#        Description: Milliseconds between two alerts of one creature
#                     (Creatures:StealthAlertCooldownMs): vmangos 10000 (AI/CreatureAI.cpp:366-367).
#        Type: uint
#        Default: 10000
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.StealthAlertCooldownMs = 10000

#
#    Creatures.StealthAlertEnabled
#        Description: Creatures:StealthAlertEnabled: a hostile creature that notices a stealthed
#                     player just outside its detection range reacts (SMSG_AI_REACTION alert, it
#                     stops and turns to the player); vmangos CreatureAI::OnMoveInStealth,
#                     AI/CreatureAI.cpp:349-385. Retail is true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.StealthAlertEnabled = true

#
#    Creatures.ThreatRadius
#        Description: ThreatRadius (yd): the soft leash sphere around where a fight began is max(1.5
#                     x aggro radius, ThreatRadius); none in instances (vmangos World.cpp:564,
#                     mangosd.conf.dist.in:1526: 50).
#        Type: float
#        Default: 50
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.ThreatRadius = 50

#
#    Creatures.UnreachableTargetEvadeMs
#        Description: Milliseconds a chasing creature tolerates a victim its pathfinder cannot reach
#                     before it evades home (Creatures:UnreachableTargetEvadeMs): vmangos
#                     Creature::Update, m_targetNotReachableTimer &gt; 24000 calls EnterEvadeMode
#                     (Objects/Creature.cpp:1037-1040). The count (vmangos
#                     m_targetNotReachableTimer, :1013-1030) runs while the chase on top of the
#                     creature's movement says its victim is unreachable, the creature is not a
#                     ranged chaser, not owned or charmed by a player, has no NO_UNREACHABLE_EVADE
#                     flag and cannot hit the victim (out of melee reach or out of sight); it
#                     restarts at 0 whenever that stops being true and when combat ends. 0 disables
#                     the evade; EventAI's EVENT_T_TARGET_NOT_REACHABLE still fires.
#        Type: uint
#        Default: 24000
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.UnreachableTargetEvadeMs = 24000

#
#    Creatures.UnreachableTargetSoftEvadeMs
#        Description: Milliseconds of the same count after which the creature is in evade mode where
#                     it stands (Creatures:UnreachableTargetSoftEvadeMs): vmangos
#                     Creature::IsEvadeBecauseTargetNotReachable, m_targetNotReachableTimer &gt;
#                     3000 (Objects/Creature.h:510). Attacks on it evade (it counts for
#                     Creature.IsInEvadeMode), its AI does not update (Creature.cpp:1041) and it
#                     regenerates as if out of combat (:1057); it keeps its victim and keeps
#                     chasing. 0 disables this stage.
#        Type: uint
#        Default: 3000
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#creatures
#
Creatures.UnreachableTargetSoftEvadeMs = 3000

###############################################################################
# DATABASE
###############################################################################

#----------------------------------------------------------------------------
# Database
#----------------------------------------------------------------------------

#
#    Database.Auth.ConnectionString
#        Description: The connection string of this component's database. The shipped files carry
#                     the development placeholder user arcane; change it for any real deployment.
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.Auth.ConnectionString = ""

#
#    Database.Auth.Provider
#        Description: The relational engine of this component's database (Database:Auth,
#                     Database:Characters or Database:World). Values: MariaDb, MySql, PostgreSql,
#                     Sqlite.
#        Type: DatabaseProvider
#        Default: MariaDb
#        Allowed: MariaDb | MySql | PostgreSql | Sqlite
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.Auth.Provider = MariaDb

#
#    Database.Auth.SqliteBusyTimeoutMs
#        Description: SQLite only: this component's busy timeout in milliseconds (0..60000),
#                     overriding Database:SqliteBusyTimeoutMs. Unset inherits it. Other engines
#                     ignore it.
#        Type: int?
#        Default: (not set)
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
# Database.Auth.SqliteBusyTimeoutMs =

#
#    Database.Auth.SqliteSynchronous
#        Description: SQLite only: this component's PRAGMA synchronous (Full or Normal), overriding
#                     Database:SqliteSynchronous. Unset inherits it. Normal avoids the fsync stall
#                     at every commit but can lose the most recent commits on power loss or an OS
#                     crash; it is applied only when the database is in WAL mode, otherwise the
#                     database stays on Full and an error is logged. Other engines ignore it.
#                     Values: Full, Normal.
#        Type: SqliteSynchronousMode?
#        Default: (not set)
#        Allowed: Full | Normal
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
# Database.Auth.SqliteSynchronous =

#
#    Database.Characters.ConnectionString
#        Description: The connection string of this component's database. The shipped files carry
#                     the development placeholder user arcane; change it for any real deployment.
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.Characters.ConnectionString = ""

#
#    Database.Characters.Provider
#        Description: The relational engine of this component's database (Database:Auth,
#                     Database:Characters or Database:World). Values: MariaDb, MySql, PostgreSql,
#                     Sqlite.
#        Type: DatabaseProvider
#        Default: MariaDb
#        Allowed: MariaDb | MySql | PostgreSql | Sqlite
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.Characters.Provider = MariaDb

#
#    Database.Characters.SqliteBusyTimeoutMs
#        Description: SQLite only: this component's busy timeout in milliseconds (0..60000),
#                     overriding Database:SqliteBusyTimeoutMs. Unset inherits it. Other engines
#                     ignore it.
#        Type: int?
#        Default: (not set)
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
# Database.Characters.SqliteBusyTimeoutMs =

#
#    Database.Characters.SqliteSynchronous
#        Description: SQLite only: this component's PRAGMA synchronous (Full or Normal), overriding
#                     Database:SqliteSynchronous. Unset inherits it. Normal avoids the fsync stall
#                     at every commit but can lose the most recent commits on power loss or an OS
#                     crash; it is applied only when the database is in WAL mode, otherwise the
#                     database stays on Full and an error is logged. Other engines ignore it.
#                     Values: Full, Normal.
#        Type: SqliteSynchronousMode?
#        Default: (not set)
#        Allowed: Full | Normal
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
# Database.Characters.SqliteSynchronous =

#
#    Database.ConnectionString
#        Description: The connection string for any component that has no Database:<Component>
#                     sub-section of its own. The shipped Realm file uses this single-database form.
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.ConnectionString = ""

#
#    Database.Provider
#        Description: The relational engine for any component that has no Database:<Component>
#                     sub-section of its own (the single-database layout). MariaDB is the primary
#                     engine; MySql, PostgreSql and Sqlite are also supported. Values: MariaDb,
#                     MySql, PostgreSql, Sqlite.
#        Type: DatabaseProvider
#        Default: MariaDb
#        Allowed: MariaDb | MySql | PostgreSql | Sqlite
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.Provider = MariaDb

#
#    Database.SlowCommandWarnMs
#        Description: How long (milliseconds, default 2000; 0 disables) a single database command
#                     may take to execute before it is logged at WARN with the DbContext, whether it
#                     ran inside a transaction or autocommitted, whether it was a write, the first
#                     80 characters of its SQL (parameter values are never logged) and the code that
#                     issued it, on every provider. It sees what the transaction warning cannot:
#                     writes that autocommit and wait in "database is locked". Identical warnings
#                     are limited to one per 10 s (docs/areas/persistence.md).
#        Type: int
#        Default: 2000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.SlowCommandWarnMs = 2000

#
#    Database.SlowTransactionWarnMs
#        Description: How long (milliseconds, default 2000; 0 disables) a database transaction may
#                     stay open before it is logged at WARN with the DbContext and the code that
#                     closed it, on every provider. A transaction that holds the write lock this
#                     long is what makes other writers fail with "database is locked", so the next
#                     holder names itself in the log (docs/areas/persistence.md).
#        Type: int
#        Default: 2000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.SlowTransactionWarnMs = 2000

#
#    Database.Sqlite.Checkpoint.Enabled
#        Description: Whether the background checkpointer owns checkpointing (default true). False
#                     leaves SQLite's own auto-checkpoint (1000 pages, inside the committing
#                     connection) untouched.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.Sqlite.Checkpoint.Enabled = true

#
#    Database.Sqlite.Checkpoint.IntervalMs
#        Description: How often (milliseconds, 100..3600000, default 2000) the background service
#                     runs PRAGMA wal_checkpoint(PASSIVE) on each database. PASSIVE takes no writer
#                     lock and waits on no lock, but its I/O still competes for the same disk; a
#                     shorter interval keeps the WAL smaller at the cost of more wake-ups.
#        Type: int
#        Default: 2000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.Sqlite.Checkpoint.IntervalMs = 2000

#
#    Database.Sqlite.Checkpoint.JournalSizeLimitBytes
#        Description: PRAGMA journal_size_limit in bytes (0..1099511627776, default 33554432 = 32
#                     MiB), set on every connection to the database: once a checkpoint has copied
#                     the whole WAL into the database and the next writer restarts it, SQLite
#                     truncates the file down to this size instead of leaving it at its high-water
#                     mark. This is the only thing that shrinks the -wal file while the server runs,
#                     and only when the log restarts (continuous overlapping readers can postpone
#                     that; a warning is logged when the file stays above 4 x max(this limit, 1 MiB)
#                     for 30 s while commits keep arriving or the copy is incomplete): the service
#                     never runs a TRUNCATE checkpoint during operation, because TRUNCATE takes the
#                     exclusive writer lock and holds it through the copy of the frames written
#                     since the last PASSIVE, the WAL fsync and the database fsync (which on Windows
#                     flushes every page earlier PASSIVE runs wrote), which would put the stall this
#                     feature removes back in front of a game save. Only the final checkpoint at
#                     host stop, after the world has drained its saves, is a TRUNCATE; it waits at
#                     most about 250 ms for readers and writers, and holds the writer lock through
#                     its copy and syncs. If the Auth database is one file shared by the world and
#                     realm daemons, either daemon's shutdown TRUNCATE can briefly stall the other's
#                     auth writes.
#        Type: long
#        Default: 33554432
#        Allowed: a whole number, -9223372036854775808 to 9223372036854775807
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.Sqlite.Checkpoint.JournalSizeLimitBytes = 33554432

#
#    Database.Sqlite.SingleWriter.StatsIntervalMs
#        Description: How often (milliseconds, 0..3600000, default 300000; 0 never) each gate logs
#                     one INFO line with its writes, contended writes, waits, longest hold and
#                     timeouts for the interval.
#        Type: int
#        Default: 300000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.Sqlite.SingleWriter.StatsIntervalMs = 300000

#
#    Database.SqliteBusyTimeoutMs
#        Description: SQLite only: how long (0..60000 ms, default 5000) a connection waits inside
#                     SQLite for another connection's write lock before reporting "database is
#                     locked", set as PRAGMA busy_timeout on every connection (never more than the
#                     connection string's Default Timeout, and clamped to
#                     Resilience:Database:QueryTimeoutMs when the database guard is on, so a refused
#                     call never outlives its deadline in SQLite's busy handler). Without it a
#                     waiting writer retries only every 150 ms, so the many background writers on
#                     one SQLite file starve each other. 0 disables the pragma. MariaDB, MySQL and
#                     PostgreSQL ignore it (docs/areas/persistence.md).
#        Type: int
#        Default: 5000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.SqliteBusyTimeoutMs = 5000

#
#    Database.SqliteSynchronous
#        Description: SQLite only: the PRAGMA synchronous set on every connection, Full (default) or
#                     Normal. Full fsyncs the WAL at every commit, so a committed save survives
#                     power loss. Normal skips that fsync, which removes multi-second commit stalls
#                     on a slow disk (and the "database is locked" failures they cause in other
#                     writers); the database stays consistent, but the most recent commits can be
#                     lost on power loss or an OS crash, never on an application crash. Normal is
#                     applied only to a database that is in WAL mode (the schema bootstrap switches
#                     file databases to WAL, best effort): a database that is not in WAL mode (the
#                     switch failed or was refused) stays on Full and an error is logged, because
#                     Normal outside WAL can corrupt the database on power loss. Each component may
#                     override it with a Database:Auth, Database:Characters or Database:World
#                     SqliteSynchronous key. MariaDB, MySQL and PostgreSQL ignore it
#                     (docs/areas/persistence.md). Values: Full, Normal.
#        Type: SqliteSynchronousMode
#        Default: Full
#        Allowed: Full | Normal
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.SqliteSynchronous = Full

#
#    Database.SqliteWriteTimeoutMs
#        Description: SQLite only, characters database only: the longest (0..60000 ms, default 5000;
#                     rounded up to whole seconds) any command on a characters connection waits for
#                     another connection's write lock before it fails as "database is locked". It is
#                     written into the connection string's Default Timeout (30 s) when smaller, and
#                     replaces 0 (unlimited), so it bounds every command including EF's first one
#                     and its BEGIN IMMEDIATE, and through the busy-timeout clamp SQLite's own wait.
#                     Without it a writer holding the file for a minute held each save queue's
#                     single consumer for the full 30 s per attempt. Failed saves are retained and
#                     retried by their queues. 0 keeps the connection string's Default Timeout.
#                     MariaDB, MySQL and PostgreSQL ignore it (docs/areas/persistence.md).
#        Type: int
#        Default: 5000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.SqliteWriteTimeoutMs = 5000

#
#    Database.Upgrade.LockTimeoutSeconds
#        Description: How long a start waits for another process's schema work, in seconds; must be
#                     1..86400 or the start is refused as a configuration error.
#        Type: int
#        Default: 60
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.Upgrade.LockTimeoutSeconds = 60

#
#    Database.Upgrade.Policy
#        Description: What a start may do to the schema. Always (default) creates and upgrades;
#                     CreateOnly creates an empty database but refuses to upgrade an existing one
#                     (the retail-like setting for production, where arcane-db upgrade applies
#                     updates); Never only verifies. See docs/ops/database-upgrade.md. Values:
#                     Always, CreateOnly, Never.
#        Type: SchemaPolicy
#        Default: Always
#        Allowed: Always | CreateOnly | Never
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.Upgrade.Policy = Always

#
#    Database.Upgrade.ValidateOnly
#        Description: When true, serving nodes run startup schema checks in validate-only mode: zero
#                     DDL and zero seed inserts are executed, and startup fails closed if any
#                     component schema is missing, behind, or ahead of the build's current version.
#                     Default is false. See docs/ops/database-upgrade.md.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.Upgrade.ValidateOnly = false

#
#    Database.World.ConnectionString
#        Description: The connection string of this component's database. The shipped files carry
#                     the development placeholder user arcane; change it for any real deployment.
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.World.ConnectionString = ""

#
#    Database.World.Provider
#        Description: The relational engine of this component's database (Database:Auth,
#                     Database:Characters or Database:World). Values: MariaDb, MySql, PostgreSql,
#                     Sqlite.
#        Type: DatabaseProvider
#        Default: MariaDb
#        Allowed: MariaDb | MySql | PostgreSql | Sqlite
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.World.Provider = MariaDb

#
#    Database.World.SqliteBusyTimeoutMs
#        Description: SQLite only: this component's busy timeout in milliseconds (0..60000),
#                     overriding Database:SqliteBusyTimeoutMs. Unset inherits it. Other engines
#                     ignore it.
#        Type: int?
#        Default: (not set)
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
# Database.World.SqliteBusyTimeoutMs =

#
#    Database.World.SqliteSynchronous
#        Description: SQLite only: this component's PRAGMA synchronous (Full or Normal), overriding
#                     Database:SqliteSynchronous. Unset inherits it. Normal avoids the fsync stall
#                     at every commit but can lose the most recent commits on power loss or an OS
#                     crash; it is applied only when the database is in WAL mode, otherwise the
#                     database stays on Full and an error is logged. Other engines ignore it.
#                     Values: Full, Normal.
#        Type: SqliteSynchronousMode?
#        Default: (not set)
#        Allowed: Full | Normal
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
# Database.World.SqliteSynchronous =

###############################################################################
# DIAGNOSTICS
###############################################################################

#----------------------------------------------------------------------------
# Diagnostics
#----------------------------------------------------------------------------

#
#    Diagnostics.BeepOnException
#        Description: Emit a short console beep when the crash hooks or the fault ledger log an
#                     exception in an interactive console session (Environment.UserInteractive and
#                     standard error not redirected), rate-limited to at most one beep per second so
#                     a fault storm cannot stall or flood the terminal. Default off.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnostics
#
Diagnostics.BeepOnException = false

#
#    Diagnostics.BeepOnStartup
#        Description: Emit a short console beep when the daemon finishes starting in an interactive
#                     console session (Environment.UserInteractive and standard output not
#                     redirected), matching the classic MaNGOS BeepAtStart cue. Never beeps under a
#                     service, test runner or redirected output. Default off.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnostics
#
Diagnostics.BeepOnStartup = false

#
#    Diagnostics.BreakOnInvariant
#        Description: Stop in the debugger on a failed invariant (Debugger.Break). Only acts when a
#                     debugger is attached, so it is safe to leave on in a development
#                     configuration; default off, because an unattended process must never wait for
#                     a debugger prompt.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnostics
#
Diagnostics.BreakOnInvariant = false

#
#    Diagnostics.CrashDialog
#        Description: Show a dialog (a Win32 message box) when the process is about to end because
#                     of an unhandled exception, an unobserved task exception under an
#                     OnUnobservedTask policy that terminates, or a world tick hang the watchdog
#                     ends. It names the exception, its message and full stack with inner
#                     exceptions, the daemon and version, thread, time, fault-ledger site and
#                     signature, and the crash report file (a crash-report.*.txt file written next
#                     to the daemon), crash journal and log file. It appears after the crash is
#                     logged and recorded, and the exit policy runs when it is closed. Only a
#                     Windows console session with no redirected standard stream, outside CI, opens
#                     one; a service, test run, redirected or non-Windows process is unaffected.
#                     Default off: an unattended process must never wait on a dialog.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnostics
#
Diagnostics.CrashDialog = false

#
#    Diagnostics.FaultDialog
#        Description: Also show a dialog the first time each fault signature is caught and survived
#                     (the fault ledger, .server faults), on a background thread so the faulting
#                     thread never waits, at most one open at a time (faults while one is open are
#                     only logged). Needs the same interactive Windows console session as
#                     CrashDialog; takes effect once the host has started. Default off: a fault
#                     storm of new signatures still means one box after another.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnostics
#
Diagnostics.FaultDialog = false

#
#    Diagnostics.FaultLogLimit
#        Description: How many occurrences of one fault (an exception type thrown from one place,
#                     caught at one of the server's catch-and-log sites) are logged in full. After
#                     that the site logs that fault at most once a minute, with "(N more since)";
#                     every occurrence is still counted in the fault ledger (.server faults, the
#                     arcanecore_faults_total metric). 0 logs the first occurrence and then once a
#                     minute. Default 10.
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnostics
#
Diagnostics.FaultLogLimit = 10

#
#    Diagnostics.FaultMaxSignatures
#        Description: How many distinct faults the fault ledger keeps. A fault beyond the cap is
#                     counted into one overflow entry, never dropped. Default 512; a lower value
#                     bounds memory on a server that throws a new exception signature per request.
#        Type: int
#        Default: 512
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnostics
#
Diagnostics.FaultMaxSignatures = 512

#
#    Diagnostics.FirstChanceExceptions
#        Description: Log every exception at the moment it is thrown
#                     (AppDomain.FirstChanceException), before any handler sees it, at Debug level.
#                     A development aid for finding swallowed exceptions; it is honoured only by a
#                     Debug build of the Kernel (the hook is compiled out of Release), where a
#                     Release daemon logs once that the key is ignored. Default off: the hook runs
#                     on every throw, caught or not.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnostics
#
Diagnostics.FirstChanceExceptions = false

#
#    Diagnostics.InvariantLogLimit
#        Description: How many failures of one invariant (one call site) are written to the log;
#                     later failures of that site are only counted (the counters are part of every
#                     crash report). 0 logs none, every failure is still counted. Default 10: a
#                     hot-path check that fails per packet cannot flood the log.
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnostics
#
Diagnostics.InvariantLogLimit = 10

#
#    Diagnostics.OnInvariant
#        Description: What a failed Invariant.Check (the release-mode check) does after it is logged
#                     and counted. Continue (default): the caller goes on with its own fail-closed
#                     handling (refuse the packet, drop the connection, throw). FailFast: the
#                     process aborts at once with the message, as the mangos MANGOS_ASSERT macro
#                     does in every build. Debug-build Invariant.Assert throws
#                     InvariantViolationException under Continue and aborts under FailFast. Values:
#                     Continue, FailFast.
#        Type: InvariantPolicy
#        Default: Continue
#        Allowed: Continue | FailFast
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnostics
#
Diagnostics.OnInvariant = Continue

#
#    Diagnostics.OnUnhandled
#        Description: What ends the process after an unhandled exception
#                     (AppDomain.UnhandledException): the report is always written first. FailFast
#                     (default): Environment.FailFast, which is what the runtime does on its own;
#                     the process aborts (exit status 134, SIGABRT, on Linux; 0x80131623 / Watson on
#                     Windows) and a dump is written when DOTNET_DbgEnableMiniDump=1. Exit:
#                     Environment.Exit(70) (ExitCodes.UnhandledException, sysexits EX_SOFTWARE), an
#                     exit code a supervisor can match; no dump. Values: FailFast, Exit.
#        Type: UnhandledExceptionPolicy
#        Default: FailFast
#        Allowed: FailFast | Exit
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnostics
#
Diagnostics.OnUnhandled = FailFast

#
#    Diagnostics.OnUnobservedTask
#        Description: What an exception a faulted Task nobody awaited does when the finalizer finds
#                     it (TaskScheduler.UnobservedTaskException). Log (default): the report is
#                     written and the exception marked observed, which is the .NET runtime's own
#                     behaviour (since .NET 4.5) made visible. Exit and FailFast end the process as
#                     OnUnhandled describes. Values: Log, Exit, FailFast.
#        Type: UnobservedTaskPolicy
#        Default: Log
#        Allowed: Log | Exit | FailFast
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnostics
#
Diagnostics.OnUnobservedTask = Log

#----------------------------------------------------------------------------
# Diagnostics:PacketCapture
#----------------------------------------------------------------------------

#
#    Diagnostics.PacketCapture.Directory
#        Description: Directory for new traces; generated filenames do not include player input.
#        Type: string
#        Default: "packet-captures"
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnosticspacketcapture
#
Diagnostics.PacketCapture.Directory = "packet-captures"

#
#    Diagnostics.PacketCapture.Enabled
#        Description: Permit an Administrator to start a session capture. Default false.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnosticspacketcapture
#
Diagnostics.PacketCapture.Enabled = false

#
#    Diagnostics.PacketCapture.MaxBytes
#        Description: Maximum bytes in one trace, including its header; a full trace stops
#                     automatically. A trace also stops when the disk writer falls 8192 records
#                     behind. Records are written by a background writer and the file is finished
#                     asynchronously after a stop; the server drains open traces at shutdown.
#        Type: long
#        Default: 67108864
#        Allowed: a whole number, -9223372036854775808 to 9223372036854775807
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnosticspacketcapture
#
Diagnostics.PacketCapture.MaxBytes = 67108864

###############################################################################
# ECONOMY
###############################################################################

#----------------------------------------------------------------------------
# Economy
#----------------------------------------------------------------------------

#
#    Economy.AllowCrossTeamMail
#        Description: Whether players of opposite teams may mail each other (vmangos
#                     CONFIG_BOOL_ALLOW_TWO_SIDE_INTERACTION_MAIL).
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#economy
#
Economy.AllowCrossTeamMail = false

#
#    Economy.AllowCrossTeamTrade
#        Description: Whether players of opposite teams may trade (vmangos
#                     CONFIG_BOOL_ALLOW_TWO_SIDE_TRADE).
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#economy
#
Economy.AllowCrossTeamTrade = false

#
#    Economy.AllowDeleteWithAttachments
#        Description: Letters with an item or money may be deleted by the receiver, destroying the
#                     attachment, as vmangos does (MailHandler.cpp:469-491 refuses only cash on
#                     delivery). Default false: only emptied letters can be deleted, the pre-lane
#                     behaviour, since no retail source shows attachments being destroyable.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#economy
#
Economy.AllowDeleteWithAttachments = false

#
#    Economy.AuctionAccountConcurrentLimit
#        Description: Active auctions one account may hold per auction house (vmangos
#                     Auction.AccountConcurrentLimit, World.cpp:538,
#                     AuctionHouseHandler.cpp:274-280). A listing counts from acceptance: while it
#                     settles, and while an unknown outcome is recovered. 0 = unlimited (default).
#        Type: uint
#        Default: 0
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#economy
#
Economy.AuctionAccountConcurrentLimit = 0

#
#    Economy.AuctionDepositMin
#        Description: Minimum deposit in copper (vmangos CONFIG_UINT32_AUCTION_DEPOSIT_MIN, default
#                     0).
#        Type: uint
#        Default: 0
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#economy
#
Economy.AuctionDepositMin = 0

#
#    Economy.AuctionHouses
#        Description: The three houses: Alliance 2, Horde 6, neutral (Blackwater/goblin) 7, with the
#                     deposit and cut percentages of the build-5875 client AuctionHouse.dbc
#                     (m_depositRate, m_consignmentRate), which vmangos reads: 5/5 for both faction
#                     houses, 25/15 for the neutral one.
#        Type: List<AuctionHouseEntry>
#        Default: 0:CutPercent = 5; 0:DepositPercent = 5; 0:Id = 2; 1:CutPercent = 5;
#                 1:DepositPercent = 5; 1:Id = 6; 2:CutPercent = 15; 2:DepositPercent = 25; 2:Id = 7
#        Allowed: a list: numbered keys 0, 1, 2, ...; each entry is a group of keys
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#economy
#
# These entries are the default list. They are commented out because a list you write is appended to the default list, not
# substituted for it; uncomment them only to document the list, or set the keys of the entries you want to add.
# Economy.AuctionHouses.0.CutPercent = 5
# Economy.AuctionHouses.0.DepositPercent = 5
# Economy.AuctionHouses.0.Id = 2
# Economy.AuctionHouses.1.CutPercent = 5
# Economy.AuctionHouses.1.DepositPercent = 5
# Economy.AuctionHouses.1.Id = 6
# Economy.AuctionHouses.2.CutPercent = 15
# Economy.AuctionHouses.2.DepositPercent = 25
# Economy.AuctionHouses.2.Id = 7

#
#    Economy.AuctionRateCut
#        Description: Rate.Auction.Cut multiplier (vmangos World.cpp:536, default 1.0).
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#economy
#
Economy.AuctionRateCut = 1

#
#    Economy.AuctionRateDeposit
#        Description: Rate.Auction.Deposit multiplier (vmangos World.cpp:535, default 1.0).
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#economy
#
Economy.AuctionRateDeposit = 1

#
#    Economy.AuctionRateTime
#        Description: Rate.Auction.Time multiplier of a listing's duration (vmangos World.cpp:534,
#                     AuctionHouseHandler.cpp:362; default 1.0).
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#economy
#
Economy.AuctionRateTime = 1

#
#    Economy.AuctionSilentRefusals
#        Description: A bid the bidder cannot afford, or a cancellation whose cut the seller cannot
#                     pay, is answered with nothing, as vmangos does
#                     (AuctionHouseHandler.cpp:498-503, 592-594); false answers NOT_ENOUGH_MONEY.
#                     Default true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#economy
#
Economy.AuctionSilentRefusals = true

#
#    Economy.CodExpireDays
#        Description: Days before a cash-on-delivery letter expires (vmangos: 3).
#        Type: uint
#        Default: 3
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#economy
#
Economy.CodExpireDays = 3

#
#    Economy.ExpirySweepSeconds
#        Description: Seconds between expiry sweeps of mail and auctions.
#        Type: uint
#        Default: 60
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#economy
#
Economy.ExpirySweepSeconds = 60

#
#    Economy.LetterItemEntry
#        Description: The Plain Letter item created by CMSG_MAIL_CREATE_TEXT_ITEM (vmangos
#                     MAIL_BODY_ITEM_TEMPLATE 8383).
#        Type: uint
#        Default: 8383
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#economy
#
Economy.LetterItemEntry = 8383

#
#    Economy.MailBodyMaxLength
#        Description: Longest body in bytes; longer ones are dropped (vmangos MailHandler.cpp:158:
#                     500).
#        Type: int
#        Default: 500
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#economy
#
Economy.MailBodyMaxLength = 500

#
#    Economy.MailDeliveryDelaySeconds
#        Description: Delivery delay of letters carrying an item or money, seconds (vmangos
#                     MailDeliveryDelay, World.cpp:691: 1 hour).
#        Type: uint
#        Default: 3600
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#economy
#
Economy.MailDeliveryDelaySeconds = 3600

#
#    Economy.MailExpireDays
#        Description: Days before an ordinary letter expires (vmangos: 30).
#        Type: uint
#        Default: 30
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#economy
#
Economy.MailExpireDays = 30

#
#    Economy.MailMaxCodCopper
#        Description: Largest cash-on-delivery amount accepted, copper (vmangos MailHandler.cpp:162:
#                     100,000,000).
#        Type: uint
#        Default: 100000000
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#economy
#
Economy.MailMaxCodCopper = 100000000

#
#    Economy.MailOversizeAnswersError
#        Description: Answer oversize or over-COD letters with an internal error instead of dropping
#                     them silently like vmangos (default false).
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#economy
#
Economy.MailOversizeAnswersError = false

#
#    Economy.MailPostage
#        Description: Postage per letter in copper (vmangos HandleSendMail: 30).
#        Type: uint
#        Default: 30
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#economy
#
Economy.MailPostage = 30

#
#    Economy.MailReadExpiryDays
#        Description: Reading a letter shortens its remaining life to this many days when more
#                     remains (vmangos MailHandler.cpp:454-458: 3; 0 disables).
#        Type: uint
#        Default: 3
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#economy
#
Economy.MailReadExpiryDays = 3

#
#    Economy.MailSubjectMaxLength
#        Description: Longest subject in bytes; longer ones are dropped (vmangos
#                     MailHandler.cpp:155: 64).
#        Type: int
#        Default: 64
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#economy
#
Economy.MailSubjectMaxLength = 64

#
#    Economy.MailboxAccess
#        Description: Mailbox proof for every mail opcode; MailboxAccessMode.Retail (default) or
#                     MailboxAccessMode.Permissive (config key Economy:MailboxAccess). Values:
#                     Retail, Permissive.
#        Type: MailboxAccessMode
#        Default: Retail
#        Allowed: Retail | Permissive
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#economy
#
Economy.MailboxAccess = Retail

#
#    Economy.MaxMailboxSize
#        Description: A recipient already holding MORE than this many letters is refused (vmangos
#                     MailHandler.cpp:258: count &gt; 100).
#        Type: int
#        Default: 100
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#economy
#
Economy.MaxMailboxSize = 100

#
#    Economy.NeutralAuctioneerFactions
#        Description: Faction.dbc ids of auctioneers that serve the neutral house (Booty Bay 21,
#                     Gadgetzan 369, Everlook 577: the factions of vmangos's goblin templates
#                     120/474/855).
#        Type: List<uint>
#        Default: 0 = 21; 1 = 369; 2 = 577
#        Allowed: a list: numbered keys 0, 1, 2, ...; each value is a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#economy
#
# These entries are the default list. They are commented out because a list you write is appended to the default list, not
# substituted for it; uncomment them only to document the list, or set the keys of the entries you want to add.
# Economy.NeutralAuctioneerFactions.0 = 21
# Economy.NeutralAuctioneerFactions.1 = 369
# Economy.NeutralAuctioneerFactions.2 = 577

#
#    Economy.ReturnExpiredMoneyOnlyMail
#        Description: Also return an expired money-only player letter to its sender (default true,
#                     the pre-lane behaviour; no retail source shows otherwise). false matches the
#                     emulators: vmangos and mangos-classic delete it (ObjectMgr.cpp:6995-7000: only
#                     letters with items are returned).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#economy
#
Economy.ReturnExpiredMoneyOnlyMail = true

#
#    Economy.SettlementBudgetSeconds
#        Description: Seconds one economy settlement (auction, mail, trade) may take end to end, and
#                     one economy store read, before it is abandoned: an operation that did not
#                     commit is answered with its ordinary failure reply (auction DATABASE error,
#                     mail INTERNAL_ERROR, trade cancelled), one whose outcome cannot be read kicks
#                     its actors. Operational, not a gameplay rule: 15 is the shipped value, three
#                     typical lock waits of the shipped 5 s Database:SqliteWriteTimeoutMs in a row
#                     (an unrelated character's write already in flight on the character save
#                     queue's one consumer, the actors' own saves, the settlement transaction), so
#                     one locked write ahead of it cannot use up the budget. A write-gate wait is
#                     not capped at one bound: it gives up after 5 s without a hand-off or 20 s of
#                     active waiting, but the settlement's budget token ends any wait it is passed
#                     to earlier. Valid range 1-300.
#        Type: int
#        Default: 15
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#economy
#
Economy.SettlementBudgetSeconds = 15

#
#    Economy.TradeScamPreventionMs
#        Description: Scam-prevention delay after a trade modification before an accept counts, ms
#                     (vmangos TradeHandler.cpp:657-658: 200; 0 = off).
#        Type: uint
#        Default: 200
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#economy
#
Economy.TradeScamPreventionMs = 200

#
#    Economy.TradeScamPreventionWholeSeconds
#        Description: Measure the delay in whole seconds like vmangos (time(nullptr): effectively
#                     "not within the same second"); false uses real milliseconds (a true 200 ms).
#                     Default true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#economy
#
Economy.TradeScamPreventionWholeSeconds = true

#
#    Economy.TradeSpaceNotifications
#        Description: Report not enough gold / bag space with notifications 801-803 and keep the
#                     window open, as vmangos does (TradeHandler.cpp:274-290, 420-455); false closes
#                     the trade with the inventory error. Default true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#economy
#
Economy.TradeSpaceNotifications = true

