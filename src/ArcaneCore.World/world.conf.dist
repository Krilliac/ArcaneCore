#                     are running (GameEventFeature, docs/areas/game-events-weather.md). Default
#                     none: an operator override for a world that runs no event service or wants an
#                     event forced on for its conditions only.
#        Type: uint[]
#        Default: (empty list)
#        Allowed: a list: numbered keys 0, 1, 2, ...; each value is a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#conditions
#
# Empty by default.
# Conditions.ActiveGameEvents.0 =

#
#    Conditions.ActiveHolidays
#        Description: Holiday ids reported active to CONDITION_ACTIVE_HOLIDAY
#                     (Conditions.cpp:318-321) in addition to the running events' holidays; default
#                     none, same override.
#        Type: uint[]
#        Default: (empty list)
#        Allowed: a list: numbered keys 0, 1, 2, ...; each value is a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#conditions
#
# Empty by default.
# Conditions.ActiveHolidays.0 =

###############################################################################
# CRAFTING
###############################################################################

#----------------------------------------------------------------------------
# Crafting
#----------------------------------------------------------------------------

#
#    Crafting.Enabled
#        Description: false leaves crafting (reagent check, tool check and the CREATE_ITEM effect)
#                     and profession-specialization gossip unregistered (read once by
#                     CraftingFeature); unset or unparsable keeps crafting enabled, the retail
#                     behaviour.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#keys-read-by-name
#
Crafting.Enabled = true

