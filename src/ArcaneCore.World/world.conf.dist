#    World.Playerbots.Combat.Kite.HealthPct
#        Description: A bot kites once its health falls to this percentage (10..95).
#        Type: float
#        Default: 50
#        Allowed: a number, '.' is the decimal point
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Combat.Kite.HealthPct = 50

