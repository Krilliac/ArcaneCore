#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.ThinkBudgetMaxMs = 30

#
#    World.Playerbots.ThinkBudgetMinMs
#        Description: The least wall time (ms, 1..200) a world tick spends on the bots' thinks,
#                     however loaded the tick is: the guarantee that a busy server still thinks
#                     (PlayerbotThinkBudget). At least one bot always thinks per tick. Equal to
#                     ThinkBudgetMaxMs it is a fixed budget. Raised, up to ThinkBudgetMaxMs, to what
#                     walking every bot within ThinkStarvedGapMs takes at the measured cost of a
#                     think (PlayerbotThinkBudget.CoverageMs): 8 ms covers about 400 bots (1.3 ms a
#                     visit, 50 ms ticks, 3 ms of fights) and 1000 bots need about 16 ms, up to the
#                     ceiling: the bots then take more of each tick. The walk is sized from the
#                     configured tick interval, not the real one: a real tick longer than the
#                     configured one does not raise the budget (that would slow the ticks further),
#                     so a full pass of the bots then takes longer than the bound it was sized for
#                     (1000 bots at about 10 bots a tick: 8 to 30 s at 80 to 260 ms ticks). The
#                     motion lease and the think-starved report follow the measured pass instead
#                     (ThinkStarvedGapMs).
#        Type: double
#        Default: 8
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.ThinkBudgetMinMs = 8

#
#    World.Playerbots.ThinkBudgetTickShare
#        Description: The share (0.05..0.95) of a tick's slack (tick interval minus the time the
#                     world spent on everything but the bots) the bots' work may take; the think
#                     budget is this share of the slack less what the bots already used this tick,
#                     between the min and the max.
#        Type: double
#        Default: 0.6
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.ThinkBudgetTickShare = 0.6

#
#    World.Playerbots.ThinkIntervalMs
#        Description: Milliseconds between two decisions of a bot (50..60000).
#        Type: int
#        Default: 500
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.ThinkIntervalMs = 500

#
#    World.Playerbots.ThinkStarvedGapMs
#        Description: A bot that goes longer than this many milliseconds (1000..3600000) of world
#                     time without a think is reported once per episode as a "cadence think-starved"
#                     anomaly (PlayerbotAnomalies); 0 turns the report off. The default is the ghost
#                     walk's stuck bound (PlayerbotRecovery.StuckMs). The report fires only for a
#                     bot that falls behind the rotation: its bound is the larger of this value and
#                     1.5 times the measured time of a full pass of the main think lane (three times
#                     this value until a pass is measured), so a rotation that is slow for every bot
#                     alike raises nothing. The think budget is still sized from this value
#                     unraised.
#        Type: int
#        Default: 10000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.ThinkStarvedGapMs = 10000

#
#    World.Playerbots.Travel.AreaTriggers
#        Description: Let bots walk into same-map teleport triggers as a leg (Teldrassil's Darnassus
#                     and Rut'theran portals; on by default).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Travel.AreaTriggers = true

#
#    World.Playerbots.Travel.Boats
#        Description: Let bots ride the boats (Menethil - Auberdine, Menethil - Theramore, Auberdine
#                     - Rut'theran, Booty Bay - Ratchet; on by default).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Travel.Boats = true

#
#    World.Playerbots.Travel.Enabled
#        Description: Let bots plan multi-leg trips to far places (on by default). Off: no trip is
#                     planned and a far goal stays where its caller leaves it.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Travel.Enabled = true

#
#    World.Playerbots.Travel.Hearthstone
#        Description: Let bots use their hearthstone (item 6948) as a leg when it is off cooldown
#                     and the bind point is on the way (on by default).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Travel.Hearthstone = true

#
#    World.Playerbots.Travel.MageService
#        Description: Let mage bots offer their Teleport and Portal spells as a service (on by
#                     default): a mage teleports itself, and opens a portal for a bot of its faction
#                     that asks on the in-world request board. Off: no mage teleports for travel and
#                     no portal is asked for or opened.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Travel.MageService = true

#
#    World.Playerbots.Travel.MageServiceFeeCopper
#        Description: Copper a requester pays the mage for a portal, by a real trade of money
#                     (0..100000; default 0: the service is free). The portal is planned only when
#                     the bot can pay it inside MaxTravelSpendCopper.
#        Type: uint
#        Default: 0
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Travel.MageServiceFeeCopper = 0

#
#    World.Playerbots.Travel.MageServiceRadiusYards
#        Description: A bot asks for a portal only from a mage within this many yards of it, on its
#                     map (10..1000; default 150).
#        Type: float
#        Default: 150
#        Allowed: a number, '.' is the decimal point
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Travel.MageServiceRadiusYards = 150

#
#    World.Playerbots.Travel.MaxTravelSpendCopper
#        Description: The most copper one trip may spend on fares, fees and reagents together
#                     (0..10000000; default 10000, one gold). 0: only free means (walking, boats,
#                     zeppelins, the tram, lifts, the hearthstone, a free portal, the bot's own
#                     teleport when it has the rune).
#        Type: uint
#        Default: 10000
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Travel.MaxTravelSpendCopper = 10000

#
#    World.Playerbots.Travel.TransitBackoffMaxSeconds
#        Description: The longest wait (seconds) before a failed transit point is tried again
#                     (10..86400; default 300). Must not be below TransitBackoffSeconds.
#        Type: int
#        Default: 300
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Travel.TransitBackoffMaxSeconds = 300

#
#    World.Playerbots.Travel.TransitBackoffSeconds
#        Description: The first wait (seconds) before a bot tries a transit point again (one flight
#                     master's node, tram platform, lift, dock) that just failed it; each further
#                     failure of the same point doubles the wait up to TransitBackoffMaxSeconds
#                     (10..3600; default 60).
#        Type: int
#        Default: 60
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Travel.TransitBackoffSeconds = 60

#
#    World.Playerbots.Travel.Zeppelins
#        Description: Let Horde bots ride the zeppelins (Orgrimmar - Undercity, Orgrimmar -
#                     Grom'gol, Undercity - Grom'gol; on by default).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Travel.Zeppelins = true

#----------------------------------------------------------------------------
# World:Playerbots:Qa
#----------------------------------------------------------------------------

#
#    World.Playerbots.Qa.AutoPruneHours
#        Description: Hours after which a finding not seen again is forgotten on every pass, counted
#                     from the later of its last sighting and the server start (so a restart prunes
#                     nothing at once). A finding that holds a GitHub issue is never forgotten, and
#                     GitHub is never touched. 0 (default) is off; the same as .playerbot qa prune
#                     #hours (0..8760).
#        Type: int
#        Default: 0
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.AutoPruneHours = 0

#
#    World.Playerbots.Qa.Directory
#        Description: The folder of the findings file, the exports (report.md, report.json) and the
#                     dry-run issues (pending-issues/): relative to the profile folder, or absolute.
#        Type: string
#        Default: "qa"
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.Directory = "qa"

#
#    World.Playerbots.Qa.Enabled
#        Description: Aggregate the bot stall, death-loop, fault and missing-data warnings into
#                     findings (on by default; it is cheap and never touches the world thread).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.Enabled = true

#
#    World.Playerbots.Qa.ExportIntervalSeconds
#        Description: Seconds between two passes that save the findings, write the exports and
#                     publish (10..86400).
#        Type: int
#        Default: 300
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.ExportIntervalSeconds = 300

#
#    World.Playerbots.Qa.GitHub.AutoCloseMinQuietHours
#        Description: The least quiet time, in hours, before AutoCloseQuietMultiple may close an
#                     issue (1..8760, default 72), whatever the finding's usual gap.
#        Type: int
#        Default: 72
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.GitHub.AutoCloseMinQuietHours = 72

#
#    World.Playerbots.Qa.GitHub.AutoCloseQuietMultiple
#        Description: Close an open issue as completed when its finding has stopped: it was last
#                     seen on an older build, the running build is newer and has not met it, and it
#                     has been quiet (since the later of its last sighting and the reporter's start)
#                     for this many times its usual gap between occurrences ((last seen - first
#                     seen) / (count - 1)) and at least AutoCloseMinQuietHours. One comment says
#                     why; a recurrence on any later build counts as a regression of the build it
#                     was last seen on and reopens it (ReopenOnRegression). 0 (default) is off
#                     (0..1000). Quiet is not proof: a finding the bots simply stopped visiting
#                     looks the same.
#        Type: int
#        Default: 0
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.GitHub.AutoCloseQuietMultiple = 0

#
#    World.Playerbots.Qa.GitHub.CloseAbsorbedDuplicates
#        Description: When findings are merged into one (the same problem met in several places) and
#                     each had its own issue, comment on the absorbed issue with a link to the
#                     surviving one and close it as not planned (a duplicate). Off (the default, so
#                     the first start after an upgrade can be checked: the start-up log lists every
#                     issue it would close, each with the surviving issue) keeps the absorbed issue
#                     open and untouched; the merge is recorded in the store either way.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.GitHub.CloseAbsorbedDuplicates = false

#
#    World.Playerbots.Qa.GitHub.CommentIntervalHours
#        Description: At most one comment per finding in this many hours (1..720).
#        Type: int
#        Default: 24
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.GitHub.CommentIntervalHours = 24

#
#    World.Playerbots.Qa.GitHub.Enabled
#        Description: Report findings to GitHub (off by default). Enabled without Publish is a dry
#                     run: no network call is made.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.GitHub.Enabled = false

#
#    World.Playerbots.Qa.GitHub.GhPassToken
#        Description: For GhCli only: hand the token from TokenEnvironmentVariable to gh as GH_TOKEN
#                     (off by default: GITHUB_TOKEN and GH_TOKEN are removed from the child so gh
#                     uses its own login).
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.GitHub.GhPassToken = false

#
#    World.Playerbots.Qa.GitHub.GhPath
#        Description: The gh executable for Transport = GhCli: a file name looked up on PATH (gh) or
#                     a full path (1..260 characters).
#        Type: string
#        Default: "gh"
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.GitHub.GhPath = "gh"

#
#    World.Playerbots.Qa.GitHub.KindLabels
#        Description: Add a per-kind label (bot-qa:spell-unsupported, bot-qa:death-loop, ...) to
#                     created issues besides Labels (off by default: the gh transport refuses a
#                     label that does not exist yet, so create the labels in the repository first).
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.GitHub.KindLabels = false

#
#    World.Playerbots.Qa.GitHub.Labels
#        Description: The labels put on created issues; the first one is also how existing issues
#                     are listed (1..10 labels; a configured list replaces the default).
#        Type: string[]
#        Default: 0 = bot-qa
#        Allowed: a list: numbered keys 0, 1, 2, ...; each value is text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
# These entries are the default list. They are commented out because a list you write is appended to the default list, not
# substituted for it; uncomment them only to document the list, or set the keys of the entries you want to add.
# World.Playerbots.Qa.GitHub.Labels.0 = "bot-qa"

#
#    World.Playerbots.Qa.GitHub.MaxCommentsPerHour
#        Description: The most comments added per rolling hour (0..1000; 0 adds none).
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.GitHub.MaxCommentsPerHour = 10

#
#    World.Playerbots.Qa.GitHub.MaxIssuesPerHour
#        Description: The most issues created per rolling hour (0..1000; 0 creates none); the rest
#                     stay pending.
#        Type: int
#        Default: 5
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.GitHub.MaxIssuesPerHour = 5

#
#    World.Playerbots.Qa.GitHub.MaxListPages
#        Description: The most 100-issue pages read when looking for an existing issue (1..100).
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.GitHub.MaxListPages = 10

#
#    World.Playerbots.Qa.GitHub.MaxSpellIssuesPerDay
#        Description: The most spell issues created per rolling 24 hours (0..1000; 0 creates none),
#                     saved with the hourly caps.
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.GitHub.MaxSpellIssuesPerDay = 10

#
#    World.Playerbots.Qa.GitHub.MaxSpellIssuesPerPass
#        Description: The most spell issues (spell unsupported, refused, no effect) created in one
#                     publish pass (0..100; 0 creates none). Spell findings can be numerous on a
#                     first run; the hourly MaxIssuesPerHour still applies on top.
#        Type: int
#        Default: 2
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.GitHub.MaxSpellIssuesPerPass = 2

#
#    World.Playerbots.Qa.GitHub.MaxStatusEditsPerHour
#        Description: The most live-status body edits per rolling hour (0..1000; 0 makes none),
#                     saved with the hourly caps.
#        Type: int
#        Default: 30
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.GitHub.MaxStatusEditsPerHour = 30

#
#    World.Playerbots.Qa.GitHub.MinDistinctBots
#        Description: A finding caused by bots is reported once this many different bots met it
#                     (1..10000); data findings of creature scripts are exempt.
#        Type: int
#        Default: 2
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.GitHub.MinDistinctBots = 2

#
#    World.Playerbots.Qa.GitHub.MinOccurrences
#        Description: A finding is reported once it was seen this many times (1..1000000).
#        Type: int
#        Default: 3
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.GitHub.MinOccurrences = 3

#
#    World.Playerbots.Qa.GitHub.Publish
#        Description: Really create issues and comments (off by default = dry run: the would-be
#                     issues are written to qa/pending-issues/ and logged, nothing is sent).
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.GitHub.Publish = false

#
#    World.Playerbots.Qa.GitHub.ReopenClosed
#        Description: Reopen a finding's issue when it was closed and the finding keeps happening
#                     (off by default: a closed issue is recorded as known and left alone).
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.GitHub.ReopenClosed = false

#
#    World.Playerbots.Qa.GitHub.ReopenOnRegression
#        Description: Reopen a closed issue, with one comment (the new build, the occurrences on it,
#                     the distinct bots and a sample), when its finding recurs on a build other than
#                     the one it was observed closed on (a regression; a recurrence on the same
#                     build is a person's won't-fix and is left alone). Acts only while publishing
#                     is on, under the comment cap; never closes anything.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.GitHub.ReopenOnRegression = true

#
#    World.Playerbots.Qa.GitHub.Repository
#        Description: The repository, owner/repo (required while enabled).
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.GitHub.Repository = ""

#
#    World.Playerbots.Qa.GitHub.RequestTimeoutSeconds
#        Description: Seconds one GitHub request may take (1..120).
#        Type: int
#        Default: 15
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.GitHub.RequestTimeoutSeconds = 15

#
#    World.Playerbots.Qa.GitHub.StatusUpdateMinutes
#        Description: Keep a live status block at the top of each open issue's body (last seen UTC,
#                     occurrences in all and on the running build, distinct bots), rewritten when
#                     the finding was seen again at least this many minutes after the time the block
#                     shows (0..10080; 0 is off). Comments come at most every CommentIntervalHours,
#                     so without it GitHub's view of when a finding last happened lags by up to a
#                     day; with it the lag is at most this long. A body edit sends no notification;
#                     edits are capped by MaxStatusEditsPerHour.
#        Type: int
#        Default: 60
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.GitHub.StatusUpdateMinutes = 60

#
#    World.Playerbots.Qa.GitHub.TokenEnvironmentVariable
#        Description: The name of the environment variable that holds a fine-grained token with
#                     Issues read and write on the repository (the value is never read from
#                     configuration and never logged).
#        Type: string
#        Default: "ARCANECORE_GITHUB_TOKEN"
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.GitHub.TokenEnvironmentVariable = "ARCANECORE_GITHUB_TOKEN"

#
#    World.Playerbots.Qa.GitHub.Transport
#        Description: How issues are read and written: Rest (default; the GitHub REST API with the
#                     token from TokenEnvironmentVariable) or GhCli (runs the gh tool with an
#                     argument list and no shell, using the login of the user the server runs as;
#                     the token variable is not needed). Values: Rest, GhCli.
#        Type: PlayerbotQaGitHubTransport
#        Default: Rest
#        Allowed: Rest | GhCli
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.GitHub.Transport = Rest

#
#    World.Playerbots.Qa.MaxFindings
#        Description: The most findings kept (10..100000); beyond it an unpublished finding is
#                     dropped, a one-off of a single bot first, then the lowest severity, then the
#                     oldest. A published or known-closed finding is never dropped.
#        Type: int
#        Default: 2000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.MaxFindings = 2000

#
#    World.Playerbots.Qa.MaxSamples
#        Description: The newest evidence samples kept per finding (1..20).
#        Type: int
#        Default: 5
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.MaxSamples = 5

#
#    World.Playerbots.Qa.SignalQueueCapacity
#        Description: Warnings waiting for the aggregator at once (64..1000000); a full queue drops
#                     the oldest and counts it.
#        Type: int
#        Default: 4096
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.SignalQueueCapacity = 4096

#
#    World.Playerbots.Qa.StaleHours
#        Description: Hours after which a finding not seen again and not published or known-closed
#                     is dropped, on load and on every pass (0..8760; 0 keeps them for ever).
#        Type: int
#        Default: 24
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.StaleHours = 24

#
#    World.Playerbots.Qa.TickHangWarmupMinutes
#        Description: Minutes after the world starts ticking during which a tick hang is not
#                     reported to QA (start-up: cold grids, JIT, loading). 0 reports from the first
#                     tick (0..1440, default 5).
#        Type: int
#        Default: 5
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbotsqa
#
World.Playerbots.Qa.TickHangWarmupMinutes = 5

#----------------------------------------------------------------------------
# World:RemoteAdmin
#----------------------------------------------------------------------------

#
#    World.RemoteAdmin.AgentLoginFile
#        Description: A file the daemon writes a fresh random token to at start; @token
#                     &lt;token&gt; logs in as the console (Administrator) without an account, for
#                     automation running as the same OS user (the file is readable by whoever can
#                     read the daemon's directory). Relative paths are under the daemon's base
#                     directory. Empty: token login off.
#        Type: string
#        Default: "ra-token.txt"
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldremoteadmin
#
World.RemoteAdmin.AgentLoginFile = "ra-token.txt"

#
#    World.RemoteAdmin.BindAddress
#        Description: The address to listen on. Default 127.0.0.1: only this machine can connect.
#                     Any other address exposes a clear-text protocol (passwords included) to the
#                     network; the daemon logs a warning when it is not a loopback address.
#        Type: string
#        Default: "127.0.0.1"
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldremoteadmin
#
World.RemoteAdmin.BindAddress = "127.0.0.1"

#
#    World.RemoteAdmin.CommandTimeoutSeconds
#        Description: Seconds a command that holds itself open (.botctl wait, .botctl run) may run
#                     before RA reports #done error timeout and reads the next line (the command
#                     itself goes on).
#        Type: int
#        Default: 1800
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldremoteadmin
#
World.RemoteAdmin.CommandTimeoutSeconds = 1800

#
#    World.RemoteAdmin.Enabled
#        Description: Listen for RA connections. Default on (loopback only, see BindAddress).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldremoteadmin
#
World.RemoteAdmin.Enabled = true

#
#    World.RemoteAdmin.FailedLoginDelayMs
#        Description: The delay before answering a wrong login.
#        Type: int
#        Default: 1000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldremoteadmin
#
World.RemoteAdmin.FailedLoginDelayMs = 1000

#
#    World.RemoteAdmin.IdleTimeoutSeconds
#        Description: Seconds a logged-in connection may stay silent (no command, no running
#                     command) before it is closed. 0: never.
#        Type: int
#        Default: 3600
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldremoteadmin
#
World.RemoteAdmin.IdleTimeoutSeconds = 3600

#
#    World.RemoteAdmin.LoginTimeoutSeconds
#        Description: Seconds a connection has to log in.
#        Type: int
#        Default: 60
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldremoteadmin
#
World.RemoteAdmin.LoginTimeoutSeconds = 60

#
#    World.RemoteAdmin.MaxConnections
#        Description: Concurrent connections; one more is refused with a message.
#        Type: int
#        Default: 8
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldremoteadmin
#
World.RemoteAdmin.MaxConnections = 8

#
#    World.RemoteAdmin.MaxFailedLogins
#        Description: Wrong logins a connection may make before it is closed (each one delayed by
#                     FailedLoginDelayMs).
#        Type: int
#        Default: 3
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldremoteadmin
#
World.RemoteAdmin.MaxFailedLogins = 3

#
#    World.RemoteAdmin.MaxLineLength
#        Description: The longest command line in bytes; a longer line closes the connection without
#                     running anything.
#        Type: int
#        Default: 16384
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldremoteadmin
#
World.RemoteAdmin.MaxLineLength = 16384

#
#    World.RemoteAdmin.MinSecurity
#        Description: The lowest account security that may log in (mangosd Ra.MinLevel, default
#                     Administrator). Values: Player, Moderator, GameMaster, Administrator.
#        Type: AccountSecurity
#        Default: Administrator
#        Allowed: Player | Moderator | GameMaster | Administrator
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldremoteadmin
#
World.RemoteAdmin.MinSecurity = Administrator

#
#    World.RemoteAdmin.Port
#        Description: The TCP port (mangosd Ra.Port default 3443).
#        Type: int
#        Default: 3443
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldremoteadmin
#
World.RemoteAdmin.Port = 3443

#----------------------------------------------------------------------------
# World:Social
#----------------------------------------------------------------------------

#
#    World.Social.AllowTwoSideAddFriend
#        Description: AllowTwoSide.AddFriend.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldsocial
#
World.Social.AllowTwoSideAddFriend = false

#
#    World.Social.AllowTwoSideChannel
#        Description: AllowTwoSide.Interaction.Channel.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldsocial
#
World.Social.AllowTwoSideChannel = false

#
#    World.Social.AllowTwoSideGroup
#        Description: AllowTwoSide.Interaction.Group.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldsocial
#
World.Social.AllowTwoSideGroup = false

#
#    World.Social.AllowTwoSideGuild
#        Description: AllowTwoSide.Interaction.Guild.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldsocial
#
World.Social.AllowTwoSideGuild = false

#
#    World.Social.MaxChannelNameLength
#        Description: ArcaneCore hardening: the longest channel name (characters) a join accepts; a
#                     longer one gets INVALID_NAME and no channel is created. 0 = no cap. vmangos
#                     has none and the stock client's limit is UNVERIFIED (not captured from a real
#                     client). The default (255) assumes a chat edit box of that length, which is
#                     unconfirmed; if the client allows longer names, raise it or set 0.
#        Type: int
#        Default: 255
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldsocial
#
World.Social.MaxChannelNameLength = 255

#
#    World.Social.MaxChannelPassphraseLength
#        Description: ArcaneCore hardening: the longest channel password (characters) accepted on
#                     join or when set; over it a join gets WRONG_PASSWORD and a set is ignored. 0 =
#                     no cap. Default 255, as for MaxChannelNameLength.
#        Type: int
#        Default: 255
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldsocial
#
World.Social.MaxChannelPassphraseLength = 255

#
#    World.Social.MaxJoinedChannels
#        Description: Most channels one player may be in; 0 = unlimited. vmangos has no cap
#                     (ChannelMgr.cpp:52-69), so the retail default is 0; a positive value is opt-in
#                     hardening (World:Social:MaxJoinedChannels).
#        Type: int
#        Default: 0
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldsocial
#
World.Social.MaxJoinedChannels = 0

#
#    World.Social.OfflineLeaderDelaySeconds
#        Description: Seconds before an offline group leader yields to an online member. Zero
#                     disables the handoff. vmangos@0e3ff01 src/game/World.cpp:811,2063-2072
#                     defaults to 300 seconds.
#        Type: int
#        Default: 300
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldsocial
#
World.Social.OfflineLeaderDelaySeconds = 300

#
#    World.Social.ReadyCheckAnswerIntervalMs
#        Description: ArcaneCore hardening: the shortest time (milliseconds) between two ready-check
#                     answers of one member that are forwarded to the leader; answers inside it are
#                     dropped (a dropped answer is not replayed, so the leader can keep a stale
#                     one), and a new ready check resets it. Off (0) by default, as in vmangos,
#                     which forwards every answer, pending check or not (GroupHandler.cpp
#                     HandleRaidReadyCheckOpcode): set it only to defend against a member spamming
#                     the leader.
#        Type: int
#        Default: 0
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldsocial
#
World.Social.ReadyCheckAnswerIntervalMs = 0

#
#    World.Social.VmangosChannelExtensions
#        Description: The vmangos-only custom channel names: "World" becomes a General-flagged
#                     channel without join/leave announcements and "China" (or its Mandarin name) a
#                     Custom one without announcements (vmangos Channel.cpp:63-71). Retail 1.12 has
#                     neither, so they are ordinary custom channels unless this is on; it applies to
#                     channels created after the change.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldsocial
#
World.Social.VmangosChannelExtensions = false

#----------------------------------------------------------------------------
# World:Social:WriteQueue
#----------------------------------------------------------------------------

#
#    World.Social.WriteQueue.MaxPendingPerCharacter
#        Description: Most friend/ignore rows of one character that may be waiting for storage
#                     (queued or retained). 0 or less: unlimited.
#        Type: int
#        Default: 256
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldsocialwritequeue
#
World.Social.WriteQueue.MaxPendingPerCharacter = 256

#
#    World.Social.WriteQueue.MaxPendingTotal
#        Description: Most friend/ignore rows of all characters waiting for storage. 0 or less:
#                     unlimited.
#        Type: int
#        Default: 25000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldsocialwritequeue
#
World.Social.WriteQueue.MaxPendingTotal = 25000

#
#    World.Social.WriteQueue.RetryDelayMs
#        Description: Backoff unit between the three attempts of one write, in milliseconds (attempt
#                     n waits n times this).
#        Type: int
#        Default: 200
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldsocialwritequeue
#
World.Social.WriteQueue.RetryDelayMs = 200

#----------------------------------------------------------------------------
# World:Stealth
#----------------------------------------------------------------------------

#
#    World.Stealth.GroupVisibilityMode
#        Description: Who always sees a non-hostile stealthed player (vmangos Visibility.GroupMode,
#                     World.cpp:689; Player::IsGroupVisibleFor, Player.cpp:2924-2935). Default
#                     StealthGroupVisibility.SameGroup: only the same 5-man (sub)group. Values:
#                     SameGroup, SameRaid, SameTeam.
#        Type: StealthGroupVisibility
#        Default: SameGroup
#        Allowed: SameGroup | SameRaid | SameTeam
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldstealth
#
World.Stealth.GroupVisibilityMode = SameGroup

#
#    World.Stealth.ImprovedSapRollPerPhase
#        Description: Improved Sap rolls twice per cast, as the vmangos code does (once at cast
#                     start, once at completion), instead of once. Default false (the talent text:
#                     30/60/90 percent chance to remain stealthed).
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldstealth
#
World.Stealth.ImprovedSapRollPerPhase = false

#
#    World.Stealth.IncludeStrengthContribution
#        Description: When true, adds 0.3 * Strength of the stealthed target to its stealth skill
#                     (mangos-classic ObjectVisibility.cpp:152-178). Default false (vmangos 1.12.1
#                     Unit::CanDetectStealthOf).
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldstealth
#
World.Stealth.IncludeStrengthContribution = false

#
#    World.Stealth.MaxCreatureDetectRange
#        Description: Beyond this distance a creature never detects a stealthed unit (vmangos
#                     CONFIG_FLOAT_MAX_CREATURES_STEALTH_DETECT_RANGE).
#        Type: float
#        Default: 30
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldstealth
#
World.Stealth.MaxCreatureDetectRange = 30

#
#    World.Stealth.MaxPlayerDetectRange
#        Description: Beyond this distance a player never detects a stealthed unit (vmangos
#                     CONFIG_FLOAT_MAX_PLAYERS_STEALTH_DETECT_RANGE).
#        Type: float
#        Default: 30
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldstealth
#
World.Stealth.MaxPlayerDetectRange = 30

#----------------------------------------------------------------------------
# World:Time
#----------------------------------------------------------------------------

#
#    World.Time.TimeZoneId
#        Description: An explicit zone id (IANA or Windows) to treat as "server local time"; empty =
#                     the machine's zone. Only read while UseServerLocalTime is true.
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldtime
#
World.Time.TimeZoneId = ""

#
#    World.Time.UseServerLocalTime
#        Description: Pack the SERVER's local time into SMSG_LOGIN_SETTIMESPEED and compute weather
#                     seasons and event dates in it, as vmangos does with localtime
#                     (Server/Packets/Misc.cpp:924-933, Weather.cpp:100-103). Default true (retail);
#                     false uses UTC.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldtime
#
World.Time.UseServerLocalTime = true

#----------------------------------------------------------------------------
# World:Transports
#----------------------------------------------------------------------------

#
#    World.Transports.Enabled
#        Description: Master switch. Set it to true once the content is present: the
#                     gameobject_template type 15 rows and the transports periods
#                     (tools/content/refresh-world-content.ps1 writes both) and a build-5875
#                     TaxiPathNode.dbc through NpcServices:TaxiPathNodeDbcPath; the world then logs
#                     "Transports: 9 routes, 9 ships sailing". Off (the default), no ship is built
#                     or spawned and a client that claims to stand on a transport is treated as
#                     standing on nothing. vmangos always runs its ships (World.cpp:1451
#                     LoadTransportTemplates).
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldtransports
#
World.Transports.Enabled = false

#
#    World.Transports.Entries
#        Description: Only these gameobject_template entries become ships; empty (the default) means
#                     every type 15 row with a usable path. A switch for bringing routes up one at a
#                     time.
#        Type: List<uint>
#        Default: (empty list)
#        Allowed: a list: numbered keys 0, 1, 2, ...; each value is a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldtransports
#
# Empty by default.
# World.Transports.Entries.0 =

#----------------------------------------------------------------------------
# World:Weather
#----------------------------------------------------------------------------

#
#    World.Weather.ChangeIntervalMs
#        Description: vmangos ChangeWeatherInterval: ms between weather regenerations of a zone
#                     (default 10 minutes, World.cpp:596).
#        Type: uint
#        Default: 600000
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldweather
#
World.Weather.ChangeIntervalMs = 600000

#
#    World.Weather.Enabled
#        Description: vmangos ActivateWeather (default 1, World.cpp:730).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldweather
#
World.Weather.Enabled = true

#----------------------------------------------------------------------------
# World:WorldStates
#----------------------------------------------------------------------------

#
#    World.WorldStates.DefaultsPath
#        Description: A JSON file holding the default world states sent with every zone entry, as
#                     [[state, value], ...] (vmangos hard-codes 108 sniffed pairs,
#                     Player.cpp:8041-8213; that table is GPL data and is not shipped here). Empty
#                     (default) = no default pairs, like mangos-classic.
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldworldstates
#
World.WorldStates.DefaultsPath = ""

#----------------------------------------------------------------------------
# World:Zones
#----------------------------------------------------------------------------

#
#    World.Zones.ClientZoneTrust
#        Description: See ClientZoneTrust. Default ClientZoneTrust.Auto: a world with imported area
#                     data behaves like retail; one without keeps accepting the client zone. This is
#                     a documented development allowance, not retail behaviour. Values: Auto, Never,
#                     Always.
#        Type: ClientZoneTrust
#        Default: Auto
#        Allowed: Auto | Never | Always
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldzones
#
World.Zones.ClientZoneTrust = Auto

#
#    World.Zones.PvpRealmMode
#        Description: The realm kind for PvP rules (vmangos IsPvPRealm / IsFFAPvPRealm): Normal
#                     (default), Pvp or FfaPvp. Values: Normal, Pvp, FfaPvp.
#        Type: PvpRealmMode
#        Default: Normal
#        Allowed: Normal | Pvp | FfaPvp
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldzones
#
World.Zones.PvpRealmMode = Normal

#
#    World.Zones.RelocationCheckDelayMs
#        Description: vmangos Movement.RelocationVmapsCheckDelay (default 0, at most 2000): when
#                     above 0 the explore check runs this many ms after a position change instead of
#                     at once (Player.cpp:5975-5985).
#        Type: uint
#        Default: 0
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldzones
#
World.Zones.RelocationCheckDelayMs = 0

