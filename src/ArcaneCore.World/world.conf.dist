###############################################################################
# SPECIALLOOT
###############################################################################

#----------------------------------------------------------------------------
# SpecialLoot
#----------------------------------------------------------------------------

#
#    SpecialLoot.Fishing.FailGain
#        Description: SkillFail.Gain.Fishing (default false): a failed catch still raises the
#                     fishing skill.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#specialloot
#
SpecialLoot.Fishing.FailGain = false

#
#    SpecialLoot.Fishing.FailLoot
#        Description: SkillFail.Loot.Fishing (default false): a failed catch still opens the junk
#                     loot (fishing_loot_template entry 0). Retail 1.12 shows "fish escaped"
#                     instead.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#specialloot
#
SpecialLoot.Fishing.FailLoot = false

#
#    SpecialLoot.Fishing.FailPossibleFishingPool
#        Description: SkillFail.Possible.FishingPool (default true). Counter-intuitively named: only
#                     when this is FALSE does vmangos search for a fishing hole after a failed roll
#                     and turn it into a success (GameObject.cpp:1672-1680); when true (default) a
#                     hole is only looked up after a successful roll.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#specialloot
#
SpecialLoot.Fishing.FailPossibleFishingPool = true

#
#    SpecialLoot.Items.ConsumeWholeStack
#        Description: A container item whose loot was taken is destroyed completely (default true:
#                     vmangos DestroyItem destroys the whole stack, LootHandler.cpp:556-563). With
#                     false only one of a stack is consumed. Three classic-db lootable items stack
#                     (Bloated Mackerel 6644, Bloated Albacore 6646, Bundle of Reports 16783); which
#                     behaviour retail had is not verifiable from the references.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#specialloot
#
SpecialLoot.Items.ConsumeWholeStack = true

###############################################################################
# SPELLRULES
###############################################################################

#----------------------------------------------------------------------------
# SpellRules
#----------------------------------------------------------------------------

#
#    SpellRules.CreatureSpellCrit
#        Description: Whether creatures that are not player-owned may crit with spells. Retail:
#                     false (vmangos Unit::GetSpellCritChance, Unit.cpp:5216-5219 "Mobs cannot land
#                     critical strikes with spells").
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#spellrules
#
SpellRules.CreatureSpellCrit = false

#
#    SpellRules.DiminishingResetMs
#        Description: Milliseconds after the last aura of a diminishing group ended before the level
#                     resets (vmangos Unit::GetDiminishing, Unit.cpp:7630: 15 seconds).
#        Type: uint
#        Default: 15000
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#spellrules
#
SpellRules.DiminishingResetMs = 15000

#
#    SpellRules.DiminishingReturns
#        Description: Whether crowd-control spells diminish (vmangos Spell.cpp:1733-1800). Retail:
#                     true; false is a dev-host switch.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#spellrules
#
SpellRules.DiminishingReturns = true

#
#    SpellRules.IgnoreHolyResistance
#        Description: Whether holy resistance is ignored when resisting damage. Retail (vmangos
#                     Unit::CalculateDamageAbsorbAndResist, Unit.cpp:1936-1946): false, holy is
#                     resisted like any magic school. true reproduces cmangos-classic
#                     (Unit::CalculateEffectiveMagicResistancePercent, Unit.cpp:3917: "completely
#                     ignore holy resistance value").
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#spellrules
#
SpellRules.IgnoreHolyResistance = false

#
#    SpellRules.ImmunityEnforcement
#        Description: Whether immunities (aura-granted and creature static masks) are enforced.
#                     Retail: true; false disables every immunity check for development hosts.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#spellrules
#
SpellRules.ImmunityEnforcement = true

#
#    SpellRules.MagicHitFloorPercent
#        Description: Lowest base magic hit chance in percent before modifiers: 22 (vmangos
#                     SpellCaster.cpp:829-834, from a classic duel test). Set 1 to reproduce
#                     cmangos-classic, which floors the final chance only.
#        Type: float
#        Default: 22
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#spellrules
#
SpellRules.MagicHitFloorPercent = 22

#
#    SpellRules.ResistTablePath
#        Description: Path of a file with vmangos' partial-resist outcome table (ResistOutcomeTable:
#                     31 rows of resist100,resist75,resist50,resist25,resist0,chanceResist,
#                     Unit.cpp:1885-1918), which the repository does not ship. Unset: the engine
#                     draws the two quarter steps around the average resist (mean-preserving
#                     approximation, docs/areas/spell-rules.md); the damage-over-time one-tenth rule
#                     and the vulnerability bonus apply either way.
#        Type: string
#        Default: (not set)
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#spellrules
#
# SpellRules.ResistTablePath =

#
#    SpellRules.WorldBossLevelDiff
#        Description: Levels a world boss counts above its target (vmangos CONFIG
#                     WorldBossLevelDiff, World.cpp:744 default 3).
#        Type: int
#        Default: 3
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#spellrules
#
SpellRules.WorldBossLevelDiff = 3

###############################################################################
# SPELLS
###############################################################################

#----------------------------------------------------------------------------
# Spells
#----------------------------------------------------------------------------

#
#    Spells.RequireSpellFocus
#        Description: false stops enforcing SpellInfo.RequiresSpellFocus on casts (read once by
#                     SpellFocusFeature); true is the retail behaviour.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#keys-read-by-name
#
Spells.RequireSpellFocus = true

#----------------------------------------------------------------------------
# Spells:Casters
#----------------------------------------------------------------------------

#
#    Spells.Casters.Bonus.Enabled
#        Description: Retail (true): +damage, +healing, Amplify/Dampen Magic and healing-taken auras
#                     change spell damage and healing (vmangos SpellCaster.cpp:1457-1700,
#                     Unit.cpp:5175-5385). False keeps the raw spell data amounts and exists only to
#                     debug against base points.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#spellscasters
#
Spells.Casters.Bonus.Enabled = true

#----------------------------------------------------------------------------
# Spells:Mods
#----------------------------------------------------------------------------

#
#    Spells.Mods.ClassMaskFile
#        Description: The class-mask overlay file (arcane-content-importer class-masks): 64-bit
#                     masks for the modifier auras, because the spell DBC's EffectItemType is read
#                     as 32 bits. Unset means the DBC masks only (a warning at startup counts the
#                     modifier effects that then have no mask at all). A missing or malformed file
#                     fails startup.
#        Type: string
#        Default: (not set)
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#spellsmods
#
# Spells.Mods.ClassMaskFile =

#
#    Spells.Mods.CustomCharges
#        Description: Shadow Trance (17941) and Netherwind Focus (22008) start with one charge
#                     whatever the spell data says (vmangos SpellAuras.cpp:1090-1099). Retail is
#                     true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#spellsmods
#
Spells.Mods.CustomCharges = true

#
#    Spells.Mods.Enabled
#        Description: Kill switch: false makes aura 107/108 inert again (no mod is registered, every
#                     value comes back unchanged), as before this area existed. Retail is true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#spellsmods
#
Spells.Mods.Enabled = true

#
#    Spells.Mods.HardcodedWardMods
#        Description: Frost Warding (11189, 28332) and Improved Fire Ward (11094, 13043) carry their
#                     modifier in code, not in data: a flat RESIST_MISS_CHANCE with a literal class
#                     mask (vmangos SpellAuras.cpp:2117-2155, builds after 1.10.2). Retail is true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#spellsmods
#
Spells.Mods.HardcodedWardMods = true

#
#    Spells.Mods.InstantCastKeepsFlatCastTimeCharge
#        Description: Patch 1.11: a flat CASTING_TIME mod (Nature's Grace) is not spent by a spell
#                     an instant-cast percent mod (Nature's Swiftness) already made instant (vmangos
#                     Player::ApplySpellMod, Player.cpp:22444-22453, builds after 1.10.2). Retail is
#                     true; false spends it anyway.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#spellsmods
#
Spells.Mods.InstantCastKeepsFlatCastTimeCharge = true

#
#    Spells.Mods.OwnerModsForPetsAndTotems
#        Description: A pet or a totem reads the modifiers of the player that owns it (vmangos
#                     Unit::GetSpellModOwner, Unit.cpp:9008-9023): its spell cooldowns, costs and
#                     ranges follow the owner's talents. Retail is true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#spellsmods
#
Spells.Mods.OwnerModsForPetsAndTotems = true

#
#    Spells.Mods.ReapplyPassives
#        Description: After a modifier is added or removed, permanent self-cast passives it affects
#                     are removed and cast again so an amount that read a modifier is recomputed
#                     (vmangos Aura::ReapplyAffectedPassiveAuras, SpellAuras.cpp:1005-1075). Retail
#                     is true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#spellsmods
#
Spells.Mods.ReapplyPassives = true

#
#    Spells.Mods.SendClientModifiers
#        Description: Tell the client about every modifier change (SMSG_SET_FLAT_SPELL_MODIFIER /
#                     SMSG_SET_PCT_SPELL_MODIFIER, one packet per mask bit): the client needs them
#                     to show modified costs and cast bars (vmangos Player::SendSpellMod). Retail is
#                     true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#spellsmods
#
Spells.Mods.SendClientModifiers = true

###############################################################################
# STARTUP
###############################################################################

#----------------------------------------------------------------------------
# Startup
#----------------------------------------------------------------------------

#
#    Startup.Strict
#        Description: true makes a configuration warning fail start-up like an error (exit code 78);
#                     read by ConfigReport.Run in both daemons.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#keys-read-by-name
#
Startup.Strict = false

###############################################################################
# STATS
###############################################################################

#----------------------------------------------------------------------------
# Stats
#----------------------------------------------------------------------------

#
#    Stats.RequireImportedData
#        Description: Refuse to log a player in unless the player base data (class health/mana,
#                     race/class stats, XP per level, crit and dodge per agility) is imported and
#                     complete, as vmangos refuses to start without it (ObjectMgr.cpp:4876-4882,
#                     4988-4994, 5011-5029, 5117-5129). The default is false: a host that has not
#                     imported the data yet still runs, the agility terms of crit and dodge are left
#                     out and the level stats come from Progression:LevelStatsPath or are absent.
#                     This is the one deliberate difference from retail behaviour of the stat
#                     feature; set it to true on a host that has imported the data.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#stats
#
Stats.RequireImportedData = false

###############################################################################
# TALENTS
###############################################################################

#----------------------------------------------------------------------------
# Talents
#----------------------------------------------------------------------------

#
#    Talents.EmptyConfirmCost
#        Description: The cost field of the empty confirmation sent when a reset is refused (nothing
#                     spent, or not enough money). vmangos fills it with the current price;
#                     mangos-classic sends zero. Default = vmangos, the primary reference. Values:
#                     Current, Zero.
#        Type: TalentEmptyConfirmCost
#        Default: Current
#        Allowed: Current | Zero
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#talents
#
Talents.EmptyConfirmCost = Current

#
#    Talents.IdempotentRespecDecay
#        Description: Deviation switch, off = vmangos. vmangos mutates the stored multiplier on
#                     every price read without advancing the last-respec time, so reading the price
#                     twice in a later month decays it twice (Player.cpp:4028-4051). When true the
#                     decay is applied once per elapsed month: it is computed from the stored state
#                     and only persisted by an actual respec.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#talents
#
Talents.IdempotentRespecDecay = false

#
#    Talents.PointsRate
#        Description: Multiplier on the talent points a level grants (vmangos Rate.Talent, default
#                     1).
#        Type: double
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#talents
#
Talents.PointsRate = 1

#
#    Talents.RequireClassTrainerForWipe
#        Description: Whether the wipe confirmation requires a class trainer of the player's own
#                     class (mangos-classic SkillHandler.cpp:51). vmangos checks only that the NPC
#                     is a reachable trainer (SkillHandler.cpp:37-56); the gossip offer, which both
#                     references share, already enforces the class, so a genuine client never
#                     notices. Default true (fail closed); false matches vmangos exactly.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#talents
#
Talents.RequireClassTrainerForWipe = true

#
#    Talents.RespecBaseCostGold
#        Description: Gold charged by the first (or fully decayed) respec (vmangos
#                     Rate.RespecBaseCost, default 1).
#        Type: uint
#        Default: 1
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#talents
#
Talents.RespecBaseCostGold = 1

#
#    Talents.RespecMaxMultiplier
#        Description: Cap of the multiplier (vmangos Rate.RespecMaxMultiplier, default 10: 50 gold).
#        Type: uint
#        Default: 10
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#talents
#
Talents.RespecMaxMultiplier = 10

#
#    Talents.RespecMinMultiplier
#        Description: Floor the decay never drops below once the multiplier had reached it (vmangos
#                     Rate.RespecMinMultiplier, default 2).
#        Type: uint
#        Default: 2
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#talents
#
Talents.RespecMinMultiplier = 2

#
#    Talents.RespecMultiplicativeCostGold
#        Description: Gold per multiplier step (vmangos Rate.RespecMultiplicativeCost, default 5).
#        Type: uint
#        Default: 5
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#talents
#
Talents.RespecMultiplicativeCostGold = 5

#
#    Talents.RespecPriceDecay
#        Description: Respec price decays one step per elapsed 30-day month. Always on for build
#                     5875: vmangos gates it with !NoRespecPriceDecay || patch &gt;= 1.11
#                     (Player.cpp:4056) and 5875 is patch 1.12. A switch for emulating earlier
#                     patches.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#talents
#
Talents.RespecPriceDecay = true

#
#    Talents.TalentDbcPath
#        Description: Path of the developer-supplied build-5875 Talent.dbc (never committed or
#                     downloaded). Unset together with TalentTabDbcPath: the talent system is inert
#                     (no points, the unlearn option stays hidden, CMSG_LEARN_TALENT is ignored) and
#                     a warning is logged. One set without the other, or an unreadable or invalid
#                     file, fails startup.
#        Type: string
#        Default: (not set)
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#talents
#
# Talents.TalentDbcPath =

#
#    Talents.TalentTabDbcPath
#        Description: Path of the developer-supplied TalentTab.dbc (see TalentDbcPath).
#        Type: string
#        Default: (not set)
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#talents
#
# Talents.TalentTabDbcPath =

#
#    Talents.WipeRefusalAlsoSendsEmptyConfirm
#        Description: After a refused reset (nothing spent, or not enough money) also send the empty
#                     confirmation that means "you have not spent any talent points" (vmangos
#                     SkillHandler.cpp:50-53). Not verified against a real client; false sends only
#                     the SMSG_BUY_FAILED of the money case.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#talents
#
Talents.WipeRefusalAlsoSendsEmptyConfirm = true

###############################################################################
# TOTEMS
###############################################################################

#----------------------------------------------------------------------------
# Totems
#----------------------------------------------------------------------------

#
#    Totems.Enabled
#        Description: false leaves the totem effects unregistered, so they report "not implemented"
#                     (fail closed).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#totems
#
Totems.Enabled = true

#
#    Totems.OwnerLeash
#        Description: vmangos Totem::Update unsummons a totem whose owner left its visibility
#                     distance (Objects/Totem.cpp:66-76). false (developer only) lets it persist.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#totems
#
Totems.OwnerLeash = true

#
#    Totems.PlacementDistance
#        Description: Base distance from the caster at which a totem is placed (vmangos
#                     Spell::EffectSummonTotem builds CreatureCreatePos(caster, orientation, 2.0f,
#                     angle), SpellEffects.cpp:4952-4957). The caster's and the totem's bounding
#                     radii are added to it, as GetClosePoint does (Object.cpp:2728-2729, 2748).
#        Type: float
#        Default: 2
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#totems
#
Totems.PlacementDistance = 2

###############################################################################
# WARDEN
###############################################################################

#----------------------------------------------------------------------------
# Warden
#----------------------------------------------------------------------------

#
#    Warden.Action
#        Description: Warden:Action, applied when a scan fails (default Log). Values: Log, Kick,
#                     Ban.
#        Type: WardenAction
#        Default: Log
#        Allowed: Log | Kick | Ban
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#warden
#
Warden.Action = Log

#
#    Warden.BanSeconds
#        Description: Warden:BanSeconds for WardenAction.Ban; 0 is permanent. Default 86400 (vmangos
#                     Warden.ClientBanDuration).
#        Type: long
#        Default: 86400
#        Allowed: a whole number, -9223372036854775808 to 9223372036854775807
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#warden
#
Warden.BanSeconds = 86400

#
#    Warden.Checks
#        Description: Warden:Checks: scans added to the table's (a configured id replaces the table
#                     row with that id). With neither, the timing scan runs alone.
#        Type: List<WardenCheckOptions>
#        Default: (empty list)
#        Allowed: a list: numbered keys 0, 1, 2, ...; each entry is a group of keys
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#warden
#
# Empty by default. Each entry is a group of keys: Warden.Checks.0.<Field> = value, Warden.Checks.1.<Field> = value, ...

#
#    Warden.ChunkSize
#        Description: Warden:ChunkSize: module bytes per MODULE_CACHE frame (MaNGOS Zero 500).
#        Type: int
#        Default: 500
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#warden
#
Warden.ChunkSize = 500

#
#    Warden.Enabled
#        Description: Warden:Enabled; default false.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#warden
#
Warden.Enabled = false

#
#    Warden.ExemptSecurity
#        Description: Warden:ExemptSecurity: accounts at or above it are never scanned. Default
#                     Moderator. Values: Player, Moderator, GameMaster, Administrator.
#        Type: AccountSecurity
#        Default: Moderator
#        Allowed: Player | Moderator | GameMaster | Administrator
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#warden
#
Warden.ExemptSecurity = Moderator

#
#    Warden.LoadFromDatabase
#        Description: Warden:LoadFromDatabase: also run the scans of the world table warden_checks
#                     for this build. Default true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#warden
#
Warden.LoadFromDatabase = true

#
#    Warden.MaxProtocolFailures
#        Description: Warden:MaxProtocolFailures: protocol failures to the server's own requests (a
#                     bad or late reply, a failed module load) that disconnect the session even
#                     under ProtocolAction Log. Each valid reply forgives one. Unsolicited packets
#                     never count. 1-100, default 3.
#        Type: int
#        Default: 3
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#warden
#
Warden.MaxProtocolFailures = 3

#
#    Warden.ProtocolAction
#        Description: Warden:ProtocolAction, applied when the handshake or a reply breaks the
#                     protocol (a wrong hash, a malformed or late reply, a failed module load). Log
#                     keeps the session and keeps scanning, up to MaxProtocolFailures; Kick
#                     disconnects. Ban is treated as Kick, so a late reply from a lagging client
#                     never bans an account (vmangos kicks for every protocol failure). Default Log.
#                     Values: Log, Kick, Ban.
#        Type: WardenAction
#        Default: Log
#        Allowed: Log | Kick | Ban
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#warden
#
Warden.ProtocolAction = Log

#
#    Warden.ProtocolReportIntervalSeconds
#        Description: Warden:ProtocolReportIntervalSeconds: under ProtocolAction Log, a session
#                     reports at most one protocol failure per interval and then one line with the
#                     count of the rest. 1-3600, default 10.
#        Type: uint
#        Default: 10
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#warden
#
Warden.ProtocolReportIntervalSeconds = 10

#
#    Warden.ResponseTimeoutSeconds
#        Description: Warden:ResponseTimeoutSeconds: every awaited reply must arrive within this
#                     (MaNGOS Zero WardenLimits.deadlineMs 30000).
#        Type: uint
#        Default: 30
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#warden
#
Warden.ResponseTimeoutSeconds = 30

#
#    Warden.ScanIntervalMaxSeconds
#        Description: Warden:ScanIntervalMaxSeconds: the longest gap between scan requests. Default
#                     60.
#        Type: uint
#        Default: 60
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#warden
#
Warden.ScanIntervalMaxSeconds = 60

#
#    Warden.ScanIntervalMinSeconds
#        Description: Warden:ScanIntervalMinSeconds: the shortest random gap between scan requests
#                     (MaNGOS Zero normal interval 30-60 s).
#        Type: uint
#        Default: 30
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#warden
#
Warden.ScanIntervalMinSeconds = 30

#
#    Warden.ScansPerRequest
#        Description: Warden:ScansPerRequest (vmangos Warden.NumScans). Default 3.
#        Type: int
#        Default: 3
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#warden
#
Warden.ScansPerRequest = 3

#
#    Warden.StaffNoticeCooldownSeconds
#        Description: Warden:StaffNoticeCooldownSeconds: the staff line for a Kick or Ban verdict is
#                     sent at most once per account and action per this many seconds; repeats inside
#                     the window are counted and reported as one "N more suppressed" line.
#                     Independent of World:Announce. 0 sends every line. 0-3600, default 30.
#        Type: uint
#        Default: 30
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#warden
#
Warden.StaffNoticeCooldownSeconds = 30

###############################################################################
# WORLD
###############################################################################

#----------------------------------------------------------------------------
# World
#----------------------------------------------------------------------------

#
#    World.AllowTwoSideChat
#        Description: Allow whispers and custom emotes across factions, and send Common/Orcish as
#                     Universal (vmangos AllowTwoSide.Interaction.Chat, default off).
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.AllowTwoSideChat = false

#
#    World.AllowTwoSideWhoList
#        Description: Show the other faction in /who (vmangos AllowTwoSide.WhoList, default off).
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.AllowTwoSideWhoList = false

#
#    World.AutosaveIntervalMs
#        Description: Periodic save of online characters, in milliseconds (vmangos
#                     PlayerSave.Interval default 900000). 0 disables.
#        Type: int
#        Default: 900000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.AutosaveIntervalMs = 900000

#
#    World.BindAddress
#        Description: Interface to bind the world listener to.
#        Type: string
#        Default: "0.0.0.0"
#        Allowed: text
#        Reload: Restart (.reload config keeps the old value and reports that a restart is needed)
#        Docs: docs/reference/configuration.md#world
#
World.BindAddress = "0.0.0.0"

#
#    World.CharactersPerRealm
#        Description: Characters an account may have on this realm (vmangos CharactersPerRealm:
#                     default 10, at most 10).
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.CharactersPerRealm = 10

#
#    World.CommandTimeBudgetMs
#        Description: Maximum command-drain time per tick in milliseconds; 0 disables the time
#                     bound.
#        Type: int
#        Default: 5
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.CommandTimeBudgetMs = 5

#
#    World.GmLevelInWhoList
#        Description: Highest staff level ordinary players see in /who (vmangos/cmangos
#                     GM.InWhoList.Level default SEC_ADMINISTRATOR, i.e. every account). Values:
#                     Player, Moderator, GameMaster, Administrator.
#        Type: AccountSecurity
#        Default: Administrator
#        Allowed: Player | Moderator | GameMaster | Administrator
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.GmLevelInWhoList = Administrator

#
#    World.InstantLogoutSecurity
#        Description: Lowest security level that logs out instantly (vmangos/cmangos InstantLogout
#                     default SEC_MODERATOR). Values: Player, Moderator, GameMaster, Administrator.
#        Type: AccountSecurity
#        Default: Moderator
#        Allowed: Player | Moderator | GameMaster | Administrator
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.InstantLogoutSecurity = Moderator

#
#    World.ListenRangeSay
#        Description: Distance /say reaches. vmangos and cmangos-classic World.cpp default to 25
#                     (cmangos' shipped mangosd.conf keeps 25; vmangos' raises it to 40). 0 = the
#                     whole map.
#        Type: float
#        Default: 25
#        Allowed: a number, '.' is the decimal point
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.ListenRangeSay = 25

#
#    World.ListenRangeTextEmote
#        Description: Distance /emote and text emotes reach (vmangos/cmangos ListenRange.TextEmote
#                     default 25). 0 = the whole map.
#        Type: float
#        Default: 25
#        Allowed: a number, '.' is the decimal point
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.ListenRangeTextEmote = 25

#
#    World.ListenRangeYell
#        Description: Distance /yell reaches (vmangos/cmangos ListenRange.Yell default 300). 0 = the
#                     whole map.
#        Type: float
#        Default: 300
#        Allowed: a number, '.' is the decimal point
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.ListenRangeYell = 300

#
#    World.LogoutDelayMs
#        Description: How long a requested logout counts down before the player leaves the world
#                     (vmangos WorldSession::ShouldLogOut hard-codes 20 seconds; configurable here
#                     for tests and tuning).
#        Type: uint
#        Default: 20000
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.LogoutDelayMs = 20000

#
#    World.Maps.DataDirectory
#        Description: Directory holding the extractor output (a maps/ folder of .map files, as
#                     written by the vmangos/cmangos-classic map extractor — vmangos DataDir).
#                     Empty, or a directory without maps/, means no terrain: height, area and liquid
#                     lookups then report "no data" and nothing fails.
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Restart (.reload config keeps the old value and reports that a restart is needed)
#        Docs: docs/reference/configuration.md#world
#
World.Maps.DataDirectory = ""

#
#    World.Maps.GridActivationDistance
#        Description: Radius around players (and active objects) whose grids are loaded and kept
#                     alive (vmangos Map::m_gridActivationDistance, initialised from
#                     Visibility.Distance.Continents = 100).
#        Type: float
#        Default: 100
#        Allowed: a number, '.' is the decimal point
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.Maps.GridActivationDistance = 100

#
#    World.Maps.GridCleanUpDelayMs
#        Description: How long an idle grid stays loaded (vmangos GridCleanUpDelay, default 5
#                     minutes, at least MinGridDelayMs — World.cpp setConfigMin).
#        Type: int
#        Default: 300000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.Maps.GridCleanUpDelayMs = 300000

#
#    World.Maps.GridPrefetchDistance
#        Description: How far beyond GridActivationDistance a player (or active object) looks for
#                     grids that do not exist yet, so their terrain, vmap and navmesh tiles are read
#                     and parsed on the thread pool before the grid is created
#                     (GridContainer.GridApproaching); other objects look half as far. 0 turns the
#                     prefetch off. An ArcaneCore addition (vmangos reads the tiles inside the
#                     update): it changes when the files are read, not what is loaded or when.
#        Type: float
#        Default: 200
#        Allowed: a number, '.' is the decimal point
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.Maps.GridPrefetchDistance = 200

#
#    World.Maps.GridUnload
#        Description: Whether idle grids are unloaded at all (vmangos GridUnload, default on).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.Maps.GridUnload = true

#
#    World.Maps.UpdateActiveCellsOnly
#        Description: On continents, update creatures only in the cells within
#                     GridActivationDistance of a player or active object (vmangos Map::UpdateCells
#                     → UpdateActiveCellsSynch, Maps/Map.cpp:815-857): a creature elsewhere in a
#                     loaded grid stands still, its AI and movement paused, until a player comes
#                     near; its respawn time is wall-clock and its corpse decay catches up on the
#                     first update (WorldObject::UpdateHelper::UpdateRealTime,
#                     Objects/Object.h:477-481). False updates every creature of the loaded grids
#                     each tick (the behaviour before 2026-10-11).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.Maps.UpdateActiveCellsOnly = true

#
#    World.Maps.VisibilityRelocationLowerLimit
#        Description: How far (yards, 3D) a unit (player or creature) must move from where its last
#                     movement-triggered visibility pass was scheduled before the next one is
#                     (vmangos Visibility.RelocationLowerLimit, default 10, World.cpp:830;
#                     Unit::OnRelocated). Moves within it keep the visible sets of the last pass;
#                     the grey distance (Map.VisibilityGreyDistance) and the next pass cover the
#                     difference. Game objects get a pass on every move. 0 runs a pass on every
#                     move.
#        Type: float
#        Default: 10
#        Allowed: a number, '.' is the decimal point
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.Maps.VisibilityRelocationLowerLimit = 10

#
#    World.MaxCommandsPerTick
#        Description: Maximum queued world commands admitted before the map pass of one tick.
#        Type: int
#        Default: 1024
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.MaxCommandsPerTick = 1024

#
#    World.MaxConnections
#        Description: Global cap on simultaneous world connections; 0 = unlimited (retail, the
#                     default). Hardening (no vmangos equivalent).
#        Type: int
#        Default: 0
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Restart (.reload config keeps the old value and reports that a restart is needed)
#        Docs: docs/reference/configuration.md#world
#
World.MaxConnections = 0

#
#    World.MaxConnectionsPerIp
#        Description: Cap per client IP address; 0 = unlimited (retail, the default). Hardening: a
#                     retail client holds one connection.
#        Type: int
#        Default: 0
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Restart (.reload config keeps the old value and reports that a restart is needed)
#        Docs: docs/reference/configuration.md#world
#
World.MaxConnectionsPerIp = 0

#
#    World.MaxConsecutiveUpdaterFaults
#        Description: A map updater that throws in this many consecutive ticks is skipped from then
#                     on, until Map.ClearUpdaterFaults (a code hot reload calls it after each
#                     applied edit). 0 (the default) never skips: a throwing updater is logged every
#                     tick and the others still run, as before. Only World:HotCode:Enabled sets it
#                     (docs/areas/code-hot-reload.md).
#        Type: int
#        Default: 0
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.MaxConsecutiveUpdaterFaults = 0

#
#    World.MaxOutboundBytes
#        Description: Disconnect a client whose unsent data exceeds this many bytes (it stopped
#                     reading).
#        Type: long
#        Default: 8388608
#        Allowed: a whole number, -9223372036854775808 to 9223372036854775807
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#world
#
World.MaxOutboundBytes = 8388608

#
#    World.MaxQueuedWorldBytes
#        Description: Most payload bytes one session may have queued for the world thread (see
#                     MaxQueuedWorldPackets); 0 disables the bound. Mirrors the 8 MiB outbound
#                     bound. The largest client frame is WorldSession.MaxClientPacketSize bytes, so
#                     this holds a few hundred maximum-size packets. Bound from
#                     World:MaxQueuedWorldBytes.
#        Type: long
#        Default: 8388608
#        Allowed: a whole number, -9223372036854775808 to 9223372036854775807
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#world
#
World.MaxQueuedWorldBytes = 8388608

#
#    World.MaxQueuedWorldPackets
#        Description: Most world-handler packets one session may have queued for the world thread;
#                     the session is disconnected when a packet would exceed it. 0 disables the
#                     bound. The drain rate is MaxWorldPacketsPerTick per 50 ms tick (3000 per
#                     second) and a retail client sends a few tens of packets per second (movement
#                     heartbeats, casts, chat), so 8192 only fills if the world thread stalled for
#                     minutes or the peer floods. Hardening: vmangos (WorldSession.cpp:307-332
#                     QueuePacket into m_recvQueue) and mangos-classic (WorldSession.cpp:256-285)
#                     queue without any bound. Bound from World:MaxQueuedWorldPackets.
#        Type: int
#        Default: 8192
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#world
#
World.MaxQueuedWorldPackets = 8192

#
#    World.MaxWorldPacketsPerTick
#        Description: In-world packets handled per session per tick; the rest wait for the next
#                     tick.
#        Type: int
#        Default: 150
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#world
#
World.MaxWorldPacketsPerTick = 150

#
#    World.Motd
#        Description: Message of the day sent as system lines at login; '@' separates lines (vmangos
#                     Motd).
#        Type: string
#        Default: "Welcome to ArcaneCore."
#        Allowed: text
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.Motd = "Welcome to ArcaneCore."

#
#    World.PlayerCommands
#        Description: Whether accounts without a GM level may use player commands such as .help and
#                     .save (vmangos PlayerCommands, default on).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.PlayerCommands = true

#
#    World.Port
#        Description: World TCP port. Vanilla default is 8085 (Charter §3).
#        Type: int
#        Default: 8085
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Restart (.reload config keeps the old value and reports that a restart is needed)
#        Docs: docs/reference/configuration.md#world
#
World.Port = 8085

#
#    World.PreAuthTimeout
#        Description: How long a world connection may stay unauthenticated (no valid
#                     CMSG_AUTH_SESSION yet), counted from accept; the session is closed when it
#                     expires. This is the retail rule: vmangos Network.TimeoutSecsIfNoAuth = 10
#                     (WorldSocket.cpp:621-628, mangosd.conf.dist.in:3039) closes the socket the
#                     same way. It stops a client that withholds the packet header (or trickles it)
#                     from holding a socket, a writer task and a DI scope forever (Codex finding 2).
#                     TimeSpan.Zero disables it. Bound from World:PreAuthTimeout (for example
#                     "00:00:10").
#        Type: TimeSpan
#        Default: 00:00:10
#        Allowed: a time span, [d.]hh:mm:ss
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#world
#
World.PreAuthTimeout = 00:00:10

#
#    World.Respawn.Dynamic.CountBots
#        Description: World:Respawn:Dynamic:CountBots: count playerbots as players (default true).
#                     False counts only human players, so bots neither shorten nor take part in the
#                     scaling.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.Respawn.Dynamic.CountBots = true

#
#    World.Respawn.Dynamic.Enabled
#        Description: World:Respawn:Dynamic:Enabled: scale respawn delays with the players around
#                     the spawn. False (the default) leaves every delay as the database says, which
#                     is retail. When true this replaces Creatures:Respawn:DynamicRate
#                     (TrinityCore's zone-rate scaling, off by default) rather than compounding with
#                     it.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.Respawn.Dynamic.Enabled = false

#
#    World.Respawn.Dynamic.IncludeElitesAndRares
#        Description: World:Respawn:Dynamic:IncludeElitesAndRares: also scale elite, rare and
#                     rare-elite creatures (default false: only normal creatures scale). World
#                     bosses never scale, whatever this says.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.Respawn.Dynamic.IncludeElitesAndRares = false

#
#    World.Respawn.Dynamic.IncludeGameObjects
#        Description: World:Respawn:Dynamic:IncludeGameObjects: scale the respawn delay of gathering
#                     nodes (herbs, mineral veins) and quest objects too (default true). Other game
#                     objects never scale.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.Respawn.Dynamic.IncludeGameObjects = true

#
#    World.Respawn.Dynamic.MaxReduction
#        Description: World:Respawn:Dynamic:MaxReduction: the share of the base delay that scaling
#                     may take off, so the delay is never below base * (1 - MaxReduction) (0..1,
#                     default 0.9: at most a tenth of the base delay remains). 0 never scales.
#        Type: float
#        Default: 0.9
#        Allowed: a number from 0 to 1 ('.' is the decimal point); 0 never scales
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.Respawn.Dynamic.MaxReduction = 0.9

#
#    World.Respawn.Dynamic.MinimumSeconds
#        Description: World:Respawn:Dynamic:MinimumSeconds: the delay is never scaled below this
#                     many seconds, and a delay already at or under it is left alone (1..86400,
#                     default 30). A corpse is removed when its respawn time is reached, so a value
#                     under the time players need to loot cuts loot short. The code has no separate
#                     corpse minimum, so this floor is it: the default 30 keeps a corpse lootable
#                     for at least 30 s.
#        Type: uint
#        Default: 30
#        Allowed: a whole number of seconds from 1 to 86400
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.Respawn.Dynamic.MinimumSeconds = 30

#
#    World.Respawn.Dynamic.PlayerThreshold
#        Description: World:Respawn:Dynamic:PlayerThreshold: players within Radius that are free;
#                     only the players above this many shorten the delay (0..10000, default 5).
#        Type: int
#        Default: 5
#        Allowed: a whole number from 0 to 10000
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.Respawn.Dynamic.PlayerThreshold = 5

#
#    World.Respawn.Dynamic.Radius
#        Description: World:Respawn:Dynamic:Radius: players are counted within this many yards (2D)
#                     of the spawn's home position (5..500, default 100). A radius is local to the
#                     contested spot, where a zone count is not, and is answered by the map's grid
#                     cells at the cost of the few cells it touches.
#        Type: float
#        Default: 100
#        Allowed: a number of yards from 5 to 500 ('.' is the decimal point)
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.Respawn.Dynamic.Radius = 100

#
#    World.Respawn.Dynamic.ScalePerPlayer
#        Description: World:Respawn:Dynamic:ScalePerPlayer: each player above PlayerThreshold adds
#                     this to the divisor, so the delay is base / (1 + ScalePerPlayer * max(0,
#                     players - PlayerThreshold)) (0..10, default 0.1: 15 players over the threshold
#                     divide the delay by 2.5). 0 never scales.
#        Type: float
#        Default: 0.1
#        Allowed: a number from 0 to 10 ('.' is the decimal point); 0 never scales
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.Respawn.Dynamic.ScalePerPlayer = 0.1

#
#    World.SaveQueueWarnAgeMs
#        Description: The character save queue warns while its oldest waiting snapshot has waited
#                     this many milliseconds. 0 disables the age check. Default 5000, the quest
#                     settlement budget (docs/areas/persistence.md).
#        Type: int
#        Default: 5000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.SaveQueueWarnAgeMs = 5000

#
#    World.SaveQueueWarnDepth
#        Description: The character save queue warns (at most every 30 s) while this many characters
#                     or more have a snapshot waiting or being written. 0 disables the depth check.
#                     Default 1000 (docs/areas/persistence.md).
#        Type: int
#        Default: 1000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.SaveQueueWarnDepth = 1000

#
#    World.StrictMovementFiniteness
#        Description: Hardening beyond retail: also require pitch, jump speeds/angles and spline
#                     elevation to be finite before a movement block is stored and relayed. Retail
#                     (vmangos VerifyMovementInfo) does not check them, so the default is off. Bound
#                     from World:StrictMovementFiniteness.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#world
#
World.StrictMovementFiniteness = false

#
#    World.TickIntervalMs
#        Description: World tick length in milliseconds (vmangos WORLD_SLEEP_CONST = 50).
#        Type: int
#        Default: 50
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Restart (.reload config keeps the old value and reports that a restart is needed)
#        Docs: docs/reference/configuration.md#world
#
World.TickIntervalMs = 50

#
#    World.TickLateToleranceMs
#        Description: Milliseconds a tick may start after its due time, and a frame may exceed the
#                     tick interval, before it counts as late (WorldTickScheduler.LateTicks) or as a
#                     frame overrun (0..1000, default 2). Read once at world start.
#        Type: int
#        Default: 2
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Restart (.reload config keeps the old value and reports that a restart is needed)
#        Docs: docs/reference/configuration.md#world
#
World.TickLateToleranceMs = 2

#
#    World.TickTimer
#        Description: How the world thread waits for its next tick (WorldTickTimer.Precise by
#                     default). Precise wakes within a fraction of a millisecond of the due time;
#                     Legacy is the plain event wait, which on Windows wakes on the ~15.6 ms system
#                     timer (frame p50 46 / p90 61 ms on a 50 ms tick;
#                     docs/integration/perf-limits-20261008.md). Read once at world start. Values:
#                     Precise, Legacy.
#        Type: WorldTickTimer
#        Default: Precise
#        Allowed: Precise | Legacy
#        Reload: Restart (.reload config keeps the old value and reports that a restart is needed)
#        Docs: docs/reference/configuration.md#world
#
World.TickTimer = Precise

#
#    World.UpdateCompressionThreshold
#        Description: Update packets larger than this many bytes are zlib-compressed into
#                     SMSG_COMPRESSED_UPDATE_OBJECT (vmangos Compression.Update.Size default 128). 0
#                     disables.
#        Type: int
#        Default: 128
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#world
#
World.UpdateCompressionThreshold = 128

#
#    World.WriterDrainGrace
#        Description: How long a closing session lets the writer flush queued frames (for example a
#                     refusal reply) before the stream is torn down so a client that stopped reading
#                     cannot hold the connection, its DI scope and its queued frames forever.
#                     TimeSpan.Zero, the default, means the built-in 5 s bound; the wait is never
#                     unbounded. vmangos does not wait at all: its CloseSocket shuts the socket down
#                     at once (AsyncSocket_windows.cpp:318-329). Bound from World:WriterDrainGrace
#                     (for example "00:00:02").
#        Type: TimeSpan
#        Default: 00:00:00
#        Allowed: a time span, [d.]hh:mm:ss
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#world
#
World.WriterDrainGrace = 00:00:00

#----------------------------------------------------------------------------
# World:Announce
#----------------------------------------------------------------------------

#
#    World.Announce.AntiCheat.AllowNamesInWorldMessage
#        Description: Let the world message carry character names when the announcing code supplies
#                     a text for it. Off by default.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldannounce
#
World.Announce.AntiCheat.AllowNamesInWorldMessage = false

#
#    World.Announce.AntiCheat.DedupSeconds
#        Description: An announcement identical to one delivered this many seconds ago is
#                     suppressed. 0 disables the window.
#        Type: int
#        Default: 30
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldannounce
#
World.Announce.AntiCheat.DedupSeconds = 30

#
#    World.Announce.AntiCheat.GmNotify
#        Description: Send the announcement to every online account above Player (an on-screen
#                     notification and a chat line). Staff only.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldannounce
#
World.Announce.AntiCheat.GmNotify = true

#
#    World.Announce.AntiCheat.IncludeDetails
#        Description: Add the staff-only detail (who, how long, counts, hashes) to the staff chat
#                     line. Players never see it.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldannounce
#
World.Announce.AntiCheat.IncludeDetails = true

#
#    World.Announce.AntiCheat.MinimumSeverity
#        Description: Announcements below this severity are logged and counted but not delivered.
#                     Values: Info, Warning, Error, Critical.
#        Type: AnnounceSeverity
#        Default: Info
#        Allowed: Info | Warning | Error | Critical
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldannounce
#
World.Announce.AntiCheat.MinimumSeverity = Info

#
#    World.Announce.AntiCheat.RateBurst
#        Description: Rate limit: how many announcements of this category may go out back to back
#                     before the limit applies. 0 disables the limit.
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldannounce
#
World.Announce.AntiCheat.RateBurst = 10

#
#    World.Announce.AntiCheat.RatePerMinute
#        Description: Rate limit: announcements of this category refilled per minute once the burst
#                     is used. Suppressed ones are counted and reported on the next delivered
#                     announcement.
#        Type: int
#        Default: 20
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldannounce
#
World.Announce.AntiCheat.RatePerMinute = 20

#
#    World.Announce.AntiCheat.WorldMessage
