###############################################################################
# ANTICHEAT
###############################################################################

#----------------------------------------------------------------------------
# AntiCheat
#----------------------------------------------------------------------------

#
#    AntiCheat.Action
#        Description: The highest escalation ever applied: None (score only), Log, GmAlert,
#                     Rubberband, Kick. A score past a threshold whose action is above this ceiling
#                     gets the ceiling instead. Bound from AntiCheat:Action; default Log. Values:
#                     None, Log, GmAlert, Rubberband, Kick.
#        Type: AntiCheatAction
#        Default: Log
#        Allowed: None | Log | GmAlert | Rubberband | Kick
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.Action = Log

#
#    AntiCheat.Autoban.DecayPerHour
#        Description: Points forgotten per hour. Default 1.
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.Autoban.DecayPerHour = 1

#
#    AntiCheat.Autoban.Enabled
#        Description: Ban accounts on repeated kicks. Default false.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.Autoban.Enabled = false

#
#    AntiCheat.Autoban.FirstBanSeconds
#        Description: Seconds of the first ban (0 is permanent). Default 86400 (one day).
#        Type: long
#        Default: 86400
#        Allowed: a whole number, -9223372036854775808 to 9223372036854775807
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.Autoban.FirstBanSeconds = 86400

#
#    AntiCheat.Autoban.HistoryDays
#        Description: Earlier AntiCheat bans older than this many days do not move the account up
#                     the ladder. Default 180.
#        Type: int
#        Default: 180
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.Autoban.HistoryDays = 180

#
#    AntiCheat.Autoban.KickPoints
#        Description: Points one kick adds. Default 10.
#        Type: float
#        Default: 10
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.Autoban.KickPoints = 10

#
#    AntiCheat.Autoban.LaterBanSeconds
#        Description: Seconds of the third and every later ban (0 is permanent). Default 0
#                     (permanent).
#        Type: long
#        Default: 0
#        Allowed: a whole number, -9223372036854775808 to 9223372036854775807
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.Autoban.LaterBanSeconds = 0

#
#    AntiCheat.Autoban.SecondBanSeconds
#        Description: Seconds of the second ban (0 is permanent). Default 604800 (seven days).
#        Type: long
#        Default: 604800
#        Allowed: a whole number, -9223372036854775808 to 9223372036854775807
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.Autoban.SecondBanSeconds = 604800

#
#    AntiCheat.Autoban.Threshold
#        Description: Points at which the account is banned. Default 25: the third kick within five
#                     hours of the first (the fork's 30 with any decay at all needs a fourth kick).
#        Type: float
#        Default: 25
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.Autoban.Threshold = 25

#
#    AntiCheat.BaselineGapMs
#        Description: A gap this long (milliseconds) between two movement packets starts a new
#                     baseline (loading screen, AFK). Default 3000.
#        Type: int
#        Default: 3000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.BaselineGapMs = 3000

#
#    AntiCheat.BurstPacketsPerSecond
#        Description: Movement packets per second, by the receive clock AND the client's own clock,
#                     that count as a burst. Default 50.
#        Type: int
#        Default: 50
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.BurstPacketsPerSecond = 50

#
#    AntiCheat.ClientTimeRegressionMs
#        Description: A client timestamp that goes back by more than this many milliseconds is
#                     scored. Default 500.
#        Type: int
#        Default: 500
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.ClientTimeRegressionMs = 500

#
#    AntiCheat.DecayPerSecond
#        Description: Score points forgotten per second, so occasional noise never adds up (fork
#                     AntiCheat.Score.DecayPerSec). Default 2.
#        Type: float
#        Default: 2
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.DecayPerSecond = 2

#
#    AntiCheat.Enabled
#        Description: Run the checks at all. Bound from AntiCheat:Enabled; default true (log only,
#                     see Action).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.Enabled = true

#
#    AntiCheat.ExemptManagedBots
#        Description: The server's own managed playerbot sessions are not checked (they are trusted
#                     server code). Bound from AntiCheat:ExemptManagedBots; default true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.ExemptManagedBots = true

#
#    AntiCheat.ExemptSecurity
#        Description: Accounts at or above this security level are not checked; Player checks
#                     everyone (a GM in GM mode is still exempt). Bound from
#                     AntiCheat:ExemptSecurity; default Moderator (every staff account). Values:
#                     Player, Moderator, GameMaster, Administrator.
#        Type: AccountSecurity
#        Default: Moderator
#        Allowed: Player | Moderator | GameMaster | Administrator
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.ExemptSecurity = Moderator

#
#    AntiCheat.FallSuppressYards
#        Description: A drop of this many yards that ends without MSG_MOVE_FALL_LAND is fall-damage
#                     suppression. Default 20.
#        Type: float
#        Default: 20
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.FallSuppressYards = 20

#
#    AntiCheat.GmAlertIntervalSeconds
#        Description: At most one GM alert per offender per this many seconds. Default 10.
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.GmAlertIntervalSeconds = 10

#
#    AntiCheat.LatencySlackMs
#        Description: The base of the latency slack in milliseconds: the time budget of a movement
#                     step is the client's own elapsed time, capped by the server's receive interval
#                     plus this plus twice the ping latency average. Default 1000.
#        Type: int
#        Default: 1000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.LatencySlackMs = 1000

#
#    AntiCheat.Log.CoalesceMs
#        Description: Repeats of one violation type by one character within this many milliseconds
#                     are folded into the row already queued (its count goes up) instead of adding
#                     rows. Default 5000.
#        Type: int
#        Default: 5000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.Log.CoalesceMs = 5000

#
#    AntiCheat.Log.FlushIntervalSeconds
#        Description: Seconds between two flushes of the queued rows. Default 10.
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.Log.FlushIntervalSeconds = 10

#
#    AntiCheat.Log.MaxQueuedRows
#        Description: Most rows waiting in memory; beyond it the newest are dropped and counted.
#                     Default 10000.
#        Type: int
#        Default: 10000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.Log.MaxQueuedRows = 10000

#
#    AntiCheat.Log.MaxRowsPerFlush
#        Description: Most rows written by one flush (the rest wait for the next). Default 500.
#        Type: int
#        Default: 500
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.Log.MaxRowsPerFlush = 500

#
#    AntiCheat.Log.Persist
#        Description: Write violations to character_anticheat_log. Default true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.Log.Persist = true

#
#    AntiCheat.MaxLatencySlackMs
#        Description: The most the latency slack may grow to, in milliseconds. Default 3000.
#        Type: int
#        Default: 3000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.MaxLatencySlackMs = 3000

#
#    AntiCheat.MaxTimeSkipMs
#        Description: A CMSG_MOVE_TIME_SKIPPED reporting more than this many milliseconds is scored
#                     (a client freeze rarely exceeds it). Default 10000.
#        Type: int
#        Default: 10000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.MaxTimeSkipMs = 10000

#
#    AntiCheat.MaxTimeSkipsPer10Seconds
#        Description: More CMSG_MOVE_TIME_SKIPPED than this in ten seconds is scored as spam.
#                     Default 10.
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.MaxTimeSkipsPer10Seconds = 10

#
#    AntiCheat.RubberbandIntervalMs
#        Description: At most one rubberband per offender per this many milliseconds. Default 2000.
#        Type: int
#        Default: 2000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.RubberbandIntervalMs = 2000

#
#    AntiCheat.ScoreGmAlert
#        Description: Score at which the GM alert applies (fork AntiCheat.Score.Warn). Default 30.
#        Type: float
#        Default: 30
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.ScoreGmAlert = 30

#
#    AntiCheat.ScoreKick
#        Description: Score at which the session is disconnected (fork AntiCheat.Score.Kick).
#                     Default 120.
#        Type: float
#        Default: 120
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.ScoreKick = 120

#
#    AntiCheat.ScoreRubberband
#        Description: Score at which the player is moved back to the last validated position (fork
#                     AntiCheat.Score.Rubberband). Default 60.
#        Type: float
#        Default: 60
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.ScoreRubberband = 60

#
#    AntiCheat.SpeedChangeGraceMs
#        Description: After a speed change is acknowledged the previous (higher) speed still counts
#                     for this long, in milliseconds, plus the latency slack, so packets already in
#                     flight are never judged by the new speed. Default 2000.
#        Type: int
#        Default: 2000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.SpeedChangeGraceMs = 2000

#
#    AntiCheat.SpeedClock.CooldownMs
#        Description: After firing it stays silent for this long (milliseconds). Default 10000.
#        Type: int
#        Default: 10000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.SpeedClock.CooldownMs = 10000

#
#    AntiCheat.SpeedClock.Enabled
#        Description: Run it. Default true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.SpeedClock.Enabled = true

#
#    AntiCheat.SpeedClock.MaxGapMs
#        Description: A pair further apart than this (milliseconds) is ignored (the player stood
#                     still or the client froze). Default 3000.
#        Type: int
#        Default: 3000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.SpeedClock.MaxGapMs = 3000

#
#    AntiCheat.SpeedClock.MinSamples
#        Description: Usable pairs needed before the window is judged. Default 12.
#        Type: int
#        Default: 12
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.SpeedClock.MinSamples = 12

#
#    AntiCheat.SpeedClock.SustainWindows
#        Description: Consecutive hot evaluations before it fires. Default 3.
#        Type: int
#        Default: 3
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.SpeedClock.SustainWindows = 3

#
#    AntiCheat.SpeedClock.TolerancePercent
#        Description: How much faster than real time, in percent, the client clock may run. Default
#                     30.
#        Type: int
#        Default: 30
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.SpeedClock.TolerancePercent = 30

#
#    AntiCheat.SpeedClock.Window
#        Description: Pairs of consecutive packets in the window. Default 20.
#        Type: int
#        Default: 20
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.SpeedClock.Window = 20

#
#    AntiCheat.SpeedSlackYards
#        Description: Distance in yards that one packet may always cover on top of the speed budget
#                     (rounding, collision push). Default 2.
#        Type: float
#        Default: 2
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.SpeedSlackYards = 2

#
#    AntiCheat.SpeedTolerancePercent
#        Description: Tolerance above the allowed speed, in percent, before the speed check scores.
#                     Default 10.
#        Type: float
#        Default: 10
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.SpeedTolerancePercent = 10

#
#    AntiCheat.StaffNoticeCooldownSeconds
#        Description: The staff line for a kick, an autoban or a failed autoban is sent at most once
#                     per account and kind per this many seconds; repeats inside the window are
#                     counted and reported as one "N more suppressed" line. Independent of
#                     World:Announce. 0 sends every line. 0-3600, default 30.
#        Type: int
#        Default: 30
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.StaffNoticeCooldownSeconds = 30

#
#    AntiCheat.TeleportDistance
#        Description: One packet moving farther than this, plus what the speed covers in the latency
#                     slack, is a teleport (fork AntiCheat.Teleport.Distance). Default 50.
#        Type: float
#        Default: 50
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.TeleportDistance = 50

#
#    AntiCheat.TerrainChecks
#        Description: Run the checks that need world geometry (swimming out of water, climbing into
#                     the air, walking through a wall). Each runs only where the terrain or vmap
#                     data for that spot is actually loaded; without data it never scores. Default
#                     true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#anticheat
#
AntiCheat.TerrainChecks = true

###############################################################################
# AUCTIONHOUSEBOT
###############################################################################

#----------------------------------------------------------------------------
# AuctionHouseBot
#----------------------------------------------------------------------------

#
#    AuctionHouseBot.BidMaxPercent
#        Description: Highest starting bid as a percent of the buyout (cMaNGOS
#                     AuctionHouseBot.Bid.Max, 0-100, default 90).
#        Type: uint
#        Default: 90
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#auctionhousebot
#
AuctionHouseBot.BidMaxPercent = 90

#
#    AuctionHouseBot.BidMinPercent
#        Description: Lowest starting bid as a percent of the buyout (cMaNGOS
#                     AuctionHouseBot.Bid.Min, 0-100, default 75).
#        Type: uint
#        Default: 75
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#auctionhousebot
#
AuctionHouseBot.BidMinPercent = 75

#
#    AuctionHouseBot.Bidding
#        Description: Whether the buyer also bids (cMaNGOS AuctionBotBuyer: an auction whose buyout
#                     is above the bot's value, but whose next bid is below it, gets that next bid).
#                     Default true. A bot bid stands with no bidding character; if it wins, the item
#                     leaves the economy and the seller is paid as for any sale.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#auctionhousebot
#
AuctionHouseBot.Bidding = true

#
#    AuctionHouseBot.Blacklist
#        Description: Item entries the bot never lists or buys, comma-separated (cMaNGOS ahbot_items
#                     rows with value 0).
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#auctionhousebot
#
AuctionHouseBot.Blacklist = ""

#
#    AuctionHouseBot.BuyChance
#        Description: Percent chance a buy action buys anything (cMaNGOS AuctionHouseBot.Chance.Buy,
#                     0-100, default 10).
#        Type: uint
#        Default: 10
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#auctionhousebot
#
AuctionHouseBot.BuyChance = 10

#
#    AuctionHouseBot.BuyValuePercent
#        Description: The most the buyer pays, as a percent of the bot's own value of the item
#                     (cMaNGOS AuctionHouseBot.Buy.Value, 0-200, default 80).
#        Type: uint
#        Default: 80
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#auctionhousebot
#
AuctionHouseBot.BuyValuePercent = 80

#
#    AuctionHouseBot.DailyBuyBudgetCopper
#        Description: Custody limit: most copper the buyer may pay out per UTC day, all houses
#                     together (MaNGOS Zero custody; 0 = the buyer never buys).
#        Type: uint
#        Default: 10000000
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#auctionhousebot
#
AuctionHouseBot.DailyBuyBudgetCopper = 10000000

#
#    AuctionHouseBot.DailyItemBudget
#        Description: Custody limit: most items the bot may create into the houses per UTC day, all
#                     houses together (MaNGOS Zero custody; 0 = none).
#        Type: uint
#        Default: 5000
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#auctionhousebot
#
AuctionHouseBot.DailyItemBudget = 5000

