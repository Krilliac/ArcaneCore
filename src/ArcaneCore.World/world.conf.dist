#
World.Playerbots.Chat.Voice.RunCalls = true

#
#    World.Playerbots.Chat.Voice.Trade
#        Description: Trade calls (on by default): WTS for tradeable surplus in the bot's bags (no
#                     grey, no bind-on-pickup or bound item, no quest item, nothing it would wear
#                     itself) at PriceMultiplier times the vendor price, and WTB for the reagents of
#                     the recipes it wants; in Trade in a capital, now and then in General elsewhere
#                     (GeneralSharePercent). A real player who whispers the seller about the item is
#                     told the price and where the bot is.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Voice.Trade = true

#
#    World.Playerbots.Chat.Voice.TradeRepeatSeconds
#        Description: The least seconds between two trade calls of one bot (60..86400).
#        Type: int
#        Default: 900
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Voice.TradeRepeatSeconds = 900

#
#    World.Playerbots.ClientFidelity
#        Description: How much real-client packet work a bot's session does
#                     (PlayerbotClientFidelity.Lean by default). Lean: a bot has no client, so the
#                     map builds no SMSG_UPDATE_OBJECT blocks for it (its visible set is still
#                     maintained) and its session keeps only the received packets a bot reads back
#                     (PlayerbotPacketIntake). Full: bots are treated like real clients, every
#                     packet is built, compressed and copied into the bot's receive ring, which is
#                     the stress-test mode for load testing. A session with an observer attached
#                     (scenario, packet capture) always receives everything. Read at start; a
#                     restart applies a change. Values: Lean, Full.
#        Type: PlayerbotClientFidelity
#        Default: Lean
#        Allowed: Lean | Full
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.ClientFidelity = Lean

#
#    World.Playerbots.Combat.Kite.Enabled
#        Description: Kite at all (on by default).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Combat.Kite.Enabled = true

