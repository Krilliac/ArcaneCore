#                     enchant spell effects unregistered.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#enchanting
#
Enchanting.Enabled = true

#
#    Enchanting.GmAllowTrades
#        Description: vmangos GM.AllowTrades (default true, World.cpp:680): false keeps a game
#                     master's enchant spells from landing (SpellEffects.cpp:3029).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#enchanting
#
Enchanting.GmAllowTrades = true

#
#    Enchanting.SpellItemEnchantmentDbcPath
#        Description: Build-5875 SpellItemEnchantment.dbc (24 fields). Without it the engine is
#                     inactive and says so in the log: no enchantment can be applied or resolved (a
#                     configured file that is unreadable or has another layout refuses startup).
#        Type: string
#        Default: (not set)
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#enchanting
#
# Enchanting.SpellItemEnchantmentDbcPath =

