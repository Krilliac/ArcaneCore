Skills.AlwaysMaxSkillForLevel = false

#
#    Skills.ChanceGreen
#        Description: vmangos SkillChance.Green (default 25).
#        Type: uint
#        Default: 25
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#skills
#
Skills.ChanceGreen = 25

#
#    Skills.ChanceGrey
#        Description: vmangos SkillChance.Grey (default 0).
#        Type: uint
#        Default: 0
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#skills
#
Skills.ChanceGrey = 0

#
#    Skills.ChanceOrange
#        Description: vmangos SkillChance.Orange (default 100).
#        Type: uint
#        Default: 100
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
