#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#auctionhousebot
#
AuctionHouseBot.ValuePoor = ""

#
#    AuctionHouseBot.ValueRare
#        Description: Deprecated override of the quality 3 (rare, blue) auction_bot_value rows; see
