# NpcServices
#----------------------------------------------------------------------------

#
#    NpcServices.BankBagSlotPricesDbcPath
#        Description: Build-5875 BankBagSlotPrices.dbc.
#        Type: string
#        Default: (not set)
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#npcservices
#
# NpcServices.BankBagSlotPricesDbcPath =

#
#    NpcServices.DurabilityCostsDbcPath
#        Description: Build-5875 DurabilityCosts.dbc (repair multipliers by item level).
#        Type: string
#        Default: (not set)
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#npcservices
#
# NpcServices.DurabilityCostsDbcPath =

#
#    NpcServices.DurabilityQualityDbcPath
#        Description: Build-5875 DurabilityQuality.dbc (repair quality factors).
#        Type: string
#        Default: (not set)
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#npcservices
#
# NpcServices.DurabilityQualityDbcPath =

#
#    NpcServices.NpcTemplates
#        Description: Optional per-entry overrides for imported creature_template gossip_menu_id and
#                     trainer_*. Without an override, CreatureQuestLookup uses the World v21
#                     imported fields.
#        Type: List<NpcTemplateMetadata>
#        Default: (empty list)
#        Allowed: a list: numbered keys 0, 1, 2, ...; each entry is a group of keys
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#npcservices
#
# Empty by default. Each entry is a group of keys: NpcServices.NpcTemplates.0.<Field> = value, NpcServices.NpcTemplates.1.<Field> = value, ...

#
#    NpcServices.SkillLineAbilityDbcPath
#        Description: Build-5875 SkillLineAbility.dbc (trainer rank prerequisites, race/class fit).
#        Type: string
#        Default: (not set)
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
