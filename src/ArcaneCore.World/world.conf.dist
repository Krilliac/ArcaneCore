#        Default: 1200
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Voice.QuestHelpRepeatSeconds = 1200

#
#    World.Playerbots.Chat.Voice.RunCalls
#        Description: The bot that leads a dungeon or raid run says the plan in party or raid chat:
