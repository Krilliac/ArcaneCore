#----------------------------------------------------------------------------
# World:Chat
#----------------------------------------------------------------------------

#
#    World.Chat.AddonChannel
#        Description: AddonChannel (vmangos mangosd.conf.dist.in:419, mangos-classic
#                     mangosd.conf.dist.in, default 1): when off, messages in the addon language are
#                     dropped (vmangos ChatHandler.cpp HandleChatMessageOpcode "Disabled addon
#                     channel?").
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldchat
#
World.Chat.AddonChannel = true

#
#    World.Chat.AddonMuteAndFloodControl
#        Description: ArcaneCore extension: apply the existing mute and flood gates to addon traffic
#                     before offering it to chat features. Uses the same counter, limits and staff
#                     exemption as spoken chat. Off by default: vmangos ChatHandler.cpp:165-236
#                     explicitly exempts LANG_ADDON from both gates (verified at commit
#                     0e3ff01e76d4758e8a7c3108b2717cc785ed56fa).
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldchat
#
World.Chat.AddonMuteAndFloodControl = false

#
#    World.Chat.ChatChannelsDbcPath
#        Description: Path of the developer's own 1.12.1 ChatChannels.dbc (no client data ships with
#                     the server). When set, the built-in channels (ids, flags and every locale's
#                     name pattern) come from it, as vmangos loads them (DBCStores.cpp
#                     sChatChannelsStore, GetChannelEntryFor); a file that cannot be read or is not
#                     the build 5875 layout stops the start. Empty (the default): the six
#                     transcribed 1.12.1 rows, English names only, so a non-English client's General
#                     or Trade channel is created as a custom channel. Read at start.
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldchat
#
World.Chat.ChatChannelsDbcPath = ""

#
#    World.Chat.EmotesDbcPath
#        Description: Path of the developer's own 1.12.1 Emotes.dbc (whether an emote is a one-shot
#                     animation or a state, vmangos Unit::HandleEmote). See EmotesTextDbcPath.
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldchat
#
World.Chat.EmotesDbcPath = ""

#
#    World.Chat.EmotesTextDbcPath
#        Description: Path of the developer's own 1.12.1 EmotesText.dbc. With it (and
#                     EmotesDbcPath), a text emote plays its animation and an unknown one is
#                     dropped, as vmangos HandleTextEmoteOpcode does with sEmotesTextStore; without
#                     it a text emote is only announced. Both paths or neither; a file that cannot
#                     be read stops the start. Read at start.
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldchat
#
World.Chat.EmotesTextDbcPath = ""

#
#    World.Chat.FakeMessagePreventing
#        Description: ChatFakeMessagePreventing (vmangos mangosd.conf.dist.in:1663, World.cpp:756,
#                     vmangos default on, mangos-classic World.cpp:681 and this option default off;
#                     opt in with true): collapse every run of space, tab, bell and newline in a
#                     chat message into one space (vmangos stripLineInvisibleChars,
#                     shared/Util.cpp:134). Addon messages are not touched.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldchat
#
World.Chat.FakeMessagePreventing = false

#
#    World.Chat.FloodMessageCount
#        Description: ChatFlood.MessageCount (vmangos mangosd.conf.dist.in:1666, mangos-classic
#                     mangosd.conf.dist.in, default 10): how many messages inside the delay window
#                     mute the speaker; 0 disables flood control (vmangos
#                     MasterPlayer::UpdateSpeakTime, MasterPlayerChat.cpp:10).
#        Type: uint
#        Default: 10
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldchat
#
World.Chat.FloodMessageCount = 10

#
#    World.Chat.FloodMessageDelaySeconds
#        Description: ChatFlood.MessageDelay (vmangos mangosd.conf.dist.in:1667, default 1 second).
#        Type: uint
#        Default: 1
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldchat
#
World.Chat.FloodMessageDelaySeconds = 1

#
#    World.Chat.FloodMuteSeconds
#        Description: ChatFlood.MuteTime (vmangos mangosd.conf.dist.in:1668, default 10 seconds).
#        Type: uint
#        Default: 10
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldchat
#
World.Chat.FloodMuteSeconds = 10

#
#    World.Chat.GmWhisperingTo
#        Description: GM.WhisperingTo (vmangos mangosd.conf.dist.in:2531, World.cpp:672,
#                     Player.cpp:15132): whether a game master accepts whispers from plain players
#                     at login. 0 = no, 1 = yes. vmangos' default 2 means "the state saved at the
#                     last logout"; persisting it needs a Characters schema change that no lane has
#                     made, so 2 is not offered and the retail first-login state (0) is the default.
#        Type: int
#        Default: 0
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldchat
#
World.Chat.GmWhisperingTo = 0

#
#    World.Chat.MaxAwayMessageLength
#        Description: ArcaneCore hardening: the longest AFK or DND reply kept on the player
#                     (characters), which is sent to every whisperer; longer text is cut to this
#                     length at a safe boundary (never inside a link or a surrogate pair). 0 = no
#                     cap. The stock client's own limit is UNVERIFIED (not captured from a real
#                     client); the 255-character chat edit box is a belief, not a measurement. The
#                     default (1024) is chosen to sit well above it. This cap, not MaxMessageLength,
#                     applies to AFK and DND text.
#        Type: int
#        Default: 1024
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldchat
#
World.Chat.MaxAwayMessageLength = 1024

#
#    World.Chat.MaxMessageLength
#        Description: ArcaneCore hardening: the longest CMSG_MESSAGECHAT text (characters) accepted;
#                     a longer message is dropped before any gate or broadcast. 0 = no cap. Not
#                     applied to AFK and DND text (MaxAwayMessageLength cuts that instead). The
#                     stock client's limit is UNVERIFIED (not captured from a real client); the
#                     default (1024) assumes an edit box of about 255 characters, which is
#                     unconfirmed, and leaves a wide margin above it.
#        Type: int
#        Default: 1024
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldchat
#
World.Chat.MaxMessageLength = 1024

#
#    World.Chat.StrictLinkKick
#        Description: ChatStrictLinkChecking.Kick (vmangos mangosd.conf.dist.in:1665, default off):
#                     disconnect a player whose message fails the link check instead of just
#                     dropping it.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldchat
#
World.Chat.StrictLinkKick = false

#
#    World.Chat.StrictLinkSeverity
#        Description: ChatStrictLinkChecking.Severity (vmangos mangosd.conf.dist.in:1664,
#                     World.cpp:758, vmangos default 2, mangos-classic World.cpp:683 and this option
#                     default 0; opt in with 2): 0 off, 1 only the pipe commands c/H/h/r and escaped
#                     pipes are allowed, 2 they must also come in the order c, H, h, h, r (vmangos
#                     ChatHandler::isValidChatMessage, Chat.cpp:2165-2208). vmangos' level 3 also
#                     checks every item, enchant and spell link against the DBC and item catalogs;
#                     those are not available to the chat handlers, so 3 behaves as 2. A message
#                     over 255 bytes or with a bad link is dropped.
#        Type: int
#        Default: 0
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldchat
#
World.Chat.StrictLinkSeverity = 0

#
#    World.Chat.WordFilter
#        Description: ArcaneCore extension after AscEmu Management/WordFilter.cpp: apply the world
#                     chat_word_filter rows (schema 47) to player chat (censor or block) and to new
#                     character and pet names. Off by default: neither retail 1.12 nor
#                     vmangos/cMaNGOS filter chat text. The rows are reloaded with .reload
#                     chat_word_filter.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldchat
#
World.Chat.WordFilter = false

#----------------------------------------------------------------------------
# World:Collision
#----------------------------------------------------------------------------

#
#    World.Collision.EnableHeight
#        Description: Use vmaps for floor heights (vmangos vmap.enableHeight, default on).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcollision
#
World.Collision.EnableHeight = true

#
#    World.Collision.EnableLineOfSight
#        Description: Use vmaps for line of sight (vmangos vmap.enableLOS, default on).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcollision
#
World.Collision.EnableLineOfSight = true

#
#    World.Collision.EnablePathfinding
#        Description: Use navmeshes for paths (vmangos mmap.enabled, default on).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcollision
#
World.Collision.EnablePathfinding = true

#
#    World.Collision.MMapDirectory
#        Description: Directory of the generated navmeshes (NNN.mmap, NNNXXYY.mmtile). Empty: mmaps/
#                     under World:Maps:DataDirectory (vmangos DataDir/mmaps).
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcollision
#
World.Collision.MMapDirectory = ""

#
#    World.Collision.NavTileReadConcurrency
#        Description: The most navigation tile files (NNNXXYY.mmtile) read at the same time by bots'
#                     path searches, in the background. Reads share the data disk with the map, so a
#                     low number keeps a cold start from starving it; a tile a search waits for is
#                     then ready a little later. At least 1.
#        Type: int
#        Default: 2
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcollision
#
World.Collision.NavTileReadConcurrency = 2

#
#    World.Collision.VMapDirectory
#        Description: Directory of the extracted vmaps (NNN.vmtree, NNN_YY_XX.vmtile, *.vmo). Empty:
#                     vmaps/ under World:Maps:DataDirectory (vmangos DataDir/vmaps).
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcollision
#
World.Collision.VMapDirectory = ""

#----------------------------------------------------------------------------
# World:Console
#----------------------------------------------------------------------------

#
#    World.Console.Enabled
#        Description: Accept typed GM commands at the daemon's console window when standard input is
#                     an interactive console. The commands run on the world thread with
#                     Administrator authority and no character. Never starts a reader when input is
#                     redirected (services, tests, deploy scripts). Default on.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldconsole
#
World.Console.Enabled = true

#----------------------------------------------------------------------------
# World:Control:MapFeed
#----------------------------------------------------------------------------

#
#    World.Control.MapFeed.AnomaliesUnowned
#        Description: Whether the anomaly ring keeps notices that carry no owner identity
#                     (AnomalyNotice.Origin null). The ledger is process-wide, and a notice with an
#                     owner is kept only when the owner is this world; a reporter that passes none
#                     cannot be told apart, so it is kept only when this is true. Default true,
#                     because the daemon runs one world per process; tests that run several worlds
#                     in one process set it false.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolmapfeed
#
World.Control.MapFeed.AnomaliesUnowned = true

#
#    World.Control.MapFeed.Enabled
#        Description: Serve the map feed on a local Windows named pipe. A connected tool may watch
#                     one map at a time (players, bots, creatures, game objects, creature splines,
#                     bot routes, loaded grids) and ask for line of sight, ground height, a
#                     navigation path or an under-map verdict between two points of a map; nothing
#                     it sends changes the world, and a question never loads a tile. The pipe admits
#                     only the account the daemon runs as and SYSTEM, refuses network clients, and
#                     is not created on other operating systems. While nobody is subscribed the feed
#                     does no work on the world thread. Default off.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolmapfeed
#
World.Control.MapFeed.Enabled = false

#
#    World.Control.MapFeed.MaxConnections
#        Description: The most tools connected at once: one pipe instance each, all created at
#                     start. A tool beyond the limit finds the pipe busy and is not served. 1 to 16.
#        Type: int
#        Default: 2
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolmapfeed
#
World.Control.MapFeed.MaxConnections = 2

#
#    World.Control.MapFeed.MaxEntitiesPerFrame
#        Description: The most entities one frame carries. Players and bots come first, then
#                     creatures (moving ones before idle ones) and game objects; the rest are
#                     counted as truncated in the frame. 16 to 65536.
#        Type: int
#        Default: 4096
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolmapfeed
#
World.Control.MapFeed.MaxEntitiesPerFrame = 4096

#
#    World.Control.MapFeed.MaxHz
#        Description: The most frames per second any subscription gets; a tool asking for more is
#                     given this rate. 1 to 60.
#        Type: int
#        Default: 5
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolmapfeed
#
World.Control.MapFeed.MaxHz = 5

#----------------------------------------------------------------------------
# World:Control:MapFeed:Actions
#----------------------------------------------------------------------------

#
#    World.Control.MapFeed.Actions.AllowOnLiveServer
#        Description: A second, deliberate opt-in: let Enabled take effect on the live server
#                     (ARCANECORE_LIVE_SERVER=1, set by the live launcher, which runs the server as
#                     Development). The daemon then logs a warning at start. Default off.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolmapfeedactions
#
World.Control.MapFeed.Actions.AllowOnLiveServer = false

#
#    World.Control.MapFeed.Actions.AuditDirectory
#        Description: The directory of the durable audit file; null: logs beside the working
#                     directory (where the server log goes).
#        Type: string
#        Default: (not set)
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolmapfeedactions
#
# World.Control.MapFeed.Actions.AuditDirectory =

#
#    World.Control.MapFeed.Actions.AuditLocalDurable
#        Description: Also append local actions to the durable audit file (atlas-web-audit.jsonl).
#                     Web actions are always recorded. Default on.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolmapfeedactions
#
World.Control.MapFeed.Actions.AuditLocalDurable = true

#
#    World.Control.MapFeed.Actions.BulkConfirmAbove
#        Description: A template applied to more targets than this needs a confirm code. 0 to 50.
#                     Default 1.
#        Type: int
#        Default: 1
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolmapfeedactions
#
World.Control.MapFeed.Actions.BulkConfirmAbove = 1

#
#    World.Control.MapFeed.Actions.Deny
#        Description: Command paths no actor may run, local included (same matching as PublicDeny).
#                     Default none.
#        Type: List<string>
#        Default: (empty list)
#        Allowed: a list: numbered keys 0, 1, 2, ...; each value is text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolmapfeedactions
#
# Empty by default.
# World.Control.MapFeed.Actions.Deny.0 =

#
#    World.Control.MapFeed.Actions.Enabled
#        Description: Accept action requests on the map feed (World:Control:MapFeed:Enabled must be
#                     on too). Default off.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolmapfeedactions
#
World.Control.MapFeed.Actions.Enabled = false

#
#    World.Control.MapFeed.Actions.LocalAccountId
#        Description: The account id the local actor counts as for "my own character" checks (.atlas
#                     tele of a player at GameMaster level). Set here, in the world's configuration,
#                     never by a tool. Default none: the local actor has no account.
#        Type: int?
#        Default: (not set)
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolmapfeedactions
#
# World.Control.MapFeed.Actions.LocalAccountId =

#
#    World.Control.MapFeed.Actions.LocalBurst
#        Description: Local actor: burst. Default 20.
#        Type: int
#        Default: 20
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolmapfeedactions
#
World.Control.MapFeed.Actions.LocalBurst = 20

#
#    World.Control.MapFeed.Actions.LocalPerSecond
#        Description: Local actor: actions per second. Default 10.
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolmapfeedactions
#
World.Control.MapFeed.Actions.LocalPerSecond = 10

#
#    World.Control.MapFeed.Actions.LocalSecurity
#        Description: The security the local actor (whoever controls the daemon's Windows account on
#                     this machine; the world sees "the daemon account") runs commands at. Player to
#                     Administrator: there is no Console level, so the local actor is never the true
#                     console. Default Administrator. Values: Player, Moderator, GameMaster,
#                     Administrator.
#        Type: AccountSecurity
#        Default: Administrator
#        Allowed: Player | Moderator | GameMaster | Administrator
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolmapfeedactions
#
World.Control.MapFeed.Actions.LocalSecurity = Administrator

#
#    World.Control.MapFeed.Actions.PublicAllowModeration
#        Description: Let web actors run .ban and .unban: removes them from PublicDeny. Default off.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolmapfeedactions
#
World.Control.MapFeed.Actions.PublicAllowModeration = false

#
#    World.Control.MapFeed.Actions.PublicDeny
#        Description: Command paths no web actor may run, matched on the path the command table
#                     resolved (so an abbreviation cannot dodge a rule): a path is denied when it
#                     starts with an entry's words ("ban" denies "ban account", "botctl raw" denies
#                     "botctl raw send"). The default list is the account, lifecycle, reload,
#                     hot-code, raw bot and moderation commands.
#        Type: List<string>
#        Default: 0 = account; 1 = server shutdown; 2 = server restart; 3 = server idleshutdown; 4 =
#                 server idlerestart; 5 = reload; 6 = hotcode; 7 = hotmodule; 8 = botctl raw; 9 =
#                 ban; 10 = unban
#        Allowed: a list: numbered keys 0, 1, 2, ...; each value is text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolmapfeedactions
#
# These entries are the default list. They are commented out because a list you write is appended to the default list, not
# substituted for it; uncomment them only to document the list, or set the keys of the entries you want to add.
# World.Control.MapFeed.Actions.PublicDeny.0 = "account"
# World.Control.MapFeed.Actions.PublicDeny.1 = "server shutdown"
# World.Control.MapFeed.Actions.PublicDeny.2 = "server restart"
# World.Control.MapFeed.Actions.PublicDeny.3 = "server idleshutdown"
# World.Control.MapFeed.Actions.PublicDeny.4 = "server idlerestart"
# World.Control.MapFeed.Actions.PublicDeny.5 = "reload"
# World.Control.MapFeed.Actions.PublicDeny.6 = "hotcode"
# World.Control.MapFeed.Actions.PublicDeny.7 = "hotmodule"
# World.Control.MapFeed.Actions.PublicDeny.8 = "botctl raw"
# World.Control.MapFeed.Actions.PublicDeny.9 = "ban"
# World.Control.MapFeed.Actions.PublicDeny.10 = "unban"

#
#    World.Control.MapFeed.Actions.PublicMaxSecurity
#        Description: The highest security a web actor runs at, whatever its account has. Default
#                     GameMaster. Values: Player, Moderator, GameMaster, Administrator.
#        Type: AccountSecurity
#        Default: GameMaster
#        Allowed: Player | Moderator | GameMaster | Administrator
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolmapfeedactions
#
World.Control.MapFeed.Actions.PublicMaxSecurity = GameMaster

#
#    World.Control.MapFeed.Actions.SettleSeconds
#        Description: Seconds an action waits for its command to settle (a command that holds itself
#                     open) before the answer goes out. 1 to 600. Default 30.
#        Type: int
#        Default: 30
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolmapfeedactions
#
World.Control.MapFeed.Actions.SettleSeconds = 30

#
#    World.Control.MapFeed.Actions.WebAuditDays
#        Description: Days the durable audit file's rotated copies are kept. 1 to 3650. Default 90.
#        Type: int
#        Default: 90
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolmapfeedactions
#
World.Control.MapFeed.Actions.WebAuditDays = 90

#
#    World.Control.MapFeed.Actions.WebBurst
#        Description: Each web actor: burst. Default 5.
#        Type: int
#        Default: 5
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolmapfeedactions
#
World.Control.MapFeed.Actions.WebBurst = 5

#
#    World.Control.MapFeed.Actions.WebLogin
#        Description: Accept web actors (tickets issued by the public Atlas listener's login). Needs
#                     the true-console predicate (CommandContextConsole, design 1.7) in this build:
#                     without it the channel logs a warning and refuses web actors. Default off.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolmapfeedactions
#
World.Control.MapFeed.Actions.WebLogin = false

#
#    World.Control.MapFeed.Actions.WebLoginMinSecurity
#        Description: The lowest account security a web login is accepted for. Default Moderator.
#                     Values: Player, Moderator, GameMaster, Administrator.
#        Type: AccountSecurity
#        Default: Moderator
#        Allowed: Player | Moderator | GameMaster | Administrator
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolmapfeedactions
#
World.Control.MapFeed.Actions.WebLoginMinSecurity = Moderator

#
#    World.Control.MapFeed.Actions.WebPerSecond
#        Description: Each web actor: actions per second. Default 2.
#        Type: int
#        Default: 2
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolmapfeedactions
#
World.Control.MapFeed.Actions.WebPerSecond = 2

#----------------------------------------------------------------------------
# World:Control:MapFeed:Web
#----------------------------------------------------------------------------

#
#    World.Control.MapFeed.Web.ClientAccount
#        Description: The one Windows account allowed to open the web pipe: a SID (S-1-5-21-...) or
#                     an account name (MACHINE\atlas-public). Required when Enabled is set; without
#                     it the pipe is not created. A group or built-in principal is refused
#                     (Everyone, Authenticated Users, SYSTEM, LOCAL/NETWORK SERVICE, BUILTIN\, NT
#                     AUTHORITY\ and NT SERVICE\ names, S-1-5-32-*, any account with a RID below
#                     1000), and so is the daemon's own account: Problems checks the text at
#                     start-up, the pipe checks the resolved SID.
#        Type: string
#        Default: (not set)
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolmapfeedweb
#
# World.Control.MapFeed.Web.ClientAccount =

#
#    World.Control.MapFeed.Web.Enabled
#        Description: Serve the web pipe (World:Control:MapFeed:Enabled must be on too). Default
#                     off.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolmapfeedweb
#
World.Control.MapFeed.Web.Enabled = false

#
#    World.Control.MapFeed.Web.MaxConnections
#        Description: The most web connections at once, independent of the local pipe's count. 1 to
#                     8. Default 2.
#        Type: int
#        Default: 2
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolmapfeedweb
#
World.Control.MapFeed.Web.MaxConnections = 2

#----------------------------------------------------------------------------
# World:Control:PacketTools
#----------------------------------------------------------------------------

#
#    World.Control.PacketTools.AllowOutsideDevelopment
#        Description: A second, deliberate opt-in: let Enabled take effect when the host environment
#                     is not Development (Staging, Production or unset). The tools then start with a
#                     warning naming the environment. Never set this on a server players use.
#                     Default off.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolpackettools
#
World.Control.PacketTools.AllowOutsideDevelopment = false

#
#    World.Control.PacketTools.Enabled
#        Description: Offer the packet tools on the map feed's pipe (World:Control:MapFeed:Enabled
#                     must be on too). A connected tool may then run console commands with the
#                     console's Administrator authority, inject client opcodes as an online player
#                     or bot, send server opcodes to its client and watch its packets. Every console
#                     line, injection and send is logged and counted. Refused, with a warning at
#                     start, outside the Development environment unless AllowOutsideDevelopment is
#                     also true. Changing it needs a restart. Default off.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolpackettools
#
World.Control.PacketTools.Enabled = false

#----------------------------------------------------------------------------
# World:Control:Pipe
#----------------------------------------------------------------------------

#
#    World.Control.Pipe.Enabled
#        Description: Accept console commands on a local Windows named pipe. Each line runs exactly
#                     like a line typed at the console: on the world thread, Administrator
#                     authority, no character, logged and GM-audited as the console. The pipe admits
#                     only the account the daemon runs as and SYSTEM, refuses network clients, and
#                     is not created on other operating systems. Default off.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolpipe
#
World.Control.Pipe.Enabled = false

#
#    World.Control.Pipe.IdleTimeoutSeconds
#        Description: Seconds a connected client may stay silent before the daemon closes the
#                     connection (frees the single pipe instance).
#        Type: int
#        Default: 120
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolpipe
#
World.Control.Pipe.IdleTimeoutSeconds = 120

#
#    World.Control.Pipe.MaxLineLength
#        Description: The longest command line in bytes; a longer line closes the connection without
#                     running anything.
#        Type: int
#        Default: 4096
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolpipe
#
World.Control.Pipe.MaxLineLength = 4096

#
#    World.Control.Pipe.Name
#        Description: The pipe name (without \\.\pipe\); {pid} is replaced by the world process id,
#                     so two daemons on one machine never share a name. The daemon refuses to serve
#                     a name another process already created. Letters, digits, '.', '_', '-' and the
#                     token only.
#        Type: string
#        Default: "arcanecore-world-{pid}"
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldcontrolpipe
#
World.Control.Pipe.Name = "arcanecore-world-{pid}"

#----------------------------------------------------------------------------
# World:Death
#----------------------------------------------------------------------------

#
#    World.Death.CorpseReclaimDelayPvE
#        Description: vmangos Death.CorpseReclaimDelay.PvE (mangosd.conf.dist.in:2851, default 1),
#                     for non-PvP deaths.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worlddeath
#
World.Death.CorpseReclaimDelayPvE = true

#
#    World.Death.CorpseReclaimDelayPvP
#        Description: vmangos Death.CorpseReclaimDelay.PvP (mangosd.conf.dist.in:2850, default 1):
#                     after a PvP death the corpse reclaim delay scales with recent deaths; off, it
#                     is always 30 s (Player.cpp:20184-20188).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worlddeath
#
World.Death.CorpseReclaimDelayPvP = true

#
#    World.Death.GhostFormAura
#        Description: Whether a released spirit gets the real ghost aura (spell 8326, vmangos
#                     Player::ApplyGhostForm), default on, which is what gives the ghost its +25%
#                     run and swim speed and its visibility flag. Off keeps the earlier behaviour:
#                     only the ghost player flag and water walking, no aura.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worlddeath
#
World.Death.GhostFormAura = true

#
#    World.Death.GraveyardFallbackToDefaults
#        Description: Deviation switch, default off (retail/vmangos): when no graveyard is linked
#                     for the ghost's area or zone and team, vmangos leaves the ghost where it is
#                     (ObjectMgr.cpp:7512-7524 returns null; Player.cpp:5008). On, the
#                     mangos-classic fallback applies instead: the default graveyard of the team,
#                     safe location 4 (Alliance) or 10 (Horde) (GraveyardManager.cpp:146-147,
#                     170-174). Matters where the classic-db data has a graveyard for one team only.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worlddeath
#
World.Death.GraveyardFallbackToDefaults = false

#
#    World.Death.SicknessLevel
#        Description: vmangos Death.SicknessLevel (mangosd.conf.dist.in:2744-2749, World.cpp:772,
#                     default 11): the level from which a spirit-healer resurrection gives
#                     resurrection sickness. It lasts one minute at that level and one more for each
#                     level above, up to the full ten minutes (Player.cpp:4675-4697). -10 gives full
#                     sickness at level 1; a level above the maximum player level gives none.
#        Type: int
#        Default: 11
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worlddeath
#
World.Death.SicknessLevel = 11

#----------------------------------------------------------------------------
# World:Duel
#----------------------------------------------------------------------------

#
#    World.Duel.Enabled
#        Description: Master switch. Off, the duel spell refuses with SPELL_FAILED_NO_DUELING.
#                     Default on (every character knows spell 7266, playercreateinfo_spell).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldduel
#
World.Duel.Enabled = true

#
#    World.Duel.ExpiredRequestIsSilent
#        Description: Both references end an unaccepted request whose flag object expired as FLED
#                     (Player.cpp:6677-6683), which announces a winner. On, that case completes as
#                     INTERRUPTED instead (no winner message).
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldduel
#
World.Duel.ExpiredRequestIsSilent = false

#
#    World.Duel.OutOfBoundsGraceSeconds
#        Description: Seconds out of bounds before the duel is lost as fled (10 in both references).
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldduel
#
World.Duel.OutOfBoundsGraceSeconds = 10

#
#    World.Duel.OutOfBoundsYards
#        Description: Yards from the flag at which the out-of-bounds warning starts: 50 as in
#                     original 1.12 (mangos-classic Player.cpp:6917-6937). vmangos widens it to 75
#                     ("Nostalrius: modified duel distance (50 -&gt; 75m)", Player.cpp:6688-6716),
#                     the option for that behaviour. Retail by default.
#        Type: float
#        Default: 50
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldduel
#
World.Duel.OutOfBoundsYards = 50

#
#    World.Duel.RequireKnownArea
#        Description: vmangos permits a duel when a player's area has no AreaTable row
#                     (SpellEffects.cpp:4689-4701 tests the flag only when the row exists). On, an
#                     unknown area refuses with SPELL_FAILED_NO_DUELING.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldduel
#
World.Duel.RequireKnownArea = false

#
#    World.Duel.ReturnInBoundsYards
#        Description: Yards within which a player who left the area counts as back: 40 as in
#                     original 1.12 (mangos-classic), 70 in vmangos.
#        Type: float
#        Default: 40
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldduel
#
World.Duel.ReturnInBoundsYards = 40

#
#    World.Duel.StartDelaySeconds
#        Description: Seconds between the accept and the start (vmangos Player::UpdateDuelFlag,
#                     Player.cpp:17248-17263: +3). The countdown packet always says 3000 ms
#                     (DuelHandler.cpp:45).
#        Type: int
#        Default: 3
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldduel
#
World.Duel.StartDelaySeconds = 3

#----------------------------------------------------------------------------
# World:Exploration
#----------------------------------------------------------------------------

#
#    World.Exploration.CorrectExploreCheat
#        Description: .explorecheat as vmangos writes it (CharacterCommands.cpp:640-679) is buggy:
#                     it announces the SELECTED player but changes the ISSUER's fields, and "0" ORs
#                     in 0 (does nothing). Default false (retail/vmangos). True applies the effect
#                     to the selected player and really clears on 0.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldexploration
#
World.Exploration.CorrectExploreCheat = false

#
#    World.Exploration.RateXp
#        Description: vmangos Rate.XP.Explore (default 1).
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldexploration
#
World.Exploration.RateXp = 1

#----------------------------------------------------------------------------
# World:GameEvents
#----------------------------------------------------------------------------

#
#    World.GameEvents.AllowReload
#        Description: Registers a .reload game_event sub-command. Retail has none, so the default is
#                     false; it still needs HotReload:Commands like every reload.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgameevents
#
World.GameEvents.AllowReload = false

#
#    World.GameEvents.Announce
#        Description: vmangos Event.Announce (GameEventMgr.cpp:788-789): tell every player in the
#                     world when an event starts. Default false (retail default).
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgameevents
#
World.GameEvents.Announce = false

#
#    World.GameEvents.DateTimeInterpretation
#        Description: How a start_time / end_time that has no zone is read. Default Wall (vmangos:
#                     MySQL UNIX_TIMESTAMP reads the session zone, GameEventMgr.cpp:183);
#                     StandardTime reproduces mangos-classic, whose std::mktime on a zeroed tm never
#                     applies daylight saving (Field.cpp:24-31). Values: Wall, StandardTime.
#        Type: GameEventDateTimeInterpretation
#        Default: Wall
#        Allowed: Wall | StandardTime
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgameevents
#
World.GameEvents.DateTimeInterpretation = Wall

#
#    World.GameEvents.Dialect
#        Description: Which game_event table layout the data is in (Events.GameEventDialect).
#                     Default Auto: decided from the table's own columns when it is loaded; set it
#                     only to override a wrong guess. Values: Auto, CMangos, VMangos.
#        Type: GameEventDialect
#        Default: Auto
#        Allowed: Auto | CMangos | VMangos
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgameevents
#
World.GameEvents.Dialect = Auto

#
#    World.GameEvents.Enabled
#        Description: Whether the game-event service runs at all. Default true. With false no event
#                     ever starts: holiday content, event quests and event spawns stay off (the
#                     pre-wave-4 behaviour).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgameevents
#
World.GameEvents.Enabled = true

#
#    World.GameEvents.LeapDayMode
#        Description: How yearly events count February 29th (Events.LeapDayMode). Default DateStable
#                     (holidays keep their calendar date, as in retail); VmangosLiteral reproduces
#                     the vmangos loop, whose yearly events start a day late in many years. Values:
#                     DateStable, VmangosLiteral.
#        Type: LeapDayMode
#        Default: DateStable
#        Allowed: DateStable | VmangosLiteral
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgameevents
#
World.GameEvents.LeapDayMode = DateStable

#
#    World.GameEvents.ManualStartLengthUnit
#        Description: The unit a manual .event start adds the event length in when its end has
#                     passed (Events.GameEventManualLengthUnit). Default Seconds: retail (vmangos
#                     GameEventMgr.cpp:95, mangos-classic) adds the minutes count as seconds, so
#                     such an event is stopped again after about length seconds; Minutes lets it run
#                     its whole length. Values: Seconds, Minutes.
#        Type: GameEventManualLengthUnit
#        Default: Seconds
#        Allowed: Seconds | Minutes
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgameevents
#
World.GameEvents.ManualStartLengthUnit = Seconds

#
#    World.GameEvents.RestoreServersideEvents
#        Description: mangos-classic never restores a serverside (schedule_type 0) event that was
#                     active at shutdown (its Update skips them and CheckOneGameEvent is false for
#                     their far-future start, GameEventMgr.cpp:634-690), vmangos leaves that state
#                     to its hardcoded handlers. Default false (retail); true re-applies the
#                     serverside events recorded in game_event_status with the resume flag, so their
#                     progress is not lost.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgameevents
#
World.GameEvents.RestoreServersideEvents = false

#
#    World.GameEvents.StartBoundary
#        Description: Whether an event is active AT its start instant (vmangos start &lt;= current,
#                     GameEventMgr.cpp:41) or only after it (mangos-classic start &lt; current,
#                     GameEventMgr.cpp:36-40). Default Auto: the rule of the table's dialect (the
#                     vmangos rule for vmangos tables, the mangos-classic rule for classic-db
#                     tables). Values: Auto, Inclusive, Exclusive.
#        Type: GameEventStartBoundary
#        Default: Auto
#        Allowed: Auto | Inclusive | Exclusive
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgameevents
#
World.GameEvents.StartBoundary = Auto

#
#    World.GameEvents.YearlyRebase
#        Description: How yearly (schedule_type 11) events are moved to the current year
#                     (Events.YearlyRebaseMode). Default SpanNewYear (a holiday that crosses New
#                     Year keeps running, as in retail); MangosLiteral is the mangos-classic code,
#                     which cuts such a holiday at December 31st. Values: SpanNewYear,
#                     MangosLiteral.
#        Type: YearlyRebaseMode
#        Default: SpanNewYear
#        Allowed: SpanNewYear | MangosLiteral
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgameevents
#
World.GameEvents.YearlyRebase = SpanNewYear

#----------------------------------------------------------------------------
# World:GmCommands
#----------------------------------------------------------------------------

#
#    World.GmCommands.AllowDangerousDebug
#        Description: ArcaneCore only: allow the debug commands that can hurt a running world (time
#                     offset, inject, opcode disable, stall, combat RNG override, forced acks,
#                     map/grid unload, watchdog dumps) behind DangerousDebugGate. Off by default;
#                     changing it needs a restart. On the live server (ARCANECORE_LIVE_SERVER=1) the
#                     commands are refused whatever this says.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgmcommands
#
World.GmCommands.AllowDangerousDebug = false

#
#    World.GmCommands.AuditTailSize
#        Description: How many of the latest audit lines .arcane gmlog can show (ArcaneCore only;
#                     the lines are the ones LogCommands writes, kept in memory, lost on restart). 0
#                     keeps none.
#        Type: int
#        Default: 200
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgmcommands
#
World.GmCommands.AuditTailSize = 200

#
#    World.GmCommands.ExactNameFirst
#        Description: A command word matching a command name exactly wins over a longer name that
#                     starts with it (the behaviour before the retail table work). Retail (false)
#                     takes the first table entry the word is a prefix of (hasStringAbbr,
#                     Chat.cpp:1566-1600), with roots in retail order.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgmcommands
#
World.GmCommands.ExactNameFirst = false

#
#    World.GmCommands.HideUnavailable
#        Description: Treat a command above the invoker's level as if it did not exist ("There is no
#                     such command", the behaviour before the retail table work). Retail (false)
#                     resolves the command first and answers "This command is not available to you."
#                     (Chat.cpp:1884-1888).
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgmcommands
#
World.GmCommands.HideUnavailable = false

#
#    World.GmCommands.LiveFx
#        Description: ArcaneCore only, NOT the retail default: registers the .fx GM tooling (music,
#                     sounds, spell visuals, cinematics, zone-under-attack, world states, client
#                     clock speed, screen messages, multi-zone weather and the .fx event presets),
#                     which pushes client-visible effects to the invoker, the selection, the zone,
#                     the map or the server. vmangos has no such root: only .debug play
#                     music|sound|cinematic and .debug worldstate, each to the invoker
#                     (Chat.cpp:288-323). False removes the root (restart to change).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgmcommands
#
World.GmCommands.LiveFx = true

#
#    World.GmCommands.LiveFxDbcDirectory
#        Description: ArcaneCore only: a directory of the developer's own build-5875 client DBC
#                     files (nothing is shipped). When set, .fx music/sound refuse an id not in
#                     SoundEntries.dbc, .fx cinematic one not in CinematicSequences.dbc and .fx
#                     visual one not in SpellVisualKit.dbc, and .fx lookup searches those files plus
#                     ZoneMusic, SpellVisualEffectName and WorldStateUI .dbc. A file missing from
#                     the directory leaves its kind unchecked (with a warning); a missing directory
#                     or a malformed file stops the daemon. Empty (the default): every id is sent
#                     unchecked. vmangos' .debug play sound|music|cinematic refuse unknown ids
#                     against its own loaded tables (DebugCommands.cpp:471-536); ArcaneCore loads no
#                     such tables unless this is set.
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgmcommands
#
World.GmCommands.LiveFxDbcDirectory = ""

#
#    World.GmCommands.LogCommands
#        Description: Write one log line per GM command (a command above level 0), as vmangos
#                     Chat.cpp:1908-1925 does.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgmcommands
#
World.GmCommands.LogCommands = true

#
#    World.GmCommands.LookupMaxResults
#        Description: The most lines .lookup prints (0 = unlimited, as vmangos). A one-letter search
#                     on a full classic database matches about 14,000 items, each its own chat
#                     packet, all sent from the world thread; an operator may cap it (a final line
#                     says results were left out).
#        Type: int
#        Default: 0
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgmcommands
#
World.GmCommands.LookupMaxResults = 0

#
#    World.GmCommands.LowerSecurity
#        Description: vmangos GM.LowerSecurity (mangosd.conf.dist.in:2536). Retail default is false,
#                     which lets staff act on a higher account; ArcaneCore keeps the stricter true
#                     as its default so the existing refusal does not weaken. Strong checks
#                     (mute/unmute) are strict in both.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgmcommands
#
World.GmCommands.LowerSecurity = true

#
#    World.GmCommands.RetailLevels
#        Description: Apply the vmangos account level of the commands declared before the retail
#                     command work (RetailCommandLevels); off keeps their ArcaneCore four-level
#                     declarations.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgmcommands
#
World.GmCommands.RetailLevels = true

#
#    World.GmCommands.SecurityMap
#        Description: The retail account level (vmangos AccountTypes, vmangos@0e3ff01
#                     src/shared/Common.h:136-146: PLAYER 0, MODERATOR 1, TICKETMASTER 2, GAMEMASTER
#                     3, BASIC_ADMIN 4, DEVELOPER 5, ADMINISTRATOR 6, CONSOLE 7) each stored
#                     AccountSecurity stands for. ArcaneCore stores four levels, so the retail
#                     levels 2, 4 and 5 are only reachable by mapping a stored level onto them (an
#                     operator may remap, e.g. GameMaster=4).
#        Type: Dictionary<AccountSecurity, byte>
#        Default: Player = 0; Moderator = 1; GameMaster = 3; Administrator = 6
#        Allowed: a map: one key per entry name; each value is a whole number, 0 to 255
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgmcommands
#
World.GmCommands.SecurityMap.Administrator = 6
World.GmCommands.SecurityMap.GameMaster = 3
World.GmCommands.SecurityMap.Moderator = 1
World.GmCommands.SecurityMap.Player = 0

#
#    World.GmCommands.TicketMutationsPerMinute
#        Description: ArcaneCore only (no reference core limits these): the most ticket mutations
#                     (CMSG_GMTICKET_CREATE, _UPDATETEXT, _DELETETICKET) one account may send per
#                     minute. Beyond it the packet is refused before anything is read (create and
#                     update answer with their error code, a delete is answered with the ticket's
#                     unchanged state) and the player is told; every accepted create or changed text
#                     tells all GameMasters online, so this also bounds that. Fail-closed: 0 refuses
#                     every ticket mutation, a negative value is the default.
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgmcommands
#
World.GmCommands.TicketMutationsPerMinute = 10

#----------------------------------------------------------------------------
# World:GmCommands:Boost
#----------------------------------------------------------------------------

#
#    World.GmCommands.Boost.MaxQuality
#        Description: The highest item quality a boost kit piece may have: 1 white, 2 green, 3 blue
#                     (default), 4 epic. Blue is what a character gets from the dungeons of its
#                     level; values outside 1-4 are clamped. White is always the lowest: grey items
#                     are never offered.
#        Type: uint
#        Default: 3
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgmcommandsboost
#
World.GmCommands.Boost.MaxQuality = 3

#----------------------------------------------------------------------------
# World:GmCommands:DebugDraw
#----------------------------------------------------------------------------

#
#    World.GmCommands.DebugDraw.FollowIntervalMs
#        Description: Milliseconds between two reads of a followed unit's path (.debug vis follow);
#                     it is redrawn only when it changed. 100..10000.
#        Type: int
#        Default: 500
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgmcommandsdebugdraw
#
World.GmCommands.DebugDraw.FollowIntervalMs = 500

#
#    World.GmCommands.DebugDraw.FollowNearbyMaxRadius
#        Description: Widest .debug vis follow nearby radius in yards (a larger request is cut to
#                     it). 5..533.
#        Type: float
#        Default: 100
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgmcommandsdebugdraw
#
World.GmCommands.DebugDraw.FollowNearbyMaxRadius = 100

#
#    World.GmCommands.DebugDraw.GameObjectDisplayInfoDbcPath
#        Description: The developer's own build-5875 GameObjectDisplayInfo.dbc (optional; nothing is
#                     shipped). When set, every marker model (built-in and overridden) is checked
#                     against it at startup: an override the client does not have falls back to the
#                     built-in model with a warning. An unreadable or malformed file stops the
#                     daemon, as every configured DBC does. Empty: no check.
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgmcommandsdebugdraw
#
World.GmCommands.DebugDraw.GameObjectDisplayInfoDbcPath = ""

#
#    World.GmCommands.DebugDraw.Glow
#        Description: Add a coloured glow model next to the key markers (end points, hits, path
#                     corners, waypoints, heights, spawns).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgmcommandsdebugdraw
#
World.GmCommands.DebugDraw.Glow = true

#
#    World.GmCommands.DebugDraw.GlowModels
#        Description: Per marker kind, the glow companion's GameObjectDisplayInfo id (0 = no glow),
#                     checked like Models.
#        Type: Dictionary<string, uint>
#        Default: (empty)
#        Allowed: a map: one key per entry name; each value is a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgmcommandsdebugdraw
#
# Empty by default.
# World.GmCommands.DebugDraw.GlowModels.<Name> =

#
#    World.GmCommands.DebugDraw.LifetimeSeconds
#        Description: Seconds a drawing stays before it is removed on its own (it also goes with
#                     .debug vis clear, a logout or a map change). 5..3600.
#        Type: int
#        Default: 120
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgmcommandsdebugdraw
#
World.GmCommands.DebugDraw.LifetimeSeconds = 120

#
#    World.GmCommands.DebugDraw.MaxFollowedUnits
#        Description: Most units one GM follows at once (.debug vis follow, follow nearby); they
#                     share MaxMarkersPerGm. 1..50.
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgmcommandsdebugdraw
#
World.GmCommands.DebugDraw.MaxFollowedUnits = 10

#
#    World.GmCommands.DebugDraw.MaxMarkersPerGm
#        Description: Most markers one GM's client holds at once (glow companions count); a new
#                     drawing removes the oldest ones to fit. 1..2000.
#        Type: int
#        Default: 300
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgmcommandsdebugdraw
#
World.GmCommands.DebugDraw.MaxMarkersPerGm = 300

#
#    World.GmCommands.DebugDraw.Models
#        Description: Per marker kind (the DebugMarkerKind name, e.g. Cell, LosClear, Waypoint), a
#                     GameObjectDisplayInfo id to draw instead of the built-in model. 0 or an id
#                     missing from GameObjectDisplayInfoDbcPath keeps the built-in model.
#        Type: Dictionary<string, uint>
#        Default: (empty)
#        Allowed: a map: one key per entry name; each value is a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgmcommandsdebugdraw
#
# Empty by default.
# World.GmCommands.DebugDraw.Models.<Name> =

#
#    World.GmCommands.DebugDraw.Spacing
#        Description: Yards between the dots of a line or path (at least 0.5; a long line spreads
#                     its dots further to stay within its share of markers).
#        Type: float
#        Default: 2
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgmcommandsdebugdraw
#
World.GmCommands.DebugDraw.Spacing = 2

#----------------------------------------------------------------------------
# World:GmCommands:FirstLoginTools
#----------------------------------------------------------------------------

#
#    World.GmCommands.FirstLoginTools.Enabled
#        Description: Teach a staff character's first login the reviewed GM tool spells (off by
#                     default; when off the other keys are not read).
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgmcommandsfirstlogintools
#
World.GmCommands.FirstLoginTools.Enabled = false

#
#    World.GmCommands.FirstLoginTools.ExcludedSpellIds
#        Description: Catalog spell ids never taught (at most 64, unique).
#        Type: uint[]
#        Default: (empty list)
#        Allowed: a list: numbered keys 0, 1, 2, ...; each value is a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgmcommandsfirstlogintools
#
# Empty by default.
# World.GmCommands.FirstLoginTools.ExcludedSpellIds.0 =

#
#    World.GmCommands.FirstLoginTools.IncludeDeveloperSpells
#        Description: Also teach the catalog's developer-only spells.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgmcommandsfirstlogintools
#
World.GmCommands.FirstLoginTools.IncludeDeveloperSpells = true

#
#    World.GmCommands.FirstLoginTools.MinimumSecurity
#        Description: The lowest account security that gets the tools (Moderator, GameMaster or
#                     Administrator). Values: Player, Moderator, GameMaster, Administrator.
#        Type: AccountSecurity
#        Default: GameMaster
#        Allowed: Player | Moderator | GameMaster | Administrator
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgmcommandsfirstlogintools
#
World.GmCommands.FirstLoginTools.MinimumSecurity = GameMaster

#
#    World.GmCommands.FirstLoginTools.ShowToolGuide
#        Description: Show the staff member a short guide to the taught tools at that first login.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgmcommandsfirstlogintools
#
World.GmCommands.FirstLoginTools.ShowToolGuide = true

#
#    World.GmCommands.FirstLoginTools.SpellIds
#        Description: Optional operator subset. Empty means the reviewed rank-filtered catalog;
#                     populated values narrow it to known catalog IDs and never add new spells.
#        Type: uint[]
#        Default: (empty list)
#        Allowed: a list: numbered keys 0, 1, 2, ...; each value is a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldgmcommandsfirstlogintools
#
# Empty by default.
# World.GmCommands.FirstLoginTools.SpellIds.0 =

#----------------------------------------------------------------------------
# World:Guild
#----------------------------------------------------------------------------

#
#    World.Guild.AllowClientGuildCreate
#        Description: Honour CMSG_GUILD_CREATE (vmangos HandleGuildCreateOpcode,
#                     GuildHandler.cpp:47-72, honours it). Default on, as vmangos; an operator may
#                     turn it off to found guilds through charters only.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldguild
#
World.Guild.AllowClientGuildCreate = true

#
#    World.Guild.CharterSpamPatterns
#        Description: Antispam patterns for guild and charter names (vmangos
#                     AntispamInterface::filterMessage at the charter purchase and at Guild::Create;
#                     vmangos ships no implementation, so it filters nothing, and neither does the
#                     empty default). A name that contains a pattern, compared without case and
#                     spaces, is refused as an invalid guild name (PatternCharterAntispamFilter).
#                     Bound from World:Guild:CharterSpamPatterns (a list).
#        Type: List<string>
#        Default: (empty list)
#        Allowed: a list: numbered keys 0, 1, 2, ...; each value is text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldguild
#
# Empty by default.
# World.Guild.CharterSpamPatterns.0 =

#
#    World.Guild.DeleteRankMovesMembers
#        Description: Deleting a rank moves its members to the new lowest rank. Default false:
#                     vmangos Guild::DelRank (Guild.cpp:696-707) leaves them on the dead rank id
#                     (name "&lt;unknown&gt;", no rights) until the next load clamps them
#                     (Guild.cpp:458-460).
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldguild
#
World.Guild.DeleteRankMovesMembers = false

#
#    World.Guild.KickOnOversizedText
#        Description: Disconnect a client that sends over-long guild text (name, MOTD, info, notes,
#                     rank names), as vmangos does through ProcessAnticheatAction
#                     (GuildHandler.cpp:58-62,470-474,518-522, 554-558,580-584,600-604). The retail
#                     client never sends such text.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldguild
#
World.Guild.KickOnOversizedText = true

#
#    World.Guild.MinCharterNameLength
#        Description: MinCharterName (mangosd.conf.dist.in:1299, default 2, World.cpp:625 clamps to
#                     2..24).
#        Type: int
#        Default: 2
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldguild
#
World.Guild.MinCharterNameLength = 2

#
#    World.Guild.MinPetitionSigns
#        Description: MinPetitionSigns (mangosd.conf.dist.in:1341, default 9, World.cpp:666 clamps
#                     to 0..9).
#        Type: int
#        Default: 9
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldguild
#
World.Guild.MinPetitionSigns = 9

#
#    World.Guild.RealmZone
#        Description: vmangos RealmZone (RealmZone.h:23-61, mangosd.conf RealmZone, default 1 =
#                     development: any language), the zone whose scripts StrictCharterNames bit 0x2
#                     accepts. The character creation and pet name options carry their own copy of
#                     the setting.
#        Type: int
#        Default: 1
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldguild
#
World.Guild.RealmZone = 1

#
#    World.Guild.StrictCharterNames
#        Description: StrictCharterNames (mangosd.conf.dist.in:1296, default 0 = any single script).
#                     Bit 0x1 accepts basic Latin; bit 0x2 accepts the scripts of the realm zone
#                     (RealmZone, vmangos GetRealmLanguageType with create false).
#        Type: int
#        Default: 0
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldguild
#
World.Guild.StrictCharterNames = 0

#----------------------------------------------------------------------------
# World:Honor
#----------------------------------------------------------------------------

#
#    World.Honor.CityProtector
#        Description: Assign the City Protector titles (vmangos default off).
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldhonor
#
World.Honor.CityProtector = false

#
#    World.Honor.DishonorableKills
#        Description: Civilian kills below gray cost honor (vmangos CONFIG_BOOL_ENABLE_DK).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldhonor
#
World.Honor.DishonorableKills = true

#
#    World.Honor.Enabled
#        Description: Master switch of the honor system (kills, ranks, the weekly calculation).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldhonor
#
World.Honor.Enabled = true

#
#    World.Honor.MaintenanceDay
#        Description: Weekday of the weekly calculation (Sunday 0, clamped to 6).
#        Type: uint
#        Default: 3
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldhonor
#
World.Honor.MaintenanceDay = 3

#
#    World.Honor.MaintenanceMode
#        Description: When the weekly calculation runs: Startup (default) or Live (an opt-in
#                     in-process weekly job). Values: Live, Startup.
#        Type: HonorMaintenanceMode
#        Default: Startup
#        Allowed: Live | Startup
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldhonor
#
World.Honor.MaintenanceMode = Startup

#
#    World.Honor.MinHonorKills
#        Description: Honorable kills a week to be ranked; 0 selects 15 (MIN_HONOR_KILLS_POST_1_10).
#        Type: uint
#        Default: 0
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldhonor
#
World.Honor.MinHonorKills = 0

#
#    World.Honor.PoolSizePerFaction
#        Description: Standing pool size per faction; 0 uses the number of ranked players.
#        Type: uint
#        Default: 0
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldhonor
#
World.Honor.PoolSizePerFaction = 0

#
#    World.Honor.RacialLeaderExcludedEntries
#        Description: Creature entries that are never racial leaders.
#        Type: uint[]
#        Default: (empty list)
#        Allowed: a list: numbered keys 0, 1, 2, ...; each value is a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldhonor
#
# Empty by default.
# World.Honor.RacialLeaderExcludedEntries.0 =

#
#    World.Honor.Rate
#        Description: Non-retail when not 1 (default 1): multiplies earned honor (kills,
#                     battleground bonuses, quests); Rate.Honor of the MaNGOS Zero fork and the
#                     cmangos/TrinityCore line (vmangos has none). A negative or non-finite value is
#                     1.
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldhonor
#
World.Honor.Rate = 1

#
#    World.Honor.ReportDirectory
#        Description: Directory that receives the vmangos HCR calculation report; empty writes none.
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldhonor
#
World.Honor.ReportDirectory = ""

#
#    World.Honor.RpDecay
#        Description: Weekly rank point decay, clamped to 0..1.
#        Type: float
#        Default: 0.2
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldhonor
#
World.Honor.RpDecay = 0.2

#
#    World.Honor.TimeZoneOffsetHours
#        Description: Hours added to UTC for the game day and the weekday of the weekly calculation.
#        Type: int
#        Default: 0
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldhonor
#
World.Honor.TimeZoneOffsetHours = 0

#----------------------------------------------------------------------------
# World:HotCode
#----------------------------------------------------------------------------

#
#    World.HotCode.AuditLogPath
#        Description: Append-only text file that receives one line per hot-code decision (start
#                     allowed, start refused, refresh applied or rejected). Empty means no file. Not
#                     tamper-proof.
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldhotcode
#
World.HotCode.AuditLogPath = ""

#
#    World.HotCode.Enabled
#        Description: Allow the process to take method-body edits while it runs (the dotnet watch
#                     runner, scripts/hot-runner.ps1). When false the server refuses to start if the
#                     runtime is already set up for metadata updates, because the watch agent cannot
#                     be vetoed later.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldhotcode
#
World.HotCode.Enabled = false

#
#    World.HotCode.MaxConsecutiveFaults
#        Description: With hot code enabled, a map updater that throws in this many consecutive
#                     ticks is skipped until the next applied code edit (the edit may be the fix)
#                     instead of failing and logging every tick. 0 disables the breaker. Ignored
#                     when Enabled is false, and an explicit World:MaxConsecutiveUpdaterFaults takes
#                     precedence.
#        Type: int
#        Default: 50
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldhotcode
#
World.HotCode.MaxConsecutiveFaults = 50

#
#    World.HotCode.Modules.AllowAnyEnvironment
#        Description: Modules are accepted in the Development and Staging environments only, unless
#                     this is set. Setting it is the operator saying that code may be loaded into
#                     this (deployed) instance.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldhotcode
#
World.HotCode.Modules.AllowAnyEnvironment = false

#
#    World.HotCode.Modules.Allowlist
#        Description: Path of a text file of SHA-256 hashes (hex, one per line, # comments) of the
#                     module dlls that may be loaded. Empty adds no restriction (any dll in
#                     Directory can be loaded by an Administrator). When set it is fail-closed: a
#                     missing, unreadable or malformed file, or a dll whose hash is not listed,
#                     refuses the load and is audited. Read on every load, so editing it needs no
#                     restart. Required when AllowAnyEnvironment lets modules into a Production
#                     instance.
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldhotcode
#
World.HotCode.Modules.Allowlist = ""

#
#    World.HotCode.Modules.Directory
#        Description: Folder holding one subfolder per module:
#                     &lt;Directory&gt;/&lt;name&gt;/&lt;name&gt;.dll plus any private dependencies.
#                     Required when Enabled (the server refuses to start without it).
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldhotcode
#
World.HotCode.Modules.Directory = ""

#
#    World.HotCode.Modules.Enabled
#        Description: Allow modules to be loaded. When false no module host exists at all.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldhotcode
#
World.HotCode.Modules.Enabled = false

#
#    World.HotCode.Modules.LoadOnStart
#        Description: Module names to load once the world is running (asynchronously; a failure is
#                     logged, not fatal).
#        Type: List<string>
#        Default: (empty list)
#        Allowed: a list: numbered keys 0, 1, 2, ...; each value is text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldhotcode
#
# Empty by default.
# World.HotCode.Modules.LoadOnStart.0 =

#----------------------------------------------------------------------------
# World:Instances
#----------------------------------------------------------------------------

#
#    World.Instances.HomebindTimerMs
#        Description: Time a player who lost the right to be in an instance (left the group, global
#                     reset) has before being sent to its bind point (vmangos
#                     Player::UpdateHomebindTime: 60 s).
#        Type: int
#        Default: 60000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldinstances
#
World.Instances.HomebindTimerMs = 60000

#
#    World.Instances.IgnoreRaidGroup
#        Description: Let players enter raids without a raid group (vmangos Instance.IgnoreRaid,
#                     default off).
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldinstances
#
World.Instances.IgnoreRaidGroup = false

#
#    World.Instances.NormalDungeonResetSeconds
#        Description: A normal (non-raid) dungeon resets this long after it was created, but only
#                     while nobody is inside (vmangos MapPersistentStateManager::AddPersistentState:
#                     "if no creatures are killed the instance will reset in two hours"; the
#                     schedule is cancelled while players are in).
#        Type: int
#        Default: 7200
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldinstances
#
World.Instances.NormalDungeonResetSeconds = 7200

#
#    World.Instances.PerHourLimit
#        Description: New instances one account may enter per hour (vmangos Instance.PerHourLimit,
#                     default 5; MAX_INSTANCE_PER_ACCOUNT_PER_HOUR Player.h:669). 0 turns the limit
#                     off (a ArcaneCore convention: vmangos would refuse every new instance at 0).
#                     Game masters are exempt.
#        Type: int
#        Default: 5
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldinstances
#
World.Instances.PerHourLimit = 5

#
#    World.Instances.RateResetTime
#        Description: vmangos Rate.InstanceResetTime (World.cpp:543, setConfigPos, default 1):
#                     multiplies the reset period in days of every raid with a reset_delay,
#                     truncated and at least one day (ObjectMgr::LoadMapTemplate,
#                     ObjectMgr.cpp:6809-6811). A delay of 0 (no global reset) stays 0. Read when
#                     the raid schedules are built and at each global reset; a negative value is 1.
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldinstances
#
World.Instances.RateResetTime = 1

#
#    World.Instances.ResetExtendsOnKills
#        Description: A creature kill in a normal dungeon moves the reset time to respawn + 2 h when
#                     later (vmangos Map::BindToInstanceOrRaid, Map.cpp:3536-3544). Default on
#                     (retail).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldinstances
#
World.Instances.ResetExtendsOnKills = true

#
#    World.Instances.ResetRefusedNoticeSeconds
#        Description: Seconds between two "Please leave the instance so it can be reset." notices to
#                     the players inside an instance that a refused personal reset asks to leave (an
#                     ArcaneCore limit: the refusal itself is an ArcaneCore choice, see
#                     docs/integration/instances.md, and the requester can repeat
#                     CMSG_RESET_INSTANCES at will). The requester still gets
#                     SMSG_INSTANCE_RESET_FAILED every time. 0 sends the notice on every refusal.
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldinstances
#
World.Instances.ResetRefusedNoticeSeconds = 10

#
#    World.Instances.ResetTimeHour
#        Description: Hour of the day (UTC, 0–23) of global raid resets (vmangos
#                     Instance.ResetTimeHour, default 4).
#        Type: int
#        Default: 4
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldinstances
#
World.Instances.ResetTimeHour = 4

#
#    World.Instances.UnloadDelayMs
#        Description: How long an empty instance map stays loaded before it is unloaded (vmangos
#                     Instance.UnloadDelay, default 30 minutes). Its save and binds survive the
#                     unload.
#        Type: int
#        Default: 1800000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldinstances
#
World.Instances.UnloadDelayMs = 1800000

#----------------------------------------------------------------------------
# World:PacketHeuristics
#----------------------------------------------------------------------------

#
#    World.PacketHeuristics.Cadence
#        Description: Report an opcode class sent faster than its ceiling (cadence). Default true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldpacketheuristics
#
World.PacketHeuristics.Cadence = true

#
#    World.PacketHeuristics.CadenceLimits.CastPerSecond
#        Description: CMSG_CAST_SPELL and CMSG_PET_CAST_SPELL per second. 0-1000, default 10.
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldpacketheuristics
#
World.PacketHeuristics.CadenceLimits.CastPerSecond = 10

#
#    World.PacketHeuristics.CadenceLimits.EmotePerSecond
#        Description: CMSG_EMOTE and CMSG_TEXT_EMOTE per second. 0-1000, default 5.
#        Type: int
#        Default: 5
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldpacketheuristics
#
World.PacketHeuristics.CadenceLimits.EmotePerSecond = 5

#
#    World.PacketHeuristics.CadenceLimits.PingMinIntervalMs
#        Description: A CMSG_PING that follows the previous one by less than this many milliseconds
#                     is reported (a 1.12.1 client pings every 30 seconds). 0 switches it off.
#                     0-60000, default 5000.
#        Type: int
#        Default: 5000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldpacketheuristics
#
World.PacketHeuristics.CadenceLimits.PingMinIntervalMs = 5000

#
#    World.PacketHeuristics.CadenceLimits.QueryPerSecond
#        Description: Query opcodes (names containing QUERY) per second. A client entering a crowded
#                     city can burst; raise it if that is all you see. 0-1000, default 50.
#        Type: int
#        Default: 50
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldpacketheuristics
#
World.PacketHeuristics.CadenceLimits.QueryPerSecond = 50

#
#    World.PacketHeuristics.CadenceLimits.UsePerSecond
#        Description: CMSG_USE_ITEM, CMSG_GAMEOBJ_USE and CMSG_LOOT per second. 0-1000, default 10.
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldpacketheuristics
#
World.PacketHeuristics.CadenceLimits.UsePerSecond = 10

#
#    World.PacketHeuristics.DevOpcode
#        Description: Report a stripped developer, GM, cheat or debug opcode that the release client
#                     never sends (dev-opcode); the packet is dropped unread either way. Default
#                     true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldpacketheuristics
#
World.PacketHeuristics.DevOpcode = true

#
#    World.PacketHeuristics.Enabled
#        Description: Run the checks at all. Default false: with it off a packet costs one volatile
#                     read and no per-session state exists.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldpacketheuristics
#
World.PacketHeuristics.Enabled = false

#
#    World.PacketHeuristics.ExemptBots
#        Description: The server's own managed playerbot sessions are not checked. Default true;
#                     with false their traffic is checked and counted as bot traffic.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldpacketheuristics
#
World.PacketHeuristics.ExemptBots = true

#
#    World.PacketHeuristics.ExemptStaff
#        Description: Staff (Moderator and above, or a player in GM mode) are not checked. Default
#                     true; with false their traffic is checked and counted as staff traffic.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldpacketheuristics
#
World.PacketHeuristics.ExemptStaff = true

#
#    World.PacketHeuristics.IncapacitatedAction
#        Description: Report an action opcode received while the player is dead or a ghost, on a
#                     taxi flight or in a far transfer (incapacitated-action; a near teleport such
#                     as Blink is not one). Default true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldpacketheuristics
#
World.PacketHeuristics.IncapacitatedAction = true

#
#    World.PacketHeuristics.Malformed
#        Description: Report a payload a handler rejected as malformed, or a bad frame header
#                     (malformed). Default true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldpacketheuristics
#
World.PacketHeuristics.Malformed = true

#
#    World.PacketHeuristics.OrphanAck
#        Description: Report an unsolicited or mismatching movement acknowledgement (orphan-ack).
#                     Default true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldpacketheuristics
#
World.PacketHeuristics.OrphanAck = true

#
#    World.PacketHeuristics.Replay
#        Description: Report the same opcode with the same payload repeated (replay). Default true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldpacketheuristics
#
World.PacketHeuristics.Replay = true

#
#    World.PacketHeuristics.ReplayBuiltInExclusions
#        Description: Keep the built-in list of opcodes that legitimately repeat an identical
#                     payload out of the replay check: movement and its acknowledgements, ping,
#                     every query, selection and attack toggles, cancels, stand state, loot release,
#                     area triggers, character enumeration and the polling a client or bot does
#                     (docs/areas/packet-heuristics.md has the list and the reason for each entry).
#                     Default true; set false to take full control with ReplayExclude.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldpacketheuristics
#
World.PacketHeuristics.ReplayBuiltInExclusions = true

#
#    World.PacketHeuristics.ReplayCount
#        Description: The same opcode and payload this many times within ReplayWindowMs is a replay.
#                     2-1000, default 5.
#        Type: int
#        Default: 5
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldpacketheuristics
#
World.PacketHeuristics.ReplayCount = 5

#
#    World.PacketHeuristics.ReplayExclude
#        Description: More opcodes never checked for replay, on top of the built-in list: exact
#                     opcode names (CMSG_PING) or names with a leading and/or trailing *
#                     (MSG_MOVE_*, *QUERY*). A configured list is added to the default (empty) one,
#                     so entries never remove anything; use ReplayBuiltInExclusions to drop the
#                     built-in list. Default empty.
#        Type: string[]
#        Default: (empty list)
#        Allowed: a list: numbered keys 0, 1, 2, ...; each value is text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldpacketheuristics
#
# Empty by default.
# World.PacketHeuristics.ReplayExclude.0 =

#
#    World.PacketHeuristics.ReplayWindowMs
#        Description: The window of the replay check, in milliseconds. 100-60000, default 1000.
#        Type: int
#        Default: 1000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldpacketheuristics
#
World.PacketHeuristics.ReplayWindowMs = 1000

#
#    World.PacketHeuristics.ReportIntervalSeconds
#        Description: At most one ledger report per session, check and opcode per this many seconds;
#                     every occurrence is still counted. 1-3600, default 10.
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldpacketheuristics
#
World.PacketHeuristics.ReportIntervalSeconds = 10

#
#    World.PacketHeuristics.Shape
#        Description: Report a payload whose length differs from the fixed length of its message
#                     (shape). Default true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldpacketheuristics
#
World.PacketHeuristics.Shape = true

#
#    World.PacketHeuristics.UnknownOpcode
#        Description: Report an opcode with no handler or outside the opcode table (unknown-opcode).
#                     Default true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldpacketheuristics
#
World.PacketHeuristics.UnknownOpcode = true

#
#    World.PacketHeuristics.WrongState
#        Description: Report an opcode dropped because the session state does not allow it
#                     (wrong-state). Default true.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldpacketheuristics
#
World.PacketHeuristics.WrongState = true

#
#    World.PacketHeuristics.WrongStateGraceMs
#        Description: After the player left the world (logout, back at the character screen) world
#                     opcodes are expected for this many milliseconds (packets in flight) and are
#                     not reported as wrong-state. Only this post-logout window is timed: a map-less
#                     player in a far teleport is excused by the teleport stage, however long the
#                     loading screen takes. 0-60000, default 5000.
#        Type: int
#        Default: 5000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldpacketheuristics
#
World.PacketHeuristics.WrongStateGraceMs = 5000

#----------------------------------------------------------------------------
# World:Playerbots
#----------------------------------------------------------------------------

#
#    World.Playerbots.AllowedMaps
#        Description: The maps bots may act and travel on (non-empty, no duplicates; a configured
#                     list replaces the default continents 0 and 1).
#        Type: uint[]
#        Default: 0 = 0; 1 = 1
#        Allowed: a list: numbered keys 0, 1, 2, ...; each value is a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
# These entries are the default list. They are commented out because a list you write is appended to the default list, not
# substituted for it; uncomment them only to document the list, or set the keys of the entries you want to add.
# World.Playerbots.AllowedMaps.0 = 0
# World.Playerbots.AllowedMaps.1 = 1

#
#    World.Playerbots.AsyncNavigationEnabled
#        Description: Run far playerbot navigation queries on the bounded private worker (off by
#                     default during rollout). Restart required: the worker is created when the
#                     feature attaches.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Restart (.reload config keeps the old value and reports that a restart is needed)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.AsyncNavigationEnabled = false

#
#    World.Playerbots.Battlegrounds.Enabled
#        Description: Let free bots queue for battlegrounds (on by default). Off: no bot starts a
#                     queue; bots already walking to a battlemaster, queued or in a match finish.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Battlegrounds.Enabled = true

#
#    World.Playerbots.Battlegrounds.MaxBotsPerBattleground
#        Description: The most bots in one battleground (0..80; 0 queues none), unless
#                     RaiseCapToFillTemplate raises it for a type whose template minimum needs more.
#                     Bots waiting for one battleground type and level bracket do not exceed the
#                     (effective) cap, a team never gets more than half of it (rounded up) and a bot
#                     declines an invitation into a match that already holds this many.
#        Type: int
#        Default: 20
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Battlegrounds.MaxBotsPerBattleground = 20

#
#    World.Playerbots.Battlegrounds.MaxQueueWaitMinutes
#        Description: Minutes a bot waits in a queue before it leaves it (1..240); it then does not
#                     queue for that type again for 10 minutes.
#        Type: int
#        Default: 30
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Battlegrounds.MaxQueueWaitMinutes = 30

#
#    World.Playerbots.Battlegrounds.MaxTravelYards
#        Description: The farthest, in yards, a battlemaster may stand from a bot for the bot to
#                     walk to it (100..20000): a straight line on the bot's own map, to a
#                     battlemaster whose faction is not hostile to the bot.
#        Type: int
#        Default: 1500
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Battlegrounds.MaxTravelYards = 1500

#
#    World.Playerbots.Battlegrounds.PreferFillingRealPlayerQueues
#        Description: Let bots fill the queues real players wait in, so their games start (on by
#                     default): a bracket with a real player waiting gets bots at once (no chance
#                     roll) up to the minimum both teams need, and they pick the type and bracket
#                     the player waits for.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Battlegrounds.PreferFillingRealPlayerQueues = true

#
#    World.Playerbots.Battlegrounds.QueueChancePerMinute
#        Description: The chance, per minute, that a free bot of a fitting level starts to queue
#                     (0..1; 0 never, 1 at the next scan). The chance of one scan is 1 - (1 -
#                     p)^(scanSeconds / 60), so the rate does not depend on how often the
#                     coordinator looks.
#        Type: float
#        Default: 0.05
#        Allowed: a number, '.' is the decimal point
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Battlegrounds.QueueChancePerMinute = 0.05

#
#    World.Playerbots.Battlegrounds.RaiseCapToFillTemplate
#        Description: Raise the cap of any battleground type whose 2 x MinPlayersPerTeam exceeds
#                     MaxBotsPerBattleground to 2 x MaxPlayersPerTeam (on by default), so bots alone
#                     can start it, fill it to the template's maximum and backfill a leaver's slot.
#                     At the default cap of 20 that is Alterac Valley (20 per team minimum, 40
#                     maximum: 80 bots); Warsong Gulch and Arathi Basin only when the cap is set
#                     below twice their minimum (10 and 16 in the z2815 rows). One warning names
#                     each raised type and its new cap, once the coordinator scans (once bots are
#                     online), and again after a reload that changes the cap, this option or the
#                     templates. Off: the configured cap is kept for every type, with no raise and
#                     no refusal, as before this option (a type whose minimum the cap does not cover
#                     then does not start from bots alone, but its bots still help a real player's
#                     queue). The retail template values are never changed.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Battlegrounds.RaiseCapToFillTemplate = true

#
#    World.Playerbots.Budget.ClassLevelsAhead
#        Description: How many levels ahead of its own the bot saves for class spells (0..10): the
#                     spells its class trainer teaches at levels up to this many above the bot's,
#                     plus the ones it can learn now, are reserved at the trainer's prices, so
#                     lower-priority spending (riding, the auction house) cannot eat the money they
#                     cost. 0 reserves only what can be learned now.
#        Type: int
#        Default: 2
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Budget.ClassLevelsAhead = 2

#
#    World.Playerbots.Budget.DiscretionaryFloorFraction
#        Description: The share of its current money (0..1) a bot may always spend on discretionary
#                     purchases (auction upgrades), even when the reserves leave nothing over: a
#                     reserve the bot may never reach (a tier far above its means) does not stop its
#                     optional buying for good. 0 lets the reserves take everything. Auction listing
#                     deposits are never limited by the reserves.
#        Type: float
#        Default: 0.1
#        Allowed: a number, '.' is the decimal point
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Budget.DiscretionaryFloorFraction = 0.1

#
#    World.Playerbots.Budget.Enabled
#        Description: Let bots save for what they will need (on by default). Off: nothing is
#                     reserved and every spend site may spend all the bot's money.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Budget.Enabled = true

#
#    World.Playerbots.Budget.EssentialsAllowanceCopper
#        Description: Copper a bot may always spend on food, drink and ammunition (0..100000000),
#                     whatever it saves for: the part of a purchase that the reserves would
#                     otherwise forbid is allowed up to this price, so a saving bot never starves.
#        Type: uint
#        Default: 10000
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Budget.EssentialsAllowanceCopper = 10000

#
#    World.Playerbots.Budget.RefreshSeconds
#        Description: Seconds between two recomputations of a bot's reserves (1..3600); a level, a
#                     learned spell or a new map recompute them at once.
#        Type: int
#        Default: 30
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Budget.RefreshSeconds = 30

#
#    World.Playerbots.Chaos.ActiveChaosBots
#        Description: How many running autonomous bots are automatically selected as chaos bots when
#                     Enabled is on (0..5000, default 4). Bots explicitly assigned with .playerbot
#                     chaos assign always run probes while Enabled is on, even when this is 0. Live
#                     through .reload config.
#        Type: int
#        Default: 4
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chaos.ActiveChaosBots = 4

#
#    World.Playerbots.Chaos.BoundaryMovement
#        Description: Include movement packets with extreme orientations, boundary flags, rapid
#                     start/stop/jump/heartbeat transitions and invalid spline or transport fields
#                     (on by default). Any non-finite coordinate is rolled back if a handler fails
#                     to reject it, and a fault is recorded. Live through .reload config.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chaos.BoundaryMovement = true

#
#    World.Playerbots.Chaos.Enabled
#        Description: Run adversarial chaos probes on designated running playerbots (off by
#                     default). Live through .reload config and .playerbot chaos on|off.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chaos.Enabled = false

#
#    World.Playerbots.Chaos.MalformedPayloads
#        Description: Include truncated, zero-length, oversized and random-byte malformed wire
#                     payloads across registered world opcodes (on by default). Clean
#                     MalformedPacket rejections are counted as expected; any other exception is
#                     recorded as a server fault. Live through .reload config.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chaos.MalformedPayloads = true

#
#    World.Playerbots.Chaos.ProbesPerThink
#        Description: How many adversarial packet/state probes each active chaos bot executes per
#                     think (1..16, default 2). Live through .reload config.
#        Type: int
#        Default: 2
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chaos.ProbesPerThink = 2

#
#    World.Playerbots.Chaos.Seed
#        Description: Deterministic PRNG seed for chaos probe selection and payload generation (0
#                     uses a time-seeded sequence; any non-zero value replays the same sequence per
#                     bot; -2147483648..2147483647). Live through .reload config.
#        Type: int
#        Default: 0
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chaos.Seed = 0

#
#    World.Playerbots.Chaos.StateRaces
#        Description: Include out-of-order state-machine race probes: resurrection/release while
#                     alive or dead, double loot/release, self-target and stale-GUID
#                     combat/spell/trade/vendor/quest/guild/group/mail/auction/battleground packets,
#                     and inventory slot boundary swaps (on by default). Live through .reload
#                     config.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chaos.StateRaces = true

#
#    World.Playerbots.ChaseReplanYards
#        Description: How far (flat yards, 0.5..100) the target of a chase may move from the place
#                     the chase route was planned to before the route is planned again, in the same
#                     think that sees it. A route cut short of its target by the route bounds
#                     (MaxRouteYards, MaxPathPoints) is planned again only once the bot has walked
#                     75% of it. A chase route walked to its end is planned again at once, whatever
#                     this says.
#        Type: float
#        Default: 5
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.ChaseReplanYards = 5

#
#    World.Playerbots.Chat.Channels
#        Description: The lines a bot answers: Whisper, Party, Say, Yell, Raid, Battleground, Guild
#                     and World (comma-separated; all of them by default). A reply goes back on the
#                     channel the line came on. Values: None, Whisper, Party, Say, Yell, Raid,
#                     Battleground, Guild, World, All.
#        Type: PlayerbotChatChannels
#        Default: All
#        Allowed: None | Whisper | Party | Say | Yell | Raid | Battleground | Guild | World | All
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Channels = All

#
#    World.Playerbots.Chat.Conversation.BotCooldownMinutes
#        Description: Minutes before one bot starts or joins another conversation (1..1440).
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Conversation.BotCooldownMinutes = 10

#
#    World.Playerbots.Chat.Conversation.CandidatesPerPass
#        Description: How many bots the director looks at per pass when it picks a conversation
#                     (1..256): the work per pass is bounded by it, whatever the size of the fleet.
#        Type: int
#        Default: 8
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Conversation.CandidatesPerPass = 8

#
#    World.Playerbots.Chat.Conversation.ConversationsPerHour
#        Description: The most conversations the director starts in an hour, over all bots (0..600;
#                     0 = none). Each pass rolls against this, so they spread over the hour instead
#                     of coming in bursts.
#        Type: int
#        Default: 20
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Conversation.ConversationsPerHour = 20

#
#    World.Playerbots.Chat.Conversation.Enabled
#        Description: Let the director start bot-to-bot conversations (on by default; needs
#                     PlayerbotSpeechOptions.BotToBot).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Conversation.Enabled = true

#
#    World.Playerbots.Chat.Conversation.LineDeadlineSeconds
#        Description: How long a planned line may wait for the speech limits before the conversation
#                     is dropped (10..600 seconds).
#        Type: int
#        Default: 60
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Conversation.LineDeadlineSeconds = 60

#
#    World.Playerbots.Chat.Conversation.LineGapSeconds
#        Description: The least seconds between two lines of a conversation (2..120): the time a
#                     player takes to read and type.
#        Type: int
#        Default: 7
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Conversation.LineGapSeconds = 7

#
#    World.Playerbots.Chat.Conversation.LineJitterSeconds
#        Description: The most extra random seconds added to LineGapSeconds (0..120).
#        Type: int
#        Default: 6
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Conversation.LineJitterSeconds = 6

#
#    World.Playerbots.Chat.Conversation.MaxActive
#        Description: The most conversations running at once (1..64).
#        Type: int
#        Default: 4
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Conversation.MaxActive = 4

#
#    World.Playerbots.Chat.Conversation.MaxHeardQueue
#        Description: Heard world channel lines waiting for the next social pass at most (8..1024);
#                     more are dropped.
#        Type: int
#        Default: 64
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Conversation.MaxHeardQueue = 64

#
#    World.Playerbots.Chat.Conversation.MaxLines
#        Description: The most lines one conversation has, the opener included (2..6). The
#                     bot-to-bot turn cap (PlayerbotSpeechOptions.BotToBotMaxTurns) still applies to
#                     the answers, so with its default of 3 a conversation has at most 4 lines.
#        Type: int
#        Default: 4
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Conversation.MaxLines = 4

#
#    World.Playerbots.Chat.Conversation.NearYards
#        Description: Two bots "near each other" are at most this many yards apart (5..100) for a
#                     /say conversation.
#        Type: int
#        Default: 20
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Conversation.NearYards = 20

#
#    World.Playerbots.Chat.Conversation.PairCooldownMinutes
#        Description: Minutes before the same two bots are paired again (1..1440).
#        Type: int
#        Default: 30
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Conversation.PairCooldownMinutes = 30

#
#    World.Playerbots.Chat.Conversation.ReactionPlayerCooldownMinutes
#        Description: Minutes before one bot reacts to the same player's world channel lines again
#                     (1..1440).
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Conversation.ReactionPlayerCooldownMinutes = 10

#
#    World.Playerbots.Chat.Conversation.ReactionsPerLine
#        Description: How many bots answer one world channel line at most (1..5).
#        Type: int
#        Default: 1
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Conversation.ReactionsPerLine = 1

#
#    World.Playerbots.Chat.Conversation.WorldReactions
#        Description: Answer a real player's world channel line that fits the bot: an LFM for a
#                     dungeon at the bot's level (a whispered "inv" when the bot is free and its
#                     role is wanted), a WTB for an item the bot carries spare (a whispered offer)
#                     (on by default).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Conversation.WorldReactions = true

#
#    World.Playerbots.Chat.Conversation.WorldReactionsPerMinute
#        Description: The most reactions all bots together whisper in a minute (0..60; 0 = none).
#        Type: int
#        Default: 4
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Conversation.WorldReactionsPerMinute = 4

#
#    World.Playerbots.Chat.Enabled
#        Description: Let bots answer players' chat (on by default, with the built-in templates
#                     only). Off: the fixed replies of before.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Enabled = true

#
#    World.Playerbots.Chat.InProcess.AmbientQueueMs
#        Description: How long a line no one is waiting on (guild chatter, announcements) may wait
#                     for a free slot before it is dropped (250..60000 ms): stale small talk is not
#                     worth writing. A player's line is never dropped this way.
#        Type: int
#        Default: 4000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.InProcess.AmbientQueueMs = 4000

#
#    World.Playerbots.Chat.InProcess.BudgetMs
#        Description: The hard budget of one reply, prompt included, in wall-clock milliseconds
#                     (250..60000); a reply not done by then is dropped and the templates answer.
#        Type: int
#        Default: 6000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.InProcess.BudgetMs = 6000

#
#    World.Playerbots.Chat.InProcess.CircuitBreakerOverruns
#        Description: Budget overruns in a row that open the circuit (1..100): the model then rests
#                     for CircuitBreakerSeconds and the templates answer.
#        Type: int
#        Default: 3
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.InProcess.CircuitBreakerOverruns = 3

#
#    World.Playerbots.Chat.InProcess.CircuitBreakerSeconds
#        Description: How long an open circuit keeps the model out (10..3600 seconds).
#        Type: int
#        Default: 300
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.InProcess.CircuitBreakerSeconds = 300

#
#    World.Playerbots.Chat.InProcess.ContextTokens
#        Description: The context window per slot in tokens (256..32768; capped at the model's own):
#                     the prompt and the reply must fit.
#        Type: int
#        Default: 1024
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.InProcess.ContextTokens = 1024

#
#    World.Playerbots.Chat.InProcess.MaxConcurrent
#        Description: Replies written at once (1..4); each has its own threads and cache.
#        Type: int
#        Default: 1
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.InProcess.MaxConcurrent = 1

#
#    World.Playerbots.Chat.InProcess.MaxNewTokens
#        Description: The most tokens of one reply (8..256).
#        Type: int
#        Default: 48
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.InProcess.MaxNewTokens = 48

#
#    World.Playerbots.Chat.InProcess.MaxQueued
#        Description: Replies that may wait for a free slot beyond the running ones (0..64); past it
#                     the templates answer.
#        Type: int
#        Default: 2
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.InProcess.MaxQueued = 2

#
#    World.Playerbots.Chat.InProcess.MaxReplyCharacters
#        Description: The longest reply said (40..255 characters); a longer one is dropped and the
#                     templates answer.
#        Type: int
#        Default: 160
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.InProcess.MaxReplyCharacters = 160

#
#    World.Playerbots.Chat.InProcess.MinP
#        Description: Drop tokens less likely than this fraction of the most likely one (0..1; 0 =
#                     off).
#        Type: double
#        Default: 0.05
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.InProcess.MinP = 0.05

#
#    World.Playerbots.Chat.InProcess.ModelPath
#        Description: The model file (GGUF, llama or qwen2 architecture, gpt2 BPE tokenizer;
#                     relative to the content root, or absolute), e.g.
#                     models/chat/SmolLM2-360M-Instruct-Q8_0.gguf.
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.InProcess.ModelPath = ""

#
#    World.Playerbots.Chat.InProcess.PrefillChunkTokens
#        Description: Prompt tokens one reply computes per scheduler step (32..512): smaller lets a
#                     player's line overtake a long prompt sooner.
#        Type: int
#        Default: 64
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.InProcess.PrefillChunkTokens = 64

#
#    World.Playerbots.Chat.InProcess.PrefixCacheTokens
#        Description: Prompt tokens kept in the shared prefix cache (0..16384; 0 = off): the keys
#                     and values of the fixed system rules every bot prompt starts with (and recent
#                     conversations) are computed once and copied into whichever slot a reply runs
#                     on.
#        Type: int
#        Default: 1024
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.InProcess.PrefixCacheTokens = 1024

#
#    World.Playerbots.Chat.InProcess.RepetitionPenalty
#        Description: The penalty on tokens already in the recent text (1..2; 1 = none).
#        Type: double
#        Default: 1.15
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.InProcess.RepetitionPenalty = 1.15

#
#    World.Playerbots.Chat.InProcess.RepetitionWindow
#        Description: How many of the latest tokens (prompt and reply) RepetitionPenalty looks at
#                     (0..1024; 0 = none).
#        Type: int
#        Default: 64
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.InProcess.RepetitionWindow = 64

#
#    World.Playerbots.Chat.InProcess.Seed
#        Description: A fixed seed makes the same prompt give the same reply (unset: a fresh draw
#                     each time).
#        Type: int?
#        Default: (not set)
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
# World.Playerbots.Chat.InProcess.Seed =

#
#    World.Playerbots.Chat.InProcess.StopSequences
#        Description: Text that ends a reply where it appears (the text itself is not said), e.g.
#                     "User:"; at most 8, each 1..32 characters.
#        Type: List<string>
#        Default: (empty list)
#        Allowed: a list: numbered keys 0, 1, 2, ...; each value is text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
# Empty by default.
# World.Playerbots.Chat.InProcess.StopSequences.0 =

#
#    World.Playerbots.Chat.InProcess.Temperature
#        Description: Sampling temperature (0..2; 0 = always the most likely token).
#        Type: double
#        Default: 0.7
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.InProcess.Temperature = 0.7

#
#    World.Playerbots.Chat.InProcess.Threads
#        Description: Threads one reply computes on (1..16; dedicated, BelowNormal priority, never
#                     the thread pool).
#        Type: int
#        Default: 2
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.InProcess.Threads = 2

#
#    World.Playerbots.Chat.InProcess.TopK
#        Description: Sample among the k most likely tokens (1..256).
#        Type: int
#        Default: 40
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.InProcess.TopK = 40

#
#    World.Playerbots.Chat.InProcess.TopP
#        Description: Then among the smallest set holding this much probability (0.05..1).
#        Type: double
#        Default: 0.9
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.InProcess.TopP = 0.9

#
#    World.Playerbots.Chat.MaxDailySpendUsd
#        Description: The most estimated US dollars the priced providers may spend per UTC day
#                     (0..10000; 0 = no daily cap). The estimate counts the tokens each reply
#                     reports at the provider's price; a provider without a known price is limited
#                     by its MaxRepliesPerHour only.
#        Type: double
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.MaxDailySpendUsd = 1

#
#    World.Playerbots.Chat.MaxQueuedRequests
#        Description: The most replies waiting for a provider at once (1..256); a line that finds
#                     the queue full is not answered.
#        Type: int
#        Default: 16
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.MaxQueuedRequests = 16

#
#    World.Playerbots.Chat.MemoryExchanges
#        Description: Earlier exchanges with the same player a bot remembers and sends with a model
#                     request (0..16).
#        Type: int
#        Default: 4
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.MemoryExchanges = 4

#
#    World.Playerbots.Chat.NaturalLanguageCommands
#        Description: Let the party master's plain-language orders ("follow me", "wait here",
#                     "attack my target") drive the party commands (on by default). Only the
#                     master's lines are read for orders; the one-word commands work either way.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.NaturalLanguageCommands = true

#
#    World.Playerbots.Chat.PerPlayerCooldownSeconds
#        Description: Seconds after a reply before the same player gets another one from any bot
#                     (0..3600; lines in between are not answered).
#        Type: int
#        Default: 8
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.PerPlayerCooldownSeconds = 8

#
#    World.Playerbots.Chat.Providers
#        Description: The reply providers, tried in order until one answers (failover on an error, a
#                     timeout, a 429, a spent budget or a missing key). Empty by default: only the
#                     built-in templates answer. The built-in provider is appended when it is not
#                     listed, and when listed it must be last. See docs/areas/playbots.md for the
#                     provider keys (Kind, BaseUrl, Model, ApiKeyEnvironmentVariable, Headers,
#                     MaxRepliesPerHour, MaxTokens, TokenLimitParameter, ReasoningEffort,
#                     JsonResponseFormat, InputUsdPerMillionTokens, OutputUsdPerMillionTokens,
#                     Moderation, ModerationBaseUrl, ModerationModel,
#                     ModerationApiKeyEnvironmentVariable).
#        Type: PlayerbotChatProviderOptions[]
#        Default: (empty list)
#        Allowed: a list: numbered keys 0, 1, 2, ...; each entry is a group of keys
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
# Empty by default. Each entry is a group of keys: World.Playerbots.Chat.Providers.0.<Field> = value, World.Playerbots.Chat.Providers.1.<Field> = value, ...

#
#    World.Playerbots.Chat.Safety.AllowOptOut
#        Description: Let a player whisper a bot "ai off" (built-in replies only) or "ai on" (on).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Safety.AllowOptOut = true

#
#    World.Playerbots.Chat.Safety.AutoMute
#        Description: Also mute a player's chat (the account mute of .mute) when they are cut off
#                     (off).
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Safety.AutoMute = false

#
#    World.Playerbots.Chat.Safety.AutoMuteMinutes
#        Description: The automatic mute's length in minutes (1..10080).
#        Type: int
#        Default: 30
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Safety.AutoMuteMinutes = 30

#
#    World.Playerbots.Chat.Safety.Categories
#        Description: The local filter's categories (comma-separated; all by default): SexualMinors,
#                     SelfHarm, Threats, Hate, Harassment, IllegalGoods, PersonalData. Values: None,
#                     SexualMinors, SelfHarm, Threats, Hate, Harassment, IllegalGoods, PersonalData,
#                     All.
#        Type: PlayerbotChatSafetyCategories
#        Default: All
#        Allowed: None | SexualMinors | SelfHarm | Threats | Hate | Harassment | IllegalGoods |
#                 PersonalData | All
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Safety.Categories = All

#
#    World.Playerbots.Chat.Safety.CutoffMinutes
#        Description: Minutes a cut-off player gets built-in replies only (1..10080).
#        Type: int
#        Default: 60
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Safety.CutoffMinutes = 60

#
#    World.Playerbots.Chat.Safety.Disclosure
#        Description: Tell each player once per login, the first time they talk to a bot, that bot
#                     replies may come from an AI service (on; only while a model provider is
#                     configured).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Safety.Disclosure = true

#
#    World.Playerbots.Chat.Safety.DisclosureText
#        Description: The disclosure (1..200 characters, one line, no '|'); the opt-out or opt-in
#                     hint is added after it.
#        Type: string
#        Default: "Bot replies on this server may be written by an AI service, which receives what
#                 you say to bots."
#        Allowed: text
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Safety.DisclosureText = "Bot replies on this server may be written by an AI service, which receives what you say to bots."

#
#    World.Playerbots.Chat.Safety.Enabled
#        Description: Screen every player line before any model provider sees it (the local filter,
#                     then each provider's optional moderation step), and every model reply before a
#                     bot says it (ScreenOutput). On by default. A flagged line never reaches a
#                     model.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Safety.Enabled = true

#
#    World.Playerbots.Chat.Safety.FlagLogSize
#        Description: Flag records kept in memory for .playerbot chat flags (0..10000; the oldest go
#                     first).
#        Type: int
#        Default: 200
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Safety.FlagLogSize = 200

#
#    World.Playerbots.Chat.Safety.OnFlagged
#        Description: What a flagged player line gets: BuiltinReply (default) or Ignore. Values:
#                     BuiltinReply, Ignore.
#        Type: PlayerbotChatFlaggedAction
#        Default: BuiltinReply
#        Allowed: BuiltinReply | Ignore
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Safety.OnFlagged = BuiltinReply

#
#    World.Playerbots.Chat.Safety.OnOutputFlagged
#        Description: What replaces a flagged model reply: BuiltinReply (default) or Drop. Values:
#                     BuiltinReply, Drop.
#        Type: PlayerbotChatOutputAction
#        Default: BuiltinReply
#        Allowed: BuiltinReply | Drop
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Safety.OnOutputFlagged = BuiltinReply

#
#    World.Playerbots.Chat.Safety.ReplaceDefaultTerms
#        Description: Use only TermsFile's lists, not the shipped ones (off).
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Safety.ReplaceDefaultTerms = false

#
#    World.Playerbots.Chat.Safety.RequireOptIn
#        Description: Use the model providers only for players who whispered a bot "ai on" (off).
#                     Everyone else gets built-in replies.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Safety.RequireOptIn = false

#
#    World.Playerbots.Chat.Safety.ScreenOutput
#        Description: Screen each model reply with the local filter before the bot says it (on).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Safety.ScreenOutput = true

#
#    World.Playerbots.Chat.Safety.StoreExcerpt
#        Description: Keep a short excerpt of each flagged line (at most 60 characters, emails,
#                     phone numbers and addresses removed) in the flag record and the log warning
#                     (on). Off: only who, when, which bot and which category.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Safety.StoreExcerpt = true

#
#    World.Playerbots.Chat.Safety.StrikeWindowMinutes
#        Description: Minutes a strike counts (1..10080); older strikes fall away.
#        Type: int
#        Default: 60
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Safety.StrikeWindowMinutes = 60

#
#    World.Playerbots.Chat.Safety.StrikesBeforeCutoff
#        Description: Strikes within StrikeWindowMinutes that cut a player off from the model
