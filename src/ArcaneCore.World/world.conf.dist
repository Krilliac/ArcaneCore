#----------------------------------------------------------------------------
# Forms
#----------------------------------------------------------------------------

#
#    Forms.ResetFistAttackTimeOnFormLoss
#        Description: true gives a weapon-less hand the 2.0 s base attack time when a shapeshift
#                     form ends (read once by FormStatFeature); false keeps the retail 1.0 / 2.5 s
#                     of an unarmed hand.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#keys-read-by-name
#
Forms.ResetFistAttackTimeOnFormLoss = false

###############################################################################
# GAMEOBJECTS
###############################################################################

#----------------------------------------------------------------------------
# GameObjects
#----------------------------------------------------------------------------

#
#    GameObjects.LootSettlementBudgetSeconds
#        Description: Seconds one dungeon chest loot settlement may take end to end (the taker's
#                     save, the instance write drain, the loot transaction) before it is abandoned:
#                     a take that never started is refused to the client as usual, one whose outcome
#                     cannot be read kicks the taker. Operational, not a gameplay rule: 5 is the
#                     shipped value. Valid range 1-300.
#        Type: int
#        Default: 5
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#gameobjects
#
GameObjects.LootSettlementBudgetSeconds = 5

#
#    GameObjects.MiningAmountRate
#        Description: vmangos Rate.Mining.Amount (CONFIG_FLOAT_RATE_MINING_AMOUNT, default 1;
#                     LootHandler.cpp:455-457): scales the minimum and maximum number of opens of a
#                     multi-use mineral vein (chest.minSuccessOpens / maxSuccessOpens). Default 1
#                     (retail).
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#gameobjects
#
GameObjects.MiningAmountRate = 1

#
#    GameObjects.MiningNextRate
#        Description: vmangos Rate.Mining.Next (CONFIG_FLOAT_RATE_MINING_NEXT, default 1;
#                     LootHandler.cpp:466-474): scales the chance that a mineral vein past its
#                     minimum opens stays for one more open. Default 1 (retail).
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#gameobjects
#
GameObjects.MiningNextRate = 1

#
#    GameObjects.RandomRespawn
#        Description: vmangos GameObjectData::GetRandomRespawnTime (GameObject.cpp:706-709): the
#                     respawn delay of a database spawn is a random value between spawntimesecsmin
#                     and spawntimesecsmax. False always uses the minimum.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#gameobjects
#
GameObjects.RandomRespawn = true

#
#    GameObjects.TransportAnimationDbcPath
#        Description: A build-5875 TransportAnimation.dbc (vmangos loads it with the other DBCs):
#                     the animations of the elevators and trams (type 11), whose create block then
#                     carries the progress through their cycle. Empty (the default): their progress
#                     stays 0, as vmangos without the data.
#        Type: string
#        Default: (not set)
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#gameobjects
#
# GameObjects.TransportAnimationDbcPath =

###############################################################################
# HOTRELOAD
###############################################################################

#----------------------------------------------------------------------------
# HotReload
#----------------------------------------------------------------------------

#
#    HotReload.BuildTimeoutMs
#        Description: How long a candidate may take to build (database read plus indexing) before
#                     the reload is abandoned. 0 = no limit.
#        Type: int
#        Default: 60000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#hotreload
#
HotReload.BuildTimeoutMs = 60000

#
#    HotReload.Commands
#        Description: The one switch for live reload. Default false: a production server does not
#                     carry the reload machinery (vmangos registers the reload root, Chat.cpp:1212,
#                     but ArcaneCore's operator-initiated hot reload is a development tool, so it is
#                     opt-in). When false the reload coordinator is not built, no reloadable is
#                     registered and the .reload root does not exist (the chat reply is "There is no
#                     such command"). A development server turns it on with HotReload:Commands=true.
#                     Read once when the world starts.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#hotreload
#
HotReload.Commands = false

#
#    HotReload.CommitTimeoutMs
#        Description: How long to wait for the world thread to run the swap before abandoning the
#                     reload. A swap that has not started by then is cancelled and never runs later.
#                     0 = no limit.
#        Type: int
#        Default: 30000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#hotreload
#
HotReload.CommitTimeoutMs = 30000

#
#    HotReload.EmptyTables
#        Description: What a reload does when item_template, game_tele or areatrigger_teleport comes
#                     back empty. Default Retail: vmangos clears the loaded rows first
#                     (ObjectMgr.cpp:3817, 10468, 7708), so the table ends up empty. Values: Retail,
#                     KeepLoaded.
#        Type: EmptyTablePolicy
#        Default: Retail
#        Allowed: Retail | KeepLoaded
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#hotreload
#
HotReload.EmptyTables = Retail

#
#    HotReload.NegativeNumbers
#        Description: What .reload config does with a negative interval or range. Default Retail:
#                     vmangos logs an error and uses the default (World.cpp:2949-2977
#                     setConfigPos/setConfigMin). Values: Retail, Reject.
#        Type: InvalidNumberPolicy
#        Default: Retail
#        Allowed: Retail | Reject
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#hotreload
#
HotReload.NegativeNumbers = Retail

