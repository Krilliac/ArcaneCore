#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Social.Rivalry.Emotes.FriendlyAffinity = 20

#
#    World.Playerbots.Social.Rivalry.Emotes.GreetStrangerChance
#        Description: The chance (0..1, times the bot's sociability) that a bot greets a stranger of
#                     the other faction; a known neutral is greeted at half the bot's sociability, a
#                     friend always (default 0.25).
#        Type: double
#        Default: 0.25
#        Allowed: a number, '.' is the decimal point
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Social.Rivalry.Emotes.GreetStrangerChance = 0.25

#
#    World.Playerbots.Social.Rivalry.Emotes.RangeYards
#        Description: How close, in yards, a character of the other faction must stand to be greeted
#                     or taunted (5..25; default 20). The range actually used is never more than
#                     World:ListenRangeTextEmote, which is read at every pass.
#        Type: int
#        Default: 20
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Social.Rivalry.Emotes.RangeYards = 20

#
#    World.Playerbots.Social.Rivalry.Emotes.RivalEmotes
#        Description: Send rude emotes at rivals and let a rival or a disliked character be answered
#                     rudely or not at all (on by default). Off: every reply is by a neutral stance.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Social.Rivalry.Emotes.RivalEmotes = true

#
#    World.Playerbots.Social.Rivalry.Emotes.RudeAtBots
#        Description: Let rude emotes and rude replies reach other bots (off by default). Off:
#                     nothing the rivalry stage sends to a bot is ever rude, a rude emote aimed at a
#                     bot is met with a shrug or a sigh, so no exchange between two bots can lower
#                     an affinity.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Social.Rivalry.Emotes.RudeAtBots = false

#
#    World.Playerbots.Social.Rivalry.Emotes.RudePairGapMinutes
#        Description: The least time, in minutes, between two rude emotes from one bot to one
#                     character (1..1440; default 30).
#        Type: int
#        Default: 30
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Social.Rivalry.Emotes.RudePairGapMinutes = 30

#
#    World.Playerbots.Social.Rivalry.Emotes.RudePerTargetMinutes
#        Description: The least time, in minutes, between two rude emotes at one character from all
#                     bots together (1..1440; default 30).
#        Type: int
#        Default: 30
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Social.Rivalry.Emotes.RudePerTargetMinutes = 30

#
#    World.Playerbots.Social.Rivalry.Emotes.RudeRequiresOptIn
#        Description: Send rude emotes only to real players who whispered "rivals on" (off by
#                     default: they go to every real rival who has not opted out).
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Social.Rivalry.Emotes.RudeRequiresOptIn = false

#
#    World.Playerbots.Social.Rivalry.Enabled
#        Description: The master switch (on by default). Off: the lane sends nothing and an emote is
#                     answered as before the stance existed. Recorded opt-outs are kept.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Social.Rivalry.Enabled = true

#
#    World.Playerbots.Social.Rivalry.Safeguards.SafeAreas
#        Description: Area ids (comma separated; the sub-zone a character stands in, not its zone)
#                     where no rude emote is sent, on top of every capital city, which is always
