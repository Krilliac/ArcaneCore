#
# NpcServices.TaxiPathDbcPath =

#
#    NpcServices.TaxiPathNodeDbcPath
#        Description: Build-5875 TaxiPathNode.dbc (flight waypoints).
#        Type: string
#        Default: (not set)
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
