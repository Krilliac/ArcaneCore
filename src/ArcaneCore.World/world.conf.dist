#        Default: 150
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loot
#
Loot.BossRewardDistanceBonus = 150

#
#    Loot.DropItemArtifactRate
#        Description: vmangos Rate.Drop.Item.Artifact (World.cpp:503, default 1): the same for
#                     artifact quality items.
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loot
#
Loot.DropItemArtifactRate = 1

#
#    Loot.DropItemEpicRate
#        Description: vmangos Rate.Drop.Item.Epic (World.cpp:501, default 1): the same for epic
#                     (purple) items.
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loot
#
Loot.DropItemEpicRate = 1

#
#    Loot.DropItemLegendaryRate
#        Description: vmangos Rate.Drop.Item.Legendary (World.cpp:502, default 1): the same for
#                     legendary (orange) items.
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loot
#
Loot.DropItemLegendaryRate = 1

#
#    Loot.DropItemNormalRate
#        Description: vmangos Rate.Drop.Item.Normal (World.cpp:498, default 1): the same for common
#                     (white) items.
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loot
#
Loot.DropItemNormalRate = 1

#
#    Loot.DropItemPoorRate
#        Description: vmangos Rate.Drop.Item.Poor (World.cpp:497, setConfigPos, default 1):
#                     multiplies the chance of an ungrouped loot row whose item is of poor (grey)
#                     quality (LootMgr.cpp:33-42 qualityToRate, applied in LootStoreItem::Roll,
#                     :256-268: a chance of 100 or more always drops, otherwise roll_chance_f(chance
#                     * rate)). Grouped rows are not scaled (LootGroup::Roll uses the raw chances,
#                     :1056-1086).
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loot
#
Loot.DropItemPoorRate = 1

#
#    Loot.DropItemRareRate
#        Description: vmangos Rate.Drop.Item.Rare (World.cpp:500, default 1): the same for rare
#                     (blue) items.
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loot
#
Loot.DropItemRareRate = 1

#
#    Loot.DropItemReferencedRate
#        Description: vmangos Rate.Drop.Item.Referenced (World.cpp:504, default 1): multiplies the
#                     chance of an ungrouped reference row (a negative mincountOrRef) to be
#                     processed (LootStoreItem::Roll, LootMgr.cpp:261-262).
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loot
#
Loot.DropItemReferencedRate = 1

#
#    Loot.DropItemUncommonRate
#        Description: vmangos Rate.Drop.Item.Uncommon (World.cpp:499, default 1): the same for
#                     uncommon (green) items.
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loot
#
Loot.DropItemUncommonRate = 1

#
#    Loot.GroupLootDistance
#        Description: vmangos CONFIG_FLOAT_GROUP_XP_DISTANCE: group members within it share loot and
#                     money.
#        Type: float
#        Default: 74
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loot
#
Loot.GroupLootDistance = 74

#
#    Loot.LootDistance
#        Description: INTERACTION_DISTANCE: how close a looter must stay to the corpse/chest (plus
#                     both radii).
#        Type: float
#        Default: 5
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loot
#
Loot.LootDistance = 5

#
#    Loot.LootedCorpseDecayRate
#        Description: vmangos CONFIG_FLOAT_RATE_CORPSE_DECAY_LOOTED (Rate.Corpse.Decay.Looted,
#                     mangosd.conf.dist.in:1542; cmangos World.cpp:457 too): a looted-out corpse
#                     stays this share of its decay time. The retail default 0 means a third of the
#                     creature's respawn delay (Creature.cpp:3369-3370).
#        Type: float
#        Default: 0
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loot
#
Loot.LootedCorpseDecayRate = 0

#
#    Loot.MoneyRate
#        Description: vmangos Rate.Drop.Money.
#        Type: float
#        Default: 1
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loot
#
Loot.MoneyRate = 1

#
#    Loot.RaidMapsUnlimitedRewardDistance
#        Description: Raid maps have no reward distance limit (vmangos Object.cpp:1482-1483). False
#                     applies GroupLootDistance there too.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loot
#
Loot.RaidMapsUnlimitedRewardDistance = true

#
#    Loot.RollTimeoutMs
#        Description: How long a need/greed roll waits for votes before the players who did not vote
#                     count as passed, in milliseconds (vmangos Group.cpp:72 LOOT_ROLL_TIMEOUT, 1
#                     minute; the same value goes into SMSG_LOOT_START_ROLL as the countdown).
#        Type: uint
#        Default: 60000
#        Allowed: a whole number, 0 to 4294967295
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loot
#
Loot.RollTimeoutMs = 60000

