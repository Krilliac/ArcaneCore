#
# NpcServices.SkillLineAbilityDbcPath =

#
#    NpcServices.TaxiNodesDbcPath
#        Description: Build-5875 TaxiNodes.dbc; when set its node positions and faction mounts
#                     replace the imported table.
#        Type: string
#        Default: (not set)
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
