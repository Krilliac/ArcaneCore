#        Default: 8
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Combat.Kite.MaxStepsPerFight = 8

#
#    World.Playerbots.Combat.Kite.StepYards
#        Description: The longest single step away from the pursuer, in yards (4..20).
#        Type: float
#        Default: 10
#        Allowed: a number, '.' is the decimal point
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Combat.Kite.StepYards = 10

#
#    World.Playerbots.CombatLaneShare
#        Description: The share (0.1..0.9) of the think time budget and of MaxActionsPerTick the
#                     combat lane may use. The lane gets floor(share × MaxActionsPerTick) actions of
#                     its own (none at MaxActionsPerTick 1); the rest, at least one, is the other
#                     bots' and no fight's think can touch it, so they are never starved by a crowd
#                     of fights. What the combat lane leaves goes to the other bots too.
#        Type: double
#        Default: 0.7
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.CombatLaneShare = 0.7

#
#    World.Playerbots.CombatThinkIntervalMs
#        Description: Milliseconds (50..60000) after which a bot that is in combat, dead or a ghost
#                     is due for the think lane that comes first (PlayerbotThinkRotation.TickLanes).
#                     Under load such a bot thinks about this often; with room for everyone every
#                     bot thinks every tick as before.
#        Type: int
#        Default: 300
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.CombatThinkIntervalMs = 300

#
#    World.Playerbots.Contention.ClaimPenaltyYards
#        Description: Yards a mob counts as farther away for each other bot already walking to it
#                     (0..200), when a bot picks among untagged mobs. 0 turns the soft claims off,
#                     so every bot goes for the nearest mob again.
#        Type: float
#        Default: 25
#        Allowed: a number from 0 to 200 ('.' is the decimal point); 0 turns the soft claims off
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Contention.ClaimPenaltyYards = 25

#
#    World.Playerbots.Contention.ContentionSuspendMinutes
#        Description: Minutes a bot leaves a quest creature alone after three minutes of contested
#                     hunting without credit (1..120; see PlayerbotContention.ObserveObjective): it
#                     hunts its next unfinished objective or quest meanwhile, and asks for a group
#                     when none is left.
#        Type: int
#        Default: 5
#        Allowed: a whole number from 1 to 120 (minutes)
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Contention.ContentionSuspendMinutes = 5

#
#    World.Playerbots.Contention.HelpChance
#        Description: Base chance (0..1) that a bot walking to a mob another player has tagged
#                     decides to help that player instead of leaving the mob alone. It is scaled by
#                     the bot's own sociability (a stable 0..1 from its guid), doubled for a real
#                     player's tag and raised by half when both share the kill quest, and only asked
#                     when the tagger is within 30 yards and losing and the bot is healthy. 0 never
#                     helps.
#        Type: float
#        Default: 0.35
#        Allowed: a number from 0 to 1 ('.' is the decimal point); 0 never helps, 1 helps whenever
#                 the other conditions hold
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Contention.HelpChance = 0.35

#
#    World.Playerbots.Contention.InvincibleTargetAbandonSeconds
#        Description: Seconds a bot may hold a target whose health stays at or below its
#                     death-prevention threshold (InvincibilityHpThreshold: a creature an EventAI
#                     script keeps at 1 health until some condition is met, such as the Blasted
#                     Lands servants of quest 2681) before it sets the creature aside as one it
#                     cannot kill (1..600).
#        Type: int
#        Default: 8
#        Allowed: a whole number from 1 to 600 (seconds)
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Contention.InvincibleTargetAbandonSeconds = 8

#
#    World.Playerbots.Contention.SomeoneElsesMemorySeconds
#        Description: Seconds a bot leaves a mob alone after it found it to be someone else's
#                     (1..600), and the least between two decisions about the same mob.
#        Type: int
#        Default: 15
#        Allowed: a whole number from 1 to 600 (seconds)
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Contention.SomeoneElsesMemorySeconds = 15

#
#    World.Playerbots.CornerCentringMaxYards
#        Description: The most (yards, 0..10) the centring part of a PathShaping move can be: a
#                     corner in a corridor bounded on both sides (a road between two walls) is
#                     pushed away from the inside of the turn by the larger of the clearance still
#                     missing and its way to the middle of the corridor, and this caps that way to
#                     the middle only, so it never lowers the clearance push. 0 turns road centring
#                     off. A corner is never moved closer than 0.5 yard to the far side.
#        Type: float
#        Default: 4
#        Allowed: a number from 0 to 10 ('.' is the decimal point); 0 turns road centring off
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.CornerCentringMaxYards = 4

#
#    World.Playerbots.CornerClearanceYards
#        Description: The clearance (yards, 0.5..5) kept from the obstacle on the inside of a turn
#                     when PathShaping moves a route corner. The navigation mesh is built with a 0.2
#                     yard agent radius, so an unshaped corner sits that close to the wall or post
#                     it goes around.
#        Type: float
#        Default: 2
#        Allowed: a number from 0.5 to 5 ('.' is the decimal point)
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.CornerClearanceYards = 2

#
#    World.Playerbots.CornerTurnLeadYards
#        Description: How far before a corner (yards, 0..6) PathShaping starts to turn it: the
#                     tangent length of the arc that rounds a turn sharper than about 34 degrees. 0
#                     turns rounding off; the lead is also held to 40% of the shorter leg beside the
#                     corner.
#        Type: float
#        Default: 2.5
#        Allowed: a number from 0 to 6 ('.' is the decimal point); 0 turns corner rounding off
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.CornerTurnLeadYards = 2.5

#
#    World.Playerbots.CutRegionMaxPolygons
#        Description: The most polygons a cut region (a navigation region that is the only way
#                     between two large parts of the mesh, such as the Timbermaw Hold tunnel) may
#                     hold and still be exempt from shared world pins and from refusing a bot's
#                     pinned plan end (0..1000000; 0: no region is exempt). The exemption judges the
#                     whole region, so a larger bound lets more real snags go unshared. The default,
#                     5000, keeps the Timbermaw Hold tunnel's largest measured region inside it,
#                     with about 2% headroom; re-check after regenerating mmaps. Bots only; no
#                     retail behaviour depends on it.
#        Type: int
#        Default: 5000
#        Allowed: a whole number from 0 to 1000000 (0: no region is exempt)
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.CutRegionMaxPolygons = 5000

#
#    World.Playerbots.Economy.BankDeposit
#        Description: Deposit goods the bot does not need (trade goods and reagents no spell of its
#                     own uses, gems, recipes, stackable curios) at a banker while it stays at its
#                     capital home (on by default). Gear, food, potions, ammunition, bags, grays and
#                     quest items are never deposited.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Economy.BankDeposit = true

#
#    World.Playerbots.Economy.BuyBankSlots
#        Description: Buy the next bank bag slot at a banker while the bot stays at its capital home
#                     when the bank has fewer than 5 free slots and the price is at most 40% of the
#                     bot's gold (on by default). A bought slot is only space once a bag is put in
#                     it, which bots do not do yet, so the bank-nearly-full gate keeps the purchase
#                     rare.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Economy.BuyBankSlots = true

#
#    World.Playerbots.Economy.BuyBelowAskPercent
#        Description: The most a bot pays per unit at the house (reagents and gear) as a percent of
#                     the bot floor of that item, so no bot ever pays what a bot asks.
#        Type: int
#        Default: 50
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Economy.BuyBelowAskPercent = 50

#
#    World.Playerbots.Economy.BuyReagents
#        Description: Buy the reagents of the recipes the bot wants to craft that it carries fewer
#                     of than one craft uses at the faction auction house during a visit (on by
#                     default): at most 2 auctions a visit, within the visit budget. Guards: a
#                     reagent a vendor stocks is never bought; an auction holds at most twice the
#                     shortfall; a buyout per unit is at most BuyBelowAskPercent percent of the bot
#                     floor of the item (an item with no vendor sell price is never bought). Off: no
#                     reagent is searched or bought. Reagents a wanted recipe uses are never listed
#                     either way.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Economy.BuyReagents = true

#
#    World.Playerbots.Economy.BuyUpgradeBudgetFraction
#        Description: The share of the money a bot holds at the start of a visit that the visit may
#                     spend in all (0..1): listing deposits and the buyout of an upgrade count
#                     against it. 0 spends nothing.
#        Type: float
#        Default: 0.25
#        Allowed: a number, '.' is the decimal point
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Economy.BuyUpgradeBudgetFraction = 0.25

#
#    World.Playerbots.Economy.ConsumableKeepCount
#        Description: Per consumable entry, the count (1..200) a bot always keeps before a stack of
#                     it is surplus.
#        Type: int
#        Default: 20
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Economy.ConsumableKeepCount = 20

#
#    World.Playerbots.Economy.Enabled
#        Description: Let bots list, buy and collect at the auction house (on by default). Off: no
#                     visit starts; a running one is dropped.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Economy.Enabled = true

#
#    World.Playerbots.Economy.HouseBuyoutsPerHour
#        Description: The most auctions all bots together buy out at one auction house in any 60
#                     minutes of world time (0..100000); 0 lets no bot buy there. A soft limit: a
#                     buyout counts when the house confirms it, so bots with buyouts in flight
#                     together can overshoot it by their number.
#        Type: int
#        Default: 200
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Economy.HouseBuyoutsPerHour = 200

#
#    World.Playerbots.Economy.HouseListingsPerHour
#        Description: The most auctions all bots together list at one auction house in any 60
#                     minutes of world time (0..100000); 0 lets no bot list there. A soft limit: a
#                     listing counts when the house confirms it, so bots with listings in flight
#                     together can overshoot it by their number.
#        Type: int
#        Default: 400
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Economy.HouseListingsPerHour = 400

#
#    World.Playerbots.Economy.ListChancePerVisit
#        Description: The chance in percent (0..100) that a visit lists anything: one roll per
#                     visit, then the bot lists up to its free listing slots. 0 lists nothing (a bot
#                     may still buy and collect); 100 always lists.
#        Type: int
#        Default: 50
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Economy.ListChancePerVisit = 50

#
#    World.Playerbots.Economy.ListMarkupPercentCommon
#        Description: The bot floor of a common (white) item as a percent of its vendor sell price
#                     (never below the reference price or the vendor floor after the cut).
#        Type: int
#        Default: 500
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Economy.ListMarkupPercentCommon = 500

#
#    World.Playerbots.Economy.ListMarkupPercentEpic
#        Description: The bot floor of an epic or better item as a percent of its vendor sell price
#                     (never below the reference price or the vendor floor after the cut).
#        Type: int
#        Default: 10000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Economy.ListMarkupPercentEpic = 10000

#
#    World.Playerbots.Economy.ListMarkupPercentRare
#        Description: The bot floor of a rare (blue) item as a percent of its vendor sell price
#                     (never below the reference price or the vendor floor after the cut).
#        Type: int
#        Default: 800
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Economy.ListMarkupPercentRare = 800

#
#    World.Playerbots.Economy.ListMarkupPercentUncommon
#        Description: The bot floor of an uncommon (green) item as a percent of its vendor sell
#                     price (never below the reference price or the vendor floor after the cut).
#        Type: int
#        Default: 300
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Economy.ListMarkupPercentUncommon = 300

#
#    World.Playerbots.Economy.ListSurplusConsumables
#        Description: List stacks of consumables (food, drink, potions, bandages, elixirs, scrolls)
#                     beyond the keep count (on by default).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Economy.ListSurplusConsumables = true

#
#    World.Playerbots.Economy.MaxBuyoutsPerHour
#        Description: The most auctions one bot buys out, reagents and upgrades together, in any 60
#                     minutes of world time (0..100); 0 buys nothing.
#        Type: int
#        Default: 6
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Economy.MaxBuyoutsPerHour = 6

#
#    World.Playerbots.Economy.MaxListingsPerBot
#        Description: The most auctions one bot has listed at once (0..50), counted from the auction
#                     house's own owner list; 0 lists nothing.
#        Type: int
#        Default: 5
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Economy.MaxListingsPerBot = 5

#
#    World.Playerbots.Economy.MaxListingsPerHour
#        Description: The most auctions one bot lists in any 60 minutes of world time (0..100); 0
#                     lists nothing.
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Economy.MaxListingsPerHour = 10

#
#    World.Playerbots.Economy.MoneyGoal
#        Description: A bot short of money lists every visit and gets 3 more listing slots (on by
#                     default). Short means its budget reserves more than it has, or its money is
#                     below MoneyGoalCopperPerLevel times its level. It only raises listing, and
#                     never when ListChancePerVisit or MaxListingsPerBot is 0.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Economy.MoneyGoal = true

#
#    World.Playerbots.Economy.MoneyGoalCopperPerLevel
#        Description: The money floor per character level of the money goal, in copper (0..100000);
#                     0: only what the budget reserves counts.
#        Type: int
#        Default: 500
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Economy.MoneyGoalCopperPerLevel = 500

#
#    World.Playerbots.Economy.VisitIntervalMinutes
#        Description: Minutes between two visits of one bot (1..1440). Bots start at a random point
#                     of the first interval.
#        Type: int
#        Default: 30
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Economy.VisitIntervalMinutes = 30

#
#    World.Playerbots.Enabled
#        Description: Run server-managed playerbots (off by default).
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Enabled = false

#
#    World.Playerbots.FaultBackoffSeconds
#        Description: Seconds a bot waits in quarantine after an action fault before it is logged in
#                     again (1..3600); each further fault in FaultWindowSeconds doubles the wait, up
#                     to an hour. The bot stays desired meanwhile.
#        Type: int
#        Default: 30
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.FaultBackoffSeconds = 30

#
#    World.Playerbots.FaultWindowSeconds
#        Description: How far back faults count towards MaxFaults, in seconds of world time
#                     (1..604800).
#        Type: int
#        Default: 3600
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.FaultWindowSeconds = 3600

#
#    World.Playerbots.Follow.CatchUpMode
#        Description: Teleport to catch up, fight through, or teleport only when unreachable
#                     (PlayerbotCatchUpMode.Teleport by default, the reference behaviour). Values:
#                     Teleport, FightThrough, Auto.
#        Type: PlayerbotCatchUpMode
#        Default: Teleport
#        Allowed: Teleport | FightThrough | Auto
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Follow.CatchUpMode = Teleport

#
#    World.Playerbots.Follow.DangerLevelMargin
#        Description: Teleport mode: a way that passes inside the aggro radius of a hostile creature
#                     this many levels or more above the bot, or of an elite at or above the bot's
#                     level, counts as no way (0..60).
#        Type: int
#        Default: 3
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Follow.DangerLevelMargin = 3

#
#    World.Playerbots.Follow.LeaderCombatRangeYards
#        Description: A bot in combat makes a catch-up teleport only when its leader is out of
#                     combat and farther than this many yards (the leader left the fight; vmangos
#                     counts a member's attacker within 50 yards as the group's fight,
#                     SelectPartyAttackTarget; 0..1000).
#        Type: float
#        Default: 50
#        Allowed: a number, '.' is the decimal point
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Follow.LeaderCombatRangeYards = 50

#
#    World.Playerbots.Follow.MaxFallHealthPercent
#        Description: A drop to a leader below is taken when the fall (vmangos Player::HandleFall
#                     damage) would cost less than this percentage of the bot's current health (0:
#                     only falls that do no damage, under 14.57 yards; 0..99).
#        Type: int
#        Default: 50
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Follow.MaxFallHealthPercent = 50

#
#    World.Playerbots.Follow.MaxPathRatio
#        Description: Teleport mode: a way to the leader longer than this many times the straight
#                     distance counts as no way (1.5..20), when it is also at least MinDetourYards
#                     longer than the straight line.
#        Type: float
#        Default: 3
#        Allowed: a number, '.' is the decimal point
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Follow.MaxPathRatio = 3

#
#    World.Playerbots.Follow.MinDetourYards
#        Description: Teleport mode: a way to the leader at most this many yards longer than the
#                     straight line is always walked (0..500).
#        Type: float
#        Default: 40
#        Allowed: a number, '.' is the decimal point
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Follow.MinDetourYards = 40

#
#    World.Playerbots.Follow.NoProgressSeconds
#        Description: Seconds without getting closer to a leader who stands still before the
#                     follower plans again; the same again after that re-plan and it teleports
#                     (Teleport and Auto modes) or plans once more (FightThrough). 2..120.
#        Type: int
#        Default: 8
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Follow.NoProgressSeconds = 8

#
#    World.Playerbots.Follow.TeleportDistanceYards
#        Description: Teleport mode: a leader on the bot's map farther than this many yards is
#                     teleported to (vmangos PartyBotAI IsWithinDistInMap(pLeader, 100.0f);
#                     10..1000).
#        Type: float
#        Default: 100
#        Allowed: a number, '.' is the decimal point
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Follow.TeleportDistanceYards = 100

