#                     into the group.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Voice.LookingForGroup = true

#
#    World.Playerbots.Chat.Voice.LookingForGroupRepeatSeconds
#        Description: The least seconds between two LFG or LFM calls of one bot (30..3600).
#        Type: int
#        Default: 180
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Voice.LookingForGroupRepeatSeconds = 180

#
#    World.Playerbots.Chat.Voice.MinSellCopper
#        Description: Items worth less than this many copper at a vendor (per stack) are not offered
#                     (0..1000000).
#        Type: int
#        Default: 200
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
