#        Type: int
#        Default: 3
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Safety.StrikesBeforeCutoff = 3

#
#    World.Playerbots.Chat.Safety.StripPersonalData
#        Description: Replace emails, phone numbers and street addresses in what is sent to a model
#                     provider with a placeholder (on).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Safety.StripPersonalData = true

#
#    World.Playerbots.Chat.Safety.TermsFile
#        Description: An operator's term file (the shipped file's JSON format), relative to the
#                     working directory or absolute. Empty: only the shipped list. Its entries are
#                     added to the shipped ones unless ReplaceDefaultTerms; it is read again when it
#                     changes.
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Safety.TermsFile = ""

#
#    World.Playerbots.Chat.Speech.BotGapSeconds
#        Description: The least seconds between two lines a bot starts on its own (0..3600; replies
#                     are not held by it).
#        Type: int
#        Default: 20
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Speech.BotGapSeconds = 20

#
#    World.Playerbots.Chat.Speech.BotLinesPerMinute
#        Description: The most lines one bot says in a minute, replies included (1..60).
#        Type: int
#        Default: 6
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Speech.BotLinesPerMinute = 6

#
#    World.Playerbots.Chat.Speech.BotToBot
#        Description: Let a bot's line reach other bots as input (on by default), within
#                     BotToBotMaxTurns, BotToBotPairLinesPerHour and BotToBotLinesPerMinute. Off:
#                     bots hear only real players, as before.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Speech.BotToBot = true

#
#    World.Playerbots.Chat.Speech.BotToBotLinesPerMinute
#        Description: The most lines all bots together say to other bots in a minute (0..600).
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Speech.BotToBotLinesPerMinute = 10

#
#    World.Playerbots.Chat.Speech.BotToBotMaxTurns
#        Description: The most answers in one exchange between two bots (0..10; 0 = bots never
#                     answer bots). An exchange ends after BotToBotQuietSeconds of silence between
#                     them.
#        Type: int
#        Default: 3
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Speech.BotToBotMaxTurns = 3

#
#    World.Playerbots.Chat.Speech.BotToBotPairLinesPerHour
#        Description: The most lines two bots say to each other in an hour (0..600).
#        Type: int
#        Default: 12
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Speech.BotToBotPairLinesPerHour = 12

#
#    World.Playerbots.Chat.Speech.BotToBotQuietSeconds
#        Description: Seconds of silence after which an exchange between two bots is over and its
#                     turns start again (10..3600).
#        Type: int
#        Default: 120
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Speech.BotToBotQuietSeconds = 120

#
#    World.Playerbots.Chat.Speech.ChannelChangesPerPass
#        Description: The most bots whose channels are changed in one social pass (1..1000), so a
#                     fleet logging in at once spreads its joins.
#        Type: int
#        Default: 25
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Speech.ChannelChangesPerPass = 25

#
#    World.Playerbots.Chat.Speech.ChannelCrowdBots
#        Description: How many bots a world channel holds before its budget thins out (1..10000; see
#                     ChannelLinesPerMinute).
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Speech.ChannelCrowdBots = 10

#
#    World.Playerbots.Chat.Speech.ChannelLinesPerMinute
#        Description: The most bot lines one world channel hears in a minute, from all bots together
#                     (0..60; 0 keeps bots silent there). The channel is per zone ("General - Elwynn
#                     Forest") and per faction; when more than ChannelCrowdBots bots are in it the
#                     minute stretches in proportion, so a crowded channel hears fewer bot lines,
#                     never more.
#        Type: int
#        Default: 3
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Speech.ChannelLinesPerMinute = 3

#
#    World.Playerbots.Chat.Speech.DedupeSeconds
#        Description: Seconds within which the same line is not said twice in the same place by any
#                     bot (0..3600).
#        Type: int
#        Default: 120
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Live (.reload config applies it to the running server)
#        Docs: docs/reference/configuration.md#worldplayerbots
#
World.Playerbots.Chat.Speech.DedupeSeconds = 120

