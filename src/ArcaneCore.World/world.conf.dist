#
# NpcServices.TaxiNodesDbcPath =

#
#    NpcServices.TaxiPathDbcPath
#        Description: Build-5875 TaxiPath.dbc; when set its routes and costs replace the imported
#                     table.
#        Type: string
#        Default: (not set)
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
