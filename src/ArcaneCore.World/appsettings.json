{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "ArcaneCore": {
      "Console": {
        "Mode": "Color"
      },
      "File": {
        "Enabled": false,
        "Path": "logs/world.log",
        "RollSizeMb": 64,
        "RollDaily": true,
        "Retain": 14
      },
      "Json": {
        "Enabled": false,
        "Path": "logs/world.jsonl"
      },
      "Timestamps": "Utc",
      "IncludeScopes": true
    }
  },
  "HotReload": {
    "Commands": false,
    "BuildTimeoutMs": 60000,
    "CommitTimeoutMs": 30000
  },
  "HostOptions": {
    "ShutdownTimeout": "00:01:00"
  },
  "Ops": {
    "Watchdog": {
      "Enabled": true,
      "TickMonitor": { "BudgetMs": 0, "HangMs": 2000 },
      "Memory": { "Action": "None", "ActionHeapBytes": 0 },
      "Heartbeat": { "Mode": "Auto", "FilePath": "" },
      "Counters": { "DumpIntervalSeconds": 300 }
    }
  },
  "PerformanceLog": {
    "SlowWorldUpdate": 100,
    "SlowWorldUpdateMeasure": "FrameInterval",
    "SlowMapUpdate": 100,
    "SlowPackets": 20
  },
  "World": {
    "BindAddress": "0.0.0.0",
    "Port": 8085,
    "TickIntervalMs": 50,
    "UpdateCompressionThreshold": 128,
    "AutosaveIntervalMs": 900000,
    "CharactersPerRealm": 10,
    "Motd": "Welcome to ArcaneCore.",
    "ListenRangeSay": 25,
    "ListenRangeYell": 300,
    "ListenRangeTextEmote": 25,
    "AllowTwoSideChat": false,
    "AllowTwoSideWhoList": false,
    "LogoutDelayMs": 20000,
    "InstantLogoutSecurity": "Moderator",
    "GmLevelInWhoList": "Administrator",
    "PlayerCommands": true,
    "Social": {
      "AllowTwoSideAddFriend": false,
      "AllowTwoSideGroup": false,
      "AllowTwoSideGuild": false,
      "AllowTwoSideChannel": false
    },
    "HotCode": {
      "Enabled": false,
      "AuditLogPath": "",
      "MaxConsecutiveFaults": 50,
      "Modules": {
        "Enabled": false,
        "Directory": "",
        "AllowAnyEnvironment": false,
        "LoadOnStart": []
      }
    },
    "GmCommands": {
      "SecurityMap": {
        "Player": 0,
        "Moderator": 1,
        "GameMaster": 3,
        "Administrator": 6
      },
      "HideUnavailable": false,
      "ExactNameFirst": false,
      "RetailLevels": true,
      "LogCommands": true,
      "LowerSecurity": true,
      "LookupMaxResults": 0,
      "AuditTailSize": 200,
      "TicketMutationsPerMinute": 10,
      "LiveFx": true
    },
    "Maps": {
      "DataDirectory": "",
      "GridUnload": true,
      "GridCleanUpDelayMs": 300000,
      "GridActivationDistance": 100
    },
    "Collision": {
      "VMapDirectory": "",
      "MMapDirectory": "",
      "EnableLineOfSight": true,
      "EnableHeight": true,
      "EnablePathfinding": true
    }
  },
  "Database": {
    "Auth": {
      "Provider": "MariaDb",
      "ConnectionString": "Server=127.0.0.1;Port=3306;Database=arcanecore_auth;User=arcane;Password=arcane;"
    },
    "Characters": {
      "Provider": "MariaDb",
      "ConnectionString": "Server=127.0.0.1;Port=3306;Database=arcanecore_characters;User=arcane;Password=arcane;"
    },
    "World": {
      "Provider": "MariaDb",
      "ConnectionString": "Server=127.0.0.1;Port=3306;Database=arcanecore_world;User=arcane;Password=arcane;"
    }
  }
}
