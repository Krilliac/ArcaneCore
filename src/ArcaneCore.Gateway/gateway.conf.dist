###############################################################################
# ArcaneCore gateway daemon configuration (gateway.conf.dist)
#
# GENERATED from the configuration catalog. Do not edit this file by hand. Regenerate it:
#   ARCANECORE_UPDATE_DOCS=1 dotnet test tests/ArcaneCore.World.Tests --filter Docs
# or write the same content with the daemon:  ArcaneCore.Gateway write-config --defaults gateway.conf
#
# USAGE
#   Copy this file to gateway.conf next to the daemon (the directory it starts in), name another file with --config <file>, or point the
#   environment variable ARCANECORE_CONFIG at a directory that holds world.conf and realm.conf. Keep the lines you change and delete the rest:
#   a key that is absent keeps the default shown here. Copying the whole file overrides every value of appsettings.json with the default.
#
# PRECEDENCE (lowest to highest)
#   appsettings.json < appsettings.{Environment}.json < gateway.conf < user secrets (Development only) < environment variables < command line
#
# SYNTAX
#   Key = Value        one key per line; '#' or ';' at the start of a line begins a comment; there are no trailing comments, because '#' and ';' can occur in values.
#   World.Port = 8085  a dot separates the levels of the key (World.Port is the configuration path World:Port); keys are not case-sensitive.
#   Name = "text"      text may be quoted; inside quotes only \" and \\ are escapes. Booleans are true or false; numbers use '.' as the decimal point.
#   List.0 = a         lists use numbered keys (List.0, List.1, ...). Entries you write are appended to the defaults of the list, they do not replace them.
#   Map.Name = value  dictionaries use the entry name as the last part of the key.
#   A key the daemon does not read is a start-up warning that names the closest key; a malformed line stops the daemon (exit code 78).
#   Documentation: docs/guide/configuration.md and docs/reference/configuration.md
#
###############################################################################

# SECTIONS
#
#   DATABASE
#   DIAGNOSTICS
#   GATEWAY
#   LOGGING
#   NET
#   STARTUP
#
###############################################################################

###############################################################################
# DATABASE
###############################################################################

#----------------------------------------------------------------------------
# Database
#----------------------------------------------------------------------------

#
#    Database.Auth.ConnectionString
#        Description: The connection string of this component's database. The shipped files carry
#                     the development placeholder user arcane; change it for any real deployment.
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.Auth.ConnectionString = ""

#
#    Database.Auth.Provider
#        Description: The relational engine of this component's database (Database:Auth,
#                     Database:Characters or Database:World). Values: MariaDb, MySql, PostgreSql,
#                     Sqlite.
#        Type: DatabaseProvider
#        Default: MariaDb
#        Allowed: MariaDb | MySql | PostgreSql | Sqlite
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.Auth.Provider = MariaDb

#
#    Database.Auth.SqliteBusyTimeoutMs
#        Description: SQLite only: this component's busy timeout in milliseconds (0..60000),
#                     overriding Database:SqliteBusyTimeoutMs. Unset inherits it. Other engines
#                     ignore it.
#        Type: int?
#        Default: (not set)
#        Allowed: a whole number from 0 to 60000
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
# Database.Auth.SqliteBusyTimeoutMs =

#
#    Database.Auth.SqliteSynchronous
#        Description: SQLite only: this component's PRAGMA synchronous (Full or Normal), overriding
#                     Database:SqliteSynchronous. Unset inherits it. Normal avoids the fsync stall
#                     at every commit but can lose the most recent commits on power loss or an OS
#                     crash; it is applied only when the database is in WAL mode, otherwise the
#                     database stays on Full and an error is logged. Other engines ignore it.
#                     Values: Full, Normal.
#        Type: SqliteSynchronousMode?
#        Default: (not set)
#        Allowed: Full | Normal
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
# Database.Auth.SqliteSynchronous =

#
#    Database.Auth.WriterLockDatabase
#        Description: PostgreSQL only: the existing maintenance database the single-writer advisory
#                     lock is taken in (overrides Database:WriterLockDatabase; unset inherits it,
#                     default postgres). PostgreSQL scopes advisory locks to the database a session
#                     is connected to, so every world must take the lock in the same database, and
#                     it must exist before the characters database does. The login needs CONNECT on
#                     it. Only the characters database takes the single-writer lock, so this key has
#                     an effect under Database:Characters only and the realm daemon ignores it;
#                     under Database:Auth and Database:World it does nothing. MariaDB, MySQL and
#                     SQLite ignore it.
#        Type: string
#        Default: (not set)
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
# Database.Auth.WriterLockDatabase =

#
#    Database.ConnectionString
#        Description: The connection string for any component that has no Database:<Component>
#                     sub-section of its own. The shipped Realm file uses this single-database form.
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.ConnectionString = ""

#
#    Database.Provider
#        Description: The relational engine for any component that has no Database:<Component>
#                     sub-section of its own (the single-database layout). MariaDB is the primary
#                     engine; MySql, PostgreSql and Sqlite are also supported. Values: MariaDb,
#                     MySql, PostgreSql, Sqlite.
#        Type: DatabaseProvider
#        Default: MariaDb
#        Allowed: MariaDb | MySql | PostgreSql | Sqlite
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.Provider = MariaDb

#
#    Database.SlowCommandWarnMs
#        Description: How long (milliseconds, default 2000; 0 disables) a single database command
#                     may take to execute before it is logged at WARN with the DbContext, whether it
#                     ran inside a transaction or autocommitted, whether it was a write, the first
#                     80 characters of its SQL (parameter values are never logged) and the code that
#                     issued it, on every provider. It sees what the transaction warning cannot:
#                     writes that autocommit and wait in "database is locked". Identical warnings
#                     are limited to one per 10 s (docs/areas/persistence.md).
#        Type: int
#        Default: 2000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.SlowCommandWarnMs = 2000

#
#    Database.SlowTransactionWarnMs
#        Description: How long (milliseconds, default 2000; 0 disables) a database transaction may
#                     stay open before it is logged at WARN with the DbContext and the code that
#                     closed it, on every provider. A transaction that holds the write lock this
#                     long is what makes other writers fail with "database is locked", so the next
#                     holder names itself in the log (docs/areas/persistence.md).
#        Type: int
#        Default: 2000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.SlowTransactionWarnMs = 2000

#
#    Database.Sqlite.Checkpoint.Enabled
#        Description: Whether the background checkpointer owns checkpointing (default true). False
#                     leaves SQLite's own auto-checkpoint (1000 pages, inside the committing
#                     connection) untouched.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.Sqlite.Checkpoint.Enabled = true

#
#    Database.Sqlite.Checkpoint.IntervalMs
#        Description: How often (milliseconds, 100..3600000, default 2000) the background service
#                     runs PRAGMA wal_checkpoint(PASSIVE) on each database. PASSIVE takes no writer
#                     lock and waits on no lock, but its I/O still competes for the same disk; a
#                     shorter interval keeps the WAL smaller at the cost of more wake-ups.
#        Type: int
#        Default: 2000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.Sqlite.Checkpoint.IntervalMs = 2000

#
#    Database.Sqlite.Checkpoint.JournalSizeLimitBytes
#        Description: PRAGMA journal_size_limit in bytes (0..1099511627776, default 33554432 = 32
#                     MiB), set on every connection to the database: once a checkpoint has copied
#                     the whole WAL into the database and the next writer restarts it, SQLite
#                     truncates the file down to this size instead of leaving it at its high-water
#                     mark. This is the only thing that shrinks the -wal file while the server runs,
#                     and only when the log restarts (continuous overlapping readers can postpone
#                     that; a warning is logged when the file stays above 4 x max(this limit, 1 MiB)
#                     for 30 s while commits keep arriving or the copy is incomplete): the service
#                     never runs a TRUNCATE checkpoint during operation, because TRUNCATE takes the
#                     exclusive writer lock and holds it through the copy of the frames written
#                     since the last PASSIVE, the WAL fsync and the database fsync (which on Windows
#                     flushes every page earlier PASSIVE runs wrote), which would put the stall this
#                     feature removes back in front of a game save. Only the final checkpoint at
#                     host stop, after the world has drained its saves, is a TRUNCATE; it waits at
#                     most about 250 ms for readers and writers, and holds the writer lock through
#                     its copy and syncs. If the Auth database is one file shared by the world and
#                     realm daemons, either daemon's shutdown TRUNCATE can briefly stall the other's
#                     auth writes.
#        Type: long
#        Default: 33554432
#        Allowed: a whole number from 0 to 1099511627776
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.Sqlite.Checkpoint.JournalSizeLimitBytes = 33554432

#
#    Database.Sqlite.SingleWriter.StatsIntervalMs
#        Description: How often (milliseconds, 0..3600000, default 300000; 0 never) each gate logs
#                     one INFO line with its writes, contended writes, waits, longest hold and
#                     timeouts for the interval.
#        Type: int
#        Default: 300000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.Sqlite.SingleWriter.StatsIntervalMs = 300000

#
#    Database.SqliteBusyTimeoutMs
#        Description: SQLite only: how long (0..60000 ms, default 5000) a connection waits inside
#                     SQLite for another connection's write lock before reporting "database is
#                     locked", set as PRAGMA busy_timeout on every connection (never more than the
#                     connection string's Default Timeout, and clamped to
#                     Resilience:Database:QueryTimeoutMs when the database guard is on, so a refused
#                     call never outlives its deadline in SQLite's busy handler). Without it a
#                     waiting writer retries only every 150 ms, so the many background writers on
#                     one SQLite file starve each other. 0 disables the pragma. MariaDB, MySQL and
#                     PostgreSQL ignore it (docs/areas/persistence.md).
#        Type: int
#        Default: 5000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.SqliteBusyTimeoutMs = 5000

#
#    Database.SqliteSynchronous
#        Description: SQLite only: the PRAGMA synchronous set on every connection, Full (default) or
#                     Normal. Full fsyncs the WAL at every commit, so a committed save survives
#                     power loss. Normal skips that fsync, which removes multi-second commit stalls
#                     on a slow disk (and the "database is locked" failures they cause in other
#                     writers); the database stays consistent, but the most recent commits can be
#                     lost on power loss or an OS crash, never on an application crash. Normal is
#                     applied only to a database that is in WAL mode (the schema bootstrap switches
#                     file databases to WAL, best effort): a database that is not in WAL mode (the
#                     switch failed or was refused) stays on Full and an error is logged, because
#                     Normal outside WAL can corrupt the database on power loss. Each component may
#                     override it with a Database:Auth, Database:Characters or Database:World
#                     SqliteSynchronous key. MariaDB, MySQL and PostgreSQL ignore it
#                     (docs/areas/persistence.md). Values: Full, Normal.
#        Type: SqliteSynchronousMode
#        Default: Full
#        Allowed: Full | Normal
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.SqliteSynchronous = Full

#
#    Database.SqliteWriteTimeoutMs
#        Description: SQLite only, characters database only: the longest (0..60000 ms, default 5000;
#                     rounded up to whole seconds) any command on a characters connection waits for
#                     another connection's write lock before it fails as "database is locked". It is
#                     written into the connection string's Default Timeout (30 s) when smaller, and
#                     replaces 0 (unlimited), so it bounds every command including EF's first one
#                     and its BEGIN IMMEDIATE, and through the busy-timeout clamp SQLite's own wait.
#                     Without it a writer holding the file for a minute held each save queue's
#                     single consumer for the full 30 s per attempt. Failed saves are retained and
#                     retried by their queues. 0 keeps the connection string's Default Timeout.
#                     MariaDB, MySQL and PostgreSQL ignore it (docs/areas/persistence.md).
#        Type: int
#        Default: 5000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.SqliteWriteTimeoutMs = 5000

#
#    Database.Upgrade.LockTimeoutSeconds
#        Description: How long a start waits for another process's schema work, in seconds; must be
#                     1..86400 or the start is refused as a configuration error.
#        Type: int
#        Default: 60
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.Upgrade.LockTimeoutSeconds = 60

#
#    Database.Upgrade.Policy
#        Description: What a start may do to the schema. Always (default) creates and upgrades;
#                     CreateOnly creates an empty database but refuses to upgrade an existing one
#                     (the retail-like setting for production, where arcane-db upgrade applies
#                     updates); Never only verifies. See docs/ops/database-upgrade.md. Values:
#                     Always, CreateOnly, Never.
#        Type: SchemaPolicy
#        Default: Always
#        Allowed: Always | CreateOnly | Never
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.Upgrade.Policy = Always

#
#    Database.Upgrade.ValidateOnly
#        Description: When true, serving nodes run startup schema checks in validate-only mode: zero
#                     DDL and zero seed inserts are executed, and startup fails closed if any
#                     component schema is missing, behind, or ahead of the build's current version.
#                     Default is false. See docs/ops/database-upgrade.md.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.Upgrade.ValidateOnly = false

#
#    Database.WriterLockDatabase
#        Description: PostgreSQL only: the existing maintenance database (default postgres) in which
#                     the world takes its single-writer advisory lock. PostgreSQL scopes advisory
#                     locks to the database the session is connected to, so all worlds of one
#                     characters database must lock in the same database, one that exists before the
#                     characters database is created. The login needs CONNECT on it. Only the
#                     characters database takes the single-writer lock, so the world uses this value
#                     (or the Database:Characters WriterLockDatabase key that overrides it) for the
#                     characters database alone; the realm daemon and the Auth and World components
#                     ignore it. MariaDB, MySQL and SQLite ignore it (docs/guide/operations.md).
#        Type: string
#        Default: "postgres"
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#database
#
Database.WriterLockDatabase = "postgres"

###############################################################################
# DIAGNOSTICS
###############################################################################

#----------------------------------------------------------------------------
# Diagnostics
#----------------------------------------------------------------------------

#
#    Diagnostics.BeepOnException
#        Description: Emit a short console beep when the crash hooks or the fault ledger log an
#                     exception in an interactive console session (Environment.UserInteractive and
#                     standard error not redirected), rate-limited to at most one beep per second so
#                     a fault storm cannot stall or flood the terminal. Default off.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnostics
#
Diagnostics.BeepOnException = false

#
#    Diagnostics.BeepOnStartup
#        Description: Emit a short console beep when the daemon finishes starting in an interactive
#                     console session (Environment.UserInteractive and standard output not
#                     redirected), matching the classic MaNGOS BeepAtStart cue. Never beeps under a
#                     service, test runner or redirected output. Default off.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnostics
#
Diagnostics.BeepOnStartup = false

#
#    Diagnostics.BreakOnInvariant
#        Description: Stop in the debugger on a failed invariant (Debugger.Break). Only acts when a
#                     debugger is attached, so it is safe to leave on in a development
#                     configuration; default off, because an unattended process must never wait for
#                     a debugger prompt.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnostics
#
Diagnostics.BreakOnInvariant = false

#
#    Diagnostics.CrashDialog
#        Description: Show a dialog (a Win32 message box) when the process is about to end because
#                     of an unhandled exception, an unobserved task exception under an
#                     OnUnobservedTask policy that terminates, or a world tick hang the watchdog
#                     ends. It names the exception, its message and full stack with inner
#                     exceptions, the daemon and version, thread, time, fault-ledger site and
#                     signature, and the crash report file (a crash-report.*.txt file written next
#                     to the daemon), crash journal and log file. It appears after the crash is
#                     logged and recorded, and the exit policy runs when it is closed. Only a
#                     Windows console session with no redirected standard stream, outside CI, opens
#                     one; a service, test run, redirected or non-Windows process is unaffected.
#                     Default off: an unattended process must never wait on a dialog.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnostics
#
Diagnostics.CrashDialog = false

#
#    Diagnostics.CrashDump.Directory
#        Description: The directory the dump files are written to, named
#                     &lt;daemon&gt;-&lt;pid&gt;-&lt;yyyyMMdd-HHmmss&gt;.dmp (UTC). Empty (default)
#                     means dumps beside the log file (the resolved Logging:ArcaneCore:File:Path, so
#                     logs/dumps by default, the directory .debug dump uses), or dumps in the
#                     daemon's own directory when file logging is off. Created on the first dump,
#                     readable by the daemon's account only on Linux and macOS.
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnostics
#
Diagnostics.CrashDump.Directory = ""

#
#    Diagnostics.CrashDump.FullMinFreeGB
#        Description: Free space, in GiB, the dump volume must have for a Full dump; below it Full
#                     falls back to Heap. Default 16, the launcher's threshold
#                     (tools/ops/live/LiveDiagnostics.ps1). 0 never falls back for space.
#        Type: int
#        Default: 16
#        Allowed: a whole number of GiB, 0 or more; 0 never falls back for space
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnostics
#
Diagnostics.CrashDump.FullMinFreeGB = 16

#
#    Diagnostics.CrashDump.MaxFiles
#        Description: How many of this feature's dump files are kept in the directory: after a dump
#                     is written the oldest beyond this count are deleted. Only files named by the
#                     pattern above are touched. 0 keeps every file. Default 5.
#        Type: int
#        Default: 5
#        Allowed: a whole number, 0 or more; 0 keeps every file
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnostics
#
Diagnostics.CrashDump.MaxFiles = 5

#
#    Diagnostics.CrashDump.Mode
#        Description: What to write: Off, Mini, Heap or Full. Default Full: it only acts when the
#                     process is already crashing, so it changes nothing for a healthy server. A
#                     failure of the chosen type falls back Full, Heap, Mini and is logged. Values:
#                     Off, Mini, Heap, Full.
#        Type: CrashDumpMode
#        Default: Full
#        Allowed: Off | Mini | Heap | Full
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnostics
#
Diagnostics.CrashDump.Mode = Full

#
#    Diagnostics.CrashDump.TimeoutSeconds
#        Description: How long the daemon waits for its own diagnostics server to start a dump
#                     before it gives up and ends the process anyway; it bounds an unresponsive
#                     server, not the length of a dump. The runtime suspends the waiting thread too,
#                     so a slow dump can outlast it: a file that is still growing is waited for, up
#                     to three times this value in total (a Full dump of a 7 GB process takes about
#                     a minute). A timeout, or an unreachable diagnostics endpoint
#                     (DOTNET_EnableDiagnostics=0), is not retried with a smaller type; a type the
#                     runtime refuses is. While it dumps the daemon publishes the heartbeat state
#                     dumping, which supervisors honour for a grace of this long plus a margin.
#                     Default 120.
#        Type: int
#        Default: 120
#        Allowed: a whole number of seconds, 1 or more (a lower value is raised to 1)
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnostics
#
Diagnostics.CrashDump.TimeoutSeconds = 120

#
#    Diagnostics.FaultDialog
#        Description: Also show a dialog the first time each fault signature is caught and survived
#                     (the fault ledger, .server faults), on a background thread so the faulting
#                     thread never waits, at most one open at a time (faults while one is open are
#                     only logged). Needs the same interactive Windows console session as
#                     CrashDialog; takes effect once the host has started. Default off: a fault
#                     storm of new signatures still means one box after another.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnostics
#
Diagnostics.FaultDialog = false

#
#    Diagnostics.FaultLogLimit
#        Description: How many occurrences of one fault (an exception type thrown from one place,
#                     caught at one of the server's catch-and-log sites) are logged in full. After
#                     that the site logs that fault at most once a minute, with "(N more since)";
#                     every occurrence is still counted in the fault ledger (.server faults, the
#                     arcanecore_faults_total metric). 0 logs the first occurrence and then once a
#                     minute. Default 10.
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnostics
#
Diagnostics.FaultLogLimit = 10

#
#    Diagnostics.FaultMaxSignatures
#        Description: How many distinct faults the fault ledger keeps. A fault beyond the cap is
#                     counted into one overflow entry, never dropped. Default 512; a lower value
#                     bounds memory on a server that throws a new exception signature per request.
#        Type: int
#        Default: 512
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnostics
#
Diagnostics.FaultMaxSignatures = 512

#
#    Diagnostics.FirstChanceExceptions
#        Description: Log every exception at the moment it is thrown
#                     (AppDomain.FirstChanceException), before any handler sees it, at Debug level.
#                     A development aid for finding swallowed exceptions; it is honoured only by a
#                     Debug build of the Kernel (the hook is compiled out of Release), where a
#                     Release daemon logs once that the key is ignored. Default off: the hook runs
#                     on every throw, caught or not.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnostics
#
Diagnostics.FirstChanceExceptions = false

#
#    Diagnostics.InvariantLogLimit
#        Description: How many failures of one invariant (one call site) are written to the log;
#                     later failures of that site are only counted (the counters are part of every
#                     crash report). 0 logs none, every failure is still counted. Default 10: a
#                     hot-path check that fails per packet cannot flood the log.
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnostics
#
Diagnostics.InvariantLogLimit = 10

#
#    Diagnostics.OnInvariant
#        Description: What a failed Invariant.Check (the release-mode check) does after it is logged
#                     and counted. Continue (default): the caller goes on with its own fail-closed
#                     handling (refuse the packet, drop the connection, throw). FailFast: the
#                     process aborts at once with the message, as the mangos MANGOS_ASSERT macro
#                     does in every build. Debug-build Invariant.Assert throws
#                     InvariantViolationException under Continue and aborts under FailFast. Values:
#                     Continue, FailFast.
#        Type: InvariantPolicy
#        Default: Continue
#        Allowed: Continue | FailFast
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnostics
#
Diagnostics.OnInvariant = Continue

#
#    Diagnostics.OnUnhandled
#        Description: What ends the process after an unhandled exception
#                     (AppDomain.UnhandledException): the report is always written first. FailFast
#                     (default): Environment.FailFast, which is what the runtime does on its own;
#                     the process aborts (exit status 134, SIGABRT, on Linux; 0x80131623 / Watson on
#                     Windows). Exit: Environment.Exit(70) (ExitCodes.UnhandledException, sysexits
#                     EX_SOFTWARE), an exit code a supervisor can match. Under both, the daemon
#                     writes a dump of itself first (Diagnostics:CrashDump); the runtime's own
#                     DOTNET_DbgEnableMiniDump=1 dump covers a FailFast too, and then this one is
#                     skipped. Values: FailFast, Exit.
#        Type: UnhandledExceptionPolicy
#        Default: FailFast
#        Allowed: FailFast | Exit
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnostics
#
Diagnostics.OnUnhandled = FailFast

#
#    Diagnostics.OnUnobservedTask
#        Description: What an exception a faulted Task nobody awaited does when the finalizer finds
#                     it (TaskScheduler.UnobservedTaskException). Log (default): the report is
#                     written and the exception marked observed, which is the .NET runtime's own
#                     behaviour (since .NET 4.5) made visible. Exit and FailFast end the process as
#                     OnUnhandled describes. Values: Log, Exit, FailFast.
#        Type: UnobservedTaskPolicy
#        Default: Log
#        Allowed: Log | Exit | FailFast
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#diagnostics
#
Diagnostics.OnUnobservedTask = Log

###############################################################################
# GATEWAY
###############################################################################

#----------------------------------------------------------------------------
# Gateway
#----------------------------------------------------------------------------

#
#    Gateway.BindAddress
#        Description: Address the client listener binds.
#        Type: string
#        Default: "0.0.0.0"
#        Allowed: an IPv4 or IPv6 address such as 0.0.0.0, 127.0.0.1 or ::1 (host names are not
#                 resolved)
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#gateway
#
Gateway.BindAddress = "0.0.0.0"

#
#    Gateway.CharactersSchemaVersion
#        Description: The characters schema version this gateway advertises; defaults to the version
#                     this build targets. Explicit override only.
#        Type: int
#        Default: 74
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#gateway
#
Gateway.CharactersSchemaVersion = 74

#
#    Gateway.ContentRevision
#        Description: The content revision this gateway advertises; must equal the worker's.
#                     Defaults to the revision derived from the world schema version this build
#                     targets (GatewayManifestVersions.ContentRevisionFor), which is what a default
#                     worker (Cluster:Worker:VersionsFromDatabase on) advertises once its database
#                     is at that version. Set it only to pin an explicit override (then set the
#                     worker's labels and Cluster:Worker:VersionsFromDatabase=false to match).
#        Type: string
#        Default: "world-schema-67"
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#gateway
#
Gateway.ContentRevision = "world-schema-67"

#
#    Gateway.LinkRetryDelay
#        Description: First wait before reconnecting a lost or refused worker link; doubles up to 30
#                     s.
#        Type: TimeSpan
#        Default: 00:00:01
#        Allowed: a time span, [d.]hh:mm:ss
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#gateway
#
Gateway.LinkRetryDelay = 00:00:01

#
#    Gateway.LinkSecret
#        Description: The shared link secret (Cluster:Worker:LinkSecret on the worker): at least 16
#                     characters, or the gateway refuses to start.
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#gateway
#
Gateway.LinkSecret = ""

#
#    Gateway.LoginWorker
#        Description: Node id of the worker new sessions open on (it must name a Workers entry, or
#                     LegacyWorkerNodeId in single-worker mode). While it is down, sessions open on
#                     the ready link with the fewest sessions. Empty, the default, designates none:
#                     sessions always spread over the ready links.
#        Type: string
#        Default: ""
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#gateway
#
Gateway.LoginWorker = ""

#
#    Gateway.MaxConnections
#        Description: Most simultaneous client connections; 0 means no cap of the gateway's own
#                     (Net:Protection still applies).
#        Type: int
#        Default: 0
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#gateway
#
Gateway.MaxConnections = 0

#
#    Gateway.MaxConnectionsPerIp
#        Description: Most simultaneous client connections from one address; 0 means no cap of the
#                     gateway's own.
#        Type: int
#        Default: 0
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#gateway
#
Gateway.MaxConnectionsPerIp = 0

#
#    Gateway.MaxOutboundBytes
#        Description: A client whose unsent data exceeds this many bytes (it stopped reading) is
#                     disconnected (World:MaxOutboundBytes).
#        Type: long
#        Default: 8388608
#        Allowed: a whole number, -9223372036854775808 to 9223372036854775807
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#gateway
#
Gateway.MaxOutboundBytes = 8388608

#
#    Gateway.NodeId
#        Description: This gateway's node id in the link manifest.
#        Type: string
#        Default: "gateway"
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#gateway
#
Gateway.NodeId = "gateway"

#
#    Gateway.Port
#        Description: Port clients connect to; the realm list must name it (realmlist address)
#                     instead of the world's World:Port.
#        Type: int
#        Default: 8086
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#gateway
#
Gateway.Port = 8086

#
#    Gateway.PreAuthTimeout
#        Description: A connection that has not sent a valid CMSG_AUTH_SESSION within this time is
#                     closed (the world's World:PreAuthTimeout rule).
#        Type: TimeSpan
#        Default: 00:00:10
#        Allowed: a time span, [d.]hh:mm:ss
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#gateway
#
Gateway.PreAuthTimeout = 00:00:10

#
#    Gateway.RealmId
#        Description: Must equal the worker's Cluster:Worker:RealmId.
#        Type: int
#        Default: 1
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#gateway
#
Gateway.RealmId = 1

#
#    Gateway.WorkerAddress
#        Description: Address of the world worker's gateway listener (Cluster:Worker:BindAddress).
#                     Used only while Workers is empty.
#        Type: string
#        Default: "127.0.0.1"
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#gateway
#
Gateway.WorkerAddress = "127.0.0.1"

#
#    Gateway.WorkerPort
#        Description: Port of the world worker's gateway listener (Cluster:Worker:Port). Used only
#                     while Workers is empty.
#        Type: int
#        Default: 8095
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#gateway
#
Gateway.WorkerPort = 8095

#
#    Gateway.Workers
#        Description: The world workers this gateway links to, one link each (node id, address,
#                     port, optional maps). When empty, the single-worker keys WorkerAddress and
#                     WorkerPort describe one entry named LegacyWorkerNodeId; when set, those two
#                     keys are ignored. Every worker must accept the same LinkSecret, RealmId and
#                     manifest values.
#        Type: List<GatewayWorkerEntry>
#        Default: (empty list)
#        Allowed: a list: numbered keys 0, 1, 2, ...; each entry is a group of keys
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#gateway
#
# Empty by default. Each entry is a group of keys: Gateway.Workers.0.<Field> = value, Gateway.Workers.1.<Field> = value, ...

#
#    Gateway.WorldSchemaVersion
#        Description: The world schema version this gateway advertises; defaults to the version this
#                     build targets. Explicit override only.
#        Type: int
#        Default: 67
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#gateway
#
Gateway.WorldSchemaVersion = 67

###############################################################################
# LOGGING
###############################################################################

#----------------------------------------------------------------------------
# Logging:ArcaneCore
#----------------------------------------------------------------------------

#
#    Logging.ArcaneCore.Console.Mode
#        Description: Color (default), Plain or Off. Live at reload; colour is still disabled when
#                     stdout is not a terminal or NO_COLOR is set. Values: Color, Plain, Off.
#        Type: ConsoleMode
#        Default: Color
#        Allowed: Color | Plain | Off
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
Logging.ArcaneCore.Console.Mode = Color

#
#    Logging.ArcaneCore.Console.QueueCapacity
#        Description: Lines the console writer thread may hold before new lines are dropped (and the
#                     drop counted and reported). Restart-only.
#        Type: int
#        Default: 4096
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
Logging.ArcaneCore.Console.QueueCapacity = 4096

#
#    Logging.ArcaneCore.File.Enabled
#        Description: true writes the one log file, in the chosen Format, to Path. Default off.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
Logging.ArcaneCore.File.Enabled = false

#
#    Logging.ArcaneCore.File.Path
#        Description: The active log file; relative paths resolve against the working directory.
#                     Rolled segments sit next to it as name-yyyyMMdd-NNN.ext. Not set means
#                     logs/arcanecore.jsonl for a Json file and logs/arcanecore.log for a Text file.
#        Type: string
#        Default: (not set)
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
# Logging.ArcaneCore.File.Path =

#
#    Logging.ArcaneCore.File.QueueCapacity
#        Description: Lines the file writer thread may hold before new lines are dropped (counted
#                     and reported in the file itself). The world thread never waits on the disk.
#        Type: int
#        Default: 8192
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
Logging.ArcaneCore.File.QueueCapacity = 8192

#
#    Logging.ArcaneCore.File.Retain
#        Description: Rolled segments kept next to the active file; the oldest beyond this count are
#                     deleted after each roll. 0 keeps all.
#        Type: int
#        Default: 14
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
Logging.ArcaneCore.File.Retain = 14

#
#    Logging.ArcaneCore.File.RollDaily
#        Description: true rolls at the first line of a new day (in the Timestamps clock).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
Logging.ArcaneCore.File.RollDaily = true

#
#    Logging.ArcaneCore.File.RollSizeMb
#        Description: Roll when the active file would exceed this many MiB; 0 never rolls by size.
#        Type: int
#        Default: 64
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
Logging.ArcaneCore.File.RollSizeMb = 64

#
#    Logging.ArcaneCore.Format
#        Description: The content format of the one log file: Json (one JSON object per line,
#                     structured properties kept) or Text (the plain console line format). Not set
#                     means the legacy File/Json switches decide; with nothing configured the
#                     default is Json: JSON keeps the structured state properties for ingestion, and
#                     the console already gives a text view. The file is configured under File.
#                     Restart-only. Values: Text, Json.
#        Type: LogFileFormat?
#        Default: (not set)
#        Allowed: Text | Json
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
# Logging.ArcaneCore.Format =

#
#    Logging.ArcaneCore.IncludeScopes
#        Description: true appends the active logger scopes to each line (=&gt; scope). Live at
#                     reload.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
Logging.ArcaneCore.IncludeScopes = true

#
#    Logging.ArcaneCore.Json.Enabled
#        Description: Deprecated: use File:Enabled with Format=Json. true writes one JSON object per
#                     log event to Path. Default off.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
Logging.ArcaneCore.Json.Enabled = false

#
#    Logging.ArcaneCore.Json.Path
#        Description: Deprecated: use File:Path. The active JSON-lines file; relative paths resolve
#                     against the working directory. Not set means logs/arcanecore.jsonl.
#        Type: string
#        Default: (not set)
#        Allowed: text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
# Logging.ArcaneCore.Json.Path =

#
#    Logging.ArcaneCore.Json.QueueCapacity
#        Description: Deprecated: use File:QueueCapacity. Lines the JSON writer thread may hold
#                     before new lines are dropped (counted and reported as a JSON line).
#        Type: int
#        Default: 8192
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
Logging.ArcaneCore.Json.QueueCapacity = 8192

#
#    Logging.ArcaneCore.Json.Retain
#        Description: Deprecated: use File:Retain. Rolled segments kept; the oldest beyond this
#                     count are deleted after each roll. 0 keeps all.
#        Type: int
#        Default: 14
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
Logging.ArcaneCore.Json.Retain = 14

#
#    Logging.ArcaneCore.Json.RollDaily
#        Description: Deprecated: use File:RollDaily. true rolls at the first line of a new day (in
#                     the Timestamps clock).
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
Logging.ArcaneCore.Json.RollDaily = true

#
#    Logging.ArcaneCore.Json.RollSizeMb
#        Description: Deprecated: use File:RollSizeMb. Roll when the active file would exceed this
#                     many MiB; 0 never rolls by size.
#        Type: int
#        Default: 64
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
Logging.ArcaneCore.Json.RollSizeMb = 64

#
#    Logging.ArcaneCore.Timestamps
#        Description: The clock timestamps are taken from: Utc (default) or Local. Live at reload.
#                     Values: Utc, Local.
#        Type: TimestampKind
#        Default: Utc
#        Allowed: Utc | Local
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#loggingarcanecore
#
Logging.ArcaneCore.Timestamps = Utc

###############################################################################
# NET
###############################################################################

#----------------------------------------------------------------------------
# Net:Protection
#----------------------------------------------------------------------------

#
#    Net.Protection.AddressIdleEviction
#        Description: How long after its last connection or attempt an address's slot counts as idle
#                     and may be reused for another address. Must be longer than the time a full
#                     burst takes to refill, or a limited address could be forgotten and start over.
#        Type: TimeSpan
#        Default: 00:10:00
#        Allowed: a time span, [d.]hh:mm:ss
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#netprotection
#
Net.Protection.AddressIdleEviction = 00:10:00

#
#    Net.Protection.AuthFailureBurstPerIp
#        Description: How many failed authentication attempts (unknown account, wrong proof or
#                     digest, banned account) one IP address may make before further attempts are
#                     refused; 0 disables. An attempt is checked before any database lookup and
#                     refused with the connection closed, so a guessing client costs no query.
#                     Successful logins never consume the budget, so players behind one address are
#                     not affected. vmangos realmd has WrongPass.MaxCount (default 10 per 60 s,
#                     LoginThrottle); the same shape, keyed by address.
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#netprotection
#
Net.Protection.AuthFailureBurstPerIp = 10

#
#    Net.Protection.AuthFailuresPerMinutePerIp
#        Description: How many failed attempts per minute an address gets back once its burst is
#                     used up (the refill rate of the failure budget). Only read when
#                     AuthFailureBurstPerIp is set.
#        Type: int
#        Default: 10
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#netprotection
#
Net.Protection.AuthFailuresPerMinutePerIp = 10

#
#    Net.Protection.ConnectionBurstPerIp
#        Description: How many connections one IP address may open at once before the per-minute
#                     rate below applies (the token bucket's capacity); 0 disables the
#                     connection-rate limit. A refused connection is closed before any session, DI
#                     scope or database context exists.
#        Type: int
#        Default: 100
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#netprotection
#
Net.Protection.ConnectionBurstPerIp = 100

#
#    Net.Protection.ConnectionsPerMinutePerIp
#        Description: Sustained new connections per minute one IP address may open once its burst is
#                     used up (the token bucket's refill rate). Only read when ConnectionBurstPerIp
#                     is set.
#        Type: int
#        Default: 300
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#netprotection
#
Net.Protection.ConnectionsPerMinutePerIp = 300

#
#    Net.Protection.ExemptAddresses
#        Description: Client addresses exempt from MaxConnectionsPerIp: single addresses
#                     ("127.0.0.1", "::1") or CIDR networks ("10.0.0.0/8"). Empty by default. Only
#                     this shared cap is lifted: the daemon's own Auth:/World:MaxConnectionsPerIp
#                     (when set), the global cap, the connection rate (ConnectionBurstPerIp) and the
#                     authentication failure budget still apply. An entry that does not parse
#                     exempts nothing (check-config reports it). Meant for the owner's own tooling
#                     and local crowd tests; do not list a reverse proxy that forwards public
#                     clients.
#        Type: string[]
#        Default: (empty list)
#        Allowed: a list: numbered keys 0, 1, 2, ...; each value is text
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#netprotection
#
# Empty by default.
# Net.Protection.ExemptAddresses.0 =

#
#    Net.Protection.ExemptLoopbackOnLoopbackBind
#        Description: When the listener is bound to a loopback address (Auth:/World:BindAddress
#                     127.0.0.1 or ::1), loopback clients are exempt as if listed in ExemptAddresses
#                     (default on): only processes on the same machine can reach such a listener, so
#                     the per-address cap would only limit the owner's own clients and crowd tests.
#                     A listener bound to any other address (0.0.0.0, a LAN or public address) keeps
#                     capping loopback clients like every other address.
#        Type: bool
#        Default: true
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#netprotection
#
Net.Protection.ExemptLoopbackOnLoopbackBind = true

#
#    Net.Protection.FrameReadTimeout
#        Description: Longest a client may take to deliver the rest of a frame once its first byte
#                     has arrived (the remaining header bytes and the payload); the connection is
#                     closed when it expires (slowloris). 00:00:00 disables. A retail client writes
#                     each frame in one send. On the logon daemon Auth:ReadTimeoutSeconds, when set,
#                     takes precedence over this value.
#        Type: TimeSpan
#        Default: 00:00:30
#        Allowed: a time span, [d.]hh:mm:ss
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#netprotection
#
Net.Protection.FrameReadTimeout = 00:00:30

#
#    Net.Protection.LogInterval
#        Description: Shortest interval between two log lines about the same kind of refusal
#                     (refused connection, refused attempt, full table, frame timeout). Refusals in
#                     between are counted and the count is printed with the next line, so a flood
#                     costs one line per interval, never one per packet. 00:00:00 logs every
#                     refusal.
#        Type: TimeSpan
#        Default: 00:00:10
#        Allowed: a time span, [d.]hh:mm:ss
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#netprotection
#
Net.Protection.LogInterval = 00:00:10

#
#    Net.Protection.LogonUnauthenticatedLifetime
#        Description: Longest a logon connection may exist without a successful proof, counted from
#                     accept; the connection is closed when it expires. 00:00:00 disables.
#                     Auth:MaxSessionDurationSeconds (300, vmangos MaxSessionDuration) still bounds
#                     the whole connection; this closes an idle or guessing one much sooner. The
#                     world daemon's equivalent is World:PreAuthTimeout (retail).
#        Type: TimeSpan
#        Default: 00:00:30
#        Allowed: a time span, [d.]hh:mm:ss
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#netprotection
#
Net.Protection.LogonUnauthenticatedLifetime = 00:00:30

#
#    Net.Protection.MaxConnectionsPerIp
#        Description: Simultaneous connections one client IP address may hold on a listener; 0
#                     disables. Applied together with the daemon's own cap
#                     (Auth:MaxConnectionsPerIp, World:MaxConnectionsPerIp): when both are set the
#                     lower one wins. A retail client holds one connection per daemon. Deviation
#                     from retail (vmangos has no per-address cap), on by default.
#        Type: int
#        Default: 16
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#netprotection
#
Net.Protection.MaxConnectionsPerIp = 16

#
#    Net.Protection.MaxTrackedAddresses
#        Description: Most client addresses the per-address table tracks (rounded up to a power of
#                     two). Memory is fixed at start (about 48 bytes per slot) and nothing is
#                     allocated per connection. When the table is full and no idle slot exists the
#                     newcomer is still admitted: the table forgets the least recently seen address
#                     of the probe window (preferring one that is not being limited) and writes one
#                     rate-limited log line. A full table measures less; it never refuses a
#                     connection (the connection caps are the fail-closed limit).
#        Type: int
#        Default: 4096
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#netprotection
#
Net.Protection.MaxTrackedAddresses = 4096

#
#    Net.Protection.WorldFloodPacketsPerSecond
#        Description: World daemon only: packets in one one-second window that close the connection
#                     as a flood (one rate-limited log line); 0 disables. Above
#                     WorldPacketsPerSecond, so a burst is dropped long before it disconnects.
#        Type: int
#        Default: 8000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#netprotection
#
Net.Protection.WorldFloodPacketsPerSecond = 8000

#
#    Net.Protection.WorldOpcodeBurst
#        Description: World daemon only: the capacity of each per-opcode token bucket of an
#                     authenticated connection (Net.OpcodeRateLimiter, the MaNGOS Zero anticheat
#                     fork's gateway RateLimiter); a packet that finds its opcode's bucket empty is
#                     dropped (not handled) and counted, the connection stays. 0 disables the
#                     per-opcode buckets. Far above a retail client: an empty client cache in a
#                     crowded city sends a few hundred queries of one opcode at once, and the world
#                     queue's own tests treat a 3000-packet burst as heavy but legitimate. Deviation
#                     from retail (vmangos handles every packet), on by default. Read when the
#                     session starts.
#        Type: int
#        Default: 4000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#netprotection
#
Net.Protection.WorldOpcodeBurst = 4000

#
#    Net.Protection.WorldOpcodeRefillPerSecond
#        Description: World daemon only: tokens a per-opcode bucket regains per second (see
#                     WorldOpcodeBurst).
#        Type: double
#        Default: 1000
#        Allowed: a number, '.' is the decimal point
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#netprotection
#
Net.Protection.WorldOpcodeRefillPerSecond = 1000

#
#    Net.Protection.WorldPacketsPerSecond
#        Description: World daemon only: packets of any opcode one connection may send in a
#                     one-second window before the rest of that window is dropped (counted, the
#                     connection stays); 0 disables. A retail client sends a few tens per second.
#        Type: int
#        Default: 4000
#        Allowed: a whole number, -2147483648 to 2147483647
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#netprotection
#
Net.Protection.WorldPacketsPerSecond = 4000

###############################################################################
# STARTUP
###############################################################################

#----------------------------------------------------------------------------
# Startup
#----------------------------------------------------------------------------

#
#    Startup.Strict
#        Description: true makes a configuration warning fail start-up like an error (exit code 78);
#                     read by ConfigReport.Run in the world, realm and gateway daemons.
#        Type: bool
#        Default: false
#        Allowed: true | false
#        Reload: Start-up (read once when the daemon starts)
#        Docs: docs/reference/configuration.md#keys-read-by-name
#
Startup.Strict = false

