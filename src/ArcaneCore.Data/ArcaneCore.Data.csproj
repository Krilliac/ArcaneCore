<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ArcaneCore.Data</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" />
    <!-- Pomelo 9.0.0 brings MySqlConnector 2.4.0, affected by GHSA-473q-m89c-ghf8 (account password sent before the TLS
         certificate is verified in zero-configuration TLS mode). Pin the patched 2.6.1. -->
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- EF Core Sqlite 9.0.0 brings SQLitePCLRaw 2.1.10, affected by CVE-2025-6965
         (GHSA-2m69-gcr7-jv3q, fixed after 2.1.11). Pin the patched native bundle. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <!-- EF Core Sqlite 9.0.0 brings Microsoft.Data.Sqlite.Core 9.0.0, whose pool can lend one native handle to two live
         connections (dotnet/efcore#39008: "database is locked" on Open, shared transactions). Fixed in 10.0.13. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <!-- Microsoft.Extensions.{DependencyInjection.Abstractions,Logging.Abstractions,Options} are included in .NET 11 shared framework (NU1510); .NET 10 gets them from NuGet dependencies. -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ArcaneCore.Data.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArcaneCore.Kernel\ArcaneCore.Kernel.csproj" />
  </ItemGroup>

</Project>
