<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>ArcaneCore.Game.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ArcaneCore.Game\ArcaneCore.Game.csproj" />
    <ProjectReference Include="..\..\src\ArcaneCore.Data\ArcaneCore.Data.csproj" />
    <ProjectReference Include="..\ThirdParty\DotRecast\DotRecast.Detour\DotRecast.Detour.csproj" />
    <ProjectReference Include="..\ArcaneCore.TestSupport\ArcaneCore.TestSupport.csproj" />
  </ItemGroup>

  <!-- FakeSession is the shared recording session (ArcaneCore.TestSupport), named as the test files here already call it. -->
  <ItemGroup>
    <Using Include="ArcaneCore.TestSupport.RecordingPlayerSession" Alias="FakeSession" />
  </ItemGroup>

  <ItemGroup>
    <None Update="CreatureAi\validated-escort-waypoints.csv" CopyToOutputDirectory="PreserveNewest" TargetPath="validated-escort-waypoints.csv" />
  </ItemGroup>

</Project>
