<Project Sdk="Microsoft.NET.Sdk">

  <!-- Version 2 of HotScripts: the same source with the V2 symbol (the spell script serves one more spell id). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <AssemblyName>HotScripts</AssemblyName>
    <RootNamespace>HotScripts</RootNamespace>
    <IsPackable>false</IsPackable>
    <DefineConstants>$(DefineConstants);V2</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\HotScriptsV1\*.cs" Link="%(Filename)%(Extension)" />
    <ProjectReference Include="..\..\..\src\ArcaneCore.World\ArcaneCore.World.csproj" />
  </ItemGroup>

</Project>
