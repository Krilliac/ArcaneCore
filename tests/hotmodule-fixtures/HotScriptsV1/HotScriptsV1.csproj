<Project Sdk="Microsoft.NET.Sdk">

  <!-- A module that contributes a spell script, an instance script and EventAI event/action handlers, for the module-host tests.
       Assembly name HotScripts. Built only through the test project's reference (not in ArcaneCore.slnx). HotScriptsV2 compiles the
       same source with V2. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <AssemblyName>HotScripts</AssemblyName>
    <RootNamespace>HotScripts</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\ArcaneCore.World\ArcaneCore.World.csproj" />
  </ItemGroup>

</Project>
