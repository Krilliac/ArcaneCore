<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ArcaneCore.World.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ArcaneCore.World\ArcaneCore.World.csproj" />
    <ProjectReference Include="..\..\src\ArcaneCore.Protocol\ArcaneCore.Protocol.csproj" />
    <ProjectReference Include="..\..\src\ArcaneCore.Kernel\ArcaneCore.Kernel.csproj" />
    <ProjectReference Include="..\..\src\ArcaneCore.Cryptography\ArcaneCore.Cryptography.csproj" />
    <ProjectReference Include="..\ThirdParty\WowWorldMessages\WowWorldMessages.Vanilla.csproj" />
  </ItemGroup>

  <!-- Codex-line databases (schema of commit 0e07c29b) for the renumbering migration's bot-load test, shared with ArcaneCore.Data.Tests. -->
  <ItemGroup>
    <Compile Include="..\ArcaneCore.Data.Tests\Upgrade\CodexLine\CodexLineDatabase.cs" Link="Playerbots\CodexLine\CodexLineDatabase.cs" />
    <EmbeddedResource Include="..\ArcaneCore.Data.Tests\Upgrade\CodexLine\*.sql" LogicalName="CodexLine/%(Filename)%(Extension)" Link="Playerbots\CodexLine\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Modules for the module-host tests: built first, then copied to hotfixtures/v1 and hotfixtures/v2 in the output. -->
  <ItemGroup>
    <ProjectReference Include="..\hotmodule-fixtures\HotFixtureV1\HotFixtureV1.csproj" ReferenceOutputAssembly="false" OutputItemType="HotFixtureV1Output" />
    <ProjectReference Include="..\hotmodule-fixtures\HotFixtureV2\HotFixtureV2.csproj" ReferenceOutputAssembly="false" OutputItemType="HotFixtureV2Output" />
  </ItemGroup>

  <Target Name="CopyHotFixtures" AfterTargets="Build">
    <Copy SourceFiles="@(HotFixtureV1Output)" DestinationFolder="$(OutDir)hotfixtures\v1" />
    <Copy SourceFiles="@(HotFixtureV2Output)" DestinationFolder="$(OutDir)hotfixtures\v2" />
  </Target>

</Project>
