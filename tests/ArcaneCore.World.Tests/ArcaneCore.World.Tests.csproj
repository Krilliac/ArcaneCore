<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ArcaneCore.World.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ArcaneCore.World\ArcaneCore.World.csproj" />
    <ProjectReference Include="..\..\src\ArcaneCore.Protocol\ArcaneCore.Protocol.csproj" />
    <ProjectReference Include="..\..\src\ArcaneCore.Kernel\ArcaneCore.Kernel.csproj" />
    <ProjectReference Include="..\..\src\ArcaneCore.Cryptography\ArcaneCore.Cryptography.csproj" />
    <ProjectReference Include="..\ThirdParty\WowWorldMessages\WowWorldMessages.Vanilla.csproj" />
    <ProjectReference Include="..\..\tools\ArcaneCore.Sniff\ArcaneCore.Sniff.csproj" />
  </ItemGroup>

  <!-- Codex-line databases (schema of commit 0e07c29b) for the renumbering migration's bot-load test, shared with ArcaneCore.Data.Tests. -->
  <ItemGroup>
    <Compile Include="..\ArcaneCore.Data.Tests\Upgrade\CodexLine\CodexLineDatabase.cs" Link="Playerbots\CodexLine\CodexLineDatabase.cs" />
    <EmbeddedResource Include="..\ArcaneCore.Data.Tests\Upgrade\CodexLine\*.sql" LogicalName="CodexLine/%(Filename)%(Extension)" Link="Playerbots\CodexLine\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Repository-authored navigation meshes (.mmap/.mmtile writer) for the playerbot region-leg tests, shared with ArcaneCore.Game.Tests. -->
  <ItemGroup>
    <Compile Include="..\ArcaneCore.Game.Tests\Collision\NavMeshFixture.cs" Link="Playerbots\NavMeshFixture.cs" />
  </ItemGroup>

  <!-- The original loot generator: the oracle of the loot plan equivalence tests on the real world.db, shared with ArcaneCore.Game.Tests. -->
  <ItemGroup>
    <Compile Include="..\ArcaneCore.Game.Tests\Memo\ReferenceLootGenerator.cs" Link="Memo\ReferenceLootGenerator.cs" />
  </ItemGroup>

  <!-- Steady-state allocation assertions that retry a window a cross-thread collection ran in, shared with ArcaneCore.Game.Tests. -->
  <ItemGroup>
    <Compile Include="..\ArcaneCore.Game.Tests\AllocationProbe.cs" Link="AllocationProbe.cs" />
  </ItemGroup>

  <!-- Modules for the module-host tests: built first, then copied to hotfixtures/v1 and hotfixtures/v2 in the output. -->
  <ItemGroup>
    <ProjectReference Include="..\hotmodule-fixtures\HotFixtureV1\HotFixtureV1.csproj" ReferenceOutputAssembly="false" OutputItemType="HotFixtureV1Output" />
    <ProjectReference Include="..\hotmodule-fixtures\HotFixtureV2\HotFixtureV2.csproj" ReferenceOutputAssembly="false" OutputItemType="HotFixtureV2Output" />
    <ProjectReference Include="..\hotmodule-fixtures\HotGameV1\HotGameV1.csproj" ReferenceOutputAssembly="false" OutputItemType="HotGameV1Output" />
    <ProjectReference Include="..\hotmodule-fixtures\HotGameV2\HotGameV2.csproj" ReferenceOutputAssembly="false" OutputItemType="HotGameV2Output" />
    <ProjectReference Include="..\hotmodule-fixtures\HotCreaturesV1\HotCreaturesV1.csproj" ReferenceOutputAssembly="false" OutputItemType="HotCreaturesOutput" />
    <ProjectReference Include="..\hotmodule-fixtures\SampleGm\SampleGm.csproj" ReferenceOutputAssembly="false" OutputItemType="SampleGmOutput" />
    <ProjectReference Include="..\hotmodule-fixtures\HotScriptsV1\HotScriptsV1.csproj" ReferenceOutputAssembly="false" OutputItemType="HotScriptsV1Output" />
    <ProjectReference Include="..\hotmodule-fixtures\HotScriptsV2\HotScriptsV2.csproj" ReferenceOutputAssembly="false" OutputItemType="HotScriptsV2Output" />
  </ItemGroup>

  <Target Name="CopyHotFixtures" AfterTargets="Build">
    <Copy SourceFiles="@(HotFixtureV1Output)" DestinationFolder="$(OutDir)hotfixtures\v1" />
    <Copy SourceFiles="@(HotFixtureV2Output)" DestinationFolder="$(OutDir)hotfixtures\v2" />
    <Copy SourceFiles="@(HotGameV1Output)" DestinationFolder="$(OutDir)hotfixtures\game1" />
    <Copy SourceFiles="@(HotGameV2Output)" DestinationFolder="$(OutDir)hotfixtures\game2" />
    <Copy SourceFiles="@(HotCreaturesOutput)" DestinationFolder="$(OutDir)hotfixtures\creatures" />
    <Copy SourceFiles="@(SampleGmOutput)" DestinationFolder="$(OutDir)hotfixtures\sample" />
    <Copy SourceFiles="@(HotScriptsV1Output)" DestinationFolder="$(OutDir)hotfixtures\scripts1" />
    <Copy SourceFiles="@(HotScriptsV2Output)" DestinationFolder="$(OutDir)hotfixtures\scripts2" />
  </Target>

</Project>
