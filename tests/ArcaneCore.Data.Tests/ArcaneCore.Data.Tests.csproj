<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ArcaneCore.Data.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Dozens of EF bootstraps run at once here. Workstation GC stopped them all for about 30 % of the wall time of the upgrade-step theory; server GC took 8m30s to 5m41s on the same rows (Node1, 2026-11-05). -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- Configuration and DI composition for the start-up policy tests (the same version the hosts use). -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Baselines/*.sql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ArcaneCore.Data\ArcaneCore.Data.csproj" />
    <ProjectReference Include="..\..\tools\ArcaneCore.AccountTool\ArcaneCore.AccountTool.csproj" />
    <ProjectReference Include="..\ArcaneCore.Data.ProcessRunner\ArcaneCore.Data.ProcessRunner.csproj" />
    <ProjectReference Include="..\ArcaneCore.TestSupport\ArcaneCore.TestSupport.csproj" />
  </ItemGroup>

</Project>
