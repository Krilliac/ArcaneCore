<Project>

  <!-- Repo-wide build settings (nullable enabled, warnings-as-errors; docs/guide/contributing.md). -->
  <PropertyGroup>
    <!-- Keep the TargetFramework local to each project evaluation, never pass it as a
         global solution property. A global -p:TargetFramework can trigger duplicate
         project-reference builds and output-file collisions (dotnet/msbuild#8142).
         ArcaneTargetFramework flows to project references without changing .csproj files.
         EF Core/Extensions packages remain on 9.x because the Pomelo MySQL/MariaDB provider uses EF 9. -->
    <TargetFramework Condition="'$(ArcaneTargetFramework)' != ''">$(ArcaneTargetFramework)</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Exhaustiveness: a switch expression must handle every value of its input type (CS8509: whatever the input type is, not only enums) and, for enums, undefined values (CS8524). C# cannot prove a class hierarchy exhaustive, so a switch over one needs a discard arm.
         Both are warnings by default; naming them keeps them errors even if a project ever relaxes TreatWarningsAsErrors. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8509;CS8524</WarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <!-- XML documentation is generated so the compiler resolves every <see cref> and <paramref> in the doc comments: with it off, a cref to
         a renamed or moved member rots silently. A cref that resolves to nothing (CS1574), badly formed XML (CS1570), a <param> or
         <paramref> naming a parameter that is gone (CS1572, CS1734) and the like are then build errors under TreatWarningsAsErrors.
         The .xml files stay in obj (CopyDocumentationFileToOutputDirectory=false), so neither bin, publish output nor a deploy copied
         from either carries them, and nothing reads them. (PublishDocumentationFile=false alone kept out only each project's own file:
         the referenced projects' files, beside their dlls in bin, were copied into every referencing bin and publish folder.)
         PublishDocumentationFiles=false keeps publish from looking for them at all: publish adds each project's doc file at its bin
         path (FinalDocFile), which is never written here; the Dockerfile's SDK image (10.0.403, Linux) fails that copy with MSB3030,
         while a Windows 10.0.401 publish skipped it. Three codes
         stay off because they are noise, not rot: CS1591 (public member without a comment), CS1573 (some parameters documented, others
         not) and CS0419 (a cref to an overloaded method written without a signature; the compiler picks one overload). The vendored
         tests/ThirdParty projects turn generation off in their own csproj, as they do for warnings-as-errors and code style.
         tests/ArcaneCore.World.Tests/Docs/DocCommentGateTests.cs fails when anything turns the gate off or silences a doc code. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS0419</NoWarn>
    <!-- Supply chain: every project restores against a committed, target-framework-specific packages.net10.lock.json or
         packages.net11.lock.json (exact versions and content hashes of the full transitive graph). CI (ci.yml, dotnet.yml),
         the Dockerfile, node CI (tools/ops/ci/node-ci.ps1), the local full gate (tools/ops/ci/full-suite-gate.ps1),
         and the deploy build (tools/ops/deploy/build-integrated.sh) restore in locked mode. Package updates:
         docs/guide/contributing.md. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- The NuGetLockFilePath selection lives in Directory.Build.targets, evaluated after
         the target is resolved from ArcaneTargetFramework (or the net10.0 default). -->
  </PropertyGroup>

  <!-- Test processes only: let a database be created through a reserved schema placeholder (src/ArcaneCore.Data/Schema/ReservedSchemaGaps.cs).
       Servers and tools never get this switch, so a build that still holds a placeholder refuses to create or upgrade a real database. -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <RuntimeHostConfigurationOption Include="ArcaneCore.Data.AllowReservedSchemaGaps" Value="true" />
  </ItemGroup>

  <!-- The safety analyzer (src/ArcaneCore.Analyzers, docs/ops/memory-safety.md) runs in every shipping project: world-thread ownership, unsafe APIs,
       pooled buffers, blocking waits. Test projects, the analyzer itself and vendored third-party code are not analysed. The allow-list of findings that predate a rule is
       analyzers/safety-baseline.txt; scripts/safety-baseline.ps1 rewrites it. -->
  <ItemGroup Condition="'$(IsTestProject)' != 'true' and '$(MSBuildProjectName)' != 'ArcaneCore.Analyzers' and !$(MSBuildProjectDirectory.Contains('ThirdParty'))">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src\ArcaneCore.Analyzers\ArcaneCore.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)analyzers\safety-baseline.txt" />
  </ItemGroup>

</Project>
