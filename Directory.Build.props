<Project>

  <!-- Repo-wide build settings (Charter §2: nullable enabled, warnings-as-errors). -->
  <PropertyGroup>
    <!-- .NET 11 (net11.0) runtime + C# 15 (LangVersion preview). EF Core/Extensions packages
         stay on 9.0.0 because the Pomelo MySQL/MariaDB provider (primary engine)
         has no .NET 11 release yet; EF 9 is runtime-compatible with net11.0. -->
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Supply chain: every project restores against its committed packages.lock.json (exact versions plus content hashes of the
         whole transitive graph). CI (ci.yml, dotnet.yml), the Dockerfile, node CI (tools/ops/ci/node-ci.ps1), the local full gate
         (tools/ops/ci/full-suite-gate.ps1) and the deploy build (tools/ops/deploy/build-integrated.sh) restore with locked mode, so a
         package graph that differs from the lock file fails the restore instead of silently resolving something new. Updating a
         package: docs/guide/contributing.md. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- Test processes only: let a database be created through a reserved schema placeholder (src/ArcaneCore.Data/Schema/ReservedSchemaGaps.cs).
       Servers and tools never get this switch, so a build that still holds a placeholder refuses to create or upgrade a real database. -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <RuntimeHostConfigurationOption Include="ArcaneCore.Data.AllowReservedSchemaGaps" Value="true" />
  </ItemGroup>

</Project>
