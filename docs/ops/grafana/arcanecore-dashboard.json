{
  "title": "ArcaneCore",
  "uid": "arcanecore",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "arcanecore",
    "wow"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "realm",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(arcanecore_world_ticks_total, realm)",
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Players online",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(arcanecore_world_players_online{realm=~\"$realm\"})"
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Sessions",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(arcanecore_world_sessions{realm=~\"$realm\"})"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Tick p99",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(arcanecore_world_tick_duration_milliseconds_bucket{realm=~\"$realm\"}[5m])))"
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Save queue",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(arcanecore_db_save_queue_depth{realm=~\"$realm\"})"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "World tick duration",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(arcanecore_world_tick_duration_milliseconds_bucket{realm=~\"$realm\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(arcanecore_world_tick_duration_milliseconds_bucket{realm=~\"$realm\"}[$__rate_interval])))",
          "legendFormat": "p99"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(arcanecore_world_map_update_duration_milliseconds_bucket{realm=~\"$realm\"}[$__rate_interval])))",
          "legendFormat": "maps p99"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Ticks per second",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(arcanecore_world_ticks_total{realm=~\"$realm\"}[$__rate_interval])",
          "legendFormat": "ticks/s"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Packets",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(arcanecore_net_packets_in_total{realm=~\"$realm\"}[$__rate_interval])",
          "legendFormat": "in"
        },
        {
          "refId": "B",
          "expr": "rate(arcanecore_net_packets_out_total{realm=~\"$realm\"}[$__rate_interval])",
          "legendFormat": "out"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Network bytes",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(arcanecore_net_bytes_in_bytes_total{realm=~\"$realm\"}[$__rate_interval])",
          "legendFormat": "in"
        },
        {
          "refId": "B",
          "expr": "rate(arcanecore_net_bytes_out_bytes_total{realm=~\"$realm\"}[$__rate_interval])",
          "legendFormat": "out"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Map update time (mean, top 10)",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, arcanecore_map_update_time_mean_milliseconds{realm=~\"$realm\"})",
          "legendFormat": "map {{map}}/{{instance}}"
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Players and creatures per map",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (map) (arcanecore_map_players{realm=~\"$realm\"})",
          "legendFormat": "players map {{map}}"
        },
        {
          "refId": "B",
          "expr": "topk(10, sum by (map) (arcanecore_map_creatures{realm=~\"$realm\"}))",
          "legendFormat": "creatures map {{map}}"
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "GC",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(arcanecore_gc_collections_total{realm=~\"$realm\"}[$__rate_interval])",
          "legendFormat": "{{job}} {{generation}}"
        },
        {
          "refId": "B",
          "expr": "rate(arcanecore_gc_pause_time_seconds_total{realm=~\"$realm\"}[$__rate_interval])",
          "legendFormat": "{{job}} pause s/s"
        }
      ],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Allocation and heap",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(arcanecore_gc_allocated_bytes_total{realm=~\"$realm\"}[$__rate_interval])",
          "legendFormat": "{{job}} allocated/s"
        },
        {
          "refId": "B",
          "expr": "rate(arcanecore_world_tick_allocated_bytes_total{realm=~\"$realm\"}[$__rate_interval])",
          "legendFormat": "world thread allocated/s"
        },
        {
          "refId": "C",
          "expr": "arcanecore_gc_heap_size_bytes{realm=~\"$realm\"}",
          "legendFormat": "{{job}} heap"
        }
      ],
      "id": 12
    }
  ]
}